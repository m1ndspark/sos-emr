refRec = Referrals_Main[ID == input.Referral_Link];
if(refRec != null)
{
	input.Patient_First_Name = refRec.Patient_First_Name;
	input.Patient_Last_Name = refRec.Patient_Last_Name;
	input.Patient_DOB = refRec.Patient_DOB;
	input.Patient_Phone = refRec.Patient_Phone;
	input.Patient_Address = refRec.Patient_Address;
	input.Patient_Location = refRec.Patient_Location;
	input.Facility_Name = refRec.Facility_Name;
	input.Facility_Phone = refRec.Facility_Phone;
	input.Facility_Room_Number = refRec.Facility_Room_Number;
	if(refRec.Referral_Date != null)
	{
		input.Referral_Date = refRec.Referral_Date.toString("MM/dd/yyyy");
	}
	else
	{
		input.Referral_Date = "";
	}
	v_partner = ifnull(refRec.Partner_Organization,"").toString().trim();
	v_branch = ifnull(refRec.Partner_Branch,"").toString().trim();
	if(v_branch != "")
	{
		if(v_partner != "")
		{
			v_partner = v_partner + " / " + v_branch;
		}
		else
		{
			v_partner = v_branch;
		}
	}
	input.Referral_Partner = v_partner;
	input.Referral_POC = ifnull(refRec.Partner_POC_Name_Title,"").toString().trim();
}
if(input.Patient_Location == "Facility")
{
	show Facility_Name;
	show Facility_Phone;
	show Facility_Room_Number;
}
else
{
	hide Facility_Name;
	hide Facility_Phone;
	hide Facility_Room_Number;
}
