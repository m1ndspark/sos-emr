#!/bin/sh
# sos-emr local pre-commit gate (mechanical checks only).
#
# Enable once per clone with:  git config core.hooksPath .githooks
# Runs on every commit, whether made from the CLI or GitHub Desktop.
# Bypass (discouraged for Deluge/PHI code):  git commit --no-verify
#
# This gate catches mechanical mistakes only. The sos-precommit-audit
# subagent (judgment) and the live Creator test remain required.

here=$(dirname "$0")

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

# --- Content checks (shared with CI) ---
out=$(printf '%s\n' "$staged" | tr '\n' '\0' | xargs -0 "$here/sos-checks.sh")
rc=$?
[ -n "$out" ] && printf '%s\n' "$out"

warn=0

# --- WARN: .dg filename convention ---
# Emit "<basename>\t<path>", drop rows whose basename starts with a known
# On<Event>__ prefix, keep the path of the rest. (Avoids `case`, which trips
# bash 3.2's parser inside this command substitution.)
bad=$(printf '%s\n' "$staged" | grep -E '\.dg$' | while IFS= read -r f; do
  printf '%s\t%s\n' "${f##*/}" "$f"
done | grep -vE '^(OnValidate__|OnSuccess__|OnUserInput__|OnLoad__)' | cut -f2)
if [ -n "$bad" ]; then
  echo "WARN   .dg filename(s) without a known On<Event>__ prefix (exceptions exist; confirm intentional):"
  printf '%s\n' "$bad" | sed 's/^/  /'
  warn=1
fi

if [ "$rc" -ne 0 ]; then
  echo
  echo "Commit BLOCKED by sos-emr checks. Fix the BLOCK items above."
  echo "(Override with 'git commit --no-verify' - avoid for PHI/Deluge code.)"
  exit 1
fi

# --- ds_map auto-refresh (never blocks the commit) ---
# Runs only when SOS_Referrals_App.ds is staged. Regenerates MANIFEST.tsv and
# context/ds_map/ with ds_sync --manifest --map and stages them into this
# commit. On any failure the map files are left as committed, the _index.md
# header is set to STATUS: STALE with the reason and the new .ds SHA-256, that
# header change is staged, one WARN line is printed, and the commit proceeds.
if printf '%s\n' "$staged" | grep -qx 'SOS_Referrals_App.ds'; then
  top=$(git rev-parse --show-toplevel)
  idx="context/ds_map/_index.md"
  if ! (cd "$top" && git diff --quiet -- SOS_Referrals_App.ds); then
    dsrc=9; dsout="MAP: working-tree SOS_Referrals_App.ds differs from the staged copy"
  elif ! command -v python3 >/dev/null 2>&1; then
    dsrc=9; dsout="MAP: python3 not found"
  else
    dsout=$(cd "$top" && python3 tools/ds_sync.py --ds SOS_Referrals_App.ds --repo . --manifest --map 2>&1)
    dsrc=$?
  fi
  if [ "$dsrc" -eq 0 ]; then
    (cd "$top" && git add MANIFEST.tsv context/ds_map)
    echo "INFO   ds_map: regenerated and staged MANIFEST.tsv and context/ds_map/ from the staged .ds."
  else
    reason=$(printf '%s\n' "$dsout" | grep -E '^MAP:' | tail -n1 | tr -d '\r|' | cut -c1-200)
    [ -z "$reason" ] && reason=$(printf '%s\n' "$dsout" | grep -v '^[[:space:]]*$' | tail -n1 | tr -d '\r|' | cut -c1-200)
    [ -z "$reason" ] && reason="ds_sync exited $dsrc"
    if command -v shasum >/dev/null 2>&1; then
      sha=$(cd "$top" && git show :SOS_Referrals_App.ds | shasum -a 256 | cut -d' ' -f1)
    else
      sha=$(cd "$top" && git show :SOS_Referrals_App.ds | sha256sum | cut -d' ' -f1)
    fi
    (cd "$top" && git checkout -q -- MANIFEST.tsv context/ds_map 2>/dev/null)
    if [ -f "$top/$idx" ]; then
      REASON="$reason" SHA="$sha" perl -pi -e 's/^- STATUS: .*$/- STATUS: STALE ($ENV{REASON}; new .ds SHA-256: $ENV{SHA}; map content below reflects the earlier .ds)/' "$top/$idx"
      (cd "$top" && git add "$idx")
    fi
    echo "WARN   ds_map NOT refreshed ($reason); _index.md marked STALE, commit allowed."
    warn=1
  fi
fi

[ "$warn" -ne 0 ] && printf '\nWarnings only - commit allowed.\n'
exit 0
