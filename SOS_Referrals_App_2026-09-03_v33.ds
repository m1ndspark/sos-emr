			Complexity_Charge_Require as "Complexity Charge Required"
			{
				type =  form
				form = Encounter_PatientVisit

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											v_lvl = input.Complexity_Level;
										if(v_lvl == null)
										{
											v_lvl = "";
										}
										v_lvl = v_lvl.trim();
										v_check = false;
										if(v_lvl != "")
										{
											if(v_lvl != "No Charge")
											{
												if(v_lvl != "Visit Cancelled")
												{
													v_check = true;
												}
											}
										}
										if(v_check == true)
										{
											v_amt = input.Complexity_Charge;
											if(v_amt == null)
											{
												v_amt = 0;
											}
											if(v_amt <= 0)
											{
												v_label = "";
												if(input.Billing_Branch != null)
												{
													for each  v_l in Partner_Locations[ID == input.Billing_Branch]
													{
														v_label = v_l.Partner_Location_Label;
														break;
													}
												}
												alert "This visit is set to " + v_lvl + " but has no charge. Add a current rate for " + v_label + " / " + v_lvl + " in Partner Rates, or set Complexity Level to No Charge.";
												cancel submit;
											}
										}
						)
					}
				}

			}
			Additional_Charges_Show_H1 as "Additional Charges Show Hide"
			{
				type =  form
				form = Encounter_PatientVisit

				record event = on add or edit

				on user input of Additional_Charges
				{
					actions 
					{
						custom deluge script
						(
											v_User = zoho.loginuserid.toLowerCase();
										v_Billing = false;
										if(v_User == "joshua.kolanko@sosmmc.com" || v_User == "neil.heird@sosmmc.com")
										{
											v_Billing = true;
										}
										if(input.Additional_Charges.contains("Equipment Charge"))
										{
											if(v_Billing)
											{
												show Equipment_Charge_Amount;
												show Equipment_Charge_Details;
											}
										}
										else
										{
											hide Equipment_Charge_Amount;
											hide Equipment_Charge_Details;
											input.Equipment_Charge_Amount = 0;
											input.Equipment_Charge_Details = null;
										}
										if(input.Additional_Charges.contains("Other"))
										{
											if(v_Billing)
											{
												show Other_Charges_Amount;
												show Other_Charges_Details;
											}
										}
										else
										{
											hide Other_Charges_Amount;
											hide Other_Charges_Details;
											input.Other_Charges_Amount = 0;
											input.Other_Charges_Details = null;
										}
										v_missing = "";
										if(input.Additional_Charges.contains("After Hours"))
										{
											v_ah = null;
											if(input.Billing_Branch != null)
											{
												for each  r in Partner_Rates[Partner_Location_Link == input.Billing_Branch && Rate_Type == "After Hours" && Current_Rate == "Yes"]
												{
													v_ah = r.Rate_Amount;
													break;
												}
											}
											if(v_ah == null)
											{
												input.After_Hours_Fee = 0;
												v_missing = v_missing + "After Hours ";
											}
											else
											{
												input.After_Hours_Fee = v_ah;
											}
										}
										else
										{
											input.After_Hours_Fee = 0;
										}
										if(input.Additional_Charges.contains("Super STAT"))
										{
											v_ss = null;
											if(input.Billing_Branch != null)
											{
												for each  r in Partner_Rates[Partner_Location_Link == input.Billing_Branch && Rate_Type == "Super STAT" && Current_Rate == "Yes"]
												{
													v_ss = r.Rate_Amount;
													break;
												}
											}
											if(v_ss == null)
											{
												input.Super_Stat_Fee = 0;
												v_missing = v_missing + "Super STAT ";
											}
											else
											{
												input.Super_Stat_Fee = v_ss;
											}
										}
										else
										{
											input.Super_Stat_Fee = 0;
										}
										if(v_Billing && v_missing != "")
										{
											alert "No current rate found for: " + v_missing + ". The price was set to $0. Add the rate in the Partner Rates table before invoicing this visit.";
										}
						)
					}
				}

			}
			PVS_Required_Fields as "PVS Required Fields"
			{
				type =  form
				form = Encounter_PatientVisit

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											v_User = zoho.loginuserid.toLowerCase();
										v_Billing = false;
										if(v_User == "joshua.kolanko@sosmmc.com" || v_User == "neil.heird@sosmmc.com")
										{
											v_Billing = true;
										}
										v_IsNew = false;
										if(input.PVS_ID == null || input.PVS_ID.trim() == "")
										{
											v_IsNew = true;
										}
										v_Missing = List();
										if(input.Patient_First_Name == null || input.Patient_First_Name.trim() == "")
										{
											v_Missing.add("Patient First Name");
										}
										if(input.Patient_Last_Name == null || input.Patient_Last_Name.trim() == "")
										{
											v_Missing.add("Patient Last Name");
										}
										if(input.Patient_DOB == null)
										{
											v_Missing.add("Patient DOB");
										}
										if(input.Patient_Gender == null || input.Patient_Gender == "")
										{
											v_Missing.add("Patient Gender");
										}
										if(input.Patient_Phone == null || input.Patient_Phone.trim() == "")
										{
											v_Missing.add("Patient Phone");
										}
										if(input.Patient_Location == null || input.Patient_Location == "")
										{
											v_Missing.add("Patient Location");
										}
										if(input.Patient_Address.address_line_1 == null || Patient_Address.address_line_1.trim() == "")
										{
											v_Missing.add("Patient Address Line 1");
										}
										if(input.Patient_Address.district_city == null || Patient_Address.district_city.trim() == "")
										{
											v_Missing.add("Patient Address City");
										}
										if(input.Patient_Address.state_province == null || Patient_Address.state_province.trim() == "")
										{
											v_Missing.add("Patient Address State");
										}
										if(input.Patient_Address.postal_Code == null || Patient_Address.postal_Code.trim() == "")
										{
											v_Missing.add("Patient Address Zip");
										}
										if(input.Reason_for_Referral == null || input.Reason_for_Referral.trim() == "")
										{
											v_Missing.add("Reason for Referral");
										}
										if(input.Employee_Name_Title == null || input.Employee_Name_Title.trim() == "")
										{
											v_Missing.add("Provider Name & Title");
										}
										if(input.Employee_Email == null || input.Employee_Email.trim() == "")
										{
											v_Missing.add("Provider Email");
										}
										if(input.Patient_Location == "Facility")
										{
											if(input.Facility_Name == null || input.Facility_Name.trim() == "")
											{
												v_Missing.add("Facility Name");
											}
											if(input.Facility_Phone == null || input.Facility_Phone.trim() == "")
											{
												v_Missing.add("Facility Phone");
											}
											if(input.Facility_Room_Number == null || input.Facility_Room_Number.trim() == "")
											{
												v_Missing.add("Facility Room Number");
											}
										}
										if(input.Type_of_Entry == "Patient Visit")
										{
											if(input.Clinical_Note_Type == null || input.Clinical_Note_Type == "")
											{
												v_Missing.add("Clinical Note Type");
											}
											if(input.Final_Clinical_Note == null || input.Final_Clinical_Note.trim() == "")
											{
												v_Missing.add("Clinical Note");
											}
											if(v_IsNew)
											{
												if(input.Type_of_Procedures == null || input.Type_of_Procedures.isEmpty())
												{
													v_Missing.add("Type of Procedure(s)");
												}
											}
											if(input.Complexity_Level == null || input.Complexity_Level == "")
											{
												v_Missing.add("Complexity Level");
											}
											if(input.Visit_Completion_Date == null)
											{
												v_Missing.add("Visit Completion Date");
											}
											if(v_Billing && v_IsNew)
											{
												if(input.Complexity_Charge == null)
												{
													v_Missing.add("Complexity Charge");
												}
											}
										}
										if(input.Type_of_Entry != "3008")
										{
											if(input.Diversion_Tracking == null || input.Diversion_Tracking == "")
											{
												v_Missing.add("Diversion Tracking");
											}
										}
										if(v_Missing.size() > 0)
										{
											alert "Please complete the following required fields: " + v_Missing.toString(", ");
											cancel submit;
										}
						)
					}
				}

			}
			Referrals_Main_On_Create_ as "Referrals Main On Create - Master"
			{
				type =  form
				form = Referrals_Main

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											thisapp.mint_referral_id(input.ID);
										v_RefDate = zoho.currentdate;
										v_Vals = List();
										v_Vals.add(input.Patient_Phone);
										v_Vals.add(input.AC_Phone);
										v_Vals.add(input.Partner_POC_Phone);
										v_Vals.add(input.Facility_Phone);
										v_Out = List();
										for each  v_Raw in v_Vals
										{
											v_F = "";
											if(v_Raw != null)
											{
												v_D = v_Raw.toString().replaceAll("[^0-9]","");
												if(v_D.length() == 10)
												{
													v_F = v_D.subString(0,3) + "-" + v_D.subString(3,6) + "-" + v_D.subString(6,10);
												}
												else
												{
													v_F = v_D;
												}
											}
											v_Out.add(v_F);
										}
										v_SSN = "";
										if(input.Patient_SSN != null)
										{
											v_S = input.Patient_SSN.toString().replaceAll("[^0-9]","");
											if(v_S.length() == 9)
											{
												v_SSN = v_S.subString(0,3) + "-" + v_S.subString(3,5) + "-" + v_S.subString(5,9);
											}
											else
											{
												v_SSN = v_S;
											}
										}
										v_Addr = "";
										if(input.Patient_Address.address_line_1 != null && Patient_Address.address_line_1.trim() != "")
										{
											v_Addr = input.Patient_Address.address_line_1.trim();
										}
										if(input.Patient_Address.address_line_2 != null && Patient_Address.address_line_2.trim() != "")
										{
											v_Addr = v_Addr + ", " + input.Patient_Address.address_line_2.trim();
										}
										if(input.Patient_Address.district_city != null && Patient_Address.district_city.trim() != "")
										{
											v_Addr = v_Addr + ", " + input.Patient_Address.district_city.trim();
										}
										if(input.Patient_Address.state_province != null && Patient_Address.state_province.trim() != "")
										{
											v_Addr = v_Addr + ", " + input.Patient_Address.state_province.trim();
										}
										if(input.Patient_Address.postal_Code != null && Patient_Address.postal_Code.trim() != "")
										{
											v_Addr = v_Addr + " " + input.Patient_Address.postal_Code.trim();
										}
										v_Addr = v_Addr.trim();
										v_ACFull = "";
										if(input.AC_First_Name != null && input.AC_First_Name.trim() != "")
										{
											v_ACFull = input.AC_First_Name.trim();
										}
										if(input.AC_Last_Name != null && input.AC_Last_Name.trim() != "")
										{
											v_ACFull = (v_ACFull + " " + input.AC_Last_Name.trim()).trim();
										}
										v_Full = "";
										if(input.Patient_First_Name != null && input.Patient_First_Name.trim() != "")
										{
											v_Full = input.Patient_First_Name.trim();
										}
										if(input.Patient_MI != null && input.Patient_MI.trim() != "")
										{
											if(v_Full != "")
											{
												v_Full = v_Full + " ";
											}
											v_Full = v_Full + input.Patient_MI.trim();
										}
										if(input.Patient_Last_Name != null && input.Patient_Last_Name.trim() != "")
										{
											if(v_Full != "")
											{
												v_Full = v_Full + " ";
											}
											v_Full = v_Full + input.Patient_Last_Name.trim();
										}
										v_NameTitle = "";
										if(input.Partner_POC_First_Name != null && input.Partner_POC_First_Name.trim() != "")
										{
											v_NameTitle = input.Partner_POC_First_Name.trim();
										}
										if(input.Partner_POC_Last_Name != null && input.Partner_POC_Last_Name.trim() != "")
										{
											if(v_NameTitle != "")
											{
												v_NameTitle = v_NameTitle + " ";
											}
											v_NameTitle = v_NameTitle + input.Partner_POC_Last_Name.trim();
										}
										if(input.Partner_POC_Title != null && input.Partner_POC_Title.trim() != "")
										{
											if(v_NameTitle != "")
											{
												v_NameTitle = v_NameTitle + ", ";
											}
											v_NameTitle = v_NameTitle + input.Partner_POC_Title.trim();
										}
										v_LocId = null;
										v_PartnerId = null;
										v_LocName = "";
										v_LocLabel = "";
										v_Org = "";
										v_PID = "";
										if(input.Partner_Location_Label != null && input.Partner_Location_Label.trim() != "")
										{
											v_Sel = input.Partner_Location_Label.trim();
											v_SelKey = v_Sel.toLowerCase();
											v_Loc = Partner_Locations[Partner_Location_Name == v_Sel && Partner_Location_Status == "Active"];
											if(v_Loc.ID == null)
											{
												for each  v_L2 in Partner_Locations[Partner_Location_Status == "Active"]
												{
													if(v_L2.Partner_Location_Name != null && v_L2.Partner_Location_Name.trim().toLowerCase() == v_SelKey)
													{
														v_Loc = Partner_Locations[ID == v_L2.ID];
														break;
													}
												}
											}
											if(v_Loc.ID != null)
											{
												v_LocId = v_Loc.ID;
												v_PartnerId = v_Loc.Partner_Link;
												v_LocName = v_Loc.Partner_Location_Name;
												v_LocLabel = v_Loc.Partner_Location_Label;
												v_Org = v_Loc.Partner_Link.Partner_Display_Name;
												v_PID = v_Loc.Partner_Link.Partner_ID;
											}
										}
										for each  v_Rec in Referrals_Main[ID == input.ID]
										{
											update v_Rec
											[
												Referral_Date=v_RefDate
												Patient_Phone=v_Out.get(0)
												AC_Phone=v_Out.get(1)
												Partner_POC_Phone=v_Out.get(2)
												Facility_Phone=v_Out.get(3)
												Patient_SSN=v_SSN
												Patient_Full_Address=v_Addr
												AC_Full_Name=v_ACFull
												Patient_Full_Name=v_Full
												Partner_POC_Name_Title=v_NameTitle
											];
											if(v_LocId != null)
											{
												update v_Rec
												[
													Partner_Organization=v_Org
													Partner_Branch=v_LocName
													Partner_Location_Label=v_LocLabel
													Partner_Link=v_PartnerId
													Partner_Branch_Link=v_LocId
													Partner_ID=v_PID
													Partner_ID_Stamp=v_PartnerId.toString()
												];
											}
										}
										v_Email = input.Partner_POC_Email;
										if(v_Email != null && v_Email.trim() != "")
										{
											v_Email = v_Email.trim();
											v_Key = v_Email.toLowerCase();
											v_MatchId = 0;
											for each  v_C in Partner_Referral_Contacts[Partner_POC_Email == v_Email]
											{
												v_MatchId = v_C.ID;
												break;
											}
											if(v_MatchId == 0)
											{
												for each  v_Scan in Partner_Referral_Contacts[ID != null]
												{
													if(v_Scan.Partner_POC_Email != null && v_Scan.Partner_POC_Email.trim().toLowerCase() == v_Key)
													{
														v_MatchId = v_Scan.ID;
														break;
													}
												}
											}
											if(v_MatchId != 0)
											{
												for each  v_Upd in Partner_Referral_Contacts[ID == v_MatchId]
												{
													update v_Upd
													[
														Partner_POC_First_Name=input.Partner_POC_First_Name
														Partner_POC_Last_Name=input.Partner_POC_Last_Name
														Partner_POC_Title=input.Partner_POC_Title
														Partner_POC_Phone=v_Out.get(2)
														Partner_Organization=v_Org
														Partner_Branch=v_LocName
														Partner_POC_Team=input.Partner_POC_Team
														Partner_POC_Name_Title=v_NameTitle
													];
													if(v_LocId != null)
													{
														update v_Upd
														[
															Partner_Link=v_PartnerId
															Partner_Locations_Link=v_LocId
														];
													}
												}
											}
											else
											{
												v_NewId = insert into Partner_Referral_Contacts
												[
													Partner_POC_Email=v_Email
													Partner_POC_First_Name=input.Partner_POC_First_Name
													Partner_POC_Last_Name=input.Partner_POC_Last_Name
													Partner_POC_Title=input.Partner_POC_Title
													Partner_POC_Phone=v_Out.get(2)
													Partner_Organization=v_Org
													Partner_Branch=v_LocName
													Partner_POC_Team=input.Partner_POC_Team
													Partner_POC_Name_Title=v_NameTitle
													Added_User=zoho.loginuser
												];
												if(v_LocId != null)
												{
													for each  v_New in Partner_Referral_Contacts[ID == v_NewId]
													{
														update v_New
														[
															Partner_Link=v_PartnerId
															Partner_Locations_Link=v_LocId
														];
													}
												}
											}
										}
										v_AsgExisting = Assignments[Referral_Link == input.ID].count();
										if(v_AsgExisting == 0)
										{
											v_AsgId = insert into Assignments
											[
												Referral_Link=input.ID
												Patient_First_Name=input.Patient_First_Name
												Patient_Last_Name=input.Patient_Last_Name
												Patient_DOB=input.Patient_DOB1
												Patient_Phone=v_Out.get(0)
												Patient_Address=input.Patient_Address
												Patient_Location=input.Patient_Location
												Facility_Name=input.Facility_Name
												Facility_Phone=v_Out.get(3)
												Facility_Room_Number=input.Facility_Room_Number
												Added_User=zoho.loginuser
											];
											thisapp.mint_assignment_id(v_AsgId);
										}
						)
					}
				}

			}
			Patient_Full_Name_Generat as "Patient Full Name Generator"
			{
				type =  form
				form = Referrals_Main

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											v_full = "";
										if(input.Patient_First_Name != null && input.Patient_First_Name.trim() != "")
										{
											v_full = input.Patient_First_Name.trim();
