			displayname = "User Lookup"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<form \n\telementName='Form'\n\n\tappLinkName = 'thisapp'\n\tlinkName = 'Partner_Referral_Contact_Lookup'\n\tallowPublicAccess = 'true'\n\theightType = 'custom'\n\theightValue = '150'\n\turlType = 'none'\n\tzc_Header = 'false'\n\tzc_SubmitVal = 'Check Identity'\n/> \n</column>\n</row>\n</layout>\n</zml>"
