	pages
	{
		page Patient_Referrals
		{
			displayname = "Patient Referrals"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\twebDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='html_snippet' elementName='HTML Snippet'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet()\ncontent\n&lt;%{\n\n}%&gt;]]>\n</dsp>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='html_snippet2' elementName='HTML Snippet 1'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet2()\ncontent\n&lt;%{\n\t%&gt;\n&lt;style&gt;\n  .sos-form-wrap {\n    margin: 0 auto;\n    max-width: 1000px;\n    padding: 24px 16px;\n    text-align: center;\n  }\n  .sos-form-frame {\n    border: none;\n    height: 680px;\n    width: 100%;\n    display: block;\n    border-radius: 20px;\n    box-shadow: 0 2px 12px rgba(0,0,0,0.08);\n\t\n  .fldSuffixBtn {\n\t  background: red !important;\n\t  background-color: red !important;\n  }\n\t\n\t\n  }\n  @media screen and (max-width: 768px) {\n    .sos-form-wrap {\n      padding: 12px 8px;\n    }\n    .sos-form-frame {\n      height: 760px;\n      border-radius: 12px;\n    }\n  }\n&lt;/style&gt;\n&lt;div class=&quot;sos-form-wrap&quot;&gt;\n  &lt;iframe\n    class=&quot;sos-form-frame&quot;\n    src=&quot;https://forms.zohopublic.com/SOSReferralForm/form/PatientReferral/formperma/_WhhCPE6GSg7iEZZyE6YGawxwZHr4Izij2oGuzkAGds&quot;\n    scrolling=&quot;auto&quot;\n    aria-label=&quot;Patient Referral&quot;\n    allow=&quot;geolocation;&quot;\n    allowfullscreen=&quot;true&quot;&gt;\n  &lt;/iframe&gt;\n&lt;/div&gt;\n&lt;%\n\n}%&gt;]]>\n</dsp>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<button \n\t\tmargin = '0px'\n\tpaddingTop = '12px'\n\tpaddingLeft = '15px'\n\tpaddingRight = '15px'\n\tpaddingBottom = '12px'\n\n    action = 'OpenForm'\n\t\tcomponentLinkName = 'Encounter_PatientVisit'\n\t\ttarget = 'new-window'\n\tcolor = '#FFFFFF'\n\tsize = '16px'\n    borderColor = '#FFFFFF'\n    borderWidth = '0px'\n\ttext ='Add PVS Record'\n\t\tbgColor = '#0B0B5B'\n\t\tcornerRadius = '3px' \n/>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row>\n</layout>\n</zml>"
		}
		page Access_Revoked_Page
		{
			displayname = "Access Revoked Page"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='html_snippet1' elementName='HTML Snippet'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet1()\ncontent\n&lt;%{\n\t%&gt;\n&lt;div style=&quot;min-height:90vh; display:flex; align-items:center; justify-content:center; padding:20px; box-sizing:border-box;&quot;&gt;\n\t&lt;div style=&quot;max-width:600px; width:100%; padding:40px; font-family:Arial, Helvetica, sans-serif; text-align:center; border:1px solid #e0e0e0; border-radius:8px; box-shadow:0 4px 16px rgba(0,0,0,0.12); background:#ffffff;&quot;&gt;\n\t\t&lt;h2 style=&quot;color:#2d3748; margin-bottom:16px;&quot;&gt;Account Access Unavailable&lt;/h2&gt;\n\t\t&lt;p style=&quot;color:#4a5568; font-size:15px; line-height:1.6;&quot;&gt;\n\t\t\tYour provider account is currently inactive, so access to the SOS Referrals application is unavailable.\n\t\t&lt;/p&gt;\n\t\t&lt;p style=&quot;color:#4a5568; font-size:15px; line-height:1.6;&quot;&gt;\n\t\t\tIf you believe this is an error, please contact an SOS administrator.\n\t\t&lt;/p&gt;\n\t\t&lt;p style=&quot;margin-top:28px; color:#718096; font-size:14px;&quot;&gt;\n\t\t\t&lt;a href=&quot;mailto:admin@sosmmc.com&quot; style=&quot;color:#3182ce; text-decoration:none;&quot;&gt;admin@sosmmc.com&lt;/a&gt;\n\t\t&lt;/p&gt;\n\t&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n\n}%&gt;]]>\n</dsp>\n</column>\n</row>\n</layout>\n</zml>"
		}
		page User_Lookup
