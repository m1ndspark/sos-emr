				 string backfill_pvs_address_from_referral()
                 {
                 	v_filled = 0;
                 	v_nosource = 0;
                 	for each  v_pvs in Encounter_PatientVisit[Referral_Link != null]
                 	{
                 		if(v_pvs.Patient_Address.address_line_1 == null || v_pvs.Patient_Address.address_line_1.trim() == "")
                 		{
                 			v_ref = Referrals_Main[ID == v_pvs.Referral_Link];
                 			v_src1 = "";
                 			v_src2 = "";
                 			v_city = "";
                 			v_state = "";
                 			v_zip = "";
                 			for each  v_r in v_ref
                 			{
                 				v_src1 = ifnull(v_r.Patient_Address.address_line_1,"");
                 				v_src2 = ifnull(v_r.Patient_Address.address_line_2,"");
                 				v_city = ifnull(v_r.Patient_Address.district_city,"");
                 				v_state = ifnull(v_r.Patient_Address.state_province,"");
                 				v_zip = ifnull(v_r.Patient_Address.postal_Code,"");
                 				break;
                 			}
                 			if(v_src1.trim() != "")
                 			{
                 				update v_pvs
                 				[
                 					Patient_Address.address_line_1=v_src1
                 					Patient_Address.address_line_2=v_src2
                 					Patient_Address.district_city=v_city
                 					Patient_Address.state_province=v_state
                 					Patient_Address.postal_Code=v_zip
                 				];
                 				v_filled = v_filled + 1;
                 			}
                 			else
                 			{
                 				v_nosource = v_nosource + 1;
                 			}
                 		}
                 	}
                 	return "Addresses filled: " + v_filled + ". No referral address available: " + v_nosource + ".";
                 }
				 string backfill_pvs_billing_branch()
                 {
                 	v_updated = 0;
                 	v_skipped = 0;
                 	v_manual = 0;
                 	for each  p in Encounter_PatientVisit[Referral_Link != null]
                 	{
                 		v_Ref = Referrals_Main[ID == p.Referral_Link];
                 		if(v_Ref.ID != null && v_Ref.Partner_Branch_Link != null)
                 		{
                 			v_Loc = Partner_Locations[ID == v_Ref.Partner_Branch_Link];
                 			p.Billing_Branch=v_Ref.Partner_Branch_Link;
                 			if(v_Loc.ID != null)
                 			{
                 				p.Partner_Branch=v_Loc.Partner_Location_Name;
                 				p.Partner_Location_Label=v_Loc.Partner_Location_Label;
                 				p.Partner_Organization=v_Loc.Partner_Link.Partner_Display_Name;
                 			}
                 			v_updated = v_updated + 1;
                 		}
                 		else
                 		{
                 			v_skipped = v_skipped + 1;
                 		}
                 	}
                 	for each  q in Encounter_PatientVisit[Referral_Link == null && Billing_Branch != null]
                 	{
                 		v_Loc2 = Partner_Locations[ID == q.Billing_Branch];
                 		if(v_Loc2.ID != null)
                 		{
                 			q.Partner_Branch=v_Loc2.Partner_Location_Name;
                 			q.Partner_Location_Label=v_Loc2.Partner_Location_Label;
                 			q.Partner_Organization=v_Loc2.Partner_Link.Partner_Display_Name;
                 			v_manual = v_manual + 1;
                 		}
                 	}
                 	return "PVS billing branch - from referral: " + v_updated + " | skipped (no branch on referral): " + v_skipped + " | no-referral PVS refreshed: " + v_manual;
                 }
				 string backfill_pvs_complexity_charge()
                 {
                 	v_filled = 0;
                 	v_kept = 0;
                 	v_norate = 0;
                 	v_skipped = 0;
                 	v_miss = List();
                 	for each  p in Encounter_PatientVisit[ID != 0]
                 	{
                 		v_lvl = p.Complexity_Level;
                 		if(v_lvl == null)
                 		{
                 			v_lvl = "";
                 		}
                 		v_lvl = v_lvl.trim();
                 		if(p.Billing_Branch == null || v_lvl == "" || v_lvl == "No Charge")
                 		{
                 			v_skipped = v_skipped + 1;
                 		}
                 		else
                 		{
                 			v_amt = 0.0;
                 			if(p.Complexity_Charge != null)
                 			{
                 				v_amt = p.Complexity_Charge.toDecimal();
                 			}
                 			if(v_amt > 0)
                 			{
                 				v_kept = v_kept + 1;
                 			}
                 			else
                 			{
                 				v_rate = null;
                 				for each  r in Partner_Rates[Partner_Location_Link == p.Billing_Branch && Rate_Type == v_lvl && Current_Rate == "Yes"]
                 				{
                 					v_rate = r.Rate_Amount;
                 					break;
                 				}
                 				if(v_rate == null)
                 				{
                 					v_norate = v_norate + 1;
                 					v_loc = Partner_Locations[ID == p.Billing_Branch];
                 					v_key = v_loc.Partner_Location_Label + " / " + v_lvl;
                 					if(!v_miss.contains(v_key))
                 					{
                 						v_miss.add(v_key);
                 					}
                 				}
                 				else
                 				{
                 					update p
                 					[
                 						Complexity_Charge=v_rate
                 					];
                 					v_filled = v_filled + 1;
                 				}
                 			}
                 		}
                 	}
                 	v_out = "Charges filled: " + v_filled + ". Already had a charge, left alone: " + v_kept + ". No current rate found: " + v_norate + ". Not eligible: " + v_skipped + ".";
                 	if(v_miss.size() > 0)
                 	{
                 		v_out = v_out + " Missing rates: " + v_miss.toString(", ");
                 	}
                 	return v_out;
                 }
				 string backfill_pvs_employee_email()
                 {
                 	v_filled = 0;
                 	v_nomatch = 0;
                 	v_kept = 0;
                 	v_unmatched = "";
                 	for each  p in Encounter_PatientVisit[Employee_Last_Name != null]
                 	{
                 		v_cur = ifnull(p.Employee_Email,"");
                 		if(v_cur.trim() != "")
                 		{
                 			v_kept = v_kept + 1;
                 		}
                 		else
                 		{
                 			v_first = ifnull(p.Employee_First_Name,"").trim().toLowerCase();
                 			v_last = ifnull(p.Employee_Last_Name,"").trim().toLowerCase();
                 			v_email = "";
                 			v_title = "";
                 			v_init = "";
                 			v_nt = "";
                 			for each  e in Employees[ID != 0]
                 			{
                 				if(ifnull(e.Employee_First_Name,"").trim().toLowerCase() == v_first && ifnull(e.Employee_Last_Name,"").trim().toLowerCase() == v_last)
                 				{
                 					v_email = ifnull(e.Employee_Email,"");
                 					v_title = ifnull(e.Employee_Title,"");
                 					v_init = ifnull(e.Employee_Initials,"");
                 					v_nt = ifnull(e.Employee_Name_Title,"");
                 					break;
                 				}
                 			}
                 			if(v_email.trim() == "")
                 			{
                 				v_nomatch = v_nomatch + 1;
                 				v_unmatched = v_unmatched + " | " + ifnull(p.Employee_First_Name,"") + " " + ifnull(p.Employee_Last_Name,"");
                 			}
                 			else
                 			{
                 				v_useTitle = ifnull(p.Employee_Title,"");
                 				if(v_useTitle.trim() == "")
                 				{
                 					v_useTitle = v_title;
                 				}
                 				v_useInit = ifnull(p.Employee_Initials,"");
                 				if(v_useInit.trim() == "")
                 				{
                 					v_useInit = v_init;
                 				}
                 				v_useNT = ifnull(p.Employee_Name_Title,"");
                 				if(v_useNT.trim() == "")
                 				{
                 					v_useNT = v_nt;
                 				}
                 				update p
                 				[
                 					Employee_Email=v_email
                 					Employee_Title=v_useTitle
                 					Employee_Initials=v_useInit
                 					Employee_Name_Title=v_useNT
                 				];
                 				v_filled = v_filled + 1;
                 			}
                 		}
                 	}
                 	return "Employee email filled: " + v_filled + ". Already had one: " + v_kept + ". No Employees match: " + v_nomatch + "." + v_unmatched;
                 }
				 string backfill_pvs_employee_initials()
                 {
                 	v_updated = 0;
                 	v_nomatch = 0;
                 	v_map = Map();
                 	for each  e in Employees[ID != 0]
                 	{
                 		if(e.Employee_Email != "" && e.Employee_Initials != "")
                 		{
                 			v_map.put(e.Employee_Email.trim().toLowerCase(),e.Employee_Initials);
                 		}
                 	}
                 	for each  p in Encounter_PatientVisit[Employee_Initials == "" && Employee_Email != ""]
                 	{
                 		v_key = p.Employee_Email.trim().toLowerCase();
                 		if(v_map.containKey(v_key))
                 		{
                 			p.Employee_Initials=v_map.get(v_key);
                 			v_updated = v_updated + 1;
                 		}
                 		else
                 		{
                 			v_nomatch = v_nomatch + 1;
                 		}
                 	}
                 	return "PVS employee initials - updated: " + v_updated + " | no match: " + v_nomatch;
                 }
				 string backfill_pvs_from_referral()
                 {
                 	v_done = 0;
                 	v_norec = 0;
                 	for each  v_pvs in Encounter_PatientVisit[Referral_Link != null]
                 	{
                 		v_ref = null;
                 		for each  v_r in Referrals_Main[ID == v_pvs.Referral_Link]
                 		{
                 			v_ref = v_r;
                 			break;
                 		}
                 		if(v_ref == null)
                 		{
                 			v_norec = v_norec + 1;
                 		}
                 		else
                 		{
                 			v_full = ifnull(v_pvs.Patient_Full_Name_1,"");
                 			if(v_full.trim() == "")
                 			{
                 				v_full = ifnull(v_ref.Patient_Full_Name,"");
                 			}
                 			v_full2 = ifnull(v_pvs.Patient_Full_Name_2,"");
                 			if(v_full2.trim() == "")
                 			{
                 				v_full2 = v_full;
                 			}
                 			v_mi = ifnull(v_pvs.Patient_MI,"");
                 			if(v_mi.trim() == "")
                 			{
                 				v_mi = ifnull(v_ref.Patient_MI,"");
                 			}
                 			v_ssn = ifnull(v_pvs.Patient_SSN,"");
                 			if(v_ssn.trim() == "")
                 			{
                 				v_ssn = ifnull(v_ref.Patient_SSN,"");
                 			}
                 			v_hosp = ifnull(v_pvs.Patient_Hospice_ID,"");
                 			if(v_hosp.trim() == "")
                 			{
                 				v_hosp = ifnull(v_ref.Patient_Hospice_ID,"");
                 			}
                 			v_pphone = ifnull(v_pvs.Patient_Phone,"");
                 			if(v_pphone.trim() == "")
                 			{
                 				v_pphone = ifnull(v_ref.Patient_Phone,"");
                 			}
                 			v_facphone = ifnull(v_pvs.Facility_Phone,"");
                 			if(v_facphone.trim() == "")
                 			{
                 				v_facphone = ifnull(v_ref.Facility_Phone,"");
                 			}
                 			v_facroom = ifnull(v_pvs.Facility_Room_Number,"");
                 			if(v_facroom.trim() == "")
                 			{
                 				v_facroom = ifnull(v_ref.Facility_Room_Number,"");
                 			}
                 			v_stamp = ifnull(v_pvs.Referral_ID_Stamp,"");
                 			if(v_stamp.trim() == "")
                 			{
                 				v_stamp = ifnull(v_ref.Referral_ID_Stamp,"");
                 			}
                 			v_pid = ifnull(v_pvs.Partner_ID,"");
                 			if(v_pid.trim() == "")
                 			{
                 				v_pid = ifnull(v_ref.Partner_ID,"");
                 			}
                 			v_pidstamp = ifnull(v_pvs.Partner_ID_Stamp,"");
                 			if(v_pidstamp.trim() == "")
                 			{
                 				v_pidstamp = ifnull(v_ref.Partner_ID_Stamp,"");
                 			}
                 			v_pocphone = ifnull(v_pvs.Partner_POC_Phone,"");
                 			if(v_pocphone.trim() == "")
                 			{
                 				v_pocphone = ifnull(v_ref.Partner_POC_Phone,"");
                 			}
                 			v_pocemail = ifnull(v_pvs.Partner_POC_Email,"");
                 			if(v_pocemail.trim() == "")
                 			{
                 				v_pocemail = ifnull(v_ref.Partner_POC_Email,"");
                 			}
                 			v_poctitle = ifnull(v_pvs.Partner_POC_Title,"");
                 			if(v_poctitle.trim() == "")
                 			{
                 				v_poctitle = ifnull(v_ref.Partner_POC_Title,"");
                 			}
                 			v_pocfirst = ifnull(v_pvs.Partner_POC_First_Name,"");
                 			if(v_pocfirst.trim() == "")
                 			{
                 				v_pocfirst = ifnull(v_ref.Partner_POC_First_Name,"");
                 			}
                 			v_poclast = ifnull(v_pvs.Partner_POC_Last_Name,"");
                 			if(v_poclast.trim() == "")
                 			{
                 				v_poclast = ifnull(v_ref.Partner_POC_Last_Name,"");
                 			}
                 			v_pocteam = ifnull(v_pvs.Partner_POC_Team,"");
                 			if(v_pocteam.trim() == "")
                 			{
                 				v_pocteam = ifnull(v_ref.Partner_POC_Team,"");
                 			}
                 			v_nametitle = ifnull(v_pvs.Partner_POC_Name_Title,"");
                 			if(v_nametitle.trim() == "")
                 			{
                 				v_nametitle = (v_pocfirst + " " + v_poclast).trim();
                 				if(v_poctitle.trim() != "" && v_nametitle != "")
                 				{
                 					v_nametitle = v_nametitle + ", " + v_poctitle.trim();
                 				}
                 			}
                 			v_label = ifnull(v_pvs.Partner_Location_Label,"");
                 			if(v_label.trim() == "")
                 			{
                 				v_label = ifnull(v_ref.Partner_Location_Label,"");
                 			}
                 			v_icd = ifnull(v_pvs.Partner_ICD_Codes,"");
                 			if(v_icd.trim() == "")
                 			{
                 				v_icd = ifnull(v_ref.Partner_ICD_Codes,"");
                 			}
                 			v_reason = ifnull(v_pvs.Reason_for_Referral,"");
                 			if(v_reason.trim() == "")
                 			{
                 				v_reason = ifnull(v_ref.Referral_Reason,"");
                 			}
                 			v_allerg = ifnull(v_pvs.List_Patient_Allergies,"");
                 			if(v_allerg.trim() == "")
                 			{
                 				v_allerg = ifnull(v_ref.List_Patient_Allergies,"");
                 			}
                 			v_antic = ifnull(v_pvs.List_Patient_Anticoagulants,"");
                 			if(v_antic.trim() == "")
                 			{
                 				v_antic = ifnull(v_ref.List_Patient_Anticoagulants,"");
                 			}
                 			v_ad = ifnull(v_pvs.Advanced_Directives_Details,"");
                 			if(v_ad.trim() == "")
                 			{
                 				v_ad = ifnull(v_ref.Advanced_Directives_Details,"");
                 			}
                 			v_addl = ifnull(v_pvs.Additional_Information,"");
                 			if(v_addl.trim() == "")
                 			{
                 				v_addl = ifnull(v_ref.Additional_Information,"");
                 			}
                 			v_a1 = ifnull(v_pvs.Patient_Address.address_line_1,"");
                 			v_a2 = ifnull(v_pvs.Patient_Address.address_line_2,"");
                 			v_city = ifnull(v_pvs.Patient_Address.district_city,"");
                 			v_state = ifnull(v_pvs.Patient_Address.state_province,"");
                 			v_zip = ifnull(v_pvs.Patient_Address.postal_Code,"");
                 			if(v_a1.trim() == "")
                 			{
                 				v_a1 = ifnull(v_ref.Patient_Address.address_line_1,"");
                 				v_a2 = ifnull(v_ref.Patient_Address.address_line_2,"");
                 				v_city = ifnull(v_ref.Patient_Address.district_city,"");
                 				v_state = ifnull(v_ref.Patient_Address.state_province,"");
                 				v_zip = ifnull(v_ref.Patient_Address.postal_Code,"");
                 			}
                 			if(v_pphone.trim() == "")
                 			{
                 				v_pphone = null;
                 			}
                 			if(v_facphone.trim() == "")
                 			{
                 				v_facphone = null;
                 			}
                 			if(v_pocphone.trim() == "")
                 			{
                 				v_pocphone = null;
                 			}
                 			if(v_pocemail.trim() == "")
                 			{
                 				v_pocemail = null;
                 			}
                 			update v_pvs
                 			[
                 				Patient_Full_Name_1=v_full
                 				Patient_Full_Name_2=v_full2
                 				Patient_MI=v_mi
                 				Patient_SSN=v_ssn
                 				Patient_Hospice_ID=v_hosp
                 				Patient_Phone=v_pphone
                 				Facility_Phone=v_facphone
                 				Facility_Room_Number=v_facroom
                 				Patient_Address.address_line_1=v_a1
                 				Patient_Address.address_line_2=v_a2
                 				Patient_Address.district_city=v_city
                 				Patient_Address.state_province=v_state
                 				Patient_Address.postal_Code=v_zip
                 				Referral_ID_Stamp=v_stamp
                 				Partner_ID=v_pid
                 				Partner_ID_Stamp=v_pidstamp
                 				Partner_POC_First_Name=v_pocfirst
                 				Partner_POC_Last_Name=v_poclast
                 				Partner_POC_Title=v_poctitle
                 				Partner_POC_Phone=v_pocphone
                 				Partner_POC_Email=v_pocemail
                 				Partner_POC_Team=v_pocteam
                 				Partner_POC_Name_Title=v_nametitle
                 				Partner_Location_Label=v_label
                 				Partner_ICD_Codes=v_icd
                 				Reason_for_Referral=v_reason
                 				List_Patient_Allergies=v_allerg
                 				List_Patient_Anticoagulants=v_antic
                 				Advanced_Directives_Details=v_ad
                 				Additional_Information=v_addl
                 			];
                 			v_done = v_done + 1;
                 		}
                 	}
                 	return "PVS backfilled from referral: " + v_done + ". No referral record found: " + v_norec + ".";
                 }
				 string backfill_pvs_ids()
                 {
                 	v_minted = 0;
                 	v_refset = 0;
                 	v_flagset = 0;
                 	v_skip = 0;
                 	for each  p in Encounter_PatientVisit[ID != 0]
                 	{
                 		v_curId = p.PVS_ID;
                 		if(v_curId == null)
                 		{
                 			v_curId = "";
                 		}
                 		v_curId = v_curId.trim();
                 		v_curRef = p.PVS_Referral_ID;
                 		if(v_curRef == null)
                 		{
                 			v_curRef = "";
                 		}
                 		v_curRef = v_curRef.trim();
                 		v_rid = p.Referral_ID;
                 		if(v_rid == null)
                 		{
                 			v_rid = "";
                 		}
                 		v_rid = v_rid.trim();
                 		v_curFlag = p.Has_Referral_ID;
                 		if(v_curFlag == null)
                 		{
                 			v_curFlag = "";
                 		}
                 		v_curFlag = v_curFlag.trim();
                 		v_flag = v_curFlag;
                 		v_doFlag = false;
                 		if(v_flag == "")
                 		{
                 			if(v_rid != "")
                 			{
                 				v_flag = "Yes";
                 			}
                 			else
                 			{
                 				v_flag = "No";
                 			}
                 			v_doFlag = true;
                 		}
                 		v_newId = v_curId;
                 		v_newRef = v_curRef;
                 		v_doId = false;
                 		v_doRef = false;
                 		v_bad = false;
                 		if(v_curId == "")
                 		{
                 			v_init = "";
                 			if(p.Employee_Initials != null)
                 			{
                 				v_init = p.Employee_Initials.toString().trim();
                 			}
                 			v_seq = 0;
                 			v_found = false;
                 			for each  t in Sequence_Tracker[Object_Prefix == "PVS"]
                 			{
                 				v_seq = t.Object_Sequence;
                 				v_found = true;
                 				update t
                 				[
                 					Object_Sequence=v_seq + 1
                 				];
                 				break;
                 			}
                 			if(!v_found)
                 			{
                 				v_bad = true;
                 			}
                 			else
                 			{
                 				v_newId = "PVS-" + v_seq.toString() + "-" + v_init;
                 				if(v_flag != "Yes")
                 				{
                 					v_newId = v_newId + "-M";
                 				}
                 				v_doId = true;
                 			}
                 		}
                 		if(v_curRef == "" && v_flag == "Yes" && v_rid != "")
                 		{
                 			v_newRef = "PVS-" + v_rid;
                 			v_doRef = true;
                 		}
                 		if(v_bad)
                 		{
                 			v_skip = v_skip + 1;
                 		}
                 		else if(v_doId || v_doRef || v_doFlag)
                 		{
                 			update p
                 			[
                 				PVS_ID=v_newId
                 				PVS_Referral_ID=v_newRef
                 				Has_Referral_ID=v_flag
                 			];
                 			if(v_doId)
                 			{
                 				v_minted = v_minted + 1;
                 			}
                 			if(v_doRef)
                 			{
                 				v_refset = v_refset + 1;
                 			}
                 			if(v_doFlag)
                 			{
                 				v_flagset = v_flagset + 1;
                 			}
                 		}
                 	}
                 	return "PVS IDs minted: " + v_minted + ". PVS Referral IDs set: " + v_refset + ". Has_Referral_ID repaired: " + v_flagset + ". Skipped (no PVS sequence record): " + v_skip + ".";
                 }
				 string backfill_pvs_patient_full_address()
                 {
                 	v_filled = 0;
                 	v_empty = 0;
                 	v_kept = 0;
                 	for each  p in Encounter_PatientVisit[ID != 0]
                 	{
                 		v_cur = p.Patient_Full_Address;
                 		if(v_cur == null)
                 		{
                 			v_cur = "";
                 		}
                 		if(v_cur.trim() != "")
                 		{
                 			v_kept = v_kept + 1;
                 		}
                 		else
                 		{
                 			v_addr = "";
                 			if(p.Patient_Address.address_line_1 != null && p.Patient_Address.address_line_1.trim() != "")
                 			{
                 				v_addr = p.Patient_Address.address_line_1.trim();
                 			}
                 			if(p.Patient_Address.address_line_2 != null && p.Patient_Address.address_line_2.trim() != "")
                 			{
                 				v_addr = v_addr + ", " + p.Patient_Address.address_line_2.trim();
                 			}
                 			if(p.Patient_Address.district_city != null && p.Patient_Address.district_city.trim() != "")
                 			{
                 				v_addr = v_addr + ", " + p.Patient_Address.district_city.trim();
                 			}
                 			if(p.Patient_Address.state_province != null && p.Patient_Address.state_province.trim() != "")
                 			{
                 				v_addr = v_addr + ", " + p.Patient_Address.state_province.trim();
                 			}
                 			if(p.Patient_Address.postal_Code != null && p.Patient_Address.postal_Code.trim() != "")
                 			{
                 				v_addr = v_addr + " " + p.Patient_Address.postal_Code.trim();
                 			}
                 			v_addr = v_addr.trim();
                 			if(v_addr == "")
                 			{
                 				v_empty = v_empty + 1;
                 			}
                 			else
                 			{
                 				update p
                 				[
                 					Patient_Full_Address=v_addr
                 				];
                 				v_filled = v_filled + 1;
                 			}
                 		}
                 	}
                 	return "Full addresses built: " + v_filled + ". Already had one: " + v_kept + ". No address on record: " + v_empty + ".";
                 }
				 string backfill_pvs_premium_fees(string p_confirm)
                 {
                 	if(p_confirm != "FEES")
                 	{
                 		return "Not run. Pass FEES to confirm.";
                 	}
                 	v_filled = 0;
                 	v_kept = 0;
                 	v_norate = 0;
                 	v_skipped = 0;
                 	v_invoiced = List();
                 	v_miss = List();
                 	for each  p in Encounter_PatientVisit[Additional_Charges != null]
                 	{
                 		v_add = p.Additional_Charges;
                 		if(v_add == null)
                 		{
                 			v_add = "";
                 		}
                 		v_add = v_add.toString();
                 		if(p.Billing_Branch == null || v_add.trim() == "")
                 		{
                 			v_skipped = v_skipped + 1;
                 			continue;
                 		}
                 		v_label = "";
                 		for each  l in Partner_Locations[ID == p.Billing_Branch]
                 		{
                 			v_label = l.Partner_Location_Label;
                 			break;
                 		}
                 		v_ah = 0.0;
                 		if(p.After_Hours_Fee != null)
                 		{
                 			v_ah = p.After_Hours_Fee.toDecimal();
                 		}
                 		v_ss = 0.0;
                 		if(p.Super_Stat_Fee != null)
                 		{
                 			v_ss = p.Super_Stat_Fee.toDecimal();
                 		}
                 		v_newAh = v_ah;
                 		v_newSs = v_ss;
                 		v_touch = false;
                 		if(v_add.contains("After Hours"))
                 		{
                 			if(v_ah <= 0)
                 			{
                 				v_r1 = null;
                 				for each  r in Partner_Rates[Partner_Location_Link == p.Billing_Branch && Rate_Type == "After Hours" && Current_Rate == "Yes"]
                 				{
                 					v_r1 = r.Rate_Amount;
                 					break;
                 				}
                 				if(v_r1 == null)
                 				{
                 					v_norate = v_norate + 1;
                 					if(!v_miss.contains(v_label + " / After Hours"))
                 					{
                 						v_miss.add(v_label + " / After Hours");
                 					}
                 				}
                 				else
                 				{
                 					v_newAh = v_r1;
                 					v_touch = true;
                 				}
                 			}
                 			else
                 			{
                 				v_kept = v_kept + 1;
                 			}
                 		}
                 		if(v_add.contains("Super STAT"))
                 		{
                 			if(v_ss <= 0)
                 			{
                 				v_r2 = null;
                 				for each  r in Partner_Rates[Partner_Location_Link == p.Billing_Branch && Rate_Type == "Super STAT" && Current_Rate == "Yes"]
                 				{
                 					v_r2 = r.Rate_Amount;
                 					break;
                 				}
                 				if(v_r2 == null)
                 				{
                 					v_norate = v_norate + 1;
                 					if(!v_miss.contains(v_label + " / Super STAT"))
                 					{
                 						v_miss.add(v_label + " / Super STAT");
                 					}
                 				}
                 				else
                 				{
                 					v_newSs = v_r2;
                 					v_touch = true;
                 				}
                 			}
                 			else
                 			{
                 				v_kept = v_kept + 1;
                 			}
                 		}
                 		if(v_touch == true)
                 		{
                 			update p
                 			[
                 				After_Hours_Fee=v_newAh
                 				Super_Stat_Fee=v_newSs
                 			];
                 			v_filled = v_filled + 1;
                 			if(p.Invoice_Link != null)
                 			{
                 				v_invoiced.add(p.PVS_ID + " (" + v_label + ")");
                 			}
                 		}
                 	}
                 	v_out = "Visits updated: " + v_filled + ". Fees already set: " + v_kept + ". No current premium rate: " + v_norate + ". Not eligible: " + v_skipped + ".";
                 	if(v_miss.size() > 0)
                 	{
                 		v_out = v_out + " Missing rates: " + v_miss.toString(", ");
                 	}
                 	if(v_invoiced.size() > 0)
                 	{
                 		v_out = v_out + " ALREADY INVOICED - void and re-run these invoices: " + v_invoiced.toString(", ");
                 	}
                 	return v_out;
                 }
				 string backfill_referral_added_time()
                 {
                 	v_Updated = 0;
                 	v_Skipped = 0;
                 	for each  rec in Referrals_Main[Referral_Added_Time == null]
                 	{
                 		v_Added = rec.Added_Time;
                 		if(v_Added != null)
                 		{
                 			rec.Referral_Added_Time=v_Added;
                 			v_Updated = v_Updated + 1;
                 		}
                 		else
                 		{
                 			v_Skipped = v_Skipped + 1;
                 		}
                 	}
                 	return "Updated: " + v_Updated + " | Skipped (no Added_Time): " + v_Skipped;
                 }
				 string backfill_referral_branch()
                 {
                 	v_updated = 0;
                 	v_skipped = 0;
                 	for each  r in Referrals_Main[Partner_Branch_Link != null]
                 	{
                 		v_Loc = Partner_Locations[ID == r.Partner_Branch_Link];
                 		if(v_Loc.ID != null)
                 		{
                 			r.Partner_Link=v_Loc.Partner_Link;
                 			r.Partner_Branch=v_Loc.Partner_Location_Name;
                 			r.Partner_Location_Label=v_Loc.Partner_Location_Label;
                 			r.Partner_Organization=v_Loc.Partner_Link.Partner_Display_Name;
                 			r.Partner_ID=v_Loc.Partner_Link.Partner_ID;
                 			v_updated = v_updated + 1;
                 		}
                 		else
                 		{
                 			v_skipped = v_skipped + 1;
                 		}
                 	}
                 	return "Referral branch backfill - updated: " + v_updated + " | skipped: " + v_skipped;
                 }
				 string backfill_referral_branch_from_contact()
                 {
                 	v_updated = 0;
                 	v_nomatch = 0;
                 	v_skipped = 0;
                 	for each  r in Referrals_Main[Partner_Branch_Link == null]
                 	{
                 		v_email = r.Partner_POC_Email;
                 		if(v_email == null || v_email.trim() == "")
                 		{
                 			v_skipped = v_skipped + 1;
                 			continue;
                 		}
                 		v_c = Partner_Referral_Contacts[Partner_POC_Email == v_email];
                 		if(v_c.ID != null && v_c.Partner_Locations_Link != null)
                 		{
                 			r.Partner_Branch_Link=v_c.Partner_Locations_Link;
                 			v_updated = v_updated + 1;
                 		}
                 		else
                 		{
                 			v_nomatch = v_nomatch + 1;
                 		}
                 	}
                 	return "Referral branch from contact - updated: " + v_updated + " | no contact match: " + v_nomatch + " | no email: " + v_skipped;
                 }
				 void backfill_referral_ids()
                 {
                 	refs = Referrals_Main[ID != 0];
                 	for each  rec in refs
                 	{
                 		existing = rec.Referral_ID;
                 		if(existing == null)
                 		{
                 			existing = "";
                 		}
                 		if(existing.trim() == "")
                 		{
                 			thisapp.mint_referral_id(rec.ID);
                 		}
                 	}
                 }
				 string backfill_referral_id_from_token()
                 {
                 	v_copied = 0;
                 	v_hadId = 0;
                 	for each  r in Referrals_Main[ID != 0]
                 	{
                 		v_tok = r.Form_Token;
                 		if(v_tok == null)
                 		{
                 			v_tok = "";
                 		}
                 		v_tok = v_tok.trim();
                 		v_rid = r.Referral_ID;
                 		if(v_rid == null)
                 		{
                 			v_rid = "";
                 		}
                 		v_rid = v_rid.trim();
                 		if(v_tok != "")
                 		{
                 			if(v_rid == "")
                 			{
                 				update r
                 				[
                 					Referral_ID=v_tok
                 					Form_Token=""
                 				];
                 				v_copied = v_copied + 1;
                 			}
                 			else
                 			{
                 				v_hadId = v_hadId + 1;
                 			}
                 		}
                 	}
                 	return "Referral IDs copied from Form Token: " + v_copied + ". Skipped, already had a Referral ID: " + v_hadId + ".";
                 }
				 void backfill_referral_id_stamp()
                 {
                 	refs = Referrals_Main[ID != 0];
                 	for each  rec in refs
                 	{
                 		existing = rec.Referral_ID_Stamp;
                 		if(existing == null)
                 		{
                 			existing = "";
                 		}
                 		if(existing.trim() == "")
                 		{
                 			rec.Referral_ID_Stamp=rec.ID.toString();
                 		}
                 	}
                 }
				 string build_pvs_fax_html(int pPvsID, string pFaxID, string pToName, string pToPartner, string pToFax, string pToAttn, string pRemarks, list pImageUrls)
                 {
                 	v_logo = "data:image/png;base64,";
                 	v_pvs = Encounter_PatientVisit[ID == pPvsID];
                 	v_refDate = "";
                 	if(v_pvs.Referral_Link != null)
                 	{
                 		v_ref = Referrals_Main[ID == v_pvs.Referral_Link];
                 		if(v_ref.Referral_Date != null)
                 		{
                 			v_refDate = v_ref.Referral_Date.toString("MM/dd/yyyy");
                 		}
                 	}
                 	v_dob = "";
                 	if(v_pvs.Patient_DOB != null)
                 	{
                 		v_dob = v_pvs.Patient_DOB.toString("MM/dd/yyyy");
                 	}
                 	v_dos = "";
                 	if(v_pvs.Visit_Completion_Date != null)
                 	{
                 		v_dos = v_pvs.Visit_Completion_Date.toString("MM/dd/yyyy");
                 	}
                 	v_signed = zoho.currenttime.toString("MM/dd/yyyy h:mm a");
                 	if(v_pvs.Modified_Time != null)
                 	{
                 		v_signed = v_pvs.Modified_Time.toString("MM/dd/yyyy h:mm a");
                 	}
                 	v_source = ifnull(v_pvs.Partner_Organization,"").toString().trim();
                 	v_branch = ifnull(v_pvs.Partner_Branch,"").toString().trim();
                 	if(v_branch != "")
                 	{
                 		v_source = v_source + " - " + v_branch;
                 	}
                 	v_procs = "";
                 	if(v_pvs.Type_of_Procedures != null)
                 	{
                 		v_procs = v_pvs.Type_of_Procedures.toString(", ");
                 	}
                 	v_noteType = ifnull(v_pvs.Clinical_Note_Type,"").toString().trim();
                 	v_banner = "";
                 	if(v_noteType == "Addendum")
                 	{
                 		v_banner = "<div class='amend'>AMENDED NOTE - SUPERSEDES THE PREVIOUSLY FAXED SUMMARY</div>";
                 	}
                 	v_pvsIdTxt = ifnull(v_pvs.PVS_ID,"").toString();
                 	v_imgPages = "";
                 	if(pImageUrls != null)
                 	{
                 		v_n = 0;
                 		for each  v_url in pImageUrls
                 		{
                 			v_n = v_n + 1;
                 			v_imgPages = v_imgPages + "<div class='page'><div class='brand'><img src='" + v_logo + "'></div><div class='note-title'>Attachment " + v_n + "</div><div class='img-wrap'><img src='" + v_url + "'></div><div class='img-cap'>PVS " + v_pvsIdTxt + " &nbsp;|&nbsp; " + pFaxID + "</div></div>";
                 		}
                 	}
                 	v_css = "<style>@page { size: letter; margin: 0.6in 0.65in 0.85in 0.65in; } * { box-sizing: border-box; } body { margin:0; font-family: Helvetica, Arial, sans-serif; font-size: 10.5pt; line-height: 1.42; color:#000; } .page { page-break-after: always; } .page:last-child { page-break-after: auto; } .brand { text-align:center; padding-bottom:8pt; } .brand img { height:46pt; } .cover-title { font-size:34pt; font-weight:bold; color:#0B0B5B; letter-spacing:1pt; margin:14pt 0 2pt 0; } .cover-sub { font-size:9pt; color:#4C4C89; margin-bottom:16pt; } .rule { border-top:2px solid #0B0B5B; margin:0 0 14pt 0; } table.grid { width:100%; border-collapse:collapse; } table.grid td { vertical-align:top; padding:0; } .col { width:50%; padding-right:18pt; } .col.right { padding-right:0; padding-left:18pt; } .blk-hd { font-size:8.5pt; font-weight:bold; letter-spacing:1.4pt; color:#FFFFFF; background:#0B0B5B; padding:4pt 7pt; text-transform:uppercase; } .blk-body { border:1px solid #BFBFBF; border-top:0; padding:8pt 7pt; } .ln { margin:0 0 3pt 0; } .ln .k { color:#4C4C89; font-size:8.5pt; } .nm { font-weight:bold; } .meta { margin:0 0 14pt 0; font-size:9.5pt; } .meta span { display:inline-block; margin-right:22pt; } .meta b { color:#0B0B5B; } .remarks-hd { font-size:8.5pt; font-weight:bold; letter-spacing:1.4pt; color:#FFFFFF; background:#0B0B5B; padding:4pt 7pt; text-transform:uppercase; margin-top:16pt; } .remarks { border:1px solid #BFBFBF; border-top:0; padding:10pt 7pt; min-height:78pt; white-space:pre-wrap; } .notice { margin-top:20pt; border:1px solid #0B0B5B; padding:9pt 10pt; font-size:8pt; line-height:1.4; color:#000; } .notice b { color:#0B0B5B; letter-spacing:.6pt; } .note-title { text-align:center; font-size:14pt; font-weight:bold; color:#0B0B5B; margin:2pt 0 12pt 0; } .amend { text-align:center; font-size:10pt; font-weight:bold; color:#0B0B5B; border:1.5px solid #0B0B5B; padding:4pt; margin:0 0 12pt 0; letter-spacing:1.2pt; } table.hdr { width:100%; border-collapse:collapse; margin-bottom:14pt; } table.hdr td { border:1px solid #AEAED0; padding:4.5pt 7pt; font-size:9.5pt; width:50%; } table.hdr td.r { text-align:right; } table.hdr .k { color:#4C4C89; } .sec { margin:0 0 11pt 0; } .sec h3 { font-size:10pt; font-weight:bold; color:#0B0B5B; margin:0 0 3pt 0; page-break-after:avoid; break-after:avoid; } .sec p { margin:0 0 6pt 0; white-space:pre-wrap; orphans:3; widows:3; } .sec h3 + p { page-break-before:avoid; break-before:avoid; } .note, .note * { font-family: Helvetica, Arial, sans-serif !important; font-size:10.5pt !important; line-height:1.42 !important; color:#000 !important; background:transparent !important; } .note { orphans:3; widows:3; } .note p { margin:0 0 7pt 0 !important; } .note br + br { line-height:0.5 !important; } .note b, .note strong { font-weight:bold !important; } .note h1, .note h2, .note h3, .note h4, .note h5, .note h6 { font-size:10pt !important; font-weight:bold !important; color:#0B0B5B !important; margin:12pt 0 3pt 0 !important; page-break-after:avoid; break-after:avoid; } .note ul, .note ol { margin:0 0 7pt 0 !important; padding-left:18pt !important; } .note li { margin:0 0 2pt 0 !important; } .note table { border-collapse:collapse !important; width:100% !important; margin:0 0 8pt 0 !important; } .note td, .note th { border:1px solid #AEAED0 !important; padding:3pt 6pt !important; } .note img { max-width:100% !important; height:auto !important; } .note a { text-decoration:none !important; } .note font { font-size:10.5pt !important; } .sig { margin-top:22pt; border-top:1px solid #BFBFBF; padding-top:8pt; font-size:9.5pt; page-break-inside:avoid; break-inside:avoid; } .sig .nm { font-weight:bold; } .sig .k { color:#4C4C89; font-size:8.5pt; } .img-wrap { text-align:center; } .img-wrap img { max-width:100%; max-height:8.4in; } .img-cap { font-size:8.5pt; color:#4C4C89; margin-top:5pt; text-align:center; }</style>";
                 	v_cover = "<div class='page'> <div class='brand'><img src='" + v_logo + "'></div> <div class='cover-title'>FAX</div> <div class='cover-sub'>Confidential clinical documentation</div> <div class='rule'></div> <div class='meta'> <span><b>Date</b>&nbsp; @@SENT_DATE@@</span> <span><b>Fax ID</b>&nbsp; @@FAX_ID@@</span> </div> <table class='grid'> <tr> <td class='col'> <div class='blk-hd'>To</div> <div class='blk-body'> <div class='ln nm'>@@TO_NAME@@</div> <div class='ln'>@@TO_PARTNER@@</div> <div class='ln'><span class='k'>Fax</span> @@TO_FAX@@</div> <div class='ln'><span class='k'>Attn</span> @@TO_ATTN@@</div> </div> </td> <td class='col right'> <div class='blk-hd'>From</div> <div class='blk-body'> <div class='ln nm'>Joshua Kolanko APRN</div> <div class='ln'>SOS Mobile Medical Care</div> <div class='ln'>8270 Woodland Center Blvd</div> <div class='ln'>Tampa, FL 33614</div> <div class='ln'><span class='k'>Phone</span> (561) 560-8302 x101</div> <div class='ln'><span class='k'>Fax</span> (813) 626-3312</div> </div> </td> </tr> </table> <div class='remarks-hd'>Remarks</div> <div class='remarks'>@@REMARKS@@</div> <div class='notice'> <b>CONFIDENTIALITY NOTICE.</b> This transmission contains protected health information intended only for the individual or entity named above. It is privileged and confidential under federal and state law, including HIPAA. If you are not the intended recipient, any review, disclosure, copying, distribution or action taken in reliance on this information is strictly prohibited. If you received this fax in error, notify SOS Mobile Medical Care immediately at (561) 560-8302 and destroy all copies, electronic and printed. Redisclosure without written patient authorization or as otherwise permitted by law is prohibited. </div> </div>";
                 	v_note = "<div class='page'> <div class='brand'><img src='" + v_logo + "'></div> <div class='note-title'>Patient Visit Summary</div> @@AMENDMENT_BANNER@@ <table class='hdr'> <tr> <td><span class='k'>Patient Name</span>&nbsp; <b>@@PATIENT_NAME@@</b></td> <td class='r'><span class='k'>Referral ID</span>&nbsp; @@REFERRAL_ID@@</td> </tr> <tr> <td><span class='k'>Date of Birth</span>&nbsp; @@PATIENT_DOB@@</td> <td class='r'><span class='k'>Referral Date</span>&nbsp; @@REFERRAL_DATE@@</td> </tr> <tr> <td><span class='k'>Gender</span>&nbsp; @@PATIENT_GENDER@@</td> <td class='r'><span class='k'>Referral Source</span>&nbsp; @@REFERRAL_SOURCE@@</td> </tr> <tr> <td><span class='k'>Provider</span>&nbsp; @@PROVIDER_NAME@@</td> <td class='r'><span class='k'>Referred By</span>&nbsp; @@REFERRED_BY@@</td> </tr> <tr> <td><span class='k'>Date of Service</span>&nbsp; @@SERVICE_DATE@@</td> <td class='r'><span class='k'>Clinical Team</span>&nbsp; @@CLINICAL_TEAM@@</td> </tr> <tr> <td><span class='k'>Acuity Level</span>&nbsp; @@ACUITY_LEVEL@@</td> <td class='r'><span class='k'>Visit Status</span>&nbsp; @@VISIT_STATUS@@</td> </tr> <tr> <td><span class='k'>PVS ID</span>&nbsp; @@PVS_ID@@</td> <td class='r'><span class='k'>Note Type</span>&nbsp; @@NOTE_TYPE@@</td> </tr> </table> <div class='sec'><h3>Procedures Performed</h3><p>@@TYPE_OF_PROCEDURES@@</p></div> <div class='sec'><h3>Diagnosis Codes</h3><p>@@ICD_CODES@@</p></div> <div class='note'>@@CLINICAL_NOTE@@</div> <div class='sig'> <div class='nm'>@@PROVIDER_NAME@@</div> <div class='k'>Electronically signed @@SIGNED_TIME@@</div> <div class='k'>SOS Mobile Medical Care &nbsp;|&nbsp; PVS @@PVS_ID@@ &nbsp;|&nbsp; Fax @@FAX_ID@@</div> </div> </div>";
                 	v_html = "<!DOCTYPE html><html><head><meta charset='utf-8'>" + v_css + "</head><body>" + v_cover + v_note + v_imgPages + "</body></html>";
                 	v_tok = Map();
                 	v_tok.put("SENT_DATE",zoho.currentdate.toString("MM/dd/yyyy"));
                 	v_tok.put("FAX_ID",pFaxID);
                 	v_tok.put("TO_NAME",pToName);
                 	v_tok.put("TO_PARTNER",pToPartner);
                 	v_tok.put("TO_FAX",pToFax);
                 	v_tok.put("TO_ATTN",pToAttn);
                 	v_tok.put("REMARKS",pRemarks);
                 	v_tok.put("PATIENT_NAME",ifnull(v_pvs.Patient_Full_Name_1,""));
                 	v_tok.put("PATIENT_DOB",v_dob);
                 	v_tok.put("PATIENT_GENDER",ifnull(v_pvs.Patient_Gender,""));
                 	v_tok.put("PROVIDER_NAME",ifnull(v_pvs.Employee_Name_Title,""));
                 	v_tok.put("SERVICE_DATE",v_dos);
                 	v_tok.put("ACUITY_LEVEL",ifnull(v_pvs.Complexity_Level,""));
                 	v_tok.put("VISIT_STATUS",ifnull(v_pvs.Visit_Status,""));
                 	v_tok.put("PVS_ID",v_pvsIdTxt);
                 	v_tok.put("NOTE_TYPE",v_noteType);
                 	v_tok.put("REFERRAL_ID",ifnull(v_pvs.Referral_ID,""));
                 	v_tok.put("REFERRAL_DATE",v_refDate);
                 	v_tok.put("REFERRAL_SOURCE",v_source);
                 	v_tok.put("REFERRED_BY",ifnull(v_pvs.Partner_POC_Name_Title,""));
                 	v_tok.put("CLINICAL_TEAM",ifnull(v_pvs.Partner_POC_Team,""));
                 	v_tok.put("TYPE_OF_PROCEDURES",v_procs);
                 	v_tok.put("ICD_CODES",ifnull(v_pvs.Provider_ICD_Print,""));
                 	v_tok.put("SIGNED_TIME",v_signed);
                 	for each  v_key in v_tok.keys()
                 	{
                 		v_val = v_tok.get(v_key).toString().trim();
                 		if(v_val == "")
                 		{
                 			v_val = "NA";
                 		}
                 		v_val = v_val.replaceAll("&","&amp;",true);
                 		v_val = v_val.replaceAll("<","&lt;",true);
                 		v_val = v_val.replaceAll(">","&gt;",true);
                 		v_val = v_val.replaceAll("&amp;nbsp;","&nbsp;",true);
                 		v_val = v_val.replaceAll("&amp;mdash;","-",true);
                 		v_html = v_html.replaceAll("@@" + v_key + "@@",v_val,true);
                 	}
                 	v_noteHtml = ifnull(v_pvs.Final_Clinical_Note,"").toString().trim();
                 	if(v_noteHtml == "")
                 	{
                 		v_noteHtml = "<p>NA</p>";
                 	}
                 	v_html = v_html.replaceAll("@@CLINICAL_NOTE@@",v_noteHtml,true);
                 	v_html = v_html.replaceAll("@@AMENDMENT_BANNER@@",v_banner,true);
                 	return v_html;
                 }
