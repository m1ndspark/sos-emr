			Provider_ICD_Print_Builde as "Provider ICD Print Builder"
			{
				type =  form
				form = Encounter_PatientVisit

				record event = on add or edit

				on user input of Provider_ICD10_Codes_Link
				{
					actions 
					{
						custom deluge script
						(
											v_Codes = "";
										for each  v_Id in input.Provider_ICD10_Codes_Link
										{
											v_Rec = ICD10_Codes[ID == v_Id];
											for each  v_R in v_Rec
											{
												if(v_Codes == "")
												{
													v_Codes = v_R.ICD_Code;
												}
												else
												{
													v_Codes = v_Codes + ", " + v_R.ICD_Code;
												}
											}
										}
										input.Provider_ICD_Print = v_Codes;
						)
					}
				}

			}
			Imaging_Order_Provider_St as "Imaging Order Provider Stamp"
			{
				type =  form
				form = Imaging_Orders

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											v_Email = zoho.loginuserid;
										for each  v_Emp in Employees[Employee_Email == v_Email]
										{
											input.Provider_Signature_Link = v_Emp.ID;
											input.Provider_NPI = v_Emp.Provider_NPI;
											input.Employee_Phone = v_Emp.Employee_Phone;
										}
										disable Provider_Signature_Link;
										disable Provider_NPI;
										disable Employee_Phone;
						)
					}
				}

			}
			Imaging_Order_Provider_Ga as "Imaging Order Provider Gate"
			{
				type =  form
				form = Imaging_Orders

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											v_Email = zoho.loginuserid;
										v_Found = false;
										for each  v_Emp in Employees[Employee_Email == v_Email && Employee_Status == "Active"]
										{
											v_Found = true;
										}
										if(v_Found == false)
										{
											alert "Your provider profile was not found or is inactive. Please contact an admin for assistance.";
											cancel submit;
										}
						)
					}
				}

			}
