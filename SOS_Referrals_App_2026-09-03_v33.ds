				 string normalize_pvs_phones(string p_confirm)
                 {
                 	if(p_confirm != "PHONES")
                 	{
                 		return "Not run. Pass PHONES to confirm.";
                 	}
                 	v_changed = 0;
                 	v_same = 0;
                 	v_odd = List();
                 	for each  p in Encounter_PatientVisit[ID != 0]
                 	{
                 		v_a = ifnull(p.Patient_Phone,"");
                 		v_b = ifnull(p.Facility_Phone,"");
                 		v_c = ifnull(p.Partner_POC_Phone,"");
                 		v_da = v_a.replaceAll("[^0-9]","");
                 		v_db = v_b.replaceAll("[^0-9]","");
                 		v_dc = v_c.replaceAll("[^0-9]","");
                 		v_na = v_a;
                 		v_nb = v_b;
                 		v_nc = v_c;
                 		if(v_da.length() == 10)
                 		{
                 			v_na = "+1" + v_da;
                 		}
                 		else if(v_da.length() == 11)
                 		{
                 			v_na = "+" + v_da;
                 		}
                 		else if(v_da.length() > 0)
                 		{
                 			v_odd.add(p.PVS_ID + " patient [" + v_a + "]");
                 		}
                 		if(v_db.length() == 10)
                 		{
                 			v_nb = "+1" + v_db;
                 		}
                 		else if(v_db.length() == 11)
                 		{
                 			v_nb = "+" + v_db;
                 		}
                 		else if(v_db.length() > 0)
                 		{
                 			v_odd.add(p.PVS_ID + " facility [" + v_b + "]");
                 		}
                 		if(v_dc.length() == 10)
                 		{
                 			v_nc = "+1" + v_dc;
                 		}
                 		else if(v_dc.length() == 11)
                 		{
                 			v_nc = "+" + v_dc;
                 		}
                 		else if(v_dc.length() > 0)
                 		{
                 			v_odd.add(p.PVS_ID + " poc [" + v_c + "]");
                 		}
                 		if(v_na.trim() == "")
                 		{
                 			v_na = null;
                 		}
                 		if(v_nb.trim() == "")
                 		{
                 			v_nb = null;
                 		}
                 		if(v_nc.trim() == "")
                 		{
                 			v_nc = null;
                 		}
                 		if(v_na != v_a || v_nb != v_b || v_nc != v_c)
                 		{
                 			update p
                 			[
                 				Patient_Phone=v_na
                 				Facility_Phone=v_nb
                 				Partner_POC_Phone=v_nc
                 			];
                 			v_changed = v_changed + 1;
                 		}
                 		else
                 		{
                 			v_same = v_same + 1;
                 		}
                 	}
                 	v_out = "Records updated: " + v_changed + ". Unchanged: " + v_same + ".";
                 	if(v_odd.size() > 0)
                 	{
                 		v_out = v_out + " Left alone, unexpected length: " + v_odd.toString(", ");
                 	}
                 	return v_out;
                 }
				 string poll_fax_status()
                 {
                 	v_token = thisapp.get_rc_token();
                 	if(v_token == "")
                 	{
                 		return "aborted: no RingCentral access token";
                 	}
                 	v_noRetry = {"LineBusy","NoAnswer","NoFaxMachine","WrongNumber","NotAcceptingFax","InvalidNumber","NumberBlocked","InternationalDisabled"};
                 	v_polled = 0;
                 	v_sent = 0;
                 	v_retry = 0;
                 	v_perm = 0;
                 	v_stuck = 0;
                 	for each  v_row in Fax_Log[Fax_Status == "Queued"]
                 	{
                 		if(v_row.RC_Message_ID != null && v_row.RC_Message_ID != "")
                 		{
                 			v_polled = v_polled + 1;
                 			v_resp = invokeurl
                 			[
                 				url :"https://platform.ringcentral.com/restapi/v1.0/account/~/extension/~/message-store/" + v_row.RC_Message_ID
                 				type :GET
                 				headers:{"Authorization":"Bearer " + v_token,"Accept":"application/json"}
                 			];
                 			v_row.Last_Polled_Time=zoho.currenttime;
                 			if(v_resp.get("faxPageCount") != null)
                 			{
                 				v_row.Page_Count=v_resp.get("faxPageCount").toLong();
                 			}
                 			v_status = "";
                 			if(v_resp.get("messageStatus") != null)
                 			{
                 				v_status = v_resp.get("messageStatus").toString();
                 			}
                 			v_pvs = Encounter_PatientVisit[ID == v_row.PVS_Link];
                 			if(v_status == "Sent")
                 			{
                 				v_row.Fax_Status="Sent";
                 				v_row.Completed_Time=zoho.currenttime;
                 				v_pvs.Fax_Status="Sent";
                 				v_sent = v_sent + 1;
                 			}
                 			else if(v_status == "SendingFailed")
                 			{
                 				v_code = "";
                 				if(v_resp.get("faxErrorCode") != null)
                 				{
                 					v_code = v_resp.get("faxErrorCode").toString();
                 				}
                 				v_row.Fax_Error_Code=v_code;
                 				v_row.Fax_Error_Reason=v_resp.toString().left(250);
                 				v_row.Completed_Time=zoho.currenttime;
                 				v_pvs.Fax_Status="Failed";
                 				if(v_noRetry.contains(v_code))
                 				{
                 					v_row.Fax_Status="Permanent Fail";
                 					v_perm = v_perm + 1;
                 				}
                 				else if(v_row.Attempt_Number >= 3)
                 				{
                 					v_row.Fax_Status="Permanent Fail";
                 					v_perm = v_perm + 1;
                 				}
                 				else
                 				{
                 					v_row.Fax_Status="Retry Pending";
                 					v_retry = v_retry + 1;
                 				}
                 			}
                 			else if(v_row.Submitted_Time != null)
                 			{
                 				if(v_row.Submitted_Time.addHour(4) < zoho.currenttime)
                 				{
                 					v_row.Fax_Status="Stuck";
                 					v_stuck = v_stuck + 1;
                 				}
                 			}
                 		}
                 	}
                 	return "polled " + v_polled + ", sent " + v_sent + ", retry pending " + v_retry + ", permanent fail " + v_perm + ", stuck " + v_stuck;
                 }
				 string replicate_uniform_rates()
                 {
                 	v_out = "";
                 	v_inserted = 0;
                 	for each  v_p in Partners[Rate_Structure == "Uniform (All Locations)" && Partner_Status == "Active"]
                 	{
                 		v_srcId = null;
                 		v_srcCount = 0;
                 		for each  v_l in Partner_Locations[Partner_Link == v_p.ID && Partner_Location_Status == "Active"]
                 		{
                 			v_c = 0;
                 			for each  v_r in Partner_Rates[Partner_Location_Link == v_l.ID && Current_Rate == "Yes"]
                 			{
                 				v_c = v_c + 1;
                 			}
                 			if(v_c > v_srcCount)
                 			{
                 				v_srcCount = v_c;
                 				v_srcId = v_l.ID;
                 			}
                 		}
                 		if(v_srcId == null || v_srcCount == 0)
                 		{
                 			v_out = v_out + "\n" + v_p.Partner_Display_Name + ": SKIPPED - no branch has rates to copy from.";
                 			continue;
                 		}
                 		v_src = Partner_Locations[ID == v_srcId];
                 		v_out = v_out + "\n" + v_p.Partner_Display_Name + ": source = " + v_src.Partner_Location_Label + " (" + v_srcCount + " rates)";
                 		for each  v_t in Partner_Locations[Partner_Link == v_p.ID && Partner_Location_Status == "Active"]
                 		{
                 			if(v_t.ID != v_srcId)
                 			{
                 				v_existing = 0;
                 				for each  v_x in Partner_Rates[Partner_Location_Link == v_t.ID]
                 				{
                 					v_existing = v_existing + 1;
                 				}
                 				if(v_existing > 0)
                 				{
                 					v_out = v_out + "\n   " + v_t.Partner_Location_Label + ": skipped, already has " + v_existing + " rate record(s)";
                 				}
                 				else
                 				{
                 					v_n = 0;
                 					for each  v_r in Partner_Rates[Partner_Location_Link == v_srcId && Current_Rate == "Yes"]
                 					{
                 						v_newId = insert into Partner_Rates
                 						[
                 							Partner_Link=v_p.ID
                 							Partner_Location_Link=v_t.ID
                 							Rate_Category=v_r.Rate_Category
                 							Rate_Type=v_r.Rate_Type
                 							Rate_Amount=v_r.Rate_Amount
                 							Partner_Rates_Effective_Date=v_r.Partner_Rates_Effective_Date
                 							Current_Rate="Yes"
                 							Partner_Rate_Status="Active"
                 							Added_User=zoho.loginuser
                 						];
                 						v_newRec = Partner_Rates[ID == v_newId];
                 						v_newRec.Partner_Rate_ID_Stamp=v_newId.toString();
                 						v_n = v_n + 1;
                 						v_inserted = v_inserted + 1;
                 					}
                 					v_out = v_out + "\n   " + v_t.Partner_Location_Label + ": copied " + v_n + " rates";
                 				}
                 			}
                 		}
                 	}
                 	return "Inserted " + v_inserted + " rate records." + v_out;
                 }
				 string report_partner_rate_coverage()
                 {
                 	v_need = List();
                 	v_need.add("High Complexity");
                 	v_need.add("Moderate Complexity");
                 	v_need.add("Low Complexity");
                 	v_need.add("Hospital at Home");
                 	v_need.add("Telemedicine");
                 	v_need.add("Care Coordination");
                 	v_need.add("General Consultation");
                 	v_need.add("Cares 3008 Assessment");
                 	v_totalRates = 0;
                 	v_orphans = List();
                 	for each  v_r in Partner_Rates[ID != 0]
                 	{
                 		v_totalRates = v_totalRates + 1;
                 		v_bad = false;
                 		if(v_r.Partner_Location_Link == null)
                 		{
                 			v_bad = true;
                 		}
                 		else
                 		{
                 			v_chk = Partner_Locations[ID == v_r.Partner_Location_Link];
                 			if(v_chk.ID == null)
                 			{
                 				v_bad = true;
                 			}
                 		}
                 		if(v_bad)
                 		{
                 			v_orphans.add("RATE ID " + v_r.ID + " | " + v_r.Rate_Category + " | " + v_r.Rate_Type + " | " + v_r.Rate_Amount + " | cur=" + v_r.Current_Rate + " | link=" + v_r.Partner_Location_Link);
                 		}
                 	}
                 	v_keys = List();
                 	for each  v_l in Partner_Locations[ID != 0]
                 	{
                 		v_lbl = v_l.Partner_Location_Label;
                 		if(v_lbl == null || v_lbl.trim() == "")
                 		{
                 			v_lbl = "(no label) ID " + v_l.ID;
                 		}
                 		v_keys.add(v_lbl + "::" + v_l.ID);
                 	}
                 	v_keys = v_keys.sort(true);
                 	v_out = "";
                 	v_locCount = 0;
                 	v_zeroRate = List();
                 	for each  v_k in v_keys
                 	{
                 		v_idx = v_k.indexOf("::");
                 		v_id = v_k.subString(v_idx + 2).toLong();
                 		v_l = Partner_Locations[ID == v_id];
                 		v_locCount = v_locCount + 1;
                 		v_pName = "NO PARTNER LINK";
                 		v_pCode = "-";
                 		v_pStatus = "-";
                 		v_pRateStruct = "-";
                 		if(v_l.Partner_Link != null)
                 		{
                 			v_p = Partners[ID == v_l.Partner_Link];
                 			if(v_p.ID != null)
                 			{
                 				v_pName = v_p.Partner_Display_Name;
                 				v_pCode = v_p.Partner_Code;
                 				v_pStatus = v_p.Partner_Status;
                 				v_pRateStruct = v_p.Rate_Structure;
                 			}
                 			else
                 			{
                 				v_pName = "BROKEN PARTNER LINK " + v_l.Partner_Link;
                 			}
                 		}
                 		v_books = "MISSING";
                 		if(v_l.Books_Customer_ID != null && v_l.Books_Customer_ID.trim() != "")
                 		{
                 			v_books = v_l.Books_Customer_ID;
                 		}
                 		v_out = v_out + "\n------------------------------------------------------------";
                 		v_out = v_out + "\nLOCATION : " + v_l.Partner_Location_Label + "   [" + v_l.Partner_Location_Status + "]";
                 		v_out = v_out + "\n  partner: " + v_pName + " (code " + v_pCode + ", status " + v_pStatus + ", rate structure " + v_pRateStruct + ")";
                 		v_out = v_out + "\n  loc name/code: " + v_l.Partner_Location_Name + " / " + v_l.Partner_Location_Code + "   locID: " + v_l.Partner_Location_ID;
                 		v_out = v_out + "\n  books customer: " + v_books;
                 		v_have = List();
                 		v_rateLines = List();
                 		for each  v_r in Partner_Rates[Partner_Location_Link == v_id]
                 		{
                 			v_amt = 0.0;
                 			if(v_r.Rate_Amount != null)
                 			{
                 				v_amt = v_r.Rate_Amount.toDecimal();
                 			}
                 			v_cur = v_r.Current_Rate;
                 			if(v_cur == null)
                 			{
                 				v_cur = "-";
                 			}
                 			v_st = v_r.Partner_Rate_Status;
                 			if(v_st == null)
                 			{
                 				v_st = "-";
                 			}
                 			v_eff = "-";
                 			if(v_r.Partner_Rates_Effective_Date != null)
                 			{
                 				v_eff = v_r.Partner_Rates_Effective_Date.toString("MM-dd-yyyy");
                 			}
                 			v_flag = "";
                 			if(v_amt <= 1)
                 			{
                 				v_flag = "   <<< SUSPECT AMOUNT";
                 			}
                 			if(v_cur != "Yes")
                 			{
                 				v_flag = v_flag + "   <<< NOT CURRENT";
                 			}
                 			v_rateLines.add("  rate   : " + v_r.Rate_Category + " | " + v_r.Rate_Type + " | " + v_amt + " | cur=" + v_cur + " | status=" + v_st + " | eff=" + v_eff + v_flag);
                 			if(v_cur == "Yes")
                 			{
                 				v_have.add(v_r.Rate_Type);
                 			}
                 		}
                 		if(v_rateLines.size() == 0)
                 		{
                 			v_out = v_out + "\n  rate   : NONE";
                 			v_zeroRate.add(v_l.Partner_Location_Label);
                 		}
                 		else
                 		{
                 			v_rateLines = v_rateLines.sort(true);
                 			for each  v_rl in v_rateLines
                 			{
                 				v_out = v_out + "\n" + v_rl;
                 			}
                 		}
                 		v_missing = List();
                 		for each  v_n in v_need
                 		{
                 			if(!v_have.contains(v_n))
                 			{
                 				v_missing.add(v_n);
                 			}
                 		}
                 		if(v_missing.size() > 0)
                 		{
                 			v_out = v_out + "\n  MISSING: " + v_missing.toString(", ");
                 		}
                 		else
                 		{
                 			v_out = v_out + "\n  MISSING: none";
                 		}
                 	}
                 	v_head = "PARTNER RATE COVERAGE";
                 	v_head = v_head + "\nLocations: " + v_locCount + " | Partner_Rates records: " + v_totalRates + " | locations with no rates: " + v_zeroRate.size() + " | orphaned rate records: " + v_orphans.size();
                 	if(v_zeroRate.size() > 0)
                 	{
                 		v_head = v_head + "\nNO RATES AT ALL: " + v_zeroRate.toString(", ");
                 	}
                 	if(v_orphans.size() > 0)
                 	{
                 		v_head = v_head + "\n\nORPHANED RATE RECORDS (no valid location link)";
                 		for each  v_o in v_orphans
                 		{
                 			v_head = v_head + "\n  " + v_o;
                 		}
                 	}
                 	return v_head + "\n" + v_out;
                 }
				 string reprice_draft_pvs(string p_branchLabel, string p_confirm)
                 {
                 	if(p_confirm != "REPRICE")
                 	{
                 		return "Not run. Pass REPRICE as the second argument to confirm.";
                 	}
                 	v_scope = p_branchLabel;
                 	if(v_scope == null)
                 	{
                 		v_scope = "";
                 	}
                 	v_scope = v_scope.trim();
                 	v_changed = 0;
                 	v_same = 0;
                 	v_norate = 0;
                 	v_skipped = 0;
                 	v_locked = 0;
                 	v_log = List();
                 	for each  p in Encounter_PatientVisit[Invoice_Status == "Draft"]
                 	{
                 		if(p.Invoice_Link != null)
                 		{
                 			v_locked = v_locked + 1;
                 			continue;
                 		}
                 		v_lvl = p.Complexity_Level;
                 		if(v_lvl == null)
                 		{
                 			v_lvl = "";
                 		}
                 		v_lvl = v_lvl.trim();
                 		if(p.Billing_Branch == null || v_lvl == "" || v_lvl == "No Charge")
                 		{
                 			v_skipped = v_skipped + 1;
                 			continue;
                 		}
                 		v_label = "";
                 		for each  l in Partner_Locations[ID == p.Billing_Branch]
                 		{
                 			v_label = l.Partner_Location_Label;
                 			break;
                 		}
                 		if(v_scope != "")
                 		{
                 			if(v_label != v_scope)
                 			{
                 				v_skipped = v_skipped + 1;
                 				continue;
                 			}
                 		}
                 		v_rate = null;
                 		for each  r in Partner_Rates[Partner_Location_Link == p.Billing_Branch && Rate_Type == v_lvl && Current_Rate == "Yes"]
                 		{
                 			v_rate = r.Rate_Amount;
                 			break;
                 		}
                 		if(v_rate == null)
                 		{
                 			v_norate = v_norate + 1;
                 			continue;
                 		}
                 		v_old = 0.0;
                 		if(p.Complexity_Charge != null)
                 		{
                 			v_old = p.Complexity_Charge.toDecimal();
                 		}
                 		if(v_old == v_rate.toDecimal())
                 		{
                 			v_same = v_same + 1;
                 		}
                 		else
                 		{
                 			update p
                 			[
                 				Complexity_Charge=v_rate
                 			];
                 			v_changed = v_changed + 1;
                 			v_log.add(p.PVS_ID + " " + v_label + " " + v_lvl + ": " + v_old + " -> " + v_rate);
                 		}
                 	}
                 	v_out = "Repriced: " + v_changed + ". Already correct: " + v_same + ". No current rate: " + v_norate + ". Not eligible: " + v_skipped + ". Locked to an invoice: " + v_locked + ".";
                 	if(v_log.size() > 0)
                 	{
                 		v_out = v_out + " Changes: " + v_log.toString(" | ");
                 	}
                 	return v_out;
                 }
				 string reset_invoice(string p_invoiceNumber, string p_confirm)
                 {
                 	if(p_confirm != "RESET")
                 	{
                 		return "ERROR: Nothing was changed. Pass RESET as the second argument to confirm.";
                 	}
                 	v_num = p_invoiceNumber;
                 	if(v_num == null)
                 	{
                 		v_num = "";
                 	}
                 	v_num = v_num.trim();
                 	if(v_num == "")
                 	{
                 		return "ERROR: No invoice number supplied.";
                 	}
                 	v_id = null;
                 	v_hits = 0;
                 	for each  v_r in Invoices[Books_Invoice_Number == v_num]
                 	{
                 		if(v_id == null)
                 		{
                 			v_id = v_r.ID;
                 		}
                 		v_hits = v_hits + 1;
                 	}
                 	if(v_id == null)
                 	{
                 		return "ERROR: No invoice record found with Books Invoice Number " + v_num + ".";
                 	}
                 	if(v_hits > 1)
                 	{
                 		return "ERROR: " + v_hits + " invoice records share Books Invoice Number " + v_num + ". Resolve the duplicate before resetting.";
                 	}
                 	v_inv = Invoices[ID == v_id];
                 	v_count = 0;
                 	v_list = List();
                 	for each  v_p in Encounter_PatientVisit[Invoice_Link == v_id]
                 	{
                 		v_list.add(v_p.PVS_ID);
                 		v_count = v_count + 1;
                 		update v_p
                 		[
                 			Invoice_Link=null
                 			Invoice_Status="Draft"
                 		];
                 	}
                 	v_booksMsg = "No Books invoice was created.";
                 	if(v_inv.Books_Invoice_ID != null && v_inv.Books_Invoice_ID.trim() != "")
                 	{
                 		v_headers = Map();
                 		v_headers.put("Content-Type","application/json");
                 		v_voidResp = invokeurl
                 		[
                 			url :"https://www.zohoapis.com/books/v3/invoices/" + v_inv.Books_Invoice_ID + "/status/void?organization_id=911048634"
                 			type :POST
                 			headers:v_headers
                 			connection:"zoho_books_partners"
                 		];
                 		if(v_voidResp.get("code") == 0)
                 		{
                 			v_booksMsg = "Books invoice " + v_num + " voided.";
                 		}
                 		else
                 		{
                 			v_booksMsg = "BOOKS VOID FAILED for " + v_num + ": " + v_voidResp.toString().left(500);
                 		}
                 	}
                 	update v_inv
                 	[
                 		Invoice_Record_Status="Void"
                 		Books_Sync_Message="RESET " + zoho.currenttime.toString() + " - " + v_booksMsg + " || " + ifnull(v_inv.Books_Sync_Message,"")
                 		Books_Sync_Timestamp=zoho.currenttime
                 	];
                 	v_msg = "Reset complete. Invoice " + v_num + " set to Void. Visits returned to Draft: " + v_count;
                 	if(v_count > 0)
                 	{
                 		v_msg = v_msg + " (" + v_list.toString(", ") + ")";
                 	}
                 	v_msg = v_msg + ". " + v_booksMsg;
                 	return v_msg;
                 }
				 string resolve_referral_branch_from_text()
                 {
                 	v_ok = 0;
                 	v_bad = 0;
                 	v_miss = List();
                 	for each  r in Referrals_Main[Partner_Branch_Link == null]
                 	{
                 		v_txt = r.Partner_Branch;
                 		if(v_txt == null)
                 		{
                 			v_txt = "";
                 		}
                 		v_txt = v_txt.trim();
                 		if(v_txt != "")
                 		{
                 			v_hit = null;
                 			for each  l in Partner_Locations[Partner_Location_Label == v_txt]
                 			{
                 				v_hit = l.ID;
                 				break;
                 			}
                 			if(v_hit == null)
                 			{
                 				v_bad = v_bad + 1;
                 				if(!v_miss.contains(v_txt))
                 				{
                 					v_miss.add(v_txt);
                 				}
                 			}
                 			else
                 			{
                 				update r
                 				[
                 					Partner_Branch_Link=v_hit
                 				];
                 				v_ok = v_ok + 1;
                 			}
                 		}
                 	}
                 	v_out = "Branch lookups resolved: " + v_ok + ". Unmatched rows: " + v_bad + ".";
                 	if(v_miss.size() > 0)
                 	{
                 		v_out = v_out + " Unmatched values: " + v_miss.toString(", ");
                 	}
                 	return v_out;
                 }
				 string resync_location_labels()
                 {
                 	v_ref = 0;
                 	v_refSkip = 0;
                 	v_pvs = 0;
                 	v_pvsSkip = 0;
                 	for each  r in Referrals_Main[ID != 0]
                 	{
                 		if(r.Partner_Branch_Link == null)
                 		{
                 			v_refSkip = v_refSkip + 1;
                 		}
                 		else
                 		{
                 			v_l = Partner_Locations[ID == r.Partner_Branch_Link];
                 			if(v_l.ID == null)
                 			{
                 				v_refSkip = v_refSkip + 1;
                 			}
                 			else
                 			{
                 				update r
                 				[
                 					Partner_Location_Label=v_l.Partner_Location_Label
                 				];
                 				v_ref = v_ref + 1;
                 			}
                 		}
                 	}
                 	for each  p in Encounter_PatientVisit[ID != 0]
                 	{
                 		if(p.Billing_Branch == null)
                 		{
                 			v_pvsSkip = v_pvsSkip + 1;
                 		}
                 		else
                 		{
                 			v_l2 = Partner_Locations[ID == p.Billing_Branch];
                 			if(v_l2.ID == null)
                 			{
                 				v_pvsSkip = v_pvsSkip + 1;
                 			}
                 			else
                 			{
                 				update p
                 				[
                 					Partner_Location_Label=v_l2.Partner_Location_Label
                 				];
                 				v_pvs = v_pvs + 1;
                 			}
                 		}
                 	}
                 	return "Referrals updated: " + v_ref + " (skipped " + v_refSkip + "). PVS updated: " + v_pvs + " (skipped " + v_pvsSkip + ").";
                 }
				 string resync_location_names()
                 {
                 	v_ref = 0;
                 	v_refSkip = 0;
                 	v_pvs = 0;
                 	v_pvsSkip = 0;
                 	for each  r in Referrals_Main[ID != 0]
                 	{
                 		if(r.Partner_Branch_Link == null)
                 		{
                 			v_refSkip = v_refSkip + 1;
                 		}
                 		else
                 		{
                 			v_l = Partner_Locations[ID == r.Partner_Branch_Link];
                 			if(v_l.ID == null)
                 			{
                 				v_refSkip = v_refSkip + 1;
                 			}
                 			else
                 			{
                 				update r
                 				[
                 					Partner_Branch=v_l.Partner_Location_Name
                 				];
                 				v_ref = v_ref + 1;
                 			}
                 		}
                 	}
                 	for each  p in Encounter_PatientVisit[ID != 0]
                 	{
                 		if(p.Billing_Branch == null)
                 		{
                 			v_pvsSkip = v_pvsSkip + 1;
                 		}
                 		else
                 		{
                 			v_l2 = Partner_Locations[ID == p.Billing_Branch];
                 			if(v_l2.ID == null)
                 			{
                 				v_pvsSkip = v_pvsSkip + 1;
                 			}
                 			else
                 			{
                 				update p
                 				[
                 					Partner_Branch=v_l2.Partner_Location_Name
                 				];
                 				v_pvs = v_pvs + 1;
                 			}
                 		}
                 	}
                 	return "Referrals updated: " + v_ref + " (skipped " + v_refSkip + "). PVS updated: " + v_pvs + " (skipped " + v_pvsSkip + ").";
                 }
				 string run_invoice_batch(int p_batchId, decimal p_maxTotal)
                 {
                 	v_b = Invoice_Batch[ID == p_batchId];
                 	if(v_b.ID == null)
                 	{
                 		return "ERROR: Batch record not found.";
                 	}
                 	if(v_b.Partner_Location_Link == null)
                 	{
                 		v_b.Batch_Status="Failed";
                 		v_b.Result_Message="ERROR: No billing branch selected.";
                 		return v_b.Result_Message;
                 	}
                 	if(v_b.Date_From == null || v_b.Date_To == null)
                 	{
                 		v_b.Batch_Status="Failed";
                 		v_b.Result_Message="ERROR: Date From and Date To are both required.";
                 		return v_b.Result_Message;
                 	}
                 	if(v_b.Date_From > v_b.Date_To)
                 	{
                 		v_b.Batch_Status="Failed";
                 		v_b.Result_Message="ERROR: Date From is after Date To.";
                 		return v_b.Result_Message;
                 	}
                 	v_cap = 0.0;
                 	if(p_maxTotal != null)
                 	{
                 		v_cap = p_maxTotal.toDecimal();
                 	}
                 	v_ids = List();
                 	v_bad = List();
                 	v_keys = List();
                 	v_keyOwner = Map();
                 	v_dups = List();
                 	v_running = 0.0;
                 	v_left = 0;
                 	v_capped = false;
                 	v_recs = Encounter_PatientVisit[Billing_Branch == v_b.Partner_Location_Link && Invoice_Status == "Draft" && Visit_Completion_Date >= v_b.Date_From && Visit_Completion_Date <= v_b.Date_To] sort by Visit_Completion_Date;
                 	for each  v_r in v_recs
                 	{
                 		if(v_r.Invoice_Link == null && v_r.Hold_From_Invoicing != "Yes")
                 		{
                 			v_lvl = v_r.Complexity_Level;
                 			if(v_lvl == null)
                 			{
                 				v_lvl = "";
                 			}
                 			v_lvl = v_lvl.trim();
                 			if(v_lvl != "Visit Cancelled")
                 			{
                 				v_amt = 0.0;
                 				if(v_r.Complexity_Charge != null)
                 				{
                 					v_amt = v_r.Complexity_Charge.toDecimal();
                 				}
                 				if(v_lvl == "")
                 				{
                 					v_bad.add(v_r.PVS_ID + " (no complexity level)");
                 				}
                 				else if(v_amt <= 0 && v_lvl != "No Charge")
                 				{
                 					v_bad.add(v_r.PVS_ID + " (" + v_lvl + " has no rate)");
                 				}
                 				else
                 				{
                 					v_ref = ifnull(v_r.Referral_ID,"").toString().trim();
                 					v_refDisp = "referral " + v_ref;
                 					if(v_ref == "")
                 					{
                 						v_ref = ifnull(v_r.PVS_Referral_ID,"").toString().trim();
                 						v_refDisp = "walk-in " + v_ref;
                 					}
                 					if(v_ref == "")
                 					{
                 						v_ref = ifnull(v_r.Patient_Full_Name_1,"").toString().trim().toLowerCase();
                 						if(v_r.Patient_DOB != null)
                 						{
                 							v_ref = v_ref + "~" + v_r.Patient_DOB.toString("yyyy-MM-dd");
                 						}
                 						v_refDisp = "same patient name and DOB";
                 					}
                 					if(v_ref != "")
                 					{
                 						v_dos = v_r.Visit_Completion_Date.toString("yyyy-MM-dd");
                 						v_key = v_ref + "|" + v_dos + "|" + v_lvl;
                 						if(v_keys.contains(v_key))
                 						{
                 							v_dups.add(v_keyOwner.get(v_key) + " / " + v_r.PVS_ID + " (" + v_refDisp + ", DOS " + v_dos + ", " + v_lvl + ")");
                 						}
                 						else
                 						{
                 							v_keys.add(v_key);
                 							v_keyOwner.put(v_key,v_r.PVS_ID);
                 						}
                 					}
                 					v_visitTotal = v_amt;
                 					if(v_r.After_Hours_Fee != null)
                 					{
                 						v_visitTotal = v_visitTotal + v_r.After_Hours_Fee.toDecimal();
                 					}
                 					if(v_r.Super_Stat_Fee != null)
                 					{
                 						v_visitTotal = v_visitTotal + v_r.Super_Stat_Fee.toDecimal();
                 					}
                 					if(v_r.Equipment_Charge_Amount != null)
                 					{
                 						v_visitTotal = v_visitTotal + v_r.Equipment_Charge_Amount.toDecimal();
                 					}
                 					if(v_r.Other_Charges_Amount != null)
                 					{
                 						v_visitTotal = v_visitTotal + v_r.Other_Charges_Amount.toDecimal();
                 					}
                 					if(v_capped == true)
                 					{
                 						v_left = v_left + 1;
                 					}
                 					else if(v_cap > 0 && v_ids.size() > 0 && v_running + v_visitTotal > v_cap)
                 					{
                 						v_capped = true;
                 						v_left = v_left + 1;
                 					}
                 					else
                 					{
                 						v_ids.add(v_r.ID);
                 						v_running = v_running + v_visitTotal;
                 					}
                 				}
                 			}
                 		}
                 	}
                 	if(v_dups.size() > 0)
                 	{
                 		v_b.Batch_Status="Failed";
                 		v_b.Result_Message="STOPPED - nothing was invoiced. " + v_dups.size() + " possible duplicate visit pair(s) found. Each pair below shares the same referral, date of service and complexity level, which usually means the same visit was entered or imported twice. TO RESOLVE: open both records in each pair, decide which one is correct, and set Hold From Invoicing = Yes on the other; if neither should be billed, set its Complexity Level to Visit Cancelled. Then run this batch again. PAIRS: " + v_dups.toString("; ");
                 		return v_b.Result_Message;
                 	}
                 	if(v_bad.size() > 0)
                 	{
                 		v_b.Batch_Status="Failed";
                 		v_b.Result_Message="STOPPED - nothing was invoiced. " + v_bad.size() + " visit(s) have no complexity level or no rate. TO RESOLVE: set the Complexity Level on each visit below, run backfill_pvs_complexity_charge to pull the rate from the partner's card, then run this batch again. VISITS: " + v_bad.toString(", ");
                 		return v_b.Result_Message;
                 	}
                 	if(v_ids.size() == 0)
                 	{
                 		v_b.Batch_Status="Failed";
                 		v_b.Result_Message="No eligible visits found for that branch and date range. Check the branch, the date range, and whether the visits are still in Draft and not held from invoicing.";
                 		return v_b.Result_Message;
                 	}
                 	v_out = thisapp.create_invoice_from_selection(v_ids);
                 	if(v_out.startsWith("ERROR"))
                 	{
                 		v_b.Batch_Status="Failed";
                 		v_b.Result_Message=v_out;
                 	}
                 	else
                 	{
                 		v_b.Batch_Status="Complete";
                 		if(v_left > 0)
                 		{
                 			v_b.Result_Message=v_out + " | Batched " + v_ids.size() + " visit(s) totalling " + v_running + ". " + v_left + " visit(s) left for the next batch.";
                 		}
                 		else
                 		{
                 			v_b.Result_Message=v_out + " | Batched " + v_ids.size() + " visit(s) totalling " + v_running + ".";
                 		}
                 	}
                 	return v_b.Result_Message;
                 }
				 string run_pvs_exclusion_monitor()
                 {
                 	alertTo = "neil.heird@sosmmc.com";
                 	maxList = 100;
                 	validRefs = List();
                 	for each  r in Referrals_Main[Referral_ID != null]
                 	{
                 		rid = r.Referral_ID;
                 		if(rid != null && rid.trim() != "")
                 		{
                 			validRefs.add(rid.trim().toUpperCase());
                 		}
                 	}
                 	flagCount = 0;
                 	scanCount = 0;
                 	blockList = List();
                 	for each  pv in Encounter_PatientVisit[Type_of_Entry == "Patient Visit" && QC_Reviewed != "Yes"]
                 	{
                 		scanCount = scanCount + 1;
                 		reasons = List();
                 		noteRaw = pv.Final_Clinical_Note;
                 		if(noteRaw == null)
                 		{
                 			noteRaw = "";
                 		}
                 		noteTxt = noteRaw.replaceAll("<[^>]*>","");
                 		noteTxt = noteTxt.replaceAll("&nbsp;"," ",true);
                 		noteTxt = noteTxt.trim();
                 		if(noteTxt == "")
                 		{
                 			reasons.add("Clinical note is blank");
                 		}
                 		if(pv.Referral_Link == null)
                 		{
                 			reasons.add("Referral Link is empty");
                 		}
                 		pvRef = pv.Referral_ID;
                 		if(pvRef == null)
                 		{
                 			pvRef = "";
                 		}
                 		pvRef = pvRef.trim();
                 		if(pvRef == "")
                 		{
                 			reasons.add("Referral ID is blank");
                 		}
                 		else if(!validRefs.contains(pvRef.toUpperCase()))
                 		{
                 			reasons.add("Referral ID " + pvRef + " does not exist in Referrals_Main");
                 		}
                 		if(pv.Visit_Completion_Date == null)
                 		{
                 			reasons.add("Visit Completion Date is blank");
                 		}
                 		pOrg = pv.Partner_Organization;
                 		if(pOrg == null)
                 		{
                 			pOrg = "";
                 		}
                 		if(pOrg.trim() == "")
                 		{
                 			reasons.add("Referral Partner is blank");
                 		}
                 		if(reasons.size() > 0)
                 		{
                 			flagCount = flagCount + 1;
                 			if(blockList.size() < maxList)
                 			{
                 				pvId = pv.PVS_ID;
                 				if(pvId == null || pvId.trim() == "")
                 				{
                 					pvId = "(no PVS ID)";
                 				}
                 				ptName = pv.Patient_Full_Name_1;
                 				if(ptName == null || ptName.trim() == "")
                 				{
                 					ptName = "(no patient name)";
                 				}
                 				prov = pv.Employee_Name_Title;
                 				if(prov == null || prov.trim() == "")
                 				{
                 					prov = "(no provider)";
                 				}
                 				addedStr = "(unknown)";
                 				if(pv.Added_Time != null)
                 				{
                 					addedStr = pv.Added_Time.toString("MM-dd-yyyy");
                 				}
                 				blk = "<div style=\"margin:0 0 12px 0;padding:10px 12px;background:#fdf0f0;border-left:3px solid #b00020;\">";
                 				blk = blk + "<b>" + pvId + "</b> &middot; " + ptName + "<br>";
                 				blk = blk + "<span style=\"color:#666;font-size:12px;\">Provider: " + prov + " &middot; Record ID: " + pv.ID + " &middot; Added: " + addedStr + "</span>";
                 				blk = blk + "<ul style=\"margin:6px 0 0 18px;padding:0;\">";
                 				for each  rsn in reasons
                 				{
                 					blk = blk + "<li>" + rsn + "</li>";
                 				}
                 				blk = blk + "</ul></div>";
                 				blockList.add(blk);
                 			}
                 		}
                 	}
                 	if(flagCount == 0)
                 	{
                 		okBody = "<div style=\"font-family:-apple-system,'Segoe UI',sans-serif;font-size:14px;line-height:1.5;\">";
                 		okBody = okBody + "<p><b>SOS EMR PVS exclusion monitor ran on " + zoho.currenttime + ".</b></p>";
                 		okBody = okBody + "<p style=\"padding:8px 12px;background:#f0f7f0;border-left:3px solid #2e7d32;\"><b>NOTHING FLAGGED.</b><br>Every unreviewed Patient Visit record passed all four checks.</p>";
                 		okBody = okBody + "<p>Records scanned: " + scanCount + "</p>";
                 		okBody = okBody + "<p style=\"color:#666;font-size:12px;\">Checks: clinical note blank, Referral Link empty, Referral ID missing or unmatched in Referrals_Main, Visit Completion Date blank, Referral Partner blank.</p>";
                 		okBody = okBody + "</div>";
                 		thisapp.send_via_sendgrid(alertTo,"SOS EMR PVS exclusion monitor: nothing flagged (" + zoho.currentdate.toString("MM-dd-yyyy") + ")",okBody);
                 		return "No records flagged. Scanned: " + scanCount + ".";
                 	}
                 	mailBody = "<div style=\"font-family:-apple-system,'Segoe UI',sans-serif;font-size:14px;line-height:1.5;\">";
                 	mailBody = mailBody + "<p><b>SOS EMR PVS exclusion monitor ran on " + zoho.currenttime + ".</b></p>";
                 	mailBody = mailBody + "<p style=\"padding:8px 12px;background:#fdf0f0;border-left:3px solid #b00020;\"><b>" + flagCount + " record(s) need review.</b><br>Each one failed at least one completeness check and may not be a real visit. Open the record, decide whether it is legitimate, then set <b>QC Reviewed</b> to <b>Yes</b> to clear it from this email.</p>";
                 	mailBody = mailBody + "<p>Unreviewed Patient Visit records scanned: " + scanCount + "</p>";
                 	if(flagCount > maxList)
                 	{
                 		mailBody = mailBody + "<p style=\"padding:8px 12px;background:#fff8e1;border-left:3px solid #f9a825;\"><b>Showing the first " + maxList + " of " + flagCount + ".</b> Clear some and the rest will appear on the next run.</p>";
                 	}
                 	mailBody = mailBody + "<hr>";
                 	for each  b in blockList
                 	{
                 		mailBody = mailBody + b;
                 	}
                 	mailBody = mailBody + "<p style=\"color:#666;font-size:12px;\">Checks: clinical note blank, Referral Link empty, Referral ID missing or unmatched in Referrals_Main, Visit Completion Date blank, Referral Partner blank. A record only leaves this list when QC Reviewed is set to Yes.</p>";
                 	mailBody = mailBody + "</div>";
                 	thisapp.send_via_sendgrid(alertTo,"SOS EMR PVS exclusion monitor: " + flagCount + " to review (" + zoho.currentdate.toString("MM-dd-yyyy") + ")",mailBody);
                 	return "Records flagged: " + flagCount + ". Scanned: " + scanCount + ".";
                 }
				 string run_schema_monitor()
                 {
                 	ownerName = "sosmmc";
                 	appName = "sos-referrals-app";
                 	baseUrl = "https://www.zohoapis.com/creator/v2.1/meta/" + ownerName + "/" + appName;
                 	repoOwner = "m1ndspark";
                 	repoName = "sos-emr";
                 	branch = "main";
                 	alertTo = "neil.heird@sosmmc.com";
                 	typeMap = Map();
                 	typeMap.put("1","Single Line");
                 	typeMap.put("2","Multi Line");
                 	typeMap.put("3","Email");
                 	typeMap.put("5","Number");
                 	typeMap.put("6","Decimal");
                 	typeMap.put("8","Currency");
                 	typeMap.put("9","Auto Number");
                 	typeMap.put("10","Date");
                 	typeMap.put("11","Date-Time");
                 	typeMap.put("12","Dropdown/Lookup");
                 	typeMap.put("13","Radio");
                 	typeMap.put("14","Multi Select");
                 	typeMap.put("15","Checkbox");
                 	typeMap.put("16","Decision Box");
                 	typeMap.put("19","File Upload");
                 	typeMap.put("20","Formula");
                 	typeMap.put("21","Subform");
                 	typeMap.put("27","Phone");
                 	typeMap.put("29","Name");
                 	typeMap.put("30","Address");
                 	currentMap = Map();
                 	fileMap = Map();
                 	formsResp = invokeurl
                 	[
                 		url :baseUrl + "/forms"
                 		type :GET
                 		connection:"sos_schema_monitor"
                 	];
                 	if(formsResp.get("code") != 3000)
                 	{
                 		thisapp.send_via_sendgrid(alertTo,"SOS EMR schema monitor ERROR (forms)","Get Forms failed. Response: " + formsResp.toString());
                 		return "ERROR: Get Forms failed.";
                 	}
                 	for each  frm in formsResp.get("forms")
                 	{
                 		formLink = frm.get("link_name");
                 		if(formLink != "Schema_Snapshot")
                 		{
                 			fieldsResp = invokeurl
                 			[
                 				url :baseUrl + "/form/" + formLink + "/fields"
                 				type :GET
                 				connection:"sos_schema_monitor"
                 			];
                 			if(fieldsResp.get("code") != 3000)
                 			{
                 				thisapp.send_via_sendgrid(alertTo,"SOS EMR schema monitor ERROR (fields)","Get Fields failed for form " + formLink + ". Response: " + fieldsResp.toString());
                 				return "ERROR: Get Fields failed for form " + formLink + ".";
                 			}
                 			formDisplay = frm.get("display_name");
                 			fieldMap = Map();
                 			fieldRows = List();
                 			for each  fld in fieldsResp.get("fields")
                 			{
                 				fLink = fld.get("link_name");
                 				if(fLink != null)
                 				{
                 					attr = fld.get("type") + "~" + fld.get("mandatory") + "~" + fld.get("unique");
                 					fieldMap.put(fLink,attr);
                 					tcStr = fld.get("type").toLong().toString();
                 					tName = typeMap.get(tcStr);
                 					if(tName == null)
                 					{
                 						typeLabel = "Type " + tcStr;
                 					}
                 					else
                 					{
                 						typeLabel = tName + " (" + tcStr + ")";
                 					}
                 					dName = fld.get("display_name");
                 					if(dName == null)
                 					{
                 						dName = "";
                 					}
                 					mandStr = "no";
                 					if(fld.get("mandatory") == true)
                 					{
                 						mandStr = "YES";
                 					}
                 					uniqStr = "no";
                 					if(fld.get("unique") == true)
                 					{
                 						uniqStr = "YES";
                 					}
                 					detail = "";
                 					if(fld.get("choices") != null)
                 					{
                 						chList = List();
                 						for each  ch in fld.get("choices")
                 						{
                 							chList.add(ch.get("value"));
                 						}
                 						detail = "choices: " + chList.toString(", ");
                 					}
                 					else if(fld.get("subfields") != null)
                 					{
                 						sfList = List();
                 						for each  sf in fld.get("subfields")
                 						{
                 							sfName = sf.get("link_name");
                 							if(sf.get("is_hidden") == true)
                 							{
                 								sfName = sfName + " (hidden)";
                 							}
                 							sfList.add(sfName);
                 						}
                 						detail = "subfields: " + sfList.toString(", ");
                 					}
                 					else if(fld.get("max_char") != null)
                 					{
                 						detail = "max " + fld.get("max_char");
                 					}
                 					fieldRows.add("| " + fLink + " | " + dName + " | " + typeLabel + " | " + mandStr + " | " + uniqStr + " | " + detail + " |");
                 				}
                 			}
                 			currentMap.put(formLink,fieldMap);
                 			contentLines = List();
                 			contentLines.add("# Schema: " + formDisplay);
                 			contentLines.add("");
                 			contentLines.add("Form link name: `" + formLink + "`");
                 			contentLines.add("Auto-generated by the SOS schema monitor. Source of truth is the live Creator app.");
                 			contentLines.add("Captured: " + zoho.currenttime);
                 			contentLines.add("Field count: " + fieldRows.size());
                 			contentLines.add("");
                 			contentLines.add("| Link Name | Display Name | Type | Mandatory | Unique | Detail |");
                 			contentLines.add("|---|---|---|---|---|---|");
                 			for each  r in fieldRows
                 			{
                 				contentLines.add(r);
                 			}
                 			fileMap.put(formLink,contentLines.toString("\n"));
                 		}
                 	}
                 	formKeys = currentMap.keys();
                 	formKeys = formKeys.sort(true);
                 	lineList = List();
                 	for each  fk in formKeys
                 	{
                 		fMap = currentMap.get(fk);
                 		fldKeys = fMap.keys();
                 		fldKeys = fldKeys.sort(true);
                 		entryList = List();
                 		for each  fl in fldKeys
                 		{
                 			entryList.add(fl + "~" + fMap.get(fl));
                 		}
                 		lineList.add(fk + "::" + entryList.toString(";;"));
                 	}
                 	lineList = lineList.sort(true);
                 	currentSnapshot = lineList.toString("\n");
                 	activeForms = currentMap.keys();
                 	activeForms = activeForms.sort(true);
                 	activeFormsHtml = activeForms.toString("<br>");
                 	previousData = "";
                 	previousSummary = "";
                 	latestTime = null;
                 	for each  rec in Schema_Snapshot[ID != null]
                 	{
                 		if(latestTime == null || rec.Captured_On > latestTime)
                 		{
                 			latestTime = rec.Captured_On;
                 			previousData = rec.Snapshot_Data;
                 			previousSummary = rec.Change_Summary;
                 		}
                 	}
                 	if(previousData == null)
                 	{
                 		previousData = "";
                 	}
                 	if(previousData == "")
                 	{
                 		insert into Schema_Snapshot
                 		[
                 			Snapshot_Data=currentSnapshot
                 			Captured_On=zoho.currenttime
                 			Change_Summary="Baseline captured"
                 			Added_User=zoho.loginuser
                 		]
                 		for each  cf in currentMap.keys()
                 		{
                 			bPath = "schema/" + cf + ".md";
                 			bPayload = Map();
                 			bPayload.put("message","schema: baseline " + cf);
                 			bPayload.put("content",zoho.encryption.base64Encode(fileMap.get(cf)));
                 			bPayload.put("branch",branch);
                 			bGet = invokeurl
                 			[
                 				url :"https://api.github.com/repos/" + repoOwner + "/" + repoName + "/contents/" + bPath + "?ref=" + branch
                 				type :GET
                 				connection:"sos_github_sync"
                 			];
                 			if(bGet.get("sha") != null)
                 			{
                 				bPayload.put("sha",bGet.get("sha"));
                 			}
                 			invokeurl
                 			[
                 				url :"https://api.github.com/repos/" + repoOwner + "/" + repoName + "/contents/" + bPath
                 				type :PUT
                 				parameters:bPayload.toString()
                 				connection:"sos_github_sync"
                 			]
                 		}
                 		thisapp.send_via_sendgrid(alertTo,"SOS EMR schema monitor: baseline captured","Baseline captured on " + zoho.currenttime + ". Forms tracked: " + currentMap.size() + ". Schema files committed to schema/ in " + repoOwner + "/" + repoName + ".");
                 		return "Baseline captured. Forms tracked: " + currentMap.size() + ".";
                 	}
                 	prevMap = Map();
                 	for each  pline in previousData.toList("\n")
                 	{
                 		pIdx = pline.indexOf("::");
                 		if(pIdx > -1)
                 		{
                 			pForm = pline.subString(0,pIdx);
                 			pRest = pline.subString(pIdx + 2);
                 			pFieldMap = Map();
                 			if(pRest != "")
                 			{
                 				for each  pe in pRest.toList(";;")
                 				{
                 					eIdx = pe.indexOf("~");
                 					if(eIdx > -1)
                 					{
                 						peLink = pe.subString(0,eIdx);
                 						peAttr = pe.subString(eIdx + 1);
                 						pFieldMap.put(peLink,peAttr);
                 					}
                 				}
                 			}
                 			prevMap.put(pForm,pFieldMap);
                 		}
                 	}
                 	addedForms = List();
                 	removedForms = List();
                 	changedForms = List();
                 	formAddedLines = List();
                 	formRemovedLines = List();
                 	fieldAddedLines = List();
                 	fieldChangedLines = List();
                 	fieldRemovedLines = List();
                 	for each  fk in currentMap.keys()
                 	{
                 		if(!prevMap.keys().contains(fk))
                 		{
                 			addedForms.add(fk);
                 			formAddedLines.add("FORM ADDED: " + fk);
                 		}
                 	}
                 	for each  pk in prevMap.keys()
                 	{
                 		if(!currentMap.keys().contains(pk))
                 		{
                 			removedForms.add(pk);
                 			formRemovedLines.add("FORM REMOVED: " + pk);
                 		}
                 	}
                 	for each  fk in currentMap.keys()
                 	{
                 		if(prevMap.keys().contains(fk))
                 		{
                 			curFields = currentMap.get(fk);
                 			prevFields = prevMap.get(fk);
                 			formTouched = false;
                 			for each  cf in curFields.keys()
                 			{
                 				if(!prevFields.keys().contains(cf))
                 				{
                 					fieldAddedLines.add(fk + "." + cf + " (" + curFields.get(cf) + ")");
                 					formTouched = true;
                 				}
                 				else if(curFields.get(cf) != prevFields.get(cf))
                 				{
                 					fieldChangedLines.add(fk + "." + cf + " [" + prevFields.get(cf) + " -> " + curFields.get(cf) + "]");
                 					formTouched = true;
                 				}
                 			}
                 			for each  pf in prevFields.keys()
                 			{
                 				if(!curFields.keys().contains(pf))
                 				{
                 					fieldRemovedLines.add(fk + "." + pf);
                 					formTouched = true;
                 				}
                 			}
                 			if(formTouched)
                 			{
                 				changedForms.add(fk);
                 			}
                 		}
                 	}
                 	suspectPull = false;
                 	if(currentMap.size() == 0)
                 	{
                 		suspectPull = true;
                 	}
                 	else if(prevMap.size() >= 5 && removedForms.size() * 10 > prevMap.size() * 3)
                 	{
                 		suspectPull = true;
                 	}
                 	if(suspectPull)
                 	{
                 		warnBody = "<div style=\"font-family:-apple-system,'Segoe UI',sans-serif;font-size:14px;\">";
                 		warnBody = warnBody + "<p><b>SUSPECTED PARTIAL / BAD SCHEMA PULL - no changes were written.</b></p>";
                 		warnBody = warnBody + "<p>Run time: " + zoho.currenttime + "<br>Forms returned this run: " + currentMap.size() + "<br>Forms in last snapshot: " + prevMap.size() + "<br>Forms appearing removed: " + removedForms.size() + "</p>";
                 		warnBody = warnBody + "<p>This exceeded the safety threshold, so the monitor did NOT tombstone files, did NOT commit, and did NOT update the snapshot. Most likely a transient Meta API hiccup. If a genuine bulk form deletion happened, re-run run_schema_monitor manually to apply it.</p>";
                 		warnBody = warnBody + "<p>Forms flagged removed:<br>" + removedForms.toString("<br>") + "</p>";
                 		warnBody = warnBody + "</div>";
                 		thisapp.send_via_sendgrid(alertTo,"SOS EMR schema monitor: suspected bad pull (no changes applied)",warnBody);
                 		return "SUSPECTED BAD PULL - nothing written. Forms this run: " + currentMap.size() + ". Last snapshot: " + prevMap.size() + ". Flagged removed: " + removedForms.size() + ".";
                 	}
                 	totalChanges = formAddedLines.size() + formRemovedLines.size() + fieldAddedLines.size() + fieldChangedLines.size() + fieldRemovedLines.size();
                 	legend = "Attribute format is type~mandatory~unique. Type codes: 1 Single Line, 2 Multi Line, 3 Email, 5 Number, 6 Decimal, 8 Currency, 9 Auto Number, 10 Date, 11 Date-Time, 12 Dropdown/Lookup, 13 Radio, 14 Multi Select, 15 Checkbox, 16 Decision Box, 19 File Upload, 20 Formula, 21 Subform, 27 Phone, 29 Name, 30 Address.";
                 	if(totalChanges == 0)
                 	{
                 		lastTimeStr = "unknown";
                 		if(latestTime != null)
                 		{
                 			lastTimeStr = latestTime.toString();
                 		}
                 		lastSummary = previousSummary;
                 		if(lastSummary == null)
                 		{
                 			lastSummary = "";
                 		}
                 		if(lastSummary.trim() == "")
                 		{
                 			lastSummary = "No change detail recorded for that snapshot.";
                 		}
                 		okBody = "<div style=\"font-family:-apple-system,'Segoe UI',sans-serif;font-size:14px;line-height:1.5;\">";
                 		okBody = okBody + "<p><b>SOS EMR schema monitor ran on " + zoho.currenttime + ".</b></p>";
                 		okBody = okBody + "<p style=\"padding:8px 12px;background:#f0f7f0;border-left:3px solid #2e7d32;\"><b>NO FIELD CHANGES THIS RUN.</b><br>Nothing was added, changed, or removed. No files committed.</p>";
                 		okBody = okBody + "<p>Forms checked: " + currentMap.size() + "</p>";
                 		okBody = okBody + "<p><b>MOST RECENT SCHEMA CHANGE</b><br>Captured: " + lastTimeStr + "</p>";
                 		okBody = okBody + "<pre style=\"background:#f6f6f6;padding:10px;white-space:pre-wrap;font-size:12px;\">" + lastSummary + "</pre>";
                 		okBody = okBody + "<hr><p><b>ACTIVE FORMS AT THIS RUN (" + activeForms.size() + ")</b><br>" + activeFormsHtml + "</p>";
                 		okBody = okBody + "<p style=\"color:#666;font-size:12px;\">" + legend + "</p>";
                 		okBody = okBody + "</div>";
                 		thisapp.send_via_sendgrid(alertTo,"SOS EMR schema monitor: NO CHANGES (" + zoho.currentdate.toString("MM-dd-yyyy") + ")",okBody);
                 		return "No field changes this run. Forms checked: " + currentMap.size() + ".";
                 	}
                 	insert into Schema_Snapshot
                 	[
                 		Snapshot_Data=currentSnapshot
                 		Captured_On=zoho.currenttime
                 		Change_Summary=formRemovedLines.toString("\n") + "\n" + formAddedLines.toString("\n") + "\n" + fieldAddedLines.toString("\n") + "\n" + fieldChangedLines.toString("\n") + "\n" + fieldRemovedLines.toString("\n")
                 		Added_User=zoho.loginuser
                 	]
                 	for each  rf in removedForms
                 	{
                 		tPath = "schema/" + rf + ".md";
                 		tLines = List();
                 		tLines.add("# " + rf + " - REMOVED FROM CREATOR");
                 		tLines.add("");
                 		tLines.add("This form no longer exists in the live Creator app as of " + zoho.currenttime + ".");
                 		tLines.add("");
                 		tLines.add("## Last-known fields (quick reference)");
                 		tLines.add("Attribute format is type~mandatory~unique. Full detail (choices, subfields, display names) is preserved in this file's GIT HISTORY - open the commit immediately before this one.");
                 		tLines.add("");
                 		tLines.add("| Link Name | type~mandatory~unique |");
                 		tLines.add("|---|---|");
                 		rfPrev = prevMap.get(rf);
                 		rfKeys = rfPrev.keys();
                 		rfKeys = rfKeys.sort(true);
                 		for each  rk in rfKeys
                 		{
                 			tLines.add("| " + rk + " | " + rfPrev.get(rk) + " |");
                 		}
                 		tLines.add("");
                 		tLines.add("Linked workflows/functions are NOT detectable via the Meta API. Before rebuilding, check _INDEX.md and the " + rf + "/ folder for attached .dg files.");
                 		tLines.add("");
                 		tLines.add("ACTION:");
                 		tLines.add("- If this removal was intentional: you may delete this file.");
                 		tLines.add("- If NOT intentional: a form was deleted in Creator - investigate before deleting anything.");
                 		tLines.add("- A form RENAME shows as one REMOVED + one ADDED; if a new form was added this run, this may be a rename.");
                 		tPayload = Map();
                 		tPayload.put("message","schema: TOMBSTONE " + rf + " (removed from Creator)");
                 		tPayload.put("content",zoho.encryption.base64Encode(tLines.toString("\n")));
                 		tPayload.put("branch",branch);
                 		tGet = invokeurl
                 		[
                 			url :"https://api.github.com/repos/" + repoOwner + "/" + repoName + "/contents/" + tPath + "?ref=" + branch
                 			type :GET
                 			connection:"sos_github_sync"
                 		];
                 		if(tGet.get("sha") != null)
                 		{
                 			tPayload.put("sha",tGet.get("sha"));
                 		}
                 		invokeurl
                 		[
                 			url :"https://api.github.com/repos/" + repoOwner + "/" + repoName + "/contents/" + tPath
                 			type :PUT
                 			parameters:tPayload.toString()
                 			connection:"sos_github_sync"
                 		]
                 	}
                 	commitForms = List();
                 	for each  af in addedForms
                 	{
                 		commitForms.add(af);
                 	}
                 	for each  cff in changedForms
                 	{
                 		commitForms.add(cff);
                 	}
                 	committedList = List();
                 	for each  cf in commitForms
                 	{
                 		cPath = "schema/" + cf + ".md";
                 		cPayload = Map();
                 		cPayload.put("message","schema: update " + cf);
                 		cPayload.put("content",zoho.encryption.base64Encode(fileMap.get(cf)));
                 		cPayload.put("branch",branch);
                 		cGet = invokeurl
                 		[
                 			url :"https://api.github.com/repos/" + repoOwner + "/" + repoName + "/contents/" + cPath + "?ref=" + branch
                 			type :GET
                 			connection:"sos_github_sync"
                 		];
                 		if(cGet.get("sha") != null)
                 		{
                 			cPayload.put("sha",cGet.get("sha"));
                 		}
                 		cPut = invokeurl
                 		[
                 			url :"https://api.github.com/repos/" + repoOwner + "/" + repoName + "/contents/" + cPath
                 			type :PUT
                 			parameters:cPayload.toString()
                 			connection:"sos_github_sync"
                 		];
                 		if(cPut.get("content") != null)
                 		{
                 			committedList.add(cf);
                 		}
                 	}
                 	mailBody = "<div style=\"font-family:-apple-system,'Segoe UI',sans-serif;font-size:14px;line-height:1.5;\">";
                 	mailBody = mailBody + "<p><b>SOS EMR schema changes detected on " + zoho.currenttime + ".</b></p>";
                 	if(formRemovedLines.size() > 0)
                 	{
                 		mailBody = mailBody + "<p><b style=\"color:#b00020;\">⚠ FORMS REMOVED (" + formRemovedLines.size() + ")</b></p>";
                 		for each  rf in removedForms
                 		{
                 			mailBody = mailBody + "<div style=\"margin:0 0 10px 0;padding:8px 12px;background:#fdf0f0;border-left:3px solid #b00020;\">";
                 			mailBody = mailBody + "<b>" + rf + "</b> is gone from Creator. Its mirror file <code>schema/" + rf + ".md</code> has been TOMBSTONED (overwritten with a removal notice + last-known fields; full detail stays in git history).<br>";
                 			mailBody = mailBody + "→ If intentional: delete <code>schema/" + rf + ".md</code> from the repo (GitHub Desktop, or on github.com open the file → trash icon → commit).<br>";
                 			mailBody = mailBody + "→ If NOT intentional: investigate - a form was deleted in Creator.<br>";
                 			mailBody = mailBody + "→ If a new form was also added this run, this may be a RENAME, not a deletion.";
                 			mailBody = mailBody + "</div>";
                 		}
                 	}
                 	if(formAddedLines.size() > 0)
                 	{
                 		mailBody = mailBody + "<p><b>FORMS ADDED (" + formAddedLines.size() + ")</b><br>" + formAddedLines.toString("<br>") + "</p>";
                 	}
                 	if(fieldAddedLines.size() > 0)
                 	{
                 		mailBody = mailBody + "<p><b>FIELDS ADDED (" + fieldAddedLines.size() + ")</b><br>" + fieldAddedLines.toString("<br>") + "</p>";
                 	}
                 	if(fieldChangedLines.size() > 0)
                 	{
                 		mailBody = mailBody + "<p><b>FIELDS CHANGED (" + fieldChangedLines.size() + ")</b><br>" + fieldChangedLines.toString("<br>") + "</p>";
                 	}
                 	if(fieldRemovedLines.size() > 0)
                 	{
                 		mailBody = mailBody + "<p><b>FIELDS REMOVED (" + fieldRemovedLines.size() + ")</b><br>" + fieldRemovedLines.toString("<br>") + "</p>";
                 	}
                 	if(committedList.size() > 0)
                 	{
                 		mailBody = mailBody + "<p><b>Files updated in repo (" + committedList.size() + ")</b><br>schema/" + committedList.toString(".md<br>schema/") + ".md</p>";
                 	}
                 	mailBody = mailBody + "<hr><p><b>ACTIVE FORMS AT THIS RUN (" + activeForms.size() + ")</b><br>" + activeFormsHtml + "</p>";
                 	mailBody = mailBody + "<p style=\"color:#666;font-size:12px;\">" + legend + "</p>";
                 	mailBody = mailBody + "</div>";
                 	thisapp.send_via_sendgrid(alertTo,"SOS EMR schema change detected (" + totalChanges + " changes)",mailBody);
                 	v_out = "Schema changes detected: " + totalChanges + ".";
                 	if(formRemovedLines.size() > 0)
                 	{
                 		v_out = v_out + "\nFORMS REMOVED: " + formRemovedLines.toString(" | ");
                 	}
                 	if(formAddedLines.size() > 0)
                 	{
                 		v_out = v_out + "\nFORMS ADDED: " + formAddedLines.toString(" | ");
                 	}
                 	if(fieldAddedLines.size() > 0)
                 	{
                 		v_out = v_out + "\nFIELDS ADDED: " + fieldAddedLines.toString(" | ");
                 	}
                 	if(fieldChangedLines.size() > 0)
                 	{
                 		v_out = v_out + "\nFIELDS CHANGED: " + fieldChangedLines.toString(" | ");
                 	}
                 	if(fieldRemovedLines.size() > 0)
                 	{
                 		v_out = v_out + "\nFIELDS REMOVED: " + fieldRemovedLines.toString(" | ");
                 	}
                 	if(committedList.size() > 0)
                 	{
                 		v_out = v_out + "\nRepo files updated: " + committedList.toString(", ");
                 	}
                 	return v_out;
                 }
				 void seed_schema_to_github()
                 {
                 	ownerName = "sosmmc";
                 	appName = "sos-referrals-app";
                 	baseUrl = "https://www.zohoapis.com/creator/v2.1/meta/" + ownerName + "/" + appName;
                 	repoOwner = "m1ndspark";
                 	repoName = "sos-emr";
                 	branch = "main";
                 	alertTo = "neil.heird@sosmmc.com";
                 	typeMap = Map();
                 	typeMap.put("1","Single Line");
                 	typeMap.put("2","Multi Line");
                 	typeMap.put("3","Email");
                 	typeMap.put("5","Number");
                 	typeMap.put("6","Decimal");
                 	typeMap.put("8","Currency");
                 	typeMap.put("9","Auto Number");
                 	typeMap.put("10","Date");
                 	typeMap.put("11","Date-Time");
                 	typeMap.put("12","Dropdown/Lookup");
                 	typeMap.put("13","Radio");
                 	typeMap.put("14","Multi Select");
                 	typeMap.put("15","Checkbox");
                 	typeMap.put("16","Decision Box");
                 	typeMap.put("19","File Upload");
                 	typeMap.put("20","Formula");
                 	typeMap.put("21","Subform");
                 	typeMap.put("27","Phone");
                 	typeMap.put("29","Name");
                 	typeMap.put("30","Address");
                 	seededList = List();
                 	failedList = List();
                 	formsResp = invokeurl
                 	[
                 		url :baseUrl + "/forms"
                 		type :GET
                 		connection:"sos_schema_monitor"
                 	];
                 	if(formsResp.get("code") != 3000)
                 	{
                 		sendmail
                 		[
                 			from :zoho.adminuserid
                 			to :alertTo
                 			subject :"SOS schema SEED ERROR (forms)"
                 			message :"Get Forms failed. Response: " + formsResp.toString()
                 		]
                 		return;
                 	}
                 	for each  frm in formsResp.get("forms")
                 	{
                 		formLink = frm.get("link_name");
                 		if(formLink != "Schema_Snapshot")
                 		{
                 			fieldsResp = invokeurl
                 			[
                 				url :baseUrl + "/form/" + formLink + "/fields"
                 				type :GET
                 				connection:"sos_schema_monitor"
                 			];
                 			if(fieldsResp.get("code") != 3000)
                 			{
                 				failedList.add(formLink + " (fields fetch failed)");
                 			}
                 			else
                 			{
                 				formDisplay = frm.get("display_name");
                 				fieldRows = List();
                 				for each  fld in fieldsResp.get("fields")
                 				{
                 					fLink = fld.get("link_name");
                 					if(fLink != null)
                 					{
                 						tcStr = fld.get("type").toLong().toString();
                 						tName = typeMap.get(tcStr);
                 						if(tName == null)
                 						{
                 							typeLabel = "Type " + tcStr;
                 						}
                 						else
                 						{
                 							typeLabel = tName + " (" + tcStr + ")";
                 						}
                 						dName = fld.get("display_name");
                 						if(dName == null)
                 						{
                 							dName = "";
                 						}
                 						mandStr = "no";
                 						if(fld.get("mandatory") == true)
                 						{
                 							mandStr = "YES";
                 						}
                 						uniqStr = "no";
                 						if(fld.get("unique") == true)
                 						{
                 							uniqStr = "YES";
                 						}
                 						detail = "";
                 						if(fld.get("choices") != null)
                 						{
                 							chList = List();
                 							for each  ch in fld.get("choices")
                 							{
                 								chList.add(ch.get("value"));
                 							}
                 							detail = "choices: " + chList.toString(", ");
                 						}
                 						else if(fld.get("subfields") != null)
                 						{
                 							sfList = List();
                 							for each  sf in fld.get("subfields")
                 							{
                 								sfName = sf.get("link_name");
                 								if(sf.get("is_hidden") == true)
                 								{
                 									sfName = sfName + " (hidden)";
                 								}
                 								sfList.add(sfName);
                 							}
                 							detail = "subfields: " + sfList.toString(", ");
                 						}
                 						else if(fld.get("max_char") != null)
                 						{
                 							detail = "max " + fld.get("max_char");
                 						}
                 						rowText = "| " + fLink + " | " + dName + " | " + typeLabel + " | " + mandStr + " | " + uniqStr + " | " + detail + " |";
                 						fieldRows.add(rowText);
                 					}
                 				}
                 				contentLines = List();
                 				contentLines.add("# Schema: " + formDisplay);
                 				contentLines.add("");
                 				contentLines.add("Form link name: `" + formLink + "`");
                 				contentLines.add("Auto-generated by the SOS schema monitor. Source of truth is the live Creator app.");
                 				contentLines.add("Captured: " + zoho.currenttime);
                 				contentLines.add("Field count: " + fieldRows.size());
                 				contentLines.add("");
                 				contentLines.add("| Link Name | Display Name | Type | Mandatory | Unique | Detail |");
                 				contentLines.add("|---|---|---|---|---|---|");
                 				for each  r in fieldRows
                 				{
                 					contentLines.add(r);
                 				}
                 				fileContent = contentLines.toString("\n");
                 				encoded = zoho.encryption.base64Encode(fileContent);
                 				filePath = "schema/" + formLink + ".md";
                 				payload = Map();
                 				payload.put("message","schema: seed " + formLink);
                 				payload.put("content",encoded);
                 				payload.put("branch",branch);
                 				getResp = invokeurl
                 				[
                 					url :"https://api.github.com/repos/" + repoOwner + "/" + repoName + "/contents/" + filePath + "?ref=" + branch
                 					type :GET
                 					connection:"sos_github_sync"
                 				];
                 				if(getResp.get("sha") != null)
                 				{
                 					payload.put("sha",getResp.get("sha"));
                 				}
                 				putResp = invokeurl
                 				[
                 					url :"https://api.github.com/repos/" + repoOwner + "/" + repoName + "/contents/" + filePath
                 					type :PUT
                 					parameters:payload.toString()
                 					connection:"sos_github_sync"
                 				];
                 				if(putResp.get("content") != null)
                 				{
                 					seededList.add(formLink);
                 				}
                 				else
                 				{
                 					failedList.add(formLink + " (commit failed: " + putResp.toString() + ")");
                 				}
                 			}
                 		}
                 	}
                 	bodyHtml = "<div style=\"font-family:-apple-system,'Segoe UI',sans-serif;font-size:14px;\">";
                 	bodyHtml = bodyHtml + "<p>Schema seed complete on " + zoho.currenttime + ".</p>";
                 	bodyHtml = bodyHtml + "<p><b>Seeded (" + seededList.size() + "):</b><br>" + seededList.toString("<br>") + "</p>";
                 	if(failedList.size() > 0)
                 	{
                 		bodyHtml = bodyHtml + "<p><b>Failed (" + failedList.size() + "):</b><br>" + failedList.toString("<br>") + "</p>";
                 	}
                 	bodyHtml = bodyHtml + "<p>Files written to <code>schema/&lt;FormName&gt;.md</code> in m1ndspark/sos-emr. Pull via GitHub Desktop.</p>";
                 	bodyHtml = bodyHtml + "</div>";
                 	sendmail
                 	[
                 		from :zoho.adminuserid
                 		to :alertTo
                 		subject :"SOS schema seed complete (" + seededList.size() + " forms)"
                 		message :bodyHtml
                 	]
                 }
				 string send_3008_notification(string p_refKey)
                 {
                 	v_key = ifnull(p_refKey,"").trim();
                 	if(v_key == "")
                 	{
                 		return "SKIP-NOKEY";
                 	}
                 	v_ref = Referrals_Main[Referral_ID == v_key];
                 	if(v_ref.count() == 0)
                 	{
                 		if(v_key.matches("^[0-9]+$"))
                 		{
                 			v_ref = Referrals_Main[ID == v_key.toLong()];
                 		}
                 	}
                 	if(v_ref.count() == 0)
                 	{
                 		return "SKIP-NOTFOUND";
                 	}
                 	v_type = ifnull(v_ref.Referral_Type,"").trim();
                 	if(v_type != "3008")
                 	{
                 		return "SKIP-TYPE";
                 	}
                 	v_cfg = API_Config[Config_Name == "ZEPTOMAIL"];
                 	if(v_cfg.count() == 0)
                 	{
                 		return "SKIP-NOCONFIG";
                 	}
                 	v_token = ifnull(v_cfg.Zepto_Send_Token,"").trim();
                 	if(v_token == "")
                 	{
                 		return "SKIP-NOTOKEN";
                 	}
                 	v_dash = "&mdash;";
                 	v_from = "notifications@sosreferrals.com";
                 	v_vals = Map();
                 	v_vals.put("REFID",ifnull(v_ref.Referral_ID,""));
                 	v_vals.put("REFDATE",if(v_ref.Referral_Date == null,"",v_ref.Referral_Date.toString("M/d/yyyy")));
                 	v_vals.put("SERVICE",ifnull(v_ref.Referral_Type,""));
                 	v_vals.put("PATNAME",ifnull(v_ref.Patient_Full_Name,""));
                 	v_vals.put("PATDOB",ifnull(v_ref.Patient_DOB1,""));
                 	v_vals.put("PATGENDER",ifnull(v_ref.Patient_Gender,""));
                 	v_vals.put("PATLOC",ifnull(v_ref.Patient_Location,""));
                 	v_vals.put("PATADDR",ifnull(v_ref.Patient_Full_Address,""));
                 	v_vals.put("FACNAME",ifnull(v_ref.Facility_Name,""));
                 	v_vals.put("FACROOM",ifnull(v_ref.Facility_Room_Number,""));
                 	v_vals.put("FACPHONE",ifnull(v_ref.Facility_Phone,""));
                 	v_vals.put("PATPHONE",ifnull(v_ref.Patient_Phone,""));
                 	v_vals.put("HOSPID",ifnull(v_ref.Patient_Hospice_ID,""));
                 	v_vals.put("ACNAME",ifnull(v_ref.AC_Full_Name,""));
                 	v_vals.put("ACPHONE",ifnull(v_ref.AC_Phone,""));
                 	v_vals.put("PARTNER",ifnull(v_ref.Partner_Organization,""));
                 	v_vals.put("BRANCH",ifnull(v_ref.Partner_Branch,""));
                 	v_vals.put("POCNAME",ifnull(v_ref.Partner_POC_Name_Title,""));
                 	v_vals.put("POCPHONE",ifnull(v_ref.Partner_POC_Phone,""));
                 	v_vals.put("POCEMAIL",ifnull(v_ref.Partner_POC_Email,""));
                 	v_vals.put("POCTEAM",ifnull(v_ref.Partner_POC_Team,""));
                 	v_keys = v_vals.keys();
                 	for each  v_k in v_keys
                 	{
                 		if(v_vals.get(v_k).toString().trim() == "")
                 		{
                 			v_vals.put(v_k,v_dash);
                 		}
                 	}
                 	for each  v_k in {"PATPHONE","ACPHONE","FACPHONE","POCPHONE"}
                 	{
                 		v_pRaw = v_vals.get(v_k).toString();
                 		if(v_pRaw != v_dash)
                 		{
                 			v_pDig = v_pRaw.replaceAll("[^0-9]","");
                 			if(v_pDig.length() == 11 && v_pDig.startsWith("1"))
                 			{
                 				v_pDig = v_pDig.subString(1,11);
                 			}
                 			if(v_pDig.length() == 10)
                 			{
                 				v_vals.put(v_k,"(" + v_pDig.subString(0,3) + ") " + v_pDig.subString(3,6) + "-" + v_pDig.subString(6,10));
                 			}
                 		}
                 	}
                 	v_source = v_vals.get("PARTNER");
                 	if(v_vals.get("BRANCH") != v_dash)
                 	{
                 		v_source = v_source + " &ndash; " + v_vals.get("BRANCH");
                 	}
                 	v_phoneLink = v_vals.get("PATPHONE");
                 	if(v_phoneLink != v_dash)
                 	{
                 		v_phoneLink = "<a href=\"tel:" + v_phoneLink.replaceAll("[^0-9]","") + "\" style=\"color:#2634a3; text-decoration:none; font-weight:bold;\">" + v_vals.get("PATPHONE") + "</a>";
                 	}
                 	v_acPhoneLink = v_vals.get("ACPHONE");
                 	if(v_acPhoneLink != v_dash)
                 	{
                 		v_acPhoneLink = "<a href=\"tel:" + v_acPhoneLink.replaceAll("[^0-9]","") + "\" style=\"color:#2634a3; text-decoration:none; font-weight:bold;\">" + v_vals.get("ACPHONE") + "</a>";
                 	}
                 	v_facPhoneLink = v_vals.get("FACPHONE");
                 	if(v_facPhoneLink != v_dash)
                 	{
                 		v_facPhoneLink = "<a href=\"tel:" + v_facPhoneLink.replaceAll("[^0-9]","") + "\" style=\"color:#2634a3; text-decoration:none; font-weight:bold;\">" + v_vals.get("FACPHONE") + "</a>";
                 	}
                 	v_pocPhoneLink = v_vals.get("POCPHONE");
                 	if(v_pocPhoneLink != v_dash)
                 	{
                 		v_pocPhoneLink = "<a href=\"tel:" + v_pocPhoneLink.replaceAll("[^0-9]","") + "\" style=\"color:#2634a3; text-decoration:none; font-weight:bold;\">" + v_vals.get("POCPHONE") + "</a>";
                 	}
                 	v_pocEmailLink = v_vals.get("POCEMAIL");
                 	if(v_pocEmailLink != v_dash)
                 	{
                 		v_pocEmailLink = "<a href=\"mailto:" + v_pocEmailLink + "\" style=\"color:#2634a3; text-decoration:none;\">" + v_vals.get("POCEMAIL") + "</a>";
                 	}
                 	v_block = List();
                 	v_block.add("#SEC|Referral Info");
                 	v_block.add("Referral ID|" + v_vals.get("REFID") + "|1");
                 	v_block.add("Referral Date|" + v_vals.get("REFDATE") + "|0");
                 	v_block.add("Service Request Type|" + v_vals.get("SERVICE") + "|0");
                 	v_block.add("Referral Source|" + v_source + "|1");
                 	v_block.add("#SEC|Patient Info");
                 	v_block.add("Name|" + v_vals.get("PATNAME") + "|1");
                 	v_block.add("Date of Birth|" + v_vals.get("PATDOB") + "|0");
                 	v_block.add("Gender|" + v_vals.get("PATGENDER") + "|0");
                 	v_block.add("Current Location|" + v_vals.get("PATLOC") + "|1");
                 	if(ifnull(v_ref.Patient_Location,"") == "Home")
                 	{
                 		v_block.add("Address|" + v_vals.get("PATADDR") + "|0");
                 	}
                 	else
                 	{
                 		v_block.add("Facility|" + v_vals.get("FACNAME") + "|1");
                 		v_block.add("Room / Unit|" + v_vals.get("FACROOM") + "|0");
                 		v_block.add("Facility Phone|" + v_facPhoneLink + "|0");
                 	}
                 	v_block.add("Phone|" + v_phoneLink + "|0");
                 	v_block.add("Hospice ID|" + v_vals.get("HOSPID") + "|0");
                 	if(ifnull(v_ref.Has_Additional_Contact,"") == "Yes")
                 	{
                 		v_block.add("#SEC|Primary Contact");
                 		v_block.add("Additional POC|" + v_vals.get("ACNAME") + "|1");
                 		v_block.add("Additional POC Phone|" + v_acPhoneLink + "|0");
                 	}
                 	v_block.add("#SEC|3008 Documents");
                 	v_block.add("Attached Files|See the Zoho Forms entry for this referral|0");
                 	v_block.add("#SEC|Partner Info");
                 	v_block.add("Referral Partner|" + v_vals.get("PARTNER") + "|1");
                 	v_block.add("Billing Branch|" + v_vals.get("BRANCH") + "|0");
                 	v_block.add("Referred By|" + v_vals.get("POCNAME") + "|0");
                 	v_block.add("Phone|" + v_pocPhoneLink + "|0");
                 	v_block.add("Email|" + v_pocEmailLink + "|0");
                 	v_block.add("Clinical Team|" + v_vals.get("POCTEAM") + "|0");
                 	v_secStyle = "background-color:#0b0b5b; padding:10px 24px; font-family:Arial,Helvetica,sans-serif; font-size:13px; font-weight:bold; color:#ffffff; letter-spacing:.05em; text-transform:uppercase;";
                 	v_lblBase = "width:40%; font-family:Arial,Helvetica,sans-serif; font-size:14px; line-height:20px; color:#4c4c89; padding:11px 0;";
                 	v_valBase = "width:60%; font-family:Arial,Helvetica,sans-serif; font-size:15px; line-height:21px; color:#000000; padding:11px 0;";
                 	v_border = " border-bottom:1px solid #e6e6ef;";
                 	v_body = "";
                 	v_open = false;
                 	v_i = 0;
                 	v_n = v_block.size();
                 	for each  v_item in v_block
                 	{
                 		v_parts = v_item.toList("|");
                 		if(v_parts.get(0) == "#SEC")
                 		{
                 			if(v_open)
                 			{
                 				v_body = v_body + "</table></td></tr>";
                 				v_open = false;
                 			}
                 			v_body = v_body + "<tr><td style=\"" + v_secStyle + "\">" + v_parts.get(1) + "</td></tr>";
                 			v_body = v_body + "<tr><td style=\"padding:0 24px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">";
                 			v_open = true;
                 		}
                 		else
                 		{
                 			v_last = true;
                 			if(v_i + 1 < v_n)
                 			{
                 				if(!v_block.get(v_i + 1).startsWith("#SEC|"))
                 				{
                 					v_last = false;
                 				}
                 			}
                 			v_lbl = v_lblBase;
                 			v_val = v_valBase;
                 			if(!v_last)
                 			{
                 				v_lbl = v_lbl + v_border;
                 				v_val = v_val + v_border;
                 			}
                 			if(v_parts.get(2) == "1")
                 			{
                 				v_val = v_val + " font-weight:bold;";
                 			}
                 			v_body = v_body + "<tr><td class=\"stack lbl\" valign=\"top\" style=\"" + v_lbl + "\">" + v_parts.get(0) + "</td>";
                 			v_body = v_body + "<td class=\"stack val\" valign=\"top\" style=\"" + v_val + "\">" + v_parts.get(1) + "</td></tr>";
                 		}
                 		v_i = v_i + 1;
                 	}
                 	if(v_open)
                 	{
                 		v_body = v_body + "</table></td></tr>";
                 	}
                 	v_html = "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">";
                 	v_html = v_html + "<html xmlns=\"http://www.w3.org/1999/xhtml\"><head>";
                 	v_html = v_html + "<meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\" />";
                 	v_html = v_html + "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />";
                 	v_html = v_html + "<title>3008 Referral</title>";
                 	v_html = v_html + "<style type=\"text/css\">@media only screen and (max-width:600px){.container{width:100% !important;}.stack{display:block !important;width:100% !important;box-sizing:border-box !important;}.lbl{background:#f0f0ff !important;border-bottom:0 !important;padding-bottom:2px !important;font-size:11px !important;text-transform:uppercase;letter-spacing:.05em;color:#4c4c89 !important;}.val{border-top:0 !important;padding-top:2px !important;font-size:16px !important;}.hero{font-size:19px !important;line-height:25px !important;}}</style>";
                 	v_html = v_html + "</head><body style=\"margin:0; padding:0; background-color:#eef0f6;\">";
                 	v_html = v_html + "<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#eef0f6;\"><tr><td align=\"center\" style=\"padding:20px 10px 32px 10px;\">";
                 	v_html = v_html + "<table role=\"presentation\" class=\"container\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%; max-width:600px; background-color:#ffffff;\">";
                 	v_html = v_html + "<tr><td style=\"background-color:#00003c; padding:20px 24px;\">";
                 	v_html = v_html + "<div style=\"font-family:Arial,Helvetica,sans-serif; font-size:13px; line-height:18px; color:#8d8db8; letter-spacing:.06em; text-transform:uppercase;\">SOS Mobile Medical Care</div>";
                 	v_html = v_html + "<div class=\"hero\" style=\"font-family:Arial,Helvetica,sans-serif; font-size:22px; line-height:28px; font-weight:bold; color:#ffffff; padding-top:4px;\">New 3008 Referral</div>";
                 	v_html = v_html + "<div style=\"font-family:Arial,Helvetica,sans-serif; font-size:15px; line-height:21px; color:#cfcfe7; padding-top:6px;\">" + v_vals.get("PATNAME") + " &nbsp;&bull;&nbsp; " + v_vals.get("REFID") + "</div>";
                 	v_html = v_html + "</td></tr>";
                 	v_html = v_html + v_body;
                 	v_html = v_html + "<tr><td align=\"center\" style=\"padding:26px 24px 8px 24px;\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td align=\"center\" bgcolor=\"#0b0b5b\" style=\"border-radius:4px;\">";
                 	v_html = v_html + "<a href=\"https://creatorapp.zoho.com/sosmmc/sos-referrals-app/#Report:Referrals_Main_Report\" style=\"display:inline-block; padding:13px 34px; font-family:Arial,Helvetica,sans-serif; font-size:15px; font-weight:bold; color:#ffffff; text-decoration:none; border-radius:4px;\">Open Referral</a>";
                 	v_html = v_html + "</td></tr></table></td></tr>";
                 	v_html = v_html + "<tr><td style=\"padding:20px 24px 24px 24px; font-family:Arial,Helvetica,sans-serif; font-size:12px; line-height:17px; color:#888888; border-top:1px solid #e6e6ef;\">Confidential. This message contains protected health information intended only for the named recipient. If you received it in error, delete it and notify the sender.</td></tr>";
                 	v_html = v_html + "</table></td></tr></table></body></html>";
                 	v_subject = "New 3008 Referral - " + v_vals.get("PATNAME") + " - " + v_vals.get("REFID");
                 	v_fromMap = Map();
                 	v_fromMap.put("address",v_from);
                 	v_fromMap.put("name","SOS Mobile Medical Care");
                 	v_toList = List();
                 	for each  v_addr in {"neil.heird@sosmmc.com","sosreferrals@sosmmc.com"}
                 	{
                 		v_addrMap = Map();
                 		v_addrMap.put("address",v_addr);
                 		v_entry = Map();
                 		v_entry.put("email_address",v_addrMap);
                 		v_toList.add(v_entry);
                 	}
                 	v_payload = Map();
                 	v_payload.put("from",v_fromMap);
                 	v_payload.put("to",v_toList);
                 	v_payload.put("subject",v_subject);
                 	v_payload.put("htmlbody",v_html);
                 	v_hdr = Map();
                 	v_hdr.put("Accept","application/json");
                 	v_hdr.put("Content-Type","application/json");
                 	v_hdr.put("Authorization","Zoho-enczapikey " + v_token);
                 	v_resp = invokeurl
                 	[
                 		url :"https://api.zeptomail.com/v1.1/email"
                 		type :POST
                 		body:v_payload.toString()
                 		headers:v_hdr
                 		detailed:true
                 	];
                 	if(v_resp.get("responseCode") == 201)
                 	{
                 		return "SENT " + v_vals.get("REFID");
                 	}
                 	return "FAIL " + v_resp.toString();
                 }
				 map send_pvs_fax(int pPvsID, string pToName, string pToPartner, string pToFax, string pToAttn, string pRemarks, string pNumberSource, string pOverrideReason, list pImageUrls, list pAttachFiles, int pAttempt, int pOriginalFaxID)
                 {
                 	v_out = Map();
                 	v_pvs = Encounter_PatientVisit[ID == pPvsID];
                 	v_seqVal = 0;
                 	for each  v_rec in Sequence_Tracker[Object_Prefix == "FAX"]
                 	{
                 		v_seqVal = v_rec.Object_Sequence;
                 		v_rec.Object_Sequence=v_seqVal + 1;
                 		break;
                 	}
                 	v_faxId = "FAX-" + zoho.currentdate.toString("MMddyy") + "-" + leftpad(v_seqVal.toString(),4).replaceAll(" ","0",true);
                 	v_digits = pToFax.replaceAll("[^0-9]","",true);
                 	if(v_digits.length() == 10)
                 	{
                 		v_digits = "1" + v_digits;
                 	}
                 	v_e164 = "+" + v_digits;
                 	v_log = insert into Fax_Log
                 	[
                 		PVS_Link=pPvsID
                 		Referral_Link=v_pvs.Referral_Link
                 		Partner_Location_Link=v_pvs.Billing_Branch
                 		Fax_ID=v_faxId
                 		Destination_Fax=v_e164
                 		Destination_Name=pToName
                 		Number_Source=pNumberSource
                 		Override_Reason=pOverrideReason
                 		Cover_Remarks=pRemarks
                 		Fax_Status="Building"
                 		Attempt_Number=pAttempt
                 		Original_Fax_Link=pOriginalFaxID
                 		Sent_By=zoho.loginuserid
                 		Submitted_Time=zoho.currenttime
                 		Added_User=zoho.loginuser
                 	];
                 	v_logId = v_log;
                 	v_row = Fax_Log[ID == v_logId];
                 	v_html = thisapp.build_pvs_fax_html(pPvsID,v_faxId,pToName,pToPartner,pToFax,pToAttn,pRemarks,pImageUrls);
                 	v_dobTxt = "";
                 	if(v_pvs.Patient_DOB != null)
                 	{
                 		v_dobTxt = v_pvs.Patient_DOB.toString("MM/dd/yyyy");
                 	}
                 	v_footer = "<div style='width:100%;font-family:Helvetica,Arial,sans-serif;font-size:7pt;color:#4C4C89;padding:0 0.65in;border-top:1px solid #BFBFBF;padding-top:4px;'><span style='float:left;'>" + ifnull(v_pvs.Patient_Full_Name_1,"") + " &nbsp;|&nbsp; DOB " + v_dobTxt + " &nbsp;|&nbsp; PVS " + ifnull(v_pvs.PVS_ID,"") + " &nbsp;|&nbsp; " + v_faxId + "</span><span style='float:right;'>Confidential - Protected Health Information &nbsp;|&nbsp; Page <span class='pageNumber'></span> of <span class='totalPages'></span></span></div>";
                 	v_opt = Collection();
                 	v_opt.insert("units","in");
                 	v_opt.insert("page-width","8.5");
                 	v_opt.insert("page-height","11");
                 	v_opt.insert("top-margin","0.6");
                 	v_opt.insert("bottom-margin","0.75");
                 	v_opt.insert("left-margin","0.65");
                 	v_opt.insert("right-margin","0.65");
                 	v_opt.insert("print-background",true);
                 	v_opt.insert("custom-header-footer",true);
                 	v_opt.insert("header","<div></div>");
                 	v_opt.insert("footer",v_footer);
                 	v_opt.insert("footer-spacing","5");
                 	v_opt.insert("disable-javascript",true);
                 	v_opt.insert("mask-html",true);
                 	v_pdf = zoho.file.convertToPDF(v_html,v_opt);
                 	v_pdf.setFileName(v_faxId + ".pdf");
                 	v_row.Fax_PDF=v_pdf;
                 	v_token = thisapp.get_rc_token();
                 	if(v_token == "")
                 	{
                 		v_row.Fax_Status="Failed";
                 		v_row.Fax_Error_Reason="No RingCentral access token";
                 		v_row.Completed_Time=zoho.currenttime;
                 		v_out.put("fax_id",v_faxId);
                 		v_out.put("log_id",v_logId);
                 		v_out.put("status","Failed");
                 		v_out.put("error","No RingCentral access token");
                 		return v_out;
                 	}
                 	v_parts = List();
                 	v_pTo = Map();
                 	v_pTo.put("paramName","to");
                 	v_pTo.put("content",v_e164);
                 	v_pTo.put("stringPart","true");
                 	v_parts.add(v_pTo);
                 	v_pRes = Map();
                 	v_pRes.put("paramName","faxResolution");
                 	v_pRes.put("content","High");
                 	v_pRes.put("stringPart","true");
                 	v_parts.add(v_pRes);
                 	v_pCov = Map();
                 	v_pCov.put("paramName","coverIndex");
                 	v_pCov.put("content","0");
                 	v_pCov.put("stringPart","true");
                 	v_parts.add(v_pCov);
                 	v_pdf.setParamName("attachment");
                 	v_parts.add(v_pdf);
                 	if(pAttachFiles != null)
                 	{
                 		for each  v_f in pAttachFiles
                 		{
                 			v_f.setParamName("attachment");
                 			v_parts.add(v_f);
                 		}
                 	}
                 	v_resp = invokeurl
                 	[
                 		url :"https://platform.ringcentral.com/restapi/v1.0/account/~/extension/~/fax"
                 		type :POST
                 		headers:{"Authorization":"Bearer " + v_token,"Accept":"application/json"}
                 		files:v_parts
                 	];
                 	v_msgId = "";
                 	if(v_resp.get("id") != null)
                 	{
                 		v_msgId = v_resp.get("id").toString();
                 	}
                 	if(v_msgId != "")
                 	{
                 		v_row.RC_Message_ID=v_msgId;
                 		v_row.Fax_Status="Queued";
                 		v_row.Last_Polled_Time=zoho.currenttime;
                 		if(v_resp.get("conversationId") != null)
                 		{
                 			v_row.RC_Conversation_ID=v_resp.get("conversationId").toString();
                 		}
                 		v_pvs.Fax_Status="Queued";
                 		v_out.put("status","Queued");
                 	}
                 	else
                 	{
                 		v_row.Fax_Status="Failed";
                 		v_row.Fax_Error_Reason=v_resp.toString().left(250);
                 		v_row.Completed_Time=zoho.currenttime;
                 		v_pvs.Fax_Status="Failed";
                 		v_out.put("status","Failed");
                 		v_out.put("error",v_resp.toString().left(250));
                 	}
                 	v_out.put("fax_id",v_faxId);
                 	v_out.put("log_id",v_logId);
                 	v_out.put("rc_message_id",v_msgId);
                 	return v_out;
                 }
				 string send_referral_notification(string p_refKey)
                 {
                 	v_key = ifnull(p_refKey,"").trim();
                 	if(v_key == "")
                 	{
                 		return "SKIP-NOKEY";
                 	}
                 	v_ref = Referrals_Main[Referral_ID == v_key];
                 	if(v_ref.count() == 0)
                 	{
                 		if(v_key.matches("^[0-9]+$"))
                 		{
                 			v_ref = Referrals_Main[ID == v_key.toLong()];
                 		}
                 	}
                 	if(v_ref.count() == 0)
                 	{
                 		return "SKIP-NOTFOUND";
                 	}
                 	v_type = ifnull(v_ref.Referral_Type,"").trim();
                 	if(v_type != "Patient Visit")
                 	{
                 		return "SKIP-TYPE";
                 	}
                 	v_cfg = API_Config[Config_Name == "ZEPTOMAIL"];
                 	if(v_cfg.count() == 0)
                 	{
                 		return "SKIP-NOCONFIG";
                 	}
                 	v_token = ifnull(v_cfg.Zepto_Send_Token,"").trim();
                 	if(v_token == "")
                 	{
                 		return "SKIP-NOTOKEN";
                 	}
                 	v_dash = "&mdash;";
                 	v_from = "notifications@sosreferrals.com";
                 	v_vals = Map();
                 	v_vals.put("REFID",ifnull(v_ref.Referral_ID,""));
                 	v_vals.put("REFDATE",if(v_ref.Referral_Date == null,"",v_ref.Referral_Date.toString("M/d/yyyy")));
                 	v_vals.put("SERVICE",ifnull(v_ref.Referral_Type,""));
                 	v_vals.put("PATNAME",ifnull(v_ref.Patient_Full_Name,""));
                 	v_vals.put("PATDOB",ifnull(v_ref.Patient_DOB1,""));
                 	v_vals.put("PATGENDER",ifnull(v_ref.Patient_Gender,""));
                 	v_vals.put("PATLOC",ifnull(v_ref.Patient_Location,""));
                 	v_vals.put("PATADDR",ifnull(v_ref.Patient_Full_Address,""));
                 	v_vals.put("FACNAME",ifnull(v_ref.Facility_Name,""));
                 	v_vals.put("FACROOM",ifnull(v_ref.Facility_Room_Number,""));
                 	v_vals.put("FACPHONE",ifnull(v_ref.Facility_Phone,""));
                 	v_vals.put("PATPHONE",ifnull(v_ref.Patient_Phone,""));
                 	v_vals.put("HOSPID",ifnull(v_ref.Patient_Hospice_ID,""));
                 	v_vals.put("ACNAME",ifnull(v_ref.AC_Full_Name,""));
                 	v_vals.put("ACPHONE",ifnull(v_ref.AC_Phone,""));
                 	v_vals.put("REASON",ifnull(v_ref.Referral_Reason,""));
                 	v_vals.put("ALLERGIES",ifnull(v_ref.List_Patient_Allergies,""));
                 	v_vals.put("ANTICOAG",ifnull(v_ref.List_Patient_Anticoagulants,""));
                 	v_vals.put("ADVDIR",ifnull(v_ref.Advanced_Directives_Details,""));
                 	v_vals.put("IMGTEST",ifnull(v_ref.Imaging_Type_Order,""));
                 	v_vals.put("IMGSITE",ifnull(v_ref.Imaging_Body_Site,""));
                 	v_vals.put("IMGREASON",ifnull(v_ref.Imaging_Order_Indication,""));
                 	v_vals.put("PARTNER",ifnull(v_ref.Partner_Organization,""));
                 	v_vals.put("BRANCH",ifnull(v_ref.Partner_Branch,""));
                 	v_vals.put("POCNAME",ifnull(v_ref.Partner_POC_Name_Title,""));
                 	v_vals.put("POCPHONE",ifnull(v_ref.Partner_POC_Phone,""));
                 	v_vals.put("POCEMAIL",ifnull(v_ref.Partner_POC_Email,""));
                 	v_vals.put("POCTEAM",ifnull(v_ref.Partner_POC_Team,""));
                 	v_keys = v_vals.keys();
                 	for each  v_k in v_keys
                 	{
                 		if(v_vals.get(v_k).toString().trim() == "")
                 		{
                 			v_vals.put(v_k,v_dash);
                 		}
                 	}
                 	for each  v_k in {"ALLERGIES","ANTICOAG","ADVDIR"}
                 	{
                 		if(v_vals.get(v_k) == v_dash)
                 		{
                 			v_vals.put(v_k,"NA");
                 		}
                 	}
                 	v_source = v_vals.get("PARTNER");
                 	if(v_vals.get("BRANCH") != v_dash)
                 	{
                 		v_source = v_source + " &ndash; " + v_vals.get("BRANCH");
                 	}
                 	v_phoneLink = v_vals.get("PATPHONE");
                 	if(v_phoneLink != v_dash)
                 	{
                 		v_phoneLink = "<a href=\"tel:" + v_phoneLink.replaceAll("[^0-9]","") + "\" style=\"color:#2634a3; text-decoration:none; font-weight:bold;\">" + v_vals.get("PATPHONE") + "</a>";
                 	}
                 	v_acPhoneLink = v_vals.get("ACPHONE");
                 	if(v_acPhoneLink != v_dash)
                 	{
                 		v_acPhoneLink = "<a href=\"tel:" + v_acPhoneLink.replaceAll("[^0-9]","") + "\" style=\"color:#2634a3; text-decoration:none; font-weight:bold;\">" + v_vals.get("ACPHONE") + "</a>";
                 	}
                 	v_facPhoneLink = v_vals.get("FACPHONE");
                 	if(v_facPhoneLink != v_dash)
                 	{
                 		v_facPhoneLink = "<a href=\"tel:" + v_facPhoneLink.replaceAll("[^0-9]","") + "\" style=\"color:#2634a3; text-decoration:none; font-weight:bold;\">" + v_vals.get("FACPHONE") + "</a>";
                 	}
                 	v_pocPhoneLink = v_vals.get("POCPHONE");
                 	if(v_pocPhoneLink != v_dash)
                 	{
                 		v_pocPhoneLink = "<a href=\"tel:" + v_pocPhoneLink.replaceAll("[^0-9]","") + "\" style=\"color:#2634a3; text-decoration:none; font-weight:bold;\">" + v_vals.get("POCPHONE") + "</a>";
                 	}
                 	v_pocEmailLink = v_vals.get("POCEMAIL");
                 	if(v_pocEmailLink != v_dash)
                 	{
                 		v_pocEmailLink = "<a href=\"mailto:" + v_pocEmailLink + "\" style=\"color:#2634a3; text-decoration:none;\">" + v_vals.get("POCEMAIL") + "</a>";
                 	}
                 	v_block = List();
                 	v_block.add("#SEC|Referral Info");
                 	v_block.add("Referral ID|" + v_vals.get("REFID") + "|1");
                 	v_block.add("Referral Date|" + v_vals.get("REFDATE") + "|0");
                 	v_block.add("Service Request Type|" + v_vals.get("SERVICE") + "|0");
                 	v_block.add("Referral Source|" + v_source + "|1");
                 	v_block.add("#SEC|Patient Info");
                 	v_block.add("Name|" + v_vals.get("PATNAME") + "|1");
                 	v_block.add("Date of Birth|" + v_vals.get("PATDOB") + "|0");
                 	v_block.add("Gender|" + v_vals.get("PATGENDER") + "|0");
                 	v_block.add("Current Location|" + v_vals.get("PATLOC") + "|1");
                 	if(ifnull(v_ref.Patient_Location,"") == "Home")
                 	{
                 		v_block.add("Address|" + v_vals.get("PATADDR") + "|0");
                 	}
                 	else
                 	{
                 		v_block.add("Facility|" + v_vals.get("FACNAME") + "|1");
                 		v_block.add("Room / Unit|" + v_vals.get("FACROOM") + "|0");
                 		v_block.add("Facility Phone|" + v_facPhoneLink + "|0");
                 	}
                 	v_block.add("Phone|" + v_phoneLink + "|0");
                 	v_block.add("Hospice ID|" + v_vals.get("HOSPID") + "|0");
                 	if(ifnull(v_ref.Has_Additional_Contact,"") == "Yes")
                 	{
                 		v_block.add("#SEC|Primary Contact");
                 		v_block.add("Additional POC|" + v_vals.get("ACNAME") + "|1");
                 		v_block.add("Additional POC Phone|" + v_acPhoneLink + "|0");
                 	}
                 	v_block.add("#SEC|Medical Info");
                 	v_block.add("Reason for Referral|" + v_vals.get("REASON") + "|0");
                 	v_block.add("Allergies|" + v_vals.get("ALLERGIES") + "|0");
                 	v_block.add("Anticoagulants|" + v_vals.get("ANTICOAG") + "|0");
                 	v_block.add("Advanced Directives|" + v_vals.get("ADVDIR") + "|0");
                 	if(ifnull(v_ref.X_Ray_Needed,"") == "Yes")
                 	{
                 		v_block.add("#SEC|Imaging Orders");
                 		v_block.add("Imaging Test(s)|" + v_vals.get("IMGTEST") + "|1");
                 		v_block.add("Body Part / Affected Area|" + v_vals.get("IMGSITE") + "|0");
                 		v_block.add("Reason for Imaging|" + v_vals.get("IMGREASON") + "|0");
                 		v_block.add("Order Document|See the Zoho Forms entry for this referral|0");
                 	}
                 	v_block.add("#SEC|Partner Info");
                 	v_block.add("Referral Partner|" + v_vals.get("PARTNER") + "|1");
                 	v_block.add("Billing Branch|" + v_vals.get("BRANCH") + "|0");
                 	v_block.add("Referred By|" + v_vals.get("POCNAME") + "|0");
                 	v_block.add("Phone|" + v_pocPhoneLink + "|0");
                 	v_block.add("Email|" + v_pocEmailLink + "|0");
                 	v_block.add("Clinical Team|" + v_vals.get("POCTEAM") + "|0");
                 	v_secStyle = "background-color:#0b0b5b; padding:10px 24px; font-family:Arial,Helvetica,sans-serif; font-size:13px; font-weight:bold; color:#ffffff; letter-spacing:.05em; text-transform:uppercase;";
                 	v_lblBase = "width:40%; font-family:Arial,Helvetica,sans-serif; font-size:14px; line-height:20px; color:#4c4c89; padding:11px 0;";
                 	v_valBase = "width:60%; font-family:Arial,Helvetica,sans-serif; font-size:15px; line-height:21px; color:#000000; padding:11px 0;";
                 	v_border = " border-bottom:1px solid #e6e6ef;";
                 	v_body = "";
                 	v_open = false;
                 	v_i = 0;
                 	v_n = v_block.size();
                 	for each  v_item in v_block
                 	{
                 		v_parts = v_item.toList("|");
                 		if(v_parts.get(0) == "#SEC")
                 		{
                 			if(v_open)
                 			{
                 				v_body = v_body + "</table></td></tr>";
                 				v_open = false;
                 			}
                 			v_body = v_body + "<tr><td style=\"" + v_secStyle + "\">" + v_parts.get(1) + "</td></tr>";
                 			v_body = v_body + "<tr><td style=\"padding:0 24px;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">";
                 			v_open = true;
                 		}
                 		else
                 		{
                 			v_last = true;
                 			if(v_i + 1 < v_n)
                 			{
                 				if(!v_block.get(v_i + 1).startsWith("#SEC|"))
                 				{
                 					v_last = false;
                 				}
                 			}
                 			v_lbl = v_lblBase;
                 			v_val = v_valBase;
                 			if(!v_last)
                 			{
                 				v_lbl = v_lbl + v_border;
                 				v_val = v_val + v_border;
                 			}
                 			if(v_parts.get(2) == "1")
                 			{
                 				v_val = v_val + " font-weight:bold;";
                 			}
                 			v_body = v_body + "<tr><td class=\"stack lbl\" valign=\"top\" style=\"" + v_lbl + "\">" + v_parts.get(0) + "</td>";
                 			v_body = v_body + "<td class=\"stack val\" valign=\"top\" style=\"" + v_val + "\">" + v_parts.get(1) + "</td></tr>";
                 		}
                 		v_i = v_i + 1;
                 	}
                 	if(v_open)
                 	{
                 		v_body = v_body + "</table></td></tr>";
                 	}
                 	v_html = "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">";
                 	v_html = v_html + "<html xmlns=\"http://www.w3.org/1999/xhtml\"><head>";
                 	v_html = v_html + "<meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\" />";
                 	v_html = v_html + "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />";
                 	v_html = v_html + "<title>Patient Referral</title>";
                 	v_html = v_html + "<style type=\"text/css\">@media only screen and (max-width:600px){.container{width:100% !important;}.stack{display:block !important;width:100% !important;box-sizing:border-box !important;}.lbl{background:#f0f0ff !important;border-bottom:0 !important;padding-bottom:2px !important;font-size:11px !important;text-transform:uppercase;letter-spacing:.05em;color:#4c4c89 !important;}.val{border-top:0 !important;padding-top:2px !important;font-size:16px !important;}.hero{font-size:19px !important;line-height:25px !important;}}</style>";
                 	v_html = v_html + "</head><body style=\"margin:0; padding:0; background-color:#eef0f6;\">";
                 	v_html = v_html + "<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#eef0f6;\"><tr><td align=\"center\" style=\"padding:20px 10px 32px 10px;\">";
                 	v_html = v_html + "<table role=\"presentation\" class=\"container\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%; max-width:600px; background-color:#ffffff;\">";
                 	v_html = v_html + "<tr><td style=\"background-color:#00003c; padding:20px 24px;\">";
                 	v_html = v_html + "<div style=\"font-family:Arial,Helvetica,sans-serif; font-size:13px; line-height:18px; color:#8d8db8; letter-spacing:.06em; text-transform:uppercase;\">SOS Mobile Medical Care</div>";
                 	v_html = v_html + "<div class=\"hero\" style=\"font-family:Arial,Helvetica,sans-serif; font-size:22px; line-height:28px; font-weight:bold; color:#ffffff; padding-top:4px;\">New Patient Referral</div>";
                 	v_html = v_html + "<div style=\"font-family:Arial,Helvetica,sans-serif; font-size:15px; line-height:21px; color:#cfcfe7; padding-top:6px;\">" + v_vals.get("PATNAME") + " &nbsp;&bull;&nbsp; " + v_vals.get("REFID") + "</div>";
                 	v_html = v_html + "</td></tr>";
                 	v_html = v_html + v_body;
                 	v_html = v_html + "<tr><td align=\"center\" style=\"padding:26px 24px 8px 24px;\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td align=\"center\" bgcolor=\"#0b0b5b\" style=\"border-radius:4px;\">";
                 	v_html = v_html + "<a href=\"https://creatorapp.zoho.com/sosmmc/sos-referrals-app/#Report:Referrals_Main_Report\" style=\"display:inline-block; padding:13px 34px; font-family:Arial,Helvetica,sans-serif; font-size:15px; font-weight:bold; color:#ffffff; text-decoration:none; border-radius:4px;\">Open Referral</a>";
                 	v_html = v_html + "</td></tr></table></td></tr>";
                 	v_html = v_html + "<tr><td style=\"padding:20px 24px 24px 24px; font-family:Arial,Helvetica,sans-serif; font-size:12px; line-height:17px; color:#888888; border-top:1px solid #e6e6ef;\">Confidential. This message contains protected health information intended only for the named recipient. If you received it in error, delete it and notify the sender.</td></tr>";
                 	v_html = v_html + "</table></td></tr></table></body></html>";
                 	v_subject = "New Patient Visit Referral - " + v_vals.get("PATNAME") + " - " + v_vals.get("REFID");
                 	v_fromMap = Map();
                 	v_fromMap.put("address",v_from);
                 	v_fromMap.put("name","SOS Mobile Medical Care");
                 	v_toList = List();
                 	for each  v_addr in {"neil.heird@sosmmc.com","sosreferrals@sosmmc.com"}
                 	{
                 		v_addrMap = Map();
                 		v_addrMap.put("address",v_addr);
                 		v_entry = Map();
                 		v_entry.put("email_address",v_addrMap);
                 		v_toList.add(v_entry);
                 	}
                 	v_payload = Map();
                 	v_payload.put("from",v_fromMap);
                 	v_payload.put("to",v_toList);
                 	v_payload.put("subject",v_subject);
                 	v_payload.put("htmlbody",v_html);
                 	v_hdr = Map();
                 	v_hdr.put("Accept","application/json");
                 	v_hdr.put("Content-Type","application/json");
                 	v_hdr.put("Authorization","Zoho-enczapikey " + v_token);
                 	v_resp = invokeurl
                 	[
                 		url :"https://api.zeptomail.com/v1.1/email"
                 		type :POST
                 		body:v_payload.toString()
                 		headers:v_hdr
                 		detailed:true
                 	];
                 	if(v_resp.get("responseCode") == 201)
                 	{
                 		return "SENT " + v_vals.get("REFID");
                 	}
                 	return "FAIL " + v_resp.toString();
                 }
				 void send_via_sendgrid(string pTo, string pSubject, string pMessage)
                 {
                 	toMap = Map();
                 	toMap.put("email",pTo);
                 	toList = List();
                 	toList.add(toMap);
                 	personalization = Map();
                 	personalization.put("to",toList);
                 	persList = List();
                 	persList.add(personalization);
                 	fromMap = Map();
                 	fromMap.put("email","notifications@sosreferrals.com");
                 	fromMap.put("name","SOS Mobile Medical Care");
                 	contentMap = Map();
                 	contentMap.put("type","text/html");
                 	contentMap.put("value",pMessage);
                 	contentList = List();
                 	contentList.add(contentMap);
                 	body = Map();
                 	body.put("personalizations",persList);
                 	body.put("from",fromMap);
                 	body.put("subject",pSubject);
                 	body.put("content",contentList);
                 	sgResponse = invokeurl
                 	[
                 		url :"https://api.sendgrid.com/v3/mail/send"
                 		type :POST
                 		parameters:body.toString()
                 		headers:{"Content-Type":"application/json"}
                 		connection:"sendgrid_connection"
                 	];
                 	info sgResponse;
                 }
				 void set_current_rate(int rateId)
                 {
                 	rate = Partner_Rates[ID == rateId];
                 	v_partner = rate.Partner_Link;
                 	v_loc = rate.Partner_Location_Link;
                 	v_cat = rate.Rate_Category;
                 	v_type = rate.Rate_Type;
                 	v_latestDate = null;
                 	v_latestRec = null;
                 	for each  r in Partner_Rates[Partner_Link == v_partner && Partner_Location_Link == v_loc && Rate_Category == v_cat && Rate_Type == v_type && Partner_Rate_Status == "Active"]
                 	{
                 		if(v_latestDate == null || r.Partner_Rates_Effective_Date >= v_latestDate)
                 		{
                 			v_latestDate = r.Partner_Rates_Effective_Date;
                 			v_latestRec = r.ID;
                 		}
                 	}
                 	for each  r in Partner_Rates[Partner_Link == v_partner && Partner_Location_Link == v_loc && Rate_Category == v_cat && Rate_Type == v_type]
                 	{
                 		if(r.ID == v_latestRec)
                 		{
                 			r.Current_Rate="Yes";
                 		}
                 		else
                 		{
                 			r.Current_Rate="No";
                 		}
                 	}
                 }
				 void set_partner_poc_name_title(int recId)
                 {
                 	rec = Referrals_Main[ID == recId];
                 	if(rec != null)
                 	{
                 		v_name = "";
                 		if(rec.Partner_POC_First_Name != null && rec.Partner_POC_First_Name.trim() != "")
                 		{
                 			v_name = rec.Partner_POC_First_Name.trim();
                 		}
                 		if(rec.Partner_POC_Last_Name != null && rec.Partner_POC_Last_Name.trim() != "")
                 		{
                 			if(v_name != "")
                 			{
                 				v_name = v_name + " ";
                 			}
                 			v_name = v_name + rec.Partner_POC_Last_Name.trim();
                 		}
                 		if(rec.Partner_POC_Title != null && rec.Partner_POC_Title.trim() != "")
                 		{
                 			if(v_name != "")
                 			{
                 				v_name = v_name + ", ";
                 			}
                 			v_name = v_name + rec.Partner_POC_Title.trim();
                 		}
                 		rec.Partner_POC_Name_Title=v_name;
                 	}
                 }
				 void set_patient_full_name(int recId)
                 {
                 	rec = Referrals_Main[ID == recId];
                 	if(rec != null)
                 	{
                 		v_last = rec.Patient_Last_Name;
                 		if(v_last == null)
                 		{
                 			v_last = "";
                 		}
                 		if(v_last.trim() != "")
                 		{
                 			v_full = "";
                 			if(rec.Patient_First_Name != null && rec.Patient_First_Name.trim() != "")
                 			{
                 				v_full = rec.Patient_First_Name.trim();
                 			}
                 			if(rec.Patient_MI != null && rec.Patient_MI.trim() != "")
                 			{
                 				if(v_full != "")
                 				{
                 					v_full = v_full + " ";
                 				}
                 				v_full = v_full + rec.Patient_MI.trim();
                 			}
                 			if(v_full != "")
                 			{
                 				v_full = v_full + " ";
                 			}
                 			v_full = v_full + v_last.trim();
                 			rec.Patient_Full_Name=v_full;
                 		}
                 	}
                 }
				 string set_pvs_equipment_charge(string p_pvsId, string p_amount, string p_details)
                 {
                 	v_target = null;
                 	for each  p in Encounter_PatientVisit[PVS_ID == p_pvsId]
                 	{
                 		v_target = p;
                 		break;
                 	}
                 	if(v_target == null)
                 	{
                 		return "No PVS found with PVS_ID " + p_pvsId + ".";
                 	}
                 	if(v_target.Invoice_Link != null)
                 	{
                 		return "PVS " + p_pvsId + " is attached to an invoice. Void that invoice first.";
                 	}
                 	v_amtTxt = p_amount;
                 	if(v_amtTxt == null)
                 	{
                 		v_amtTxt = "";
                 	}
                 	v_amtTxt = v_amtTxt.trim();
                 	if(v_amtTxt == "")
                 	{
                 		return "No amount supplied.";
                 	}
                 	v_amt = v_amtTxt.toDecimal();
                 	if(v_amt <= 0)
                 	{
                 		return "Amount must be greater than zero.";
                 	}
                 	v_det = p_details;
                 	if(v_det == null)
                 	{
                 		v_det = "";
                 	}
                 	v_det = v_det.trim();
                 	if(v_det == "")
                 	{
                 		update v_target
                 		[
                 			Equipment_Charge_Amount=v_amt
                 		];
                 	}
                 	else
                 	{
                 		update v_target
                 		[
                 			Equipment_Charge_Amount=v_amt
                 			Equipment_Charge_Details=v_det
                 		];
                 	}
                 	return "PVS " + p_pvsId + " equipment charge set to " + v_amt + ".";
                 }
				 string set_pvs_provider(string p_pvsId, string p_employeeEmail)
                 {
                 	v_target = null;
                 	for each  p in Encounter_PatientVisit[PVS_ID == p_pvsId]
                 	{
                 		v_target = p;
                 		break;
                 	}
                 	if(v_target == null)
                 	{
                 		return "No PVS found with PVS_ID " + p_pvsId + ".";
                 	}
                 	v_emp = null;
                 	for each  e in Employees[Employee_Email == p_employeeEmail]
                 	{
                 		v_emp = e;
                 		break;
                 	}
                 	if(v_emp == null)
                 	{
                 		return "No Employees record with email " + p_employeeEmail + ".";
                 	}
                 	v_first = ifnull(v_emp.Employee_First_Name,"");
                 	v_last = ifnull(v_emp.Employee_Last_Name,"");
                 	v_title = ifnull(v_emp.Employee_Title,"");
                 	v_init = ifnull(v_emp.Employee_Initials,"");
                 	v_fullname = (v_first + " " + v_last).trim();
                 	v_nametitle = v_fullname;
                 	if(v_title.trim() != "" && v_nametitle != "")
                 	{
                 		v_nametitle = v_nametitle + ", " + v_title.trim();
                 	}
                 	v_newId = ifnull(v_target.PVS_ID,"");
                 	v_idnote = "PVS_ID unchanged.";
                 	if(v_newId.endsWith("-") && v_init.trim() != "")
                 	{
                 		v_candidate = v_newId + v_init.trim();
                 		v_clash = false;
                 		for each  c in Encounter_PatientVisit[PVS_ID == v_candidate]
                 		{
                 			v_clash = true;
                 			break;
                 		}
                 		if(v_clash)
                 		{
                 			v_idnote = "PVS_ID not changed - " + v_candidate + " already exists.";
                 		}
                 		else
                 		{
                 			v_newId = v_candidate;
                 			v_idnote = "PVS_ID repaired to " + v_newId + ".";
                 		}
                 	}
                 	update v_target
                 	[
                 		Employee_First_Name=v_first
                 		Employee_Last_Name=v_last
                 		Employee_Title=v_title
                 		Employee_Initials=v_init
                 		Employee_Email=ifnull(v_emp.Employee_Email,"")
                 		Employee_Full_Name=v_fullname
                 		Employee_Name_Title=v_nametitle
                 		PVS_ID=v_newId
                 	];
                 	return "Provider set to " + v_nametitle + ". " + v_idnote;
                 }
				 void test_github_commit()
                 {
                 	repoOwner = "m1ndspark";
                 	repoName = "sos-emr";
                 	filePath = "schema/_connection_test.md";
                 	branch = "main";
                 	rawContent = "GitHub write path proven from Creator on " + zoho.currenttime + ".";
                 	encoded = zoho.encryption.base64Encode(rawContent);
                 	payload = Map();
                 	payload.put("message","test: prove Creator->GitHub commit path");
                 	payload.put("content",encoded);
                 	payload.put("branch",branch);
                 	getResp = invokeurl
                 	[
                 		url :"https://api.github.com/repos/" + repoOwner + "/" + repoName + "/contents/" + filePath + "?ref=" + branch
                 		type :GET
                 		connection:"sos_github_sync"
                 	];
                 	if(getResp.get("sha") != null)
                 	{
                 		payload.put("sha",getResp.get("sha"));
                 	}
                 	putResp = invokeurl
                 	[
                 		url :"https://api.github.com/repos/" + repoOwner + "/" + repoName + "/contents/" + filePath
                 		type :PUT
                 		parameters:payload.toString()
                 		connection:"sos_github_sync"
                 	];
                 	info putResp;
                 }
				 void test_schema_connection()
                 {
                 	response = invokeurl
                 	[
                 		url :"https://www.zohoapis.com/creator/v2.1/meta/sosmmc/sos-referrals-app/form/Partners/fields"
                 		type :GET
                 		connection:"sos_schema_monitor"
                 	];
                 	info response;
                 }
				 string test_smtp()
                 {
                 	sendmail
                 	[
                 		from :zoho.adminuserid
                 		to :"neil.heird@sosmmc.com"
                 		subject :"SOS SMTP test"
                 		message :"If you received this, Creator is routing through SendGrid."
                 	]
                 	return "Sent. Check SendGrid Activity Feed.";
                 }
				 string default.fn_diag_billed_visits(date p_start, date p_end)
                 {
                 	v_total = 0;
                 	v_billed = 0;
                 	v_unbilled = 0;
                 	v_held = 0;
                 	v_cancelled = 0;
                 	v_3008 = 0;
                 	v_visits = 0;
                 	m_partner_total = Map();
                 	m_partner_billed = Map();
                 	l_unbilled = List();
                 	for each  rec in Encounter_PatientVisit[Visit_Completion_Date >= p_start && Visit_Completion_Date <= p_end]
                 	{
                 		v_total = v_total + 1;
                 		v_partner = ifnull(rec.Partner_Organization,"").toString().trim();
                 		if(v_partner == "")
                 		{
                 			v_partner = "Unresolved";
                 		}
                 		m_partner_total.put(v_partner,ifnull(m_partner_total.get(v_partner),0) + 1);
                 		if(rec.Type_of_Entry == "3008")
                 		{
                 			v_3008 = v_3008 + 1;
                 		}
                 		else
                 		{
                 			v_visits = v_visits + 1;
                 		}
                 		if(rec.Complexity_Level == "Visit Cancelled")
                 		{
                 			v_cancelled = v_cancelled + 1;
                 		}
                 		if(rec.Hold_From_Invoicing == "Yes")
                 		{
                 			v_held = v_held + 1;
                 		}
                 		if(rec.Invoice_Link != null)
                 		{
                 			v_billed = v_billed + 1;
                 			m_partner_billed.put(v_partner,ifnull(m_partner_billed.get(v_partner),0) + 1);
                 		}
                 		else
                 		{
                 			v_unbilled = v_unbilled + 1;
                 			l_unbilled.add(ifnull(rec.PVS_ID,"NO-ID") + " | " + rec.Visit_Completion_Date.toString("MM-dd-yyyy") + " | " + v_partner + " | " + ifnull(rec.Type_of_Entry,"") + " | " + ifnull(rec.Invoice_Status,""));
                 		}
                 	}
                 	v_out = "BILLED VISIT DIAGNOSTIC";
                 	v_out = v_out + "\nWindow: " + p_start.toString("MM-dd-yyyy") + " to " + p_end.toString("MM-dd-yyyy");
                 	v_out = v_out + "\nBasis: Visit_Completion_Date";
                 	v_out = v_out + "\n";
                 	v_out = v_out + "\nTotal PVS rows in window: " + v_total;
                 	v_out = v_out + "\n  Patient Visit entries: " + v_visits;
                 	v_out = v_out + "\n  3008 entries: " + v_3008;
                 	v_out = v_out + "\n";
                 	v_out = v_out + "\nAttached to an invoice: " + v_billed;
                 	v_out = v_out + "\nNot attached to an invoice: " + v_unbilled;
                 	v_out = v_out + "\n  of which held from invoicing: " + v_held;
                 	v_out = v_out + "\n  of which Visit Cancelled: " + v_cancelled;
                 	v_out = v_out + "\n";
                 	v_out = v_out + "\nBY PARTNER  (billed / total)";
                 	for each  k in m_partner_total.keys()
                 	{
                 		v_out = v_out + "\n  " + k + ": " + ifnull(m_partner_billed.get(k),0) + " / " + m_partner_total.get(k);
                 	}
                 	v_out = v_out + "\n";
                 	v_out = v_out + "\nUNBILLED DETAIL  (PVS ID | Date | Partner | Entry Type | Invoice Status)";
                 	if(l_unbilled.size() == 0)
                 	{
                 		v_out = v_out + "\n  none";
                 	}
                 	else
                 	{
                 		for each  ln in l_unbilled
                 		{
                 			v_out = v_out + "\n  " + ln;
                 		}
                 	}
                 	info v_out;
                 	return v_out;
                 }
			 }
		 }


		workflow
