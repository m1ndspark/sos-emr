			Complexity_Sets_Charge as "Complexity Sets Charge"
			{
				type =  form
				form = Encounter_PatientVisit

				record event = on add or edit

				on user input of Complexity_Level
				{
					actions 
					{
						custom deluge script
						(
											if(input.Complexity_Level == null || input.Complexity_Level == "")
										{
											input.Complexity_Charge = 0;
											return;
										}
										if(input.Billing_Branch == null)
										{
											input.Complexity_Charge = 0;
											return;
										}
										v_found = false;
										for each  v_r in Partner_Rates[Partner_Location_Link == input.Billing_Branch && Rate_Type == input.Complexity_Level && Current_Rate == "Yes"]
										{
											input.Complexity_Charge = v_r.Rate_Amount;
											v_found = true;
											break;
										}
										if(!v_found)
										{
											input.Complexity_Charge = 0;
											v_label = "";
											for each  v_l in Partner_Locations[ID == input.Billing_Branch]
											{
												v_label = ifnull(v_l.Partner_Location_Label,"");
												break;
											}
											alert "No current rate for " + v_label + " / " + input.Complexity_Level + ". The charge has been set to 0. Add the rate in Partner Rates before invoicing this visit.";
										}
						)
					}
				}

			}
