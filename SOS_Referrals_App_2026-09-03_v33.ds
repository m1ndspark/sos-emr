				 string diag_esi_references()
                 {
                 	v_id = null;
                 	v_lab = "";
                 	for each  l in Partner_Locations[ID != 0]
                 	{
                 		v_x = l.Partner_Location_Label;
                 		if(v_x == null)
                 		{
                 			v_x = "";
                 		}
                 		if(v_x.trim() == "Empath - ESI")
                 		{
                 			v_id = l.ID;
                 			v_lab = v_x;
                 			break;
                 		}
                 	}
                 	if(v_id == null)
                 	{
                 		return "No Partner_Locations record with label Empath - ESI.";
                 	}
                 	v_ref = 0;
                 	for each  r in Referrals_Main[Partner_Branch_Link == v_id]
                 	{
                 		v_ref = v_ref + 1;
                 	}
                 	v_pvs = 0;
                 	for each  p in Encounter_PatientVisit[Billing_Branch == v_id]
                 	{
                 		v_pvs = v_pvs + 1;
                 	}
                 	v_inv = 0;
                 	for each  i in Invoices[Partner_Location_Link == v_id]
                 	{
                 		v_inv = v_inv + 1;
                 	}
                 	v_rate = 0;
                 	for each  q in Partner_Rates[Partner_Location_Link == v_id]
                 	{
                 		v_rate = v_rate + 1;
                 	}
                 	v_bill = 0;
                 	for each  b in Partner_Billing_Contacts[Partner_Location_Link == v_id]
                 	{
                 		v_bill = v_bill + 1;
                 	}
                 	return "Empath - ESI (ID " + v_id + ") references -- Referrals: " + v_ref + " | PVS: " + v_pvs + " | Invoices: " + v_inv + " | Partner_Rates: " + v_rate + " | Billing contacts: " + v_bill;
                 }
				 string diag_form_fields(string p_formLink)
                 {
                 	ownerName = "sosmmc";
                 	appName = "sos-referrals-app";
                 	baseUrl = "https://www.zohoapis.com/creator/v2.1/meta/" + ownerName + "/" + appName;
                 	typeMap = Map();
                 	typeMap.put("1","Single Line");
                 	typeMap.put("2","Multi Line");
                 	typeMap.put("3","Email");
                 	typeMap.put("5","Number");
                 	typeMap.put("6","Decimal");
                 	typeMap.put("8","Currency");
                 	typeMap.put("9","Auto Number");
                 	typeMap.put("10","Date");
                 	typeMap.put("11","Date-Time");
                 	typeMap.put("12","Dropdown/Lookup");
                 	typeMap.put("13","Radio");
                 	typeMap.put("14","Multi Select");
                 	typeMap.put("15","Checkbox");
                 	typeMap.put("16","Decision Box");
                 	typeMap.put("19","File Upload");
                 	typeMap.put("20","Formula");
                 	typeMap.put("21","Subform");
                 	typeMap.put("27","Phone");
                 	typeMap.put("29","Name");
                 	typeMap.put("30","Address");
                 	outLines = List();
                 	if(p_formLink == null || p_formLink.trim() == "")
                 	{
                 		formsResp = invokeurl
                 		[
                 			url :baseUrl + "/forms"
                 			type :GET
                 			connection:"sos_schema_monitor"
                 		];
                 		if(formsResp.get("code") != 3000)
                 		{
                 			return "ERROR: Get Forms failed. Response: " + formsResp.toString();
                 		}
                 		outLines.add("FORMS IN " + appName);
                 		outLines.add("");
                 		outLines.add("| Link Name | Display Name |");
                 		outLines.add("|---|---|");
                 		formCount = 0;
                 		for each  frm in formsResp.get("forms")
                 		{
                 			outLines.add("| " + frm.get("link_name") + " | " + frm.get("display_name") + " |");
                 			formCount = formCount + 1;
                 		}
                 		outLines.add("");
                 		outLines.add("Total forms: " + formCount);
                 		return outLines.toString("\n");
                 	}
                 	fieldsResp = invokeurl
                 	[
                 		url :baseUrl + "/form/" + p_formLink + "/fields"
                 		type :GET
                 		connection:"sos_schema_monitor"
                 	];
                 	if(fieldsResp.get("code") != 3000)
                 	{
                 		return "ERROR: Get Fields failed for form " + p_formLink + ". Response: " + fieldsResp.toString();
                 	}
                 	outLines.add("FIELD DUMP - " + p_formLink);
                 	outLines.add("Generated: " + zoho.currentdate.toString("yyyy-MM-dd HH:mm"));
                 	outLines.add("");
                 	outLines.add("| # | Link Name | Display Name | Type | Mandatory | Unique | Detail |");
                 	outLines.add("|---|---|---|---|---|---|---|");
                 	rowNum = 0;
                 	for each  fld in fieldsResp.get("fields")
                 	{
                 		fLink = fld.get("link_name");
                 		if(fLink != null)
                 		{
                 			rowNum = rowNum + 1;
                 			tcStr = fld.get("type").toLong().toString();
                 			tName = typeMap.get(tcStr);
                 			if(tName == null)
                 			{
                 				typeLabel = "Type " + tcStr;
                 			}
                 			else
                 			{
                 				typeLabel = tName + " (" + tcStr + ")";
                 			}
                 			dName = fld.get("display_name");
                 			if(dName == null)
                 			{
                 				dName = "";
                 			}
                 			mandStr = "no";
                 			if(fld.get("mandatory") == true)
                 			{
                 				mandStr = "YES";
                 			}
                 			uniqStr = "no";
                 			if(fld.get("unique") == true)
                 			{
                 				uniqStr = "YES";
                 			}
                 			detail = "";
                 			if(fld.get("choices") != null)
                 			{
                 				chList = List();
                 				for each  ch in fld.get("choices")
                 				{
                 					chList.add(ch.get("value"));
                 				}
                 				detail = "choices: " + chList.toString(", ");
                 			}
                 			else if(fld.get("subfields") != null)
                 			{
                 				sfList = List();
                 				for each  sf in fld.get("subfields")
                 				{
                 					sfName = sf.get("link_name");
                 					if(sf.get("is_hidden") == true)
                 					{
                 						sfName = sfName + " (hidden)";
                 					}
                 					sfList.add(sfName);
                 				}
                 				detail = "subfields: " + sfList.toString(", ");
                 			}
                 			else if(fld.get("max_char") != null)
                 			{
                 				detail = "max " + fld.get("max_char");
                 			}
                 			outLines.add("| " + rowNum + " | " + fLink + " | " + dName + " | " + typeLabel + " | " + mandStr + " | " + uniqStr + " | " + detail + " |");
                 		}
                 	}
                 	outLines.add("");
                 	outLines.add("Total fields: " + rowNum);
                 	return outLines.toString("\n");
                 }
				 string diag_innovage_rates()
                 {
                 	v_out = "";
                 	for each  l in Partner_Locations[ID != 0]
                 	{
                 		v_lab = l.Partner_Location_Label;
                 		if(v_lab == null)
                 		{
                 			v_lab = "";
                 		}
                 		v_par = "";
                 		for each  p in Partners[ID == l.Partner_Link]
                 		{
                 			v_par = p.Partner_Display_Name;
                 			break;
                 		}
                 		if(v_par.toLowerCase().contains("innovage"))
                 		{
                 			v_out = v_out + "\n== " + v_par + " / label [" + v_lab + "] name [" + l.Partner_Location_Name + "] code [" + l.Partner_Location_Code + "] status [" + l.Partner_Location_Status + "] books [" + l.Books_Customer_ID + "]";
                 			v_n = 0;
                 			for each  r in Partner_Rates[Partner_Location_Link == l.ID]
                 			{
                 				v_n = v_n + 1;
                 				v_out = v_out + "\n   [" + r.Rate_Type + "] amt=" + r.Rate_Amount + " current=[" + r.Current_Rate + "] cat=[" + r.Rate_Category + "] status=[" + r.Partner_Rate_Status + "]";
                 			}
                 			if(v_n == 0)
                 			{
                 				v_out = v_out + "\n   (no rate records)";
                 			}
                 		}
                 	}
                 	return v_out;
                 }
				 string diag_invoice_batch(int p_batchId)
                 {
                 	v_b = Invoice_Batch[ID == p_batchId];
                 	if(v_b.ID == null)
                 	{
                 		return "ERROR: Batch record not found.";
                 	}
                 	v_allPvs = 0;
                 	v_onBranch = 0;
                 	v_draft = 0;
                 	v_nullStatus = 0;
                 	v_noInvoice = 0;
                 	v_inRange = 0;
                 	v_notHeld = 0;
                 	v_noBranch = 0;
                 	v_noDate = 0;
                 	v_recs = Encounter_PatientVisit[ID != 0];
                 	for each  v_r in v_recs
                 	{
                 		v_allPvs = v_allPvs + 1;
                 		if(v_r.Billing_Branch == null)
                 		{
                 			v_noBranch = v_noBranch + 1;
                 		}
                 		if(v_r.Visit_Completion_Date == null)
                 		{
                 			v_noDate = v_noDate + 1;
                 		}
                 		if(v_r.Invoice_Status == null || v_r.Invoice_Status == "")
                 		{
                 			v_nullStatus = v_nullStatus + 1;
                 		}
                 		if(v_r.Billing_Branch == v_b.Partner_Location_Link)
                 		{
                 			v_onBranch = v_onBranch + 1;
                 			if(v_r.Invoice_Status == "Draft")
                 			{
                 				v_draft = v_draft + 1;
                 			}
                 			if(v_r.Invoice_Link == null)
                 			{
                 				v_noInvoice = v_noInvoice + 1;
                 			}
                 			if(v_r.Visit_Completion_Date != null && v_r.Visit_Completion_Date >= v_b.Date_From && v_r.Visit_Completion_Date <= v_b.Date_To)
                 			{
                 				v_inRange = v_inRange + 1;
                 			}
                 			if(v_r.Hold_From_Invoicing != "Yes")
                 			{
                 				v_notHeld = v_notHeld + 1;
                 			}
                 		}
                 	}
                 	v_out = "Batch branch ID: " + v_b.Partner_Location_Link + " | Range: " + v_b.Date_From + " to " + v_b.Date_To;
                 	v_out = v_out + "\nTotal PVS: " + v_allPvs;
                 	v_out = v_out + "\nPVS with no Billing Branch: " + v_noBranch;
                 	v_out = v_out + "\nPVS with no Visit Completion Date: " + v_noDate;
                 	v_out = v_out + "\nPVS with blank Invoice Status: " + v_nullStatus;
                 	v_out = v_out + "\nOn this branch: " + v_onBranch;
                 	v_out = v_out + "\n  of those, Invoice Status = Draft: " + v_draft;
                 	v_out = v_out + "\n  of those, no Invoice Link: " + v_noInvoice;
                 	v_out = v_out + "\n  of those, in date range: " + v_inRange;
                 	v_out = v_out + "\n  of those, not held: " + v_notHeld;
                 	return v_out;
                 }
				 string diag_partner_rates()
                 {
                 	v_need = List();
                 	v_need.add("High Complexity");
                 	v_need.add("Moderate Complexity");
                 	v_need.add("Low Complexity");
                 	v_need.add("Hospital at Home");
                 	v_need.add("Telemedicine");
                 	v_need.add("Care Coordination");
                 	v_need.add("General Consultation");
                 	v_need.add("Cares 3008 Assessment");
                 	v_out = "";
                 	v_totalRates = 0;
                 	v_locsOk = 0;
                 	v_locsShort = 0;
                 	for each  v_l in Partner_Locations[Partner_Location_Status == "Active"]
                 	{
                 		v_have = List();
                 		v_low = List();
                 		for each  v_r in Partner_Rates[Partner_Location_Link == v_l.ID && Current_Rate == "Yes"]
                 		{
                 			v_totalRates = v_totalRates + 1;
                 			v_have.add(v_r.Rate_Type);
                 			v_amt = 0.0;
                 			if(v_r.Rate_Amount != null)
                 			{
                 				v_amt = v_r.Rate_Amount.toDecimal();
                 			}
                 			if(v_amt <= 1)
                 			{
                 				v_low.add(v_r.Rate_Type + "=" + v_amt);
                 			}
                 		}
                 		v_missing = List();
                 		for each  v_n in v_need
                 		{
                 			if(!v_have.contains(v_n))
                 			{
                 				v_missing.add(v_n);
                 			}
                 		}
                 		v_books = "no BooksID";
                 		if(v_l.Books_Customer_ID != null && v_l.Books_Customer_ID.trim() != "")
                 		{
                 			v_books = "BooksID ok";
                 		}
                 		if(v_missing.size() == 0 && v_low.size() == 0)
                 		{
                 			v_locsOk = v_locsOk + 1;
                 			v_out = v_out + "\nOK   " + v_l.Partner_Location_Label + " (" + v_have.size() + " rates, " + v_books + ")";
                 		}
                 		else
                 		{
                 			v_locsShort = v_locsShort + 1;
                 			v_out = v_out + "\nSHORT " + v_l.Partner_Location_Label + " (" + v_have.size() + " rates, " + v_books + ")";
                 			if(v_missing.size() > 0)
                 			{
                 				v_out = v_out + "\n      missing: " + v_missing.toString(", ");
                 			}
                 			if(v_low.size() > 0)
                 			{
                 				v_out = v_out + "\n      suspect amounts: " + v_low.toString(", ");
                 			}
                 		}
                 	}
                 	return "Active branches OK: " + v_locsOk + " | short: " + v_locsShort + " | total current rates: " + v_totalRates + "\n" + v_out;
                 }
				 string diag_patient_visits(string pName)
                 {
                 	v_Key = pName.trim().toLowerCase();
                 	v_Lines = List();
                 	for each  p in Encounter_PatientVisit[ID != 0]
                 	{
                 		v_Nm = ifnull(p.Patient_Full_Name_1,"").toString().trim().toLowerCase();
                 		if(v_Nm != "" && v_Nm.contains(v_Key))
                 		{
                 			v_Dos = "no DOS";
                 			if(p.Visit_Completion_Date != null)
                 			{
                 				v_Dos = p.Visit_Completion_Date.toString("yyyy-MM-dd");
                 			}
                 			v_Branch = "no branch";
                 			if(p.Billing_Branch != null)
                 			{
                 				for each  l in Partner_Locations[ID == p.Billing_Branch]
                 				{
                 					v_Branch = ifnull(l.Partner_Location_Label,l.Partner_Location_Name);
                 					break;
                 				}
                 			}
                 			v_Inv = "not invoiced";
                 			if(p.Invoice_Link != null)
                 			{
                 				for each  i in Invoices[ID == p.Invoice_Link]
                 				{
                 					v_Inv = ifnull(i.Books_Invoice_Number,"no Books number") + "/" + ifnull(i.Invoice_Record_Status,"?");
                 					break;
                 				}
                 			}
                 			v_Amt = 0.0;
                 			if(p.Complexity_Charge != null)
                 			{
                 				v_Amt = p.Complexity_Charge.toDecimal();
                 			}
                 			v_Lines.add(ifnull(p.PVS_ID,"no PVS ID") + " | DOS " + v_Dos + " | " + ifnull(p.Complexity_Level,"NO LEVEL") + " $" + v_Amt + " | status " + ifnull(p.Invoice_Status,"null") + " | hold " + ifnull(p.Hold_From_Invoicing,"null") + " | " + v_Branch + " | " + v_Inv);
                 		}
                 	}
                 	if(v_Lines.size() == 0)
                 	{
                 		return "No PVS records matched that name.";
                 	}
                 	return v_Lines.size() + " record(s): " + v_Lines.toString(" || ");
                 }
				 string diag_premium_visit_invoices()
                 {
                 	v_ids = List();
                 	v_ids.add("PVS-1034-AS");
                 	v_ids.add("PVS-1049-JK");
                 	v_ids.add("PVS-1056-AS");
                 	v_ids.add("PVS-1058-AS");
                 	v_ids.add("PVS-1081-JK");
                 	v_log = List();
                 	for each  v_pid in v_ids
                 	{
                 		for each  p in Encounter_PatientVisit[PVS_ID == v_pid]
                 		{
                 			v_line = v_pid + ": Invoice_Status=" + ifnull(p.Invoice_Status,"null");
                 			if(p.Invoice_Link == null)
                 			{
                 				v_line = v_line + ", no Invoice_Link";
                 			}
                 			else
                 			{
                 				for each  i in Invoices[ID == p.Invoice_Link]
                 				{
                 					v_line = v_line + ", linked to " + ifnull(i.Books_Invoice_Number,"no Books number") + " (record status " + ifnull(i.Invoice_Record_Status,"null") + ")";
                 					break;
                 				}
                 			}
                 			v_log.add(v_line);
                 			break;
                 		}
                 	}
                 	return v_log.toString(" | ");
                 }
				 string diag_pvs_field_values(string p_pvsId)
                 {
                 	v_t = null;
                 	for each  p in Encounter_PatientVisit[PVS_ID == p_pvsId]
                 	{
                 		v_t = p;
                 		break;
                 	}
                 	if(v_t == null)
                 	{
                 		return "No PVS found with PVS_ID " + p_pvsId + ".";
                 	}
                 	v_out = "PVS " + p_pvsId + "\n";
                 	v_p1 = ifnull(v_t.Patient_Phone,"");
                 	v_p2 = ifnull(v_t.Facility_Phone,"");
                 	v_p3 = ifnull(v_t.Partner_POC_Phone,"");
                 	v_d1 = v_p1.replaceAll("[^0-9]","");
                 	v_d2 = v_p2.replaceAll("[^0-9]","");
                 	v_d3 = v_p3.replaceAll("[^0-9]","");
                 	v_out = v_out + "Patient_Phone [" + v_p1 + "] digits=" + v_d1.length() + "\n";
                 	v_out = v_out + "Facility_Phone [" + v_p2 + "] digits=" + v_d2.length() + "\n";
                 	v_out = v_out + "Partner_POC_Phone [" + v_p3 + "] digits=" + v_d3.length() + "\n";
                 	v_out = v_out + "Patient_Email [" + ifnull(v_t.Patient_Email,"") + "]\n";
                 	v_out = v_out + "Partner_POC_Email [" + ifnull(v_t.Partner_POC_Email,"") + "]\n";
                 	v_ssn = ifnull(v_t.Patient_SSN,"");
                 	v_out = v_out + "Patient_SSN [" + v_ssn + "] len=" + v_ssn.length() + " (max 12)\n";
                 	v_out = v_out + "Patient_Hospice_ID [" + ifnull(v_t.Patient_Hospice_ID,"") + "]\n";
                 	v_out = v_out + "Type_of_Procedures [" + ifnull(v_t.Type_of_Procedures,"").toString() + "]\n";
                 	v_out = v_out + "Additional_Charges [" + ifnull(v_t.Additional_Charges,"").toString() + "]\n";
                 	v_out = v_out + "Complexity_Level [" + ifnull(v_t.Complexity_Level,"") + "]\n";
                 	v_out = v_out + "Clinical_Note_Type [" + ifnull(v_t.Clinical_Note_Type,"") + "]\n";
                 	v_out = v_out + "Invoice_Status [" + ifnull(v_t.Invoice_Status,"") + "]\n";
                 	v_out = v_out + "Employee_Title [" + ifnull(v_t.Employee_Title,"") + "]\n";
                 	v_out = v_out + "Partner_POC_Title [" + ifnull(v_t.Partner_POC_Title,"") + "]\n";
                 	v_out = v_out + "Facility_Room_Number [" + ifnull(v_t.Facility_Room_Number,"") + "]\n";
                 	v_out = v_out + "Patient_Zip [" + ifnull(v_t.Patient_Address.postal_Code,"") + "]\n";
                 	v_out = v_out + "Patient_State [" + ifnull(v_t.Patient_Address.state_province,"") + "]\n";
                 	return v_out;
                 }
