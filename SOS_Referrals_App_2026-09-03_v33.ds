				 string diag_pvs_premium_mismatches()
                 {
                 	v_ok = 0;
                 	v_bad = 0;
                 	v_norate = 0;
                 	v_skipped = 0;
                 	v_log = List();
                 	for each  p in Encounter_PatientVisit[Additional_Charges != null]
                 	{
                 		v_add = p.Additional_Charges;
                 		if(v_add == null)
                 		{
                 			v_add = "";
                 		}
                 		v_add = v_add.toString();
                 		if(!v_add.contains("After Hours") && !v_add.contains("Super STAT"))
                 		{
                 			v_skipped = v_skipped + 1;
                 			continue;
                 		}
                 		if(p.Billing_Branch == null)
                 		{
                 			v_skipped = v_skipped + 1;
                 			continue;
                 		}
                 		v_label = "";
                 		for each  l in Partner_Locations[ID == p.Billing_Branch]
                 		{
                 			v_label = l.Partner_Location_Label;
                 			break;
                 		}
                 		v_inv = "not invoiced";
                 		if(p.Invoice_Link != null)
                 		{
                 			v_inv = "INVOICED";
                 		}
                 		if(v_add.contains("After Hours"))
                 		{
                 			v_card = null;
                 			for each  r in Partner_Rates[Partner_Location_Link == p.Billing_Branch && Rate_Type == "After Hours" && Current_Rate == "Yes"]
                 			{
                 				v_card = r.Rate_Amount;
                 				break;
                 			}
                 			v_stored = 0.0;
                 			if(p.After_Hours_Fee != null)
                 			{
                 				v_stored = p.After_Hours_Fee.toDecimal();
                 			}
                 			if(v_card == null)
                 			{
                 				v_norate = v_norate + 1;
                 				v_log.add(p.PVS_ID + " " + v_label + " After Hours: stored " + v_stored + ", NO CURRENT RATE, " + v_inv);
                 			}
                 			else if(v_stored != v_card.toDecimal())
                 			{
                 				v_bad = v_bad + 1;
                 				v_log.add(p.PVS_ID + " " + v_label + " After Hours: stored " + v_stored + ", card " + v_card + ", " + v_inv);
                 			}
                 			else
                 			{
                 				v_ok = v_ok + 1;
                 			}
                 		}
                 		if(v_add.contains("Super STAT"))
                 		{
                 			v_card = null;
                 			for each  r in Partner_Rates[Partner_Location_Link == p.Billing_Branch && Rate_Type == "Super STAT" && Current_Rate == "Yes"]
                 			{
                 				v_card = r.Rate_Amount;
                 				break;
                 			}
                 			v_stored = 0.0;
                 			if(p.Super_Stat_Fee != null)
                 			{
                 				v_stored = p.Super_Stat_Fee.toDecimal();
                 			}
                 			if(v_card == null)
                 			{
                 				v_norate = v_norate + 1;
                 				v_log.add(p.PVS_ID + " " + v_label + " Super STAT: stored " + v_stored + ", NO CURRENT RATE, " + v_inv);
                 			}
                 			else if(v_stored != v_card.toDecimal())
                 			{
                 				v_bad = v_bad + 1;
                 				v_log.add(p.PVS_ID + " " + v_label + " Super STAT: stored " + v_stored + ", card " + v_card + ", " + v_inv);
                 			}
                 			else
                 			{
                 				v_ok = v_ok + 1;
                 			}
                 		}
                 	}
                 	v_out = "Mismatches: " + v_bad + ". Correct: " + v_ok + ". No current rate: " + v_norate + ". Not premium-eligible: " + v_skipped + ".";
                 	if(v_log.size() > 0)
                 	{
                 		v_out = v_out + " Detail: " + v_log.toString(" | ");
                 	}
                 	return v_out;
                 }
				 string diag_referral_contact_match()
                 {
                 	v_totalC = 0;
                 	v_cWithLoc = 0;
                 	for each  c in Partner_Referral_Contacts[ID != 0]
                 	{
                 		v_totalC = v_totalC + 1;
                 		if(c.Partner_Locations_Link != null)
                 		{
                 			v_cWithLoc = v_cWithLoc + 1;
                 		}
                 	}
                 	v_noEmail = 0;
                 	v_noContact = 0;
                 	v_noLoc = 0;
                 	v_ok = 0;
                 	v_sample = List();
                 	for each  r in Referrals_Main[Partner_Branch_Link == null]
                 	{
                 		v_email = r.Partner_POC_Email;
                 		if(v_email == null || v_email.trim() == "")
                 		{
                 			v_noEmail = v_noEmail + 1;
                 			continue;
                 		}
                 		v_c = Partner_Referral_Contacts[Partner_POC_Email == v_email];
                 		if(v_c.ID == null)
                 		{
                 			v_noContact = v_noContact + 1;
                 			if(v_sample.size() < 10)
                 			{
                 				v_sample.add(v_email);
                 			}
                 		}
                 		else if(v_c.Partner_Locations_Link == null)
                 		{
                 			v_noLoc = v_noLoc + 1;
                 			if(v_sample.size() < 10)
                 			{
                 				v_sample.add(v_email + " [contact, no loc]");
                 			}
                 		}
                 		else
                 		{
                 			v_ok = v_ok + 1;
                 		}
                 	}
                 	return "Contacts: " + v_totalC + " | with location link: " + v_cWithLoc + "\nNo email: " + v_noEmail + " | No contact record: " + v_noContact + " | Contact but no location: " + v_noLoc + " | Would match: " + v_ok + "\nSamples: " + v_sample.toString(", ");
                 }
