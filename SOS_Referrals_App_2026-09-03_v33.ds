										{
											v_addr = input.Patient_Address.address_line_1.trim();
										}
										if(input.Patient_Address.address_line_2 != null && Patient_Address.address_line_2.trim() != "")
										{
											v_addr = v_addr + ", " + input.Patient_Address.address_line_2.trim();
										}
										if(input.Patient_Address.district_city != null && Patient_Address.district_city.trim() != "")
										{
											v_addr = v_addr + ", " + input.Patient_Address.district_city.trim();
										}
										if(input.Patient_Address.state_province != null && Patient_Address.state_province.trim() != "")
										{
											v_addr = v_addr + ", " + input.Patient_Address.state_province.trim();
										}
										if(input.Patient_Address.postal_Code != null && Patient_Address.postal_Code.trim() != "")
										{
											v_addr = v_addr + " " + input.Patient_Address.postal_Code.trim();
										}
										input.Patient_Full_Address = v_addr.trim();
						)
					}
				}

			}
