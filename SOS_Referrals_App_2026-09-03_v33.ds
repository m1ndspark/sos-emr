										hide Partner_POC_First_Name;
										hide Partner_POC_Last_Name;
										hide Partner_POC_Title;
										hide Equipment_Charge_Amount;
										hide Equipment_Charge_Details;
										hide Other_Charges_Amount;
										hide Other_Charges_Details;
										hide Facility_Name;
										hide Facility_Phone;
										hide Facility_Room_Number;
										hide Employee_First_Name;
										hide Employee_Last_Name;
										hide Employee_Title;
										hide Employee_Full_Name;
										show Employee_Name_Title;
										hide Invoice_Status;
										hide Billing_Branch;
										hide Patient_Full_Address;
										if(input.Has_Referral_ID == "No")
										{
											disable Type_of_Entry;
											show Billing_Branch;
											enable Billing_Branch;
										}
										if(input.Has_Referral_ID == "Yes")
										{
											disable Patient_First_Name;
											disable Patient_MI;
											disable Patient_Last_Name;
											disable Patient_DOB;
											disable Patient_Gender;
											disable Patient_Address;
											disable Partner_ICD_Codes;
											disable Reason_for_Referral;
											disable Goals_of_Care;
											disable List_Patient_Allergies;
											disable List_Patient_Anticoagulants;
											disable Advanced_Directives_Details;
											disable Additional_Information;
											show Billing_Branch;
											disable Billing_Branch;
										}
										else
										{
											enable Patient_First_Name;
											enable Patient_MI;
											enable Patient_Last_Name;
											enable Patient_DOB;
											enable Patient_Gender;
											enable Patient_Address;
											enable Patient_Phone;
											enable Patient_Email;
											enable Patient_Hospice_ID;
											enable Patient_SSN;
											enable Facility_Name;
											enable Facility_Phone;
											enable Facility_Room_Number;
											enable Partner_ICD_Codes;
											enable Reason_for_Referral;
											enable Goals_of_Care;
											enable List_Patient_Allergies;
											enable List_Patient_Anticoagulants;
											enable Advanced_Directives_Details;
											enable Additional_Information;
										}
										disable Employee_First_Name;
										disable Employee_Last_Name;
										disable Employee_Initials;
										disable Employee_Title;
										disable Employee_Full_Name;
										disable Employee_Name_Title;
										disable Employee_Email;
										disable PVS_ID;
										disable Referral_ID;
										disable Referral_ID_Stamp;
										disable Partner_ID;
										disable Partner_ID_Stamp;
										disable Invoice_Status;
										disable PVS_Referral_ID;
										disable Provider_ICD_Print;
										if(input.Type_of_Entry == "Patient Visit")
										{
											show Referral_Details_Section;
											show Final_Clinical_Note_Section;
											show Type_of_Procedure_Section;
											show Visit_Cost_Drivers_Section;
											if(v_Billing)
											{
												show Charges_Section;
											}
											show Diversion_Tracking_Section;
											show Files_Upload_Section;
										}
										else if(input.Type_of_Entry == "3008")
										{
											show Cares_3008_Completion_Section;
										}
										else if(input.Type_of_Entry == "Lab Order")
										{
											show Lab_Orders_Section;
											show Diversion_Tracking_Section;
										}
										else if(input.Type_of_Entry == "Imaging Order")
										{
											show Imaging_Orders_Section;
											show Diversion_Tracking_Section;
										}
										else if(input.Type_of_Entry == "Clinic Hours")
										{
											show Diversion_Tracking_Section;
										}
										if(input.Patient_Location == "Facility")
										{
											show Facility_Name;
											show Facility_Phone;
											show Facility_Room_Number;
										}
										if(input.Diversion_Tracking == "Yes")
										{
											show Type_of_Diversion;
										}
										if(v_Billing && input.Additional_Charges != null)
										{
											if(input.Additional_Charges.contains("Equipment Charge"))
											{
												show Equipment_Charge_Amount;
												show Equipment_Charge_Details;
											}
											if(input.Additional_Charges.contains("Other"))
											{
												show Other_Charges_Amount;
												show Other_Charges_Details;
											}
										}
						)
					}
				}

			}
