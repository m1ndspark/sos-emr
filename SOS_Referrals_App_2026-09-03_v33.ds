				 string fix_accentcare_current_rate()
                 {
                 	v_fixed = 0;
                 	for each  v_r in Partner_Rates[Current_Rate != "Yes"]
                 	{
                 		v_l = Partner_Locations[ID == v_r.Partner_Location_Link];
                 		if(v_l.ID != null && v_l.Partner_Location_Code != "BRO" && v_r.Partner_Rates_Effective_Date == null)
                 		{
                 			v_p = Partners[ID == v_l.Partner_Link];
                 			if(v_p.ID != null && v_p.Partner_Code == "ACC")
                 			{
                 				v_r.Current_Rate="Yes";
                 				v_r.Partner_Rate_Status="Active";
                 				v_fixed = v_fixed + 1;
                 			}
                 		}
                 	}
                 	return "Set Current_Rate=Yes and Status=Active on " + v_fixed + " AccentCare rates.";
                 }
				 map get_partner_referral_contact(string pPocEmail)
                 {
                 	v_Email = pPocEmail.trim();
                 	v_Lower = v_Email.toLowerCase();
                 	v_MsgFail = "We couldn't find " + v_Email + " in our records. Double-check it for typos and search again. If you're new here, leave your email as entered, complete the remaining fields, and we'll save everything for next time.";
                 	v_MsgOk = "Welcome back! We found the details for " + v_Email + " and filled them in on the next page. Click the NEXT button below to continue.";
                 	response = Map();
                 	response.put("Lookup_Status","NOT_FOUND");
                 	response.put("Lookup_Message",v_MsgFail);
                 	response.put("Partner_POC_First_Name","");
                 	response.put("Partner_POC_Last_Name","");
                 	response.put("Partner_POC_Title","");
                 	response.put("Partner_POC_Phone","");
                 	response.put("Partner_Organization","");
                 	response.put("Partner_Branch","");
                 	response.put("Partner_POC_Team","");
                 	v_MatchId = 0;
                 	for each  v_Rec in Partner_Referral_Contacts[Partner_POC_Email == v_Email]
                 	{
                 		v_MatchId = v_Rec.ID;
                 		break;
                 	}
                 	if(v_MatchId == 0)
                 	{
                 		for each  v_C in Partner_Referral_Contacts[ID != null]
                 		{
                 			if(v_C.Partner_POC_Email != null && v_C.Partner_POC_Email.toString().trim().toLowerCase() == v_Lower)
                 			{
                 				v_MatchId = v_C.ID;
                 				break;
                 			}
                 		}
                 	}
                 	if(v_MatchId != 0)
                 	{
                 		v_Con = Partner_Referral_Contacts[ID == v_MatchId];
                 		v_Branch = "";
                 		v_Org = "";
                 		if(v_Con.Partner_Locations_Link != null)
                 		{
                 			v_Branch = ifnull(v_Con.Partner_Locations_Link.Partner_Location_Name,"");
                 		}
                 		if(v_Branch == "")
                 		{
                 			v_Branch = ifnull(v_Con.Partner_Branch,"");
                 		}
                 		if(v_Con.Partner_Link != null)
                 		{
                 			v_Org = ifnull(v_Con.Partner_Link.Partner_Display_Name,"");
                 		}
                 		if(v_Org == "")
                 		{
                 			v_Org = ifnull(v_Con.Partner_Organization,"");
                 		}
                 		v_Phone = ifnull(v_Con.Partner_POC_Phone,"").toString().replaceAll("[^0-9]","");
                 		if(v_Phone.length() == 11 && v_Phone.startsWith("1"))
                 		{
                 			v_Phone = v_Phone.subString(1,11);
                 		}
                 		response.put("Lookup_Status","FOUND");
                 		response.put("Lookup_Message",v_MsgOk);
                 		response.put("Partner_POC_First_Name",ifnull(v_Con.Partner_POC_First_Name,""));
                 		response.put("Partner_POC_Last_Name",ifnull(v_Con.Partner_POC_Last_Name,""));
                 		response.put("Partner_POC_Title",ifnull(v_Con.Partner_POC_Title,""));
                 		response.put("Partner_POC_Phone",v_Phone);
                 		response.put("Partner_Organization",v_Org);
                 		response.put("Partner_Branch",v_Branch);
                 		response.put("Partner_POC_Team",ifnull(v_Con.Partner_POC_Team,""));
                 	}
                 	return response;
                 }
				 string get_rc_token()
                 {
                 	v_cfg = API_Config[Config_Name == "RingCentral"];
                 	if(v_cfg.count() == 0)
                 	{
                 		return "";
                 	}
                 	if(v_cfg.RC_Access_Token != null && v_cfg.RC_Access_Token != "" && v_cfg.RC_Token_Expiry != null)
                 	{
                 		if(v_cfg.RC_Token_Expiry > zoho.currenttime)
                 		{
                 			return v_cfg.RC_Access_Token.toString();
                 		}
                 	}
                 	v_basic = zoho.encryption.base64Encode(v_cfg.RC_Client_ID + ":" + v_cfg.RC_Client_Secret);
                 	v_body = Map();
                 	v_body.put("grant_type","urn:ietf:params:oauth:grant-type:jwt-bearer");
                 	v_body.put("assertion",v_cfg.RC_JWT_Assertion.toString());
                 	v_resp = invokeurl
                 	[
                 		url :"https://platform.ringcentral.com/restapi/oauth/token"
                 		type :POST
                 		parameters:v_body
                 		headers:{"Authorization":"Basic " + v_basic,"Content-Type":"application/x-www-form-urlencoded","Accept":"application/json"}
                 	];
                 	v_token = "";
                 	if(v_resp.get("access_token") != null)
                 	{
                 		v_token = v_resp.get("access_token").toString();
                 		v_cfg.RC_Access_Token=v_token;
                 		v_cfg.RC_Token_Expiry=zoho.currenttime.addMinutes(115);
                 	}
                 	return v_token;
                 }
				 string link_pvs_to_referral()
                 {
                 	v_linked = 0;
                 	v_nomatch = 0;
                 	for each  p in Encounter_PatientVisit[Referral_Link == null && Referral_ID != ""]
                 	{
                 		v_Ref = Referrals_Main[Referral_ID == p.Referral_ID];
                 		if(v_Ref.ID != null)
                 		{
                 			p.Referral_Link=v_Ref.ID;
                 			v_linked = v_linked + 1;
                 		}
                 		else
                 		{
                 			v_nomatch = v_nomatch + 1;
                 		}
                 	}
                 	return "PVS link - linked: " + v_linked + " | no match: " + v_nomatch;
                 }
