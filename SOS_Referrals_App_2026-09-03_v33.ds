                 	v_rows.add("REF-070926-1299|2026-07-09|Ann Smith");
                 	v_rows.add("REF-072426-1424|2026-07-24|Ann Smith");
                 	v_rows.add("REF-072426-1425|2026-07-24|Ann Smith");
                 	v_rows.add("REF-072426-1431|2026-07-24|Ann Smith");
                 	v_rows.add("REF-072426-1433|2026-07-24|Ann Smith");
                 	v_rows.add("REF-072426-1434|2026-07-24|Ann Smith");
                 	v_rows.add("REF-072426-1435|2026-07-26|Ann Smith");
                 	v_rows.add("REF-072426-1437|2026-07-26|Ann Smith");
                 	v_rows.add("REF-072426-1438|2026-07-26|Ann Smith");
                 	v_rows.add("REF-072426-1439|2026-07-26|Ann Smith");
                 	v_rows.add("REF-072726-1448|2026-07-27|Ann Smith");
                 	v_rows.add("REF-072826-1463|2026-07-28|Ann Smith");
                 	v_rows.add("REF-072826-1464|2026-07-28|Ann Smith");
                 	v_rows.add("REF-073126-1495|2026-07-31|Ann Smith");
                 	v_made = 0;
                 	v_skipDup = 0;
                 	v_noRef = 0;
                 	v_noRate = 0;
                 	v_noEmp = 0;
                 	v_log = List();
                 	for each  v_line in v_rows
                 	{
                 		v_parts = v_line.toList("|");
                 		v_rid = v_parts.get(0).toString();
                 		v_done = v_parts.get(1).toString().toDate();
                 		v_who = v_parts.get(2).toString();
                 		v_first = v_who.getPrefix(" ");
                 		v_last = v_who.getSuffix(" ");
                 		v_ref = Referrals_Main[Referral_ID == v_rid];
                 		if(v_ref.count() == 0)
                 		{
                 			v_noRef = v_noRef + 1;
                 			v_log.add(v_rid + " no referral");
                 			continue;
                 		}
                 		v_dup = Encounter_PatientVisit[Referral_Link == v_ref.ID && Type_of_Entry == "3008"];
                 		if(v_dup.count() > 0)
                 		{
                 			v_skipDup = v_skipDup + 1;
                 			continue;
                 		}
                 		v_emp = Employees[Employee_First_Name == v_first && Employee_Last_Name == v_last && Employee_Status == "Active"];
                 		if(v_emp.count() == 0)
                 		{
                 			v_noEmp = v_noEmp + 1;
                 			v_log.add(v_rid + " no employee " + v_who);
                 			continue;
                 		}
                 		v_rate = 0;
                 		for each  v_r in Partner_Rates[Partner_Location_Link == v_ref.Partner_Branch_Link && Rate_Type == "Cares 3008 Assessment" && Current_Rate == "Yes"]
                 		{
                 			v_rate = v_r.Rate_Amount;
                 		}
                 		if(v_rate == 0)
                 		{
                 			v_noRate = v_noRate + 1;
                 			v_log.add(v_rid + " no 3008 rate on " + v_ref.Partner_Location_Label);
                 			continue;
                 		}
                 		v_seq = 0;
                 		for each  v_st in Sequence_Tracker[Object_Prefix == "PVS"]
                 		{
                 			v_seq = v_st.Object_Sequence;
                 			break;
                 		}
                 		if(pMode == "COMMIT")
                 		{
                 			for each  v_st2 in Sequence_Tracker[Object_Prefix == "PVS"]
                 			{
                 				v_st2.Object_Sequence=v_seq + 1;
                 				break;
                 			}
                 			v_new = insert into Encounter_PatientVisit
                 			[
                 				PVS_ID="PVS-" + v_seq + "-" + v_emp.Employee_Initials
                 				Has_Referral_ID="Yes"
                 				Referral_Link=v_ref.ID
                 				Type_of_Entry="3008"
                 				Patient_Full_Name_1=v_ref.Patient_Full_Name
                 				Patient_Full_Name_2=v_ref.Patient_Full_Name
                 				Patient_First_Name=v_ref.Patient_First_Name
                 				Patient_MI=v_ref.Patient_MI
                 				Patient_Last_Name=v_ref.Patient_Last_Name
                 				Patient_DOB=v_ref.Patient_DOB
                 				Patient_Gender=v_ref.Patient_Gender
                 				Patient_Hospice_ID=v_ref.Patient_Hospice_ID
                 				Patient_Phone=v_ref.Patient_Phone
                 				Patient_Location=v_ref.Patient_Location
                 				Facility_Name=v_ref.Facility_Name
                 				Facility_Phone=v_ref.Facility_Phone
                 				Facility_Room_Number=v_ref.Facility_Room_Number
                 				Patient_Full_Address=v_ref.Patient_Full_Address
                 				Reason_for_Referral=v_ref.Referral_Reason
                 				Was_3008_Completed="Yes"
                 				Cares_3008_Completion_Date=v_done
                 				Visit_Completion_Date=v_done
                 				Complexity_Level="Cares 3008 Assessment"
                 				Complexity_Charge=v_rate
                 				Employee_First_Name=v_emp.Employee_First_Name
                 				Employee_Last_Name=v_emp.Employee_Last_Name
                 				Employee_Title=v_emp.Employee_Title
                 				Employee_Initials=v_emp.Employee_Initials
                 				Employee_Email=v_emp.Employee_Email
                 				Employee_Name_Title=v_emp.Employee_Name_Title
                 				Employee_Full_Name=v_emp.Employee_First_Name + " " + v_emp.Employee_Last_Name
                 				Partner_Organization=v_ref.Partner_Organization
                 				Partner_Branch=v_ref.Partner_Branch
                 				Partner_POC_Name_Title=v_ref.Partner_POC_Name_Title
                 				Partner_POC_Team=v_ref.Partner_POC_Team
                 				Partner_POC_Phone=v_ref.Partner_POC_Phone
                 				Partner_POC_Email=v_ref.Partner_POC_Email
                 				Billing_Branch=v_ref.Partner_Branch_Link
                 				Referral_ID=v_rid
                 				Partner_ID=v_ref.Partner_ID
                 				Invoice_Status="Draft"
                 				Hold_From_Invoicing="No"
                 				Added_User=zoho.loginuser
                 			];
                 		}
                 		v_made = v_made + 1;
                 	}
                 	v_out = pMode + " | would create " + v_made + " | duplicates skipped " + v_skipDup + " | missing referral " + v_noRef + " | missing employee " + v_noEmp + " | missing 3008 rate " + v_noRate;
                 	if(v_log.size() > 0)
                 	{
                 		v_out = v_out + "\n" + v_log.toString("\n");
                 	}
                 	return v_out;
                 }
				 string create_books_customers()
                 {
                 	v_created = 0;
                 	v_failed = 0;
                 	v_skipped = 0;
                 	v_noContact = List();
                 	v_errors = List();
                 	v_locs = Partner_Locations[Partner_Location_Status == "Active"];
                 	for each  v_l in v_locs
                 	{
                 		v_loc = Partner_Locations[ID == v_l.ID];
                 		if(v_loc.Books_Customer_ID != null && v_loc.Books_Customer_ID.trim() != "")
                 		{
                 			v_skipped = v_skipped + 1;
                 			continue;
                 		}
                 		if(v_loc.Partner_Location_Label == null || v_loc.Partner_Location_Label.trim() == "")
                 		{
                 			v_failed = v_failed + 1;
                 			v_errors.add("Location ID " + v_loc.ID + " has no Partner Location Label.");
                 			continue;
                 		}
                 		v_payload = Map();
                 		v_payload.put("contact_name",v_loc.Partner_Location_Label);
                 		v_payload.put("contact_type","customer");
                 		v_payload.put("customer_sub_type","business");
                 		v_payload.put("currency_code","USD");
                 		if(v_loc.Partner_Location_Name != null && v_loc.Partner_Location_Name.trim() != "")
                 		{
                 			v_payload.put("company_name",v_loc.Partner_Location_Name);
                 		}
                 		v_bc = Partner_Billing_Contacts[Partner_Location_Link == v_loc.ID && Partner_Billing_POC_Status == "Active"];
                 		if(v_bc.ID == null)
                 		{
                 			v_noContact.add(v_loc.Partner_Location_Label);
                 		}
                 		else
                 		{
                 			v_addr = Map();
                 			v_addr.put("attention",v_loc.Partner_Location_Label);
                 			v_addr.put("address",v_bc.Partner_Billing_Address.address_line_1);
                 			v_addr.put("street2",v_bc.Partner_Billing_Address.address_line_2);
                 			v_addr.put("city",v_bc.Partner_Billing_Address.district_city);
                 			v_addr.put("state",v_bc.Partner_Billing_Address.state_province);
                 			v_addr.put("zip",v_bc.Partner_Billing_Address.postal_Code);
                 			v_addr.put("country",v_bc.Partner_Billing_Address.country);
                 			v_payload.put("billing_address",v_addr);
                 			v_person = Map();
                 			v_person.put("first_name",v_bc.Partner_Billing_POC_First_Name);
                 			v_person.put("last_name",v_bc.Partner_Billing_POC_Last_Name);
                 			v_person.put("email",v_bc.Partner_Billing_POC_Email);
                 			v_person.put("phone",v_bc.Partner_Billing_POC_Phone);
                 			v_person.put("is_primary_contact",true);
                 			v_persons = List();
                 			v_persons.add(v_person);
                 			v_payload.put("contact_persons",v_persons);
                 		}
                 		v_headers = Map();
                 		v_headers.put("Content-Type","application/json");
                 		v_resp = invokeurl
                 		[
                 			url :"https://www.zohoapis.com/books/v3/contacts?organization_id=911048634"
                 			type :POST
                 			parameters:v_payload.toString()
                 			headers:v_headers
                 			connection:"zoho_books_partners"
                 		];
                 		if(v_resp.get("code") == 0)
                 		{
                 			v_c = v_resp.get("contact");
                 			v_loc.Books_Customer_ID=v_c.get("contact_id").toString();
                 			v_created = v_created + 1;
                 		}
                 		else
                 		{
                 			v_failed = v_failed + 1;
                 			v_errors.add(v_loc.Partner_Location_Label + ": " + v_resp.get("message"));
                 		}
                 	}
                 	v_out = "Created: " + v_created + " | Skipped (already had ID): " + v_skipped + " | Failed: " + v_failed;
                 	if(v_noContact.size() > 0)
                 	{
                 		v_out = v_out + "\nNo billing contact (created name-only): " + v_noContact.toString();
                 	}
                 	if(v_errors.size() > 0)
                 	{
                 		v_out = v_out + "\nErrors: " + v_errors.toString();
                 	}
                 	return v_out;
                 }
				 string create_invoice_from_selection(list p_pvsIds)
                 {
                 	if(p_pvsIds.size() == 0)
                 	{
                 		return "ERROR: No visits selected.";
                 	}
                 	v_branchId = null;
                 	v_dateFrom = null;
                 	v_dateTo = null;
                 	v_keys = List();
                 	v_lineName = Map();
                 	v_lineRate = Map();
                 	v_lineQty = Map();
                 	v_lineDesc = Map();
                 	v_lineSeq = Map();
                 	v_visits = List();
                 	for each  v_id in p_pvsIds
                 	{
                 		v_p = Encounter_PatientVisit[ID == v_id];
                 		if(v_p.ID == null)
                 		{
                 			return "ERROR: Visit ID " + v_id + " not found.";
                 		}
                 		if(v_p.Invoice_Link != null)
                 		{
                 			return "ERROR: Visit " + v_p.PVS_ID + " is already on an invoice.";
                 		}
                 		if(v_p.Billing_Branch == null)
                 		{
                 			return "ERROR: Visit " + v_p.PVS_ID + " has no Billing Branch.";
                 		}
                 		if(v_p.Visit_Completion_Date == null)
                 		{
                 			return "ERROR: Visit " + v_p.PVS_ID + " has no Visit Completion Date.";
                 		}
                 		if(v_branchId == null)
                 		{
                 			v_branchId = v_p.Billing_Branch;
                 		}
                 		else if(v_branchId != v_p.Billing_Branch)
                 		{
                 			return "ERROR: Selection spans more than one billing branch. Select one branch at a time.";
                 		}
                 		if(v_dateFrom == null || v_p.Visit_Completion_Date < v_dateFrom)
                 		{
                 			v_dateFrom = v_p.Visit_Completion_Date;
                 		}
                 		if(v_dateTo == null || v_p.Visit_Completion_Date > v_dateTo)
                 		{
                 			v_dateTo = v_p.Visit_Completion_Date;
                 		}
                 		v_visits.add(v_p.ID);
                 	}
                 	v_loc = Partner_Locations[ID == v_branchId];
                 	if(v_loc.ID == null)
                 	{
                 		return "ERROR: Billing branch record not found.";
                 	}
                 	if(v_loc.Books_Customer_ID == null || v_loc.Books_Customer_ID.trim() == "")
                 	{
                 		return "ERROR: Branch " + v_loc.Partner_Location_Name + " has no Books Customer ID.";
                 	}
                 	v_partnerId = v_loc.Partner_Link;
                 	for each  v_id in v_visits
                 	{
                 		v_p = Encounter_PatientVisit[ID == v_id];
                 		v_charge = 0.0;
                 		if(v_p.Complexity_Charge != null)
                 		{
                 			v_charge = v_p.Complexity_Charge.toDecimal();
                 		}
                 		v_level = v_p.Complexity_Level;
                 		if(v_level == null || v_level == "")
                 		{
                 			v_level = "Visit";
                 		}
                 		v_key = "C|" + v_level + "|" + v_charge;
                 		if(!v_keys.contains(v_key))
                 		{
                 			v_keys.add(v_key);
                 			v_lineName.put(v_key,v_level);
                 			v_lineRate.put(v_key,v_charge);
                 			v_lineQty.put(v_key,0);
                 			v_lineDesc.put(v_key,"");
                 			v_lineSeq.put(v_key,0);
                 		}
                 		v_refDate = "";
                 		if(v_p.Referral_Link != null)
                 		{
                 			v_ref = Referrals_Main[ID == v_p.Referral_Link];
                 			if(v_ref.ID != null && v_ref.Referral_Date != null)
                 			{
                 				v_refDate = v_ref.Referral_Date.toString("M/d/yyyy");
                 			}
                 		}
                 		v_dob = "";
                 		if(v_p.Patient_DOB != null)
                 		{
                 			v_dob = v_p.Patient_DOB.toString("M/d/yyyy");
                 		}
                 		v_body = "NAME: " + ifnull(v_p.Patient_Full_Name_1,"") + "\n";
                 		v_body = v_body + "DOB: " + v_dob + "\n";
                 		v_body = v_body + "MRN: " + ifnull(v_p.Patient_Hospice_ID,"") + "\n";
                 		v_body = v_body + "REF DATE: " + v_refDate + "\n";
                 		v_body = v_body + "REASON: " + ifnull(v_p.Reason_for_Referral,"") + "\n";
                 		v_body = v_body + "DOS: " + v_p.Visit_Completion_Date.toString("M/d/yyyy") + "\n";
                 		v_body = v_body + "===\n";
                 		v_n = v_lineSeq.get(v_key) + 1;
                 		v_lineSeq.put(v_key,v_n);
                 		v_lineQty.put(v_key,v_lineQty.get(v_key) + 1);
                 		v_lineDesc.put(v_key,v_lineDesc.get(v_key) + "#" + v_n + "\n" + v_body);
                 		v_feeNames = List();
                 		v_feeAmts = List();
                 		v_feeNames.add("After Hours");
                 		v_feeAmts.add(v_p.After_Hours_Fee);
                 		v_feeNames.add("Super STAT");
                 		v_feeAmts.add(v_p.Super_Stat_Fee);
                 		v_feeNames.add("Equipment Charge");
                 		v_feeAmts.add(v_p.Equipment_Charge_Amount);
                 		v_feeNames.add("Other Charges");
                 		v_feeAmts.add(v_p.Other_Charges_Amount);
                 		for each index v_i in v_feeNames
                 		{
                 			v_fAmt = 0.0;
                 			if(v_feeAmts.get(v_i) != null)
                 			{
                 				v_fAmt = v_feeAmts.get(v_i).toDecimal();
                 			}
                 			if(v_fAmt > 0)
                 			{
                 				v_fKey = "F|" + v_feeNames.get(v_i) + "|" + v_fAmt;
                 				if(!v_keys.contains(v_fKey))
                 				{
                 					v_keys.add(v_fKey);
                 					v_lineName.put(v_fKey,v_feeNames.get(v_i));
                 					v_lineRate.put(v_fKey,v_fAmt);
                 					v_lineQty.put(v_fKey,0);
                 					v_lineDesc.put(v_fKey,"");
                 					v_lineSeq.put(v_fKey,0);
                 				}
                 				v_fn = v_lineSeq.get(v_fKey) + 1;
                 				v_lineSeq.put(v_fKey,v_fn);
                 				v_lineQty.put(v_fKey,v_lineQty.get(v_fKey) + 1);
                 				v_lineDesc.put(v_fKey,v_lineDesc.get(v_fKey) + "#" + v_fn + "\n" + v_body);
                 			}
                 		}
                 	}
                 	v_lineItems = List();
                 	v_total = 0.0;
                 	for each  v_key in v_keys
                 	{
                 		v_item = Map();
                 		v_item.put("name",v_lineName.get(v_key));
                 		v_item.put("description",v_lineDesc.get(v_key));
                 		v_item.put("rate",v_lineRate.get(v_key));
                 		v_item.put("quantity",v_lineQty.get(v_key));
                 		v_lineItems.add(v_item);
                 		v_total = v_total + v_lineRate.get(v_key) * v_lineQty.get(v_key);
                 	}
                 	v_invRec = insert into Invoices
                 	[
                 		Partner_Link=v_partnerId
                 		Partner_Location_Link=v_branchId
                 		Invoice_Date=zoho.currentdate
                 		Service_Date_From=v_dateFrom
                 		Service_Date_To=v_dateTo
                 		Invoice_Total=v_total
                 		Visit_Count=v_visits.size()
                 		Invoice_Record_Status="Pending"
                 		Created_By=zoho.loginuser
                 		Books_Customer_ID=v_loc.Books_Customer_ID
                 		Added_User=zoho.loginuser
                 	];
                 	v_invId = v_invRec;
                 	for each  v_upd in Encounter_PatientVisit[ID in v_visits]
                 	{
                 		update v_upd
                 		[
                 			Invoice_Link=v_invId
                 			Invoice_Status="Final"
                 		];
                 	}
                 	v_payload = Map();
                 	v_payload.put("customer_id",v_loc.Books_Customer_ID);
                 	v_payload.put("date",zoho.currentdate.toString("yyyy-MM-dd"));
                 	v_payload.put("reference_number",v_invId.toString());
                 	v_payload.put("line_items",v_lineItems);
                 	v_headers = Map();
                 	v_headers.put("Content-Type","application/json");
                 	v_resp = invokeurl
                 	[
                 		url :"https://www.zohoapis.com/books/v3/invoices?organization_id=911048634"
                 		type :POST
                 		parameters:v_payload.toString()
                 		headers:v_headers
                 		connection:"zoho_books_partners"
                 	];
                 	v_inv = Invoices[ID == v_invId];
                 	v_inv.Books_Sync_Timestamp=zoho.currenttime;
                 	if(v_resp.get("code") == 0)
                 	{
                 		v_books = v_resp.get("invoice");
                 		v_inv.Books_Invoice_ID=v_books.get("invoice_id");
                 		v_inv.Books_Invoice_Number=v_books.get("invoice_number");
                 		v_inv.Invoice_Record_Status="Sent";
                 		v_inv.Books_Sync_Message="Success";
                 		return "INVID:" + v_invId + "|Invoice created: " + v_books.get("invoice_number") + " | visits: " + v_visits.size() + " | total: " + v_total;
                 	}
                 	else
                 	{
                 		v_inv.Invoice_Record_Status="Failed";
                 		v_inv.Books_Sync_Message=v_resp.toString().left(2000);
                 		return "INVID:" + v_invId + "|ERROR: Books rejected the invoice. See Books Sync Message on invoice record " + v_invId + ".";
                 	}
                 }
				 string diag_accentcare_rates()
                 {
                 	v_out = "";
                 	for each  l in Partner_Locations[Partner_Location_Label.contains("AccentCare")]
                 	{
                 		v_out = v_out + "\n== " + l.Partner_Location_Label;
                 		v_n = 0;
                 		for each  r in Partner_Rates[Partner_Location_Link == l.ID]
                 		{
                 			v_n = v_n + 1;
                 			v_out = v_out + "\n   [" + r.Rate_Type + "] amt=" + r.Rate_Amount + " current=[" + r.Current_Rate + "] status=[" + r.Partner_Rate_Status + "]";
                 		}
                 		if(v_n == 0)
                 		{
                 			v_out = v_out + "\n   (no rate records)";
                 		}
                 	}
                 	return v_out;
                 }
				 string diag_config_write()
                 {
                 	v_cfg = API_Config[Config_Name == "RingCentral"];
                 	if(v_cfg.count() == 0)
                 	{
                 		return "no record";
                 	}
                 	v_cfg.RC_Access_Token="WRITE_TEST";
                 	v_cfg.RC_Token_Expiry=zoho.currenttime;
                 	v_after = API_Config[Config_Name == "RingCentral"];
                 	info "token now: " + ifnull(v_after.RC_Access_Token,"NULL");
                 	return "done";
                 }
				 string diag_duplicate_location_names()
                 {
                 	v_Names = List();
                 	v_Lines = List();
                 	for each  v_L in Partner_Locations[Partner_Location_Status == "Active"]
                 	{
                 		v_N = ifnull(v_L.Partner_Location_Name,"").trim().toLowerCase();
                 		if(v_N != "" && !v_Names.contains(v_N))
                 		{
                 			v_Names.add(v_N);
                 		}
                 	}
                 	for each  v_Name in v_Names
                 	{
                 		v_Count = 0;
                 		v_Owners = List();
                 		for each  v_L2 in Partner_Locations[Partner_Location_Status == "Active"]
                 		{
                 			if(v_L2.Partner_Location_Name != null && v_L2.Partner_Location_Name.trim().toLowerCase() == v_Name)
                 			{
                 				v_Count = v_Count + 1;
                 				v_Loc = Partner_Locations[ID == v_L2.ID];
                 				v_Owners.add(ifnull(v_Loc.Partner_Link.Partner_Display_Name,"?") + " / " + v_Loc.Partner_Location_Name);
                 			}
                 		}
                 		if(v_Count > 1)
                 		{
                 			v_Lines.add("DUPLICATE x" + v_Count + ": " + v_Owners.toString(" | "));
                 		}
                 	}
                 	if(v_Lines.size() == 0)
                 	{
                 		return "No duplicate Active location names.";
                 	}
                 	return v_Lines.toString(" || ");
                 }
				 string diag_duplicate_visits()
                 {
                 	v_keys = List();
                 	v_count = Map();
                 	v_data = Map();
                 	v_dupAmt = Map();
                 	for each  p in Encounter_PatientVisit[ID != 0]
                 	{
                 		if(p.Visit_Completion_Date != null)
                 		{
                 			v_nm = ifnull(p.Patient_Full_Name_1,"").toString().trim().toLowerCase();
                 			v_dob = "";
                 			if(p.Patient_DOB != null)
                 			{
                 				v_dob = p.Patient_DOB.toString("yyyy-MM-dd");
                 			}
                 			v_dos = p.Visit_Completion_Date.toString("yyyy-MM-dd");
                 			v_key = v_nm + "|" + v_dob + "|" + v_dos;
                 			if(v_nm != "")
                 			{
                 				v_inv = "not invoiced";
                 				if(p.Invoice_Link != null)
                 				{
                 					for each  i in Invoices[ID == p.Invoice_Link]
                 					{
                 						v_inv = ifnull(i.Books_Invoice_Number,"no Books number") + "/" + ifnull(i.Invoice_Record_Status,"?");
                 						break;
                 					}
                 				}
                 				v_amt = 0.0;
                 				if(p.Complexity_Charge != null)
                 				{
                 					v_amt = p.Complexity_Charge.toDecimal();
                 				}
                 				v_line = ifnull(p.PVS_ID,"no PVS ID") + " DOS " + v_dos + " $" + v_amt + " [" + v_inv + "]";
                 				if(!v_keys.contains(v_key))
                 				{
                 					v_keys.add(v_key);
                 					v_count.put(v_key,0);
                 					v_data.put(v_key,"");
                 					v_dupAmt.put(v_key,0.0);
                 				}
                 				v_count.put(v_key,v_count.get(v_key) + 1);
                 				v_data.put(v_key,v_data.get(v_key) + v_line + " ; ");
                 				if(v_count.get(v_key) > 1)
                 				{
                 					v_dupAmt.put(v_key,v_dupAmt.get(v_key) + v_amt);
                 				}
                 			}
                 		}
                 	}
                 	v_out = List();
                 	v_sets = 0;
                 	v_extra = 0;
                 	v_exposure = 0.0;
                 	for each  v_k in v_keys
                 	{
                 		if(v_count.get(v_k) > 1)
                 		{
                 			v_sets = v_sets + 1;
                 			v_extra = v_extra + v_count.get(v_k) - 1;
                 			v_exposure = v_exposure + v_dupAmt.get(v_k);
                 			v_out.add("x" + v_count.get(v_k) + ": " + v_data.get(v_k));
                 		}
                 	}
                 	v_msg = "Duplicate visit sets: " + v_sets + ". Extra records beyond the first: " + v_extra + ". Complexity-charge exposure: $" + v_exposure + ".";
                 	if(v_out.size() > 0)
                 	{
                 		v_msg = v_msg + " Detail: " + v_out.toString(" || ");
                 	}
                 	return v_msg;
                 }
				 string diag_empath_labels()
                 {
                 	v_out = "";
                 	for each  l in Partner_Locations[ID != 0]
                 	{
                 		v_lab = l.Partner_Location_Label;
