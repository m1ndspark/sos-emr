			Portal_Access_By_Status as "Portal Access By Status"
			{
				type =  form
				form = Employees

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Employee_Email != null && input.Employee_Email.trim() != "")
										{
											v_Email = input.Employee_Email.trim();
											v_Existing = thisapp.portal.profileForUser(v_Email);
											if(v_Existing != null && v_Existing != "")
											{
												if(input.Employee_Status == "Inactive")
												{
													thisapp.portal.assignUserInProfile(v_Email,"Deactivated User");
												}
												else if(input.Employee_Status == "Active")
												{
													thisapp.portal.assignUserInProfile(v_Email,"Provider");
												}
											}
										}
						)
					}
				}

			}
			Employee_Phone_Format as "Employee Phone Format"
			{
				type =  form
				form = Employees

				record event = on add or edit

				on user input of Employee_Phone
				{
					actions 
					{
						custom deluge script
						(
											v_Raw = input.Employee_Phone.toString();
										v_Digits = v_Raw.replaceAll("[^0-9]","");
										if(v_Digits.length() != 10)
										{
											if(v_Raw != v_Digits)
											{
												input.Employee_Phone = v_Digits;
											}
											return;
										}
										v_Formatted = v_Digits.subString(0,3) + "-" + v_Digits.subString(3,6) + "-" + v_Digits.subString(6,10);
										if(v_Raw == v_Formatted)
										{
											return;
										}
										input.Employee_Phone = v_Formatted;
						)
					}
				}

			}
			Validate_Employee_Phone_B as "Validate Employee Phone Block"
			{
				type =  form
				form = Employees

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											v_Phone = input.Employee_Phone.trim();
										if(v_Phone != "")
										{
											v_Digits = v_Phone.replaceAll("[^0-9]","");
											if(v_Digits.length() != 10)
											{
												alert "Employee Phone must be 10 digits. Enter area code plus number, no country code.";
												cancel submit;
											}
										}
						)
					}
				}

			}
			Imaging_Referral_Link_Pre as "Imaging Referral Link Pre-Fill"
			{
				type =  form
				form = Imaging_Orders

				record event = on add or edit

				on user input of Referral_Link
				{
					actions 
					{
						custom deluge script
						(
											v_Found = false;
										if(input.Referral_Link != null)
										{
											v_Referral = Referrals_Main[ID == input.Referral_Link];
											for each  v_Rec in v_Referral
											{
												input.Patient_Full_Name = v_Rec.Patient_Full_Name;
												input.Patient_DOB = v_Rec.Patient_DOB;
												input.Patient_Gender = v_Rec.Patient_Gender;
												input.Patient_Hospice_ID = v_Rec.Patient_Hospice_ID;
												input.Patient_Location = v_Rec.Patient_Location;
												input.Patient_Address = v_Rec.Patient_Address;
												input.Patient_Phone = v_Rec.Patient_Phone;
												input.Facility_Name = v_Rec.Facility_Name;
												input.Facility_Room_Number = v_Rec.Facility_Room_Number;
												input.Facility_Phone = v_Rec.Facility_Phone;
												input.DM_Full_Name = v_Rec.AC_Full_Name;
												input.Is_Self_Responsible = v_Rec.Has_Additional_Contact;
												v_Found = true;
												break;
											}
										}
										if(v_Found)
										{
											disable Patient_Full_Name;
											disable Patient_DOB;
											disable Patient_Gender;
											disable Patient_Hospice_ID;
											disable Patient_Location;
											disable Patient_Address;
											disable Patient_Phone;
											disable Facility_Name;
											disable Facility_Room_Number;
											disable Facility_Phone;
											disable DM_Full_Name;
											disable Is_Self_Responsible;
											if(input.Patient_Location == "Facility")
											{
												show Facility_Name;
												show Facility_Room_Number;
												show Facility_Phone;
											}
											else
											{
												hide Facility_Name;
												hide Facility_Room_Number;
												hide Facility_Phone;
											}
										}
										else
										{
											input.Patient_Full_Name = null;
											input.Patient_DOB = null;
											input.Patient_Gender = null;
											input.Patient_Hospice_ID = null;
											input.Patient_Location = null;
											input.Patient_Address = null;
											input.Patient_Phone = null;
											input.Facility_Name = null;
											input.Facility_Room_Number = null;
											input.Facility_Phone = null;
											input.DM_Full_Name = null;
											input.Is_Self_Responsible = null;
											enable Patient_Full_Name;
											enable Patient_DOB;
											enable Patient_Gender;
											enable Patient_Hospice_ID;
											enable Patient_Location;
											enable Patient_Address;
											enable Patient_Phone;
											enable Facility_Name;
											enable Facility_Room_Number;
											enable Facility_Phone;
											enable DM_Full_Name;
											enable Is_Self_Responsible;
											hide Facility_Name;
											hide Facility_Room_Number;
											hide Facility_Phone;
										}
						)
					}
				}

			}
