		 functions
		 {
			 Deluge
			 {
				 string add_missing_rate_to_uniform_branches()
                 {
                 	v_out = "";
                 	v_inserted = 0;
                 	for each  v_p in Partners[Rate_Structure == "Uniform (All Locations)" && Partner_Status == "Active"]
                 	{
                 		v_srcId = null;
                 		v_srcCount = 0;
                 		for each  v_l in Partner_Locations[Partner_Link == v_p.ID && Partner_Location_Status == "Active"]
                 		{
                 			v_c = 0;
                 			for each  v_r in Partner_Rates[Partner_Location_Link == v_l.ID && Current_Rate == "Yes"]
                 			{
                 				v_c = v_c + 1;
                 			}
                 			if(v_c > v_srcCount)
                 			{
                 				v_srcCount = v_c;
                 				v_srcId = v_l.ID;
                 			}
                 		}
                 		if(v_srcId == null || v_srcCount == 0)
                 		{
                 			v_out = v_out + "\n" + v_p.Partner_Display_Name + ": SKIPPED - no source branch.";
                 			continue;
                 		}
                 		v_src = Partner_Locations[ID == v_srcId];
                 		v_out = v_out + "\n" + v_p.Partner_Display_Name + ": source = " + v_src.Partner_Location_Label;
                 		for each  v_t in Partner_Locations[Partner_Link == v_p.ID && Partner_Location_Status == "Active"]
                 		{
                 			if(v_t.ID != v_srcId)
                 			{
                 				v_have = List();
                 				for each  v_x in Partner_Rates[Partner_Location_Link == v_t.ID && Current_Rate == "Yes"]
                 				{
                 					v_have.add(v_x.Rate_Type);
                 				}
                 				v_n = 0;
                 				for each  v_r in Partner_Rates[Partner_Location_Link == v_srcId && Current_Rate == "Yes"]
                 				{
                 					if(!v_have.contains(v_r.Rate_Type))
                 					{
                 						v_newId = insert into Partner_Rates
                 						[
                 							Partner_Link=v_p.ID
                 							Partner_Location_Link=v_t.ID
                 							Rate_Category=v_r.Rate_Category
                 							Rate_Type=v_r.Rate_Type
                 							Rate_Amount=v_r.Rate_Amount
                 							Partner_Rates_Effective_Date=v_r.Partner_Rates_Effective_Date
                 							Current_Rate="Yes"
                 							Partner_Rate_Status="Active"
                 							Added_User=zoho.loginuser
                 						];
                 						v_newRec = Partner_Rates[ID == v_newId];
                 						v_newRec.Partner_Rate_ID_Stamp=v_newId.toString();
                 						v_have.add(v_r.Rate_Type);
                 						v_n = v_n + 1;
                 						v_inserted = v_inserted + 1;
                 					}
                 				}
                 				if(v_n > 0)
                 				{
                 					v_out = v_out + "\n   " + v_t.Partner_Location_Label + ": added " + v_n + " missing rate type(s)";
                 				}
                 			}
                 		}
                 	}
                 	return "Inserted " + v_inserted + " rate records." + v_out;
                 }
				 void backfill_assignment_ids()
                 {
                 	rows = Assignments[ID != 0];
                 	for each  rec in rows
                 	{
                 		existing = rec.Assignment_ID;
                 		if(existing == null)
                 		{
                 			existing = "";
                 		}
                 		if(existing.trim() == "")
                 		{
                 			thisapp.mint_assignment_id(rec.ID);
                 		}
                 	}
                 }
				 string backfill_contact_name_title()
                 {
                 	v_n = 0;
                 	for each  c in Partner_Referral_Contacts[ID != 0]
                 	{
                 		v_first = c.Partner_POC_First_Name;
                 		if(v_first == null)
                 		{
                 			v_first = "";
                 		}
                 		v_last = c.Partner_POC_Last_Name;
                 		if(v_last == null)
                 		{
                 			v_last = "";
                 		}
                 		v_title = c.Partner_POC_Title;
                 		if(v_title == null)
                 		{
                 			v_title = "";
                 		}
                 		v_name = (v_first + " " + v_last).trim();
                 		if(v_title.trim() != "")
                 		{
                 			v_name = v_name + ", " + v_title;
                 		}
                 		c.Partner_POC_Name_Title=v_name;
                 		v_n = v_n + 1;
                 	}
                 	return "Updated " + v_n + " contacts.";
                 }
				 void backfill_current_rate()
                 {
                 	for each  r in Partner_Rates[ID != null]
                 	{
                 		thisapp.set_current_rate(r.ID);
                 	}
                 }
				 void backfill_dm_full_names()
                 {
                 	v_Count = 0;
                 	v_Records = Referrals_Main[AC_Full_Name == null || AC_Full_Name == ""];
                 	for each  v_Rec in v_Records
                 	{
                 		v_First = "";
                 		v_Last = "";
                 		if(v_Rec.AC_First_Name != null && v_Rec.AC_First_Name.trim() != "")
                 		{
                 			v_First = v_Rec.AC_First_Name.trim();
                 		}
                 		if(v_Rec.AC_Last_Name != null && v_Rec.AC_Last_Name.trim() != "")
                 		{
                 			v_Last = v_Rec.AC_Last_Name.trim();
                 		}
                 		if(v_Last != "")
                 		{
                 			v_Name = "";
                 			if(v_First != "")
                 			{
                 				v_Name = v_First + " " + v_Last;
                 			}
                 			else
                 			{
                 				v_Name = v_Last;
                 			}
                 			v_Rec.AC_Full_Name=v_Name;
                 			v_Count = v_Count + 1;
                 		}
                 	}
                 	info "DM_Full_Name backfill complete. Records updated: " + v_Count;
                 }
				 void backfill_employee_ids()
                 {
                 	emps = Employees[ID != 0];
                 	for each  rec in emps
                 	{
                 		existing = rec.Employee_ID;
                 		if(existing == null)
                 		{
                 			existing = "";
                 		}
                 		if(existing.trim() == "")
                 		{
                 			thisapp.mint_employee_id(rec.ID);
                 		}
                 	}
                 }
				 void backfill_employee_phone_format()
                 {
                 	v_Count = 0;
                 	v_Records = Employees[ID != 0];
                 	for each  v_Rec in v_Records
                 	{
                 		if(v_Rec.Employee_Phone != null && v_Rec.Employee_Phone.trim() != "")
                 		{
                 			v_Raw = v_Rec.Employee_Phone.toString();
                 			v_Digits = v_Raw.replaceAll("[^0-9]","");
                 			if(v_Digits.length() == 10)
                 			{
                 				v_Formatted = v_Digits.subString(0,3) + "-" + v_Digits.subString(3,6) + "-" + v_Digits.subString(6,10);
                 				if(v_Raw != v_Formatted)
                 				{
                 					v_Rec.Employee_Phone=v_Formatted;
                 					v_Count = v_Count + 1;
                 				}
                 			}
                 		}
                 	}
                 	info "Employee phone backfill complete. Records updated: " + v_Count;
                 }
