			Branch_Sets_Partner_Link as "Branch Sets Partner Link"
			{
				type =  form
				form = Referrals_Main

				record event = on add or edit
					status = inactive

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Partner_Branch_Link != null)
										{
											for each  v_Loc in Partner_Locations[ID == input.Partner_Branch_Link]
											{
												for each  v_P in Partners[ID == v_Loc.Partner_Link]
												{
													Partner_Link = v_P.ID;
													input.Partner_ID = v_P.Partner_ID;
													break;
												}
												break;
											}
										}
						)
					}
				}

