				 string create_books_customers()
                 {
                 	v_created = 0;
                 	v_failed = 0;
                 	v_skipped = 0;
                 	v_noContact = List();
                 	v_errors = List();
                 	v_locs = Partner_Locations[Partner_Location_Status == "Active"];
                 	for each  v_l in v_locs
                 	{
                 		v_loc = Partner_Locations[ID == v_l.ID];
                 		if(v_loc.Books_Customer_ID != null && v_loc.Books_Customer_ID.trim() != "")
                 		{
                 			v_skipped = v_skipped + 1;
                 			continue;
                 		}
                 		if(v_loc.Partner_Location_Label == null || v_loc.Partner_Location_Label.trim() == "")
                 		{
                 			v_failed = v_failed + 1;
                 			v_errors.add("Location ID " + v_loc.ID + " has no Partner Location Label.");
                 			continue;
                 		}
                 		v_payload = Map();
                 		v_payload.put("contact_name",v_loc.Partner_Location_Label);
                 		v_payload.put("contact_type","customer");
                 		v_payload.put("customer_sub_type","business");
                 		v_payload.put("currency_code","USD");
                 		if(v_loc.Partner_Location_Name != null && v_loc.Partner_Location_Name.trim() != "")
                 		{
                 			v_payload.put("company_name",v_loc.Partner_Location_Name);
                 		}
                 		v_bc = Partner_Billing_Contacts[Partner_Location_Link == v_loc.ID && Partner_Billing_POC_Status == "Active"];
                 		if(v_bc.ID == null)
                 		{
                 			v_noContact.add(v_loc.Partner_Location_Label);
                 		}
                 		else
                 		{
                 			v_addr = Map();
                 			v_addr.put("attention",v_loc.Partner_Location_Label);
                 			v_addr.put("address",v_bc.Partner_Billing_Address.address_line_1);
                 			v_addr.put("street2",v_bc.Partner_Billing_Address.address_line_2);
                 			v_addr.put("city",v_bc.Partner_Billing_Address.district_city);
                 			v_addr.put("state",v_bc.Partner_Billing_Address.state_province);
                 			v_addr.put("zip",v_bc.Partner_Billing_Address.postal_Code);
                 			v_addr.put("country",v_bc.Partner_Billing_Address.country);
                 			v_payload.put("billing_address",v_addr);
                 			v_person = Map();
                 			v_person.put("first_name",v_bc.Partner_Billing_POC_First_Name);
                 			v_person.put("last_name",v_bc.Partner_Billing_POC_Last_Name);
                 			v_person.put("email",v_bc.Partner_Billing_POC_Email);
                 			v_person.put("phone",v_bc.Partner_Billing_POC_Phone);
                 			v_person.put("is_primary_contact",true);
                 			v_persons = List();
                 			v_persons.add(v_person);
                 			v_payload.put("contact_persons",v_persons);
                 		}
                 		v_headers = Map();
                 		v_headers.put("Content-Type","application/json");
                 		v_resp = invokeurl
                 		[
                 			url :"https://www.zohoapis.com/books/v3/contacts?organization_id=911048634"
                 			type :POST
                 			parameters:v_payload.toString()
                 			headers:v_headers
                 			connection:"zoho_books_partners"
                 		];
                 		if(v_resp.get("code") == 0)
                 		{
                 			v_c = v_resp.get("contact");
                 			v_loc.Books_Customer_ID=v_c.get("contact_id").toString();
                 			v_created = v_created + 1;
                 		}
                 		else
                 		{
                 			v_failed = v_failed + 1;
                 			v_errors.add(v_loc.Partner_Location_Label + ": " + v_resp.get("message"));
                 		}
                 	}
                 	v_out = "Created: " + v_created + " | Skipped (already had ID): " + v_skipped + " | Failed: " + v_failed;
                 	if(v_noContact.size() > 0)
                 	{
                 		v_out = v_out + "\nNo billing contact (created name-only): " + v_noContact.toString();
                 	}
                 	if(v_errors.size() > 0)
                 	{
                 		v_out = v_out + "\nErrors: " + v_errors.toString();
                 	}
                 	return v_out;
                 }
				 string create_invoice_from_selection(list p_pvsIds)
                 {
                 	if(p_pvsIds.size() == 0)
                 	{
                 		return "ERROR: No visits selected.";
                 	}
                 	v_branchId = null;
                 	v_dateFrom = null;
                 	v_dateTo = null;
                 	v_keys = List();
                 	v_lineName = Map();
                 	v_lineRate = Map();
                 	v_lineQty = Map();
                 	v_lineDesc = Map();
                 	v_lineSeq = Map();
                 	v_visits = List();
                 	for each  v_id in p_pvsIds
                 	{
                 		v_p = Encounter_PatientVisit[ID == v_id];
                 		if(v_p.ID == null)
                 		{
                 			return "ERROR: Visit ID " + v_id + " not found.";
                 		}
                 		if(v_p.Invoice_Link != null)
                 		{
                 			return "ERROR: Visit " + v_p.PVS_ID + " is already on an invoice.";
                 		}
                 		if(v_p.Billing_Branch == null)
                 		{
                 			return "ERROR: Visit " + v_p.PVS_ID + " has no Billing Branch.";
                 		}
                 		if(v_p.Visit_Completion_Date == null)
                 		{
                 			return "ERROR: Visit " + v_p.PVS_ID + " has no Visit Completion Date.";
                 		}
                 		if(v_branchId == null)
                 		{
                 			v_branchId = v_p.Billing_Branch;
                 		}
                 		else if(v_branchId != v_p.Billing_Branch)
                 		{
                 			return "ERROR: Selection spans more than one billing branch. Select one branch at a time.";
                 		}
                 		if(v_dateFrom == null || v_p.Visit_Completion_Date < v_dateFrom)
                 		{
                 			v_dateFrom = v_p.Visit_Completion_Date;
                 		}
                 		if(v_dateTo == null || v_p.Visit_Completion_Date > v_dateTo)
                 		{
                 			v_dateTo = v_p.Visit_Completion_Date;
                 		}
                 		v_visits.add(v_p.ID);
                 	}
                 	v_loc = Partner_Locations[ID == v_branchId];
                 	if(v_loc.ID == null)
                 	{
                 		return "ERROR: Billing branch record not found.";
                 	}
                 	if(v_loc.Books_Customer_ID == null || v_loc.Books_Customer_ID.trim() == "")
                 	{
                 		return "ERROR: Branch " + v_loc.Partner_Location_Name + " has no Books Customer ID.";
                 	}
                 	v_partnerId = v_loc.Partner_Link;
                 	for each  v_id in v_visits
                 	{
                 		v_p = Encounter_PatientVisit[ID == v_id];
                 		v_charge = 0.0;
                 		if(v_p.Complexity_Charge != null)
                 		{
                 			v_charge = v_p.Complexity_Charge.toDecimal();
                 		}
                 		v_level = v_p.Complexity_Level;
                 		if(v_level == null || v_level == "")
                 		{
                 			v_level = "Visit";
                 		}
                 		v_key = "C|" + v_level + "|" + v_charge;
                 		if(!v_keys.contains(v_key))
                 		{
                 			v_keys.add(v_key);
                 			v_lineName.put(v_key,v_level);
                 			v_lineRate.put(v_key,v_charge);
                 			v_lineQty.put(v_key,0);
                 			v_lineDesc.put(v_key,"");
                 			v_lineSeq.put(v_key,0);
                 		}
                 		v_refDate = "";
                 		if(v_p.Referral_Link != null)
                 		{
                 			v_ref = Referrals_Main[ID == v_p.Referral_Link];
                 			if(v_ref.ID != null && v_ref.Referral_Date != null)
                 			{
                 				v_refDate = v_ref.Referral_Date.toString("M/d/yyyy");
                 			}
                 		}
                 		v_dob = "";
                 		if(v_p.Patient_DOB != null)
                 		{
                 			v_dob = v_p.Patient_DOB.toString("M/d/yyyy");
                 		}
                 		v_n = v_lineSeq.get(v_key) + 1;
                 		v_lineSeq.put(v_key,v_n);
                 		v_lineQty.put(v_key,v_lineQty.get(v_key) + 1);
                 		v_block = "#" + v_n + "\n";
                 		v_block = v_block + "NAME: " + v_p.Patient_Full_Name + "\n";
                 		v_block = v_block + "DOB: " + v_dob + "\n";
                 		v_block = v_block + "MRN: " + v_p.Patient_Hospice_ID + "\n";
                 		v_block = v_block + "REF DATE: " + v_refDate + "\n";
                 		v_block = v_block + "REASON: " + v_p.Reason_for_Referral + "\n";
                 		v_block = v_block + "DOS: " + v_p.Visit_Completion_Date.toString("M/d/yyyy") + "\n";
                 		v_block = v_block + "===\n";
                 		v_lineDesc.put(v_key,v_lineDesc.get(v_key) + v_block);
                 		v_feeNames = List();
                 		v_feeAmts = List();
                 		v_feeNames.add("After Hours");
                 		v_feeAmts.add(v_p.After_Hours_Fee);
                 		v_feeNames.add("Super STAT");
                 		v_feeAmts.add(v_p.Super_Stat_Fee);
                 		v_feeNames.add("Equipment Charge");
                 		v_feeAmts.add(v_p.Equipment_Charge_Amount);
                 		v_feeNames.add("Other Charges");
                 		v_feeAmts.add(v_p.Other_Charges_Amount);
                 		for each index v_i in v_feeNames
                 		{
                 			v_fAmt = 0.0;
                 			if(v_feeAmts.get(v_i) != null)
                 			{
                 				v_fAmt = v_feeAmts.get(v_i).toDecimal();
                 			}
                 			if(v_fAmt > 0)
                 			{
                 				v_fKey = "F|" + v_feeNames.get(v_i) + "|" + v_fAmt;
                 				if(!v_keys.contains(v_fKey))
                 				{
                 					v_keys.add(v_fKey);
                 					v_lineName.put(v_fKey,v_feeNames.get(v_i));
                 					v_lineRate.put(v_fKey,v_fAmt);
                 					v_lineQty.put(v_fKey,0);
                 					v_lineDesc.put(v_fKey,"");
                 					v_lineSeq.put(v_fKey,0);
                 				}
                 				v_lineQty.put(v_fKey,v_lineQty.get(v_fKey) + 1);
                 			}
                 		}
                 	}
                 	v_lineItems = List();
                 	v_total = 0.0;
                 	for each  v_key in v_keys
                 	{
                 		v_item = Map();
                 		v_item.put("name",v_lineName.get(v_key));
                 		v_item.put("description",v_lineDesc.get(v_key));
                 		v_item.put("rate",v_lineRate.get(v_key));
                 		v_item.put("quantity",v_lineQty.get(v_key));
                 		v_lineItems.add(v_item);
                 		v_total = v_total + v_lineRate.get(v_key) * v_lineQty.get(v_key);
                 	}
                 	v_invRec = insert into Invoices
                 	[
                 		Partner_Link=v_partnerId
                 		Partner_Location_Link=v_branchId
                 		Invoice_Date=zoho.currentdate
                 		Service_Date_From=v_dateFrom
                 		Service_Date_To=v_dateTo
                 		Invoice_Total=v_total
                 		Visit_Count=v_visits.size()
                 		Invoice_Record_Status="Pending"
                 		Created_By=zoho.loginuser
                 		Books_Customer_ID=v_loc.Books_Customer_ID
                 		Added_User=zoho.loginuser
                 	];
                 	v_invId = v_invRec;
                 	for each  v_id in v_visits
                 	{
                 		v_upd = Encounter_PatientVisit[ID == v_id];
                 		v_upd.Invoice_Link=v_invId;
                 		v_upd.Invoice_Status="Final";
                 	}
                 	v_payload = Map();
                 	v_payload.put("customer_id",v_loc.Books_Customer_ID);
                 	v_payload.put("date",zoho.currentdate.toString("yyyy-MM-dd"));
                 	v_payload.put("reference_number",v_invId.toString());
                 	v_payload.put("line_items",v_lineItems);
                 	v_headers = Map();
                 	v_headers.put("Content-Type","application/json");
                 	v_resp = invokeurl
                 	[
                 		url :"https://www.zohoapis.com/books/v3/invoices?organization_id=911048634"
                 		type :POST
                 		parameters:v_payload.toString()
                 		headers:v_headers
                 		connection:"zoho_books_partners"
                 	];
                 	v_inv = Invoices[ID == v_invId];
                 	v_inv.Books_Sync_Timestamp=zoho.currenttime;
                 	if(v_resp.get("code") == 0)
                 	{
                 		v_books = v_resp.get("invoice");
                 		v_inv.Books_Invoice_ID=v_books.get("invoice_id");
                 		v_inv.Books_Invoice_Number=v_books.get("invoice_number");
                 		v_inv.Invoice_Record_Status="Sent";
                 		v_inv.Books_Sync_Message="Success";
                 		return "Invoice created: " + v_books.get("invoice_number") + " | visits: " + v_visits.size() + " | total: " + v_total;
                 	}
                 	else
                 	{
                 		v_inv.Invoice_Record_Status="Failed";
                 		v_inv.Books_Sync_Message=v_resp.toString().left(2000);
                 		return "ERROR: Books rejected the invoice. See Books Sync Message on invoice record " + v_invId + ".";
                 	}
                 }
				 string diag_invoice_batch(int p_batchId)
                 {
                 	v_b = Invoice_Batch[ID == p_batchId];
                 	if(v_b.ID == null)
                 	{
                 		return "ERROR: Batch record not found.";
                 	}
                 	v_allPvs = 0;
                 	v_onBranch = 0;
                 	v_draft = 0;
                 	v_nullStatus = 0;
                 	v_noInvoice = 0;
                 	v_inRange = 0;
                 	v_notHeld = 0;
                 	v_noBranch = 0;
                 	v_noDate = 0;
                 	v_recs = Encounter_PatientVisit[ID != 0];
                 	for each  v_r in v_recs
                 	{
                 		v_allPvs = v_allPvs + 1;
                 		if(v_r.Billing_Branch == null)
                 		{
                 			v_noBranch = v_noBranch + 1;
                 		}
                 		if(v_r.Visit_Completion_Date == null)
                 		{
                 			v_noDate = v_noDate + 1;
                 		}
                 		if(v_r.Invoice_Status == null || v_r.Invoice_Status == "")
                 		{
                 			v_nullStatus = v_nullStatus + 1;
                 		}
                 		if(v_r.Billing_Branch == v_b.Partner_Location_Link)
                 		{
                 			v_onBranch = v_onBranch + 1;
                 			if(v_r.Invoice_Status == "Draft")
                 			{
                 				v_draft = v_draft + 1;
                 			}
                 			if(v_r.Invoice_Link == null)
                 			{
                 				v_noInvoice = v_noInvoice + 1;
                 			}
                 			if(v_r.Visit_Completion_Date != null && v_r.Visit_Completion_Date >= v_b.Date_From && v_r.Visit_Completion_Date <= v_b.Date_To)
                 			{
                 				v_inRange = v_inRange + 1;
                 			}
                 			if(v_r.Hold_From_Invoicing != "Yes")
                 			{
                 				v_notHeld = v_notHeld + 1;
                 			}
                 		}
                 	}
                 	v_out = "Batch branch ID: " + v_b.Partner_Location_Link + " | Range: " + v_b.Date_From + " to " + v_b.Date_To;
                 	v_out = v_out + "\nTotal PVS: " + v_allPvs;
                 	v_out = v_out + "\nPVS with no Billing Branch: " + v_noBranch;
                 	v_out = v_out + "\nPVS with no Visit Completion Date: " + v_noDate;
                 	v_out = v_out + "\nPVS with blank Invoice Status: " + v_nullStatus;
                 	v_out = v_out + "\nOn this branch: " + v_onBranch;
                 	v_out = v_out + "\n  of those, Invoice Status = Draft: " + v_draft;
                 	v_out = v_out + "\n  of those, no Invoice Link: " + v_noInvoice;
                 	v_out = v_out + "\n  of those, in date range: " + v_inRange;
                 	v_out = v_out + "\n  of those, not held: " + v_notHeld;
                 	return v_out;
                 }
				 string diag_partner_rates()
                 {
                 	v_need = List();
                 	v_need.add("High Complexity");
                 	v_need.add("Moderate Complexity");
                 	v_need.add("Low Complexity");
                 	v_need.add("Hospital at Home");
                 	v_need.add("Telemedicine");
                 	v_need.add("Care Coordination");
                 	v_need.add("General Consultation");
                 	v_need.add("Cares 3008 Assessment");
                 	v_out = "";
                 	v_totalRates = 0;
                 	v_locsOk = 0;
                 	v_locsShort = 0;
                 	for each  v_l in Partner_Locations[Partner_Location_Status == "Active"]
                 	{
                 		v_have = List();
                 		v_low = List();
                 		for each  v_r in Partner_Rates[Partner_Location_Link == v_l.ID && Current_Rate == "Yes"]
                 		{
                 			v_totalRates = v_totalRates + 1;
                 			v_have.add(v_r.Rate_Type);
                 			v_amt = 0.0;
                 			if(v_r.Rate_Amount != null)
                 			{
                 				v_amt = v_r.Rate_Amount.toDecimal();
                 			}
                 			if(v_amt <= 1)
                 			{
                 				v_low.add(v_r.Rate_Type + "=" + v_amt);
                 			}
                 		}
                 		v_missing = List();
                 		for each  v_n in v_need
                 		{
                 			if(!v_have.contains(v_n))
                 			{
                 				v_missing.add(v_n);
                 			}
                 		}
                 		v_books = "no BooksID";
                 		if(v_l.Books_Customer_ID != null && v_l.Books_Customer_ID.trim() != "")
                 		{
                 			v_books = "BooksID ok";
                 		}
                 		if(v_missing.size() == 0 && v_low.size() == 0)
                 		{
                 			v_locsOk = v_locsOk + 1;
                 			v_out = v_out + "\nOK   " + v_l.Partner_Location_Label + " (" + v_have.size() + " rates, " + v_books + ")";
                 		}
                 		else
                 		{
                 			v_locsShort = v_locsShort + 1;
                 			v_out = v_out + "\nSHORT " + v_l.Partner_Location_Label + " (" + v_have.size() + " rates, " + v_books + ")";
                 			if(v_missing.size() > 0)
                 			{
                 				v_out = v_out + "\n      missing: " + v_missing.toString(", ");
                 			}
                 			if(v_low.size() > 0)
                 			{
                 				v_out = v_out + "\n      suspect amounts: " + v_low.toString(", ");
                 			}
                 		}
                 	}
                 	return "Active branches OK: " + v_locsOk + " | short: " + v_locsShort + " | total current rates: " + v_totalRates + "\n" + v_out;
                 }
				 string diag_referral_contact_match()
                 {
                 	v_totalC = 0;
                 	v_cWithLoc = 0;
                 	for each  c in Partner_Referral_Contacts[ID != 0]
                 	{
                 		v_totalC = v_totalC + 1;
                 		if(c.Partner_Locations_Link != null)
                 		{
                 			v_cWithLoc = v_cWithLoc + 1;
                 		}
                 	}
                 	v_noEmail = 0;
                 	v_noContact = 0;
                 	v_noLoc = 0;
                 	v_ok = 0;
                 	v_sample = List();
                 	for each  r in Referrals_Main[Partner_Branch_Link == null]
                 	{
                 		v_email = r.Partner_POC_Email;
                 		if(v_email == null || v_email.trim() == "")
                 		{
                 			v_noEmail = v_noEmail + 1;
                 			continue;
                 		}
                 		v_c = Partner_Referral_Contacts[Partner_POC_Email == v_email];
                 		if(v_c.ID == null)
                 		{
                 			v_noContact = v_noContact + 1;
                 			if(v_sample.size() < 10)
                 			{
                 				v_sample.add(v_email);
                 			}
                 		}
                 		else if(v_c.Partner_Locations_Link == null)
                 		{
                 			v_noLoc = v_noLoc + 1;
                 			if(v_sample.size() < 10)
                 			{
                 				v_sample.add(v_email + " [contact, no loc]");
                 			}
                 		}
                 		else
                 		{
                 			v_ok = v_ok + 1;
                 		}
                 	}
                 	return "Contacts: " + v_totalC + " | with location link: " + v_cWithLoc + "\nNo email: " + v_noEmail + " | No contact record: " + v_noContact + " | Contact but no location: " + v_noLoc + " | Would match: " + v_ok + "\nSamples: " + v_sample.toString(", ");
                 }
				 string fix_accentcare_current_rate()
                 {
                 	v_fixed = 0;
                 	for each  v_r in Partner_Rates[Current_Rate != "Yes"]
                 	{
                 		v_l = Partner_Locations[ID == v_r.Partner_Location_Link];
                 		if(v_l.ID != null && v_l.Partner_Location_Code != "BRO" && v_r.Partner_Rates_Effective_Date == null)
                 		{
                 			v_p = Partners[ID == v_l.Partner_Link];
                 			if(v_p.ID != null && v_p.Partner_Code == "ACC")
                 			{
                 				v_r.Current_Rate="Yes";
                 				v_r.Partner_Rate_Status="Active";
                 				v_fixed = v_fixed + 1;
                 			}
                 		}
                 	}
                 	return "Set Current_Rate=Yes and Status=Active on " + v_fixed + " AccentCare rates.";
                 }
				 map get_partner_referral_contact(string pPocEmail)
                 {
                 	response = Map();
                 	response.put("Partner_POC_First_Name","");
                 	response.put("Partner_POC_Last_Name","");
                 	response.put("Partner_POC_Title","");
                 	response.put("Partner_POC_Phone","");
                 	response.put("Partner_Organization","");
                 	response.put("Partner_Branch","");
                 	response.put("Partner_POC_Team","");
                 	v_Email = pPocEmail.trim();
                 	v_Contacts = Partner_Referral_Contacts[Partner_POC_Email == v_Email];
                 	for each  v_Rec in v_Contacts
                 	{
                 		response.put("Partner_POC_First_Name",v_Rec.Partner_POC_First_Name);
                 		response.put("Partner_POC_Last_Name",v_Rec.Partner_POC_Last_Name);
                 		response.put("Partner_POC_Title",v_Rec.Partner_POC_Title);
                 		response.put("Partner_POC_Phone",v_Rec.Partner_POC_Phone);
                 		response.put("Partner_Organization",v_Rec.Partner_Organization);
                 		response.put("Partner_Branch",v_Rec.Partner_Branch);
                 		response.put("Partner_POC_Team",v_Rec.Partner_POC_Team);
                 		break;
                 	}
                 	return response;
                 }
				 string link_pvs_to_referral()
                 {
                 	v_linked = 0;
                 	v_nomatch = 0;
                 	for each  p in Encounter_PatientVisit[Referral_Link == null && Referral_ID != ""]
                 	{
                 		v_Ref = Referrals_Main[Referral_ID == p.Referral_ID];
                 		if(v_Ref.ID != null)
                 		{
                 			p.Referral_Link=v_Ref.ID;
                 			v_linked = v_linked + 1;
                 		}
                 		else
                 		{
                 			v_nomatch = v_nomatch + 1;
                 		}
                 	}
                 	return "PVS link - linked: " + v_linked + " | no match: " + v_nomatch;
                 }
				 void log_change(string source_form, string source_rec_id, string source_display_id, string field_label, string old_val, string new_val, string changed_by)
                 {
                 }
				 void mint_assignment_id(int recId)
                 {
                 	rec = Assignments[ID == recId];
                 	if(rec != null)
                 	{
                 		existing = rec.Assignment_ID;
                 		if(existing == null)
                 		{
                 			existing = "";
                 		}
                 		if(existing.trim() == "")
                 		{
                 			v_seq = 0;
                 			for each  trk in Sequence_Tracker[Object_Prefix == "ASG"]
                 			{
                 				v_seq = trk.Object_Sequence;
                 			}
                 			rec.Assignment_ID="ASG-" + v_seq;
                 			rec.Assignment_ID_Stamp=recId.toString();
                 			for each  trk in Sequence_Tracker[Object_Prefix == "ASG"]
                 			{
                 				trk.Object_Sequence=v_seq + 1;
                 			}
                 		}
                 	}
                 }
				 void mint_employee_id(int recId)
                 {
                 	rec = Employees[ID == recId];
                 	if(rec != null)
                 	{
                 		existing = rec.Employee_ID;
                 		if(existing == null)
                 		{
                 			existing = "";
                 		}
                 		if(existing.trim() == "")
                 		{
                 			v_seq = 0;
                 			for each  trk in Sequence_Tracker[Object_Prefix == "EMP"]
                 			{
                 				v_seq = trk.Object_Sequence;
                 			}
                 			rec.Employee_ID="EMP-" + v_seq;
                 			rec.Employee_ID_Stamp=recId.toString();
                 			for each  trk in Sequence_Tracker[Object_Prefix == "EMP"]
                 			{
                 				trk.Object_Sequence=v_seq + 1;
                 			}
                 		}
                 	}
                 }
				 void mint_location_id(int recId)
                 {
                 	rec = Partner_Locations[ID == recId];
                 	if(rec != null)
                 	{
                 		existing = rec.Partner_Location_ID;
                 		if(existing == null)
                 		{
                 			existing = "";
                 		}
                 		if(existing.trim() == "" || existing.startsWith("LOC-REVIEW-"))
                 		{
                 			partnerRec = Partners[ID == rec.Partner_Link];
                 			v_partnerCode = "";
                 			if(partnerRec != null)
                 			{
                 				v_partnerCode = partnerRec.Partner_Code;
                 			}
                 			if(v_partnerCode == null)
                 			{
                 				v_partnerCode = "";
                 			}
                 			v_branchCode = rec.Partner_Location_Code;
                 			if(v_branchCode == null)
                 			{
                 				v_branchCode = "";
                 			}
                 			rec.Partner_Location_ID_Stamp=recId.toString();
                 			if(v_partnerCode.trim() == "" || v_branchCode.trim() == "")
                 			{
                 				rec.Partner_Location_ID="LOC-REVIEW-" + recId.toString();
                 			}
                 			else
                 			{
                 				v_seq = 0;
                 				for each  trk in Sequence_Tracker[Object_Prefix == "LOC"]
                 				{
                 					v_seq = trk.Object_Sequence;
                 				}
                 				rec.Partner_Location_ID="LOC-" + v_partnerCode + v_branchCode + "-" + v_seq;
                 				for each  trk in Sequence_Tracker[Object_Prefix == "LOC"]
                 				{
                 					trk.Object_Sequence=v_seq + 1;
                 				}
                 			}
                 		}
                 	}
                 }
				 void mint_partner_id(int recId)
                 {
                 	rec = Partners[ID == recId];
                 	if(rec != null)
                 	{
                 		existing = rec.Partner_ID;
                 		if(existing == null)
                 		{
                 			existing = "";
                 		}
                 		if(existing.trim() == "" || existing.startsWith("PAR-REVIEW-"))
                 		{
                 			v_partnerCode = rec.Partner_Code;
                 			if(v_partnerCode == null)
                 			{
                 				v_partnerCode = "";
                 			}
                 			rec.Partner_ID_Stamp=recId.toString();
                 			if(v_partnerCode.trim() == "")
                 			{
                 				rec.Partner_ID="PAR-REVIEW-" + recId.toString();
                 			}
                 			else
                 			{
                 				v_seq = 0;
                 				for each  trk in Sequence_Tracker[Object_Prefix == "PAR"]
                 				{
                 					v_seq = trk.Object_Sequence;
                 				}
                 				rec.Partner_ID="PAR-" + v_partnerCode + "-" + v_seq;
                 				for each  trk in Sequence_Tracker[Object_Prefix == "PAR"]
                 				{
                 					trk.Object_Sequence=v_seq + 1;
                 				}
                 			}
                 		}
                 	}
                 }
				 void mint_referral_id(int recId)
                 {
                 	rec = Referrals_Main[ID == recId];
                 	if(rec != null)
                 	{
                 		existing = rec.Referral_ID;
                 		if(existing == null)
                 		{
                 			existing = "";
                 		}
                 		if(existing.trim() == "")
                 		{
                 			v_seq = 0;
                 			for each  trk in Sequence_Tracker[Object_Prefix == "REF"]
                 			{
                 				v_seq = trk.Object_Sequence;
                 			}
                 			rec.Referral_ID="REF-" + v_seq;
                 			rec.Referral_ID_Stamp=recId.toString();
                 			for each  trk in Sequence_Tracker[Object_Prefix == "REF"]
                 			{
                 				trk.Object_Sequence=v_seq + 1;
                 			}
                 		}
                 	}
                 }
				 string replicate_uniform_rates()
                 {
                 	v_out = "";
                 	v_inserted = 0;
                 	for each  v_p in Partners[Rate_Structure == "Uniform (All Locations)" && Partner_Status == "Active"]
                 	{
                 		v_srcId = null;
                 		v_srcCount = 0;
                 		for each  v_l in Partner_Locations[Partner_Link == v_p.ID && Partner_Location_Status == "Active"]
                 		{
                 			v_c = 0;
                 			for each  v_r in Partner_Rates[Partner_Location_Link == v_l.ID && Current_Rate == "Yes"]
                 			{
                 				v_c = v_c + 1;
                 			}
                 			if(v_c > v_srcCount)
                 			{
                 				v_srcCount = v_c;
                 				v_srcId = v_l.ID;
                 			}
                 		}
                 		if(v_srcId == null || v_srcCount == 0)
                 		{
                 			v_out = v_out + "\n" + v_p.Partner_Display_Name + ": SKIPPED - no branch has rates to copy from.";
                 			continue;
                 		}
                 		v_src = Partner_Locations[ID == v_srcId];
                 		v_out = v_out + "\n" + v_p.Partner_Display_Name + ": source = " + v_src.Partner_Location_Label + " (" + v_srcCount + " rates)";
                 		for each  v_t in Partner_Locations[Partner_Link == v_p.ID && Partner_Location_Status == "Active"]
                 		{
                 			if(v_t.ID != v_srcId)
                 			{
                 				v_existing = 0;
                 				for each  v_x in Partner_Rates[Partner_Location_Link == v_t.ID]
                 				{
                 					v_existing = v_existing + 1;
                 				}
                 				if(v_existing > 0)
                 				{
                 					v_out = v_out + "\n   " + v_t.Partner_Location_Label + ": skipped, already has " + v_existing + " rate record(s)";
                 				}
                 				else
                 				{
                 					v_n = 0;
                 					for each  v_r in Partner_Rates[Partner_Location_Link == v_srcId && Current_Rate == "Yes"]
                 					{
                 						v_newId = insert into Partner_Rates
                 						[
                 							Partner_Link=v_p.ID
                 							Partner_Location_Link=v_t.ID
                 							Rate_Category=v_r.Rate_Category
                 							Rate_Type=v_r.Rate_Type
                 							Rate_Amount=v_r.Rate_Amount
                 							Partner_Rates_Effective_Date=v_r.Partner_Rates_Effective_Date
                 							Current_Rate="Yes"
                 							Partner_Rate_Status="Active"
                 							Added_User=zoho.loginuser
                 						];
                 						v_newRec = Partner_Rates[ID == v_newId];
                 						v_newRec.Partner_Rate_ID_Stamp=v_newId.toString();
                 						v_n = v_n + 1;
                 						v_inserted = v_inserted + 1;
                 					}
                 					v_out = v_out + "\n   " + v_t.Partner_Location_Label + ": copied " + v_n + " rates";
                 				}
                 			}
                 		}
                 	}
                 	return "Inserted " + v_inserted + " rate records." + v_out;
                 }
				 string report_partner_rate_coverage()
                 {
                 	v_need = List();
                 	v_need.add("High Complexity");
                 	v_need.add("Moderate Complexity");
                 	v_need.add("Low Complexity");
                 	v_need.add("Hospital at Home");
                 	v_need.add("Telemedicine");
                 	v_need.add("Care Coordination");
                 	v_need.add("General Consultation");
                 	v_need.add("Cares 3008 Assessment");
                 	v_totalRates = 0;
                 	v_orphans = List();
                 	for each  v_r in Partner_Rates[ID != 0]
                 	{
                 		v_totalRates = v_totalRates + 1;
                 		v_bad = false;
                 		if(v_r.Partner_Location_Link == null)
                 		{
                 			v_bad = true;
                 		}
                 		else
                 		{
                 			v_chk = Partner_Locations[ID == v_r.Partner_Location_Link];
                 			if(v_chk.ID == null)
                 			{
                 				v_bad = true;
                 			}
                 		}
                 		if(v_bad)
                 		{
                 			v_orphans.add("RATE ID " + v_r.ID + " | " + v_r.Rate_Category + " | " + v_r.Rate_Type + " | " + v_r.Rate_Amount + " | cur=" + v_r.Current_Rate + " | link=" + v_r.Partner_Location_Link);
                 		}
                 	}
                 	v_keys = List();
                 	for each  v_l in Partner_Locations[ID != 0]
                 	{
                 		v_lbl = v_l.Partner_Location_Label;
                 		if(v_lbl == null || v_lbl.trim() == "")
                 		{
                 			v_lbl = "(no label) ID " + v_l.ID;
                 		}
                 		v_keys.add(v_lbl + "::" + v_l.ID);
                 	}
                 	v_keys = v_keys.sort(true);
                 	v_out = "";
                 	v_locCount = 0;
                 	v_zeroRate = List();
                 	for each  v_k in v_keys
                 	{
                 		v_idx = v_k.indexOf("::");
                 		v_id = v_k.subString(v_idx + 2).toLong();
                 		v_l = Partner_Locations[ID == v_id];
                 		v_locCount = v_locCount + 1;
                 		v_pName = "NO PARTNER LINK";
                 		v_pCode = "-";
                 		v_pStatus = "-";
                 		v_pRateStruct = "-";
                 		if(v_l.Partner_Link != null)
                 		{
                 			v_p = Partners[ID == v_l.Partner_Link];
                 			if(v_p.ID != null)
                 			{
                 				v_pName = v_p.Partner_Display_Name;
                 				v_pCode = v_p.Partner_Code;
                 				v_pStatus = v_p.Partner_Status;
                 				v_pRateStruct = v_p.Rate_Structure;
                 			}
                 			else
                 			{
                 				v_pName = "BROKEN PARTNER LINK " + v_l.Partner_Link;
                 			}
                 		}
                 		v_books = "MISSING";
                 		if(v_l.Books_Customer_ID != null && v_l.Books_Customer_ID.trim() != "")
                 		{
                 			v_books = v_l.Books_Customer_ID;
                 		}
                 		v_out = v_out + "\n------------------------------------------------------------";
                 		v_out = v_out + "\nLOCATION : " + v_l.Partner_Location_Label + "   [" + v_l.Partner_Location_Status + "]";
                 		v_out = v_out + "\n  partner: " + v_pName + " (code " + v_pCode + ", status " + v_pStatus + ", rate structure " + v_pRateStruct + ")";
                 		v_out = v_out + "\n  loc name/code: " + v_l.Partner_Location_Name + " / " + v_l.Partner_Location_Code + "   locID: " + v_l.Partner_Location_ID;
                 		v_out = v_out + "\n  books customer: " + v_books;
                 		v_have = List();
                 		v_rateLines = List();
                 		for each  v_r in Partner_Rates[Partner_Location_Link == v_id]
                 		{
                 			v_amt = 0.0;
                 			if(v_r.Rate_Amount != null)
                 			{
                 				v_amt = v_r.Rate_Amount.toDecimal();
                 			}
                 			v_cur = v_r.Current_Rate;
                 			if(v_cur == null)
                 			{
                 				v_cur = "-";
                 			}
                 			v_st = v_r.Partner_Rate_Status;
                 			if(v_st == null)
                 			{
                 				v_st = "-";
                 			}
                 			v_eff = "-";
                 			if(v_r.Partner_Rates_Effective_Date != null)
                 			{
                 				v_eff = v_r.Partner_Rates_Effective_Date.toString("MM-dd-yyyy");
                 			}
                 			v_flag = "";
                 			if(v_amt <= 1)
                 			{
                 				v_flag = "   <<< SUSPECT AMOUNT";
                 			}
                 			if(v_cur != "Yes")
                 			{
                 				v_flag = v_flag + "   <<< NOT CURRENT";
                 			}
                 			v_rateLines.add("  rate   : " + v_r.Rate_Category + " | " + v_r.Rate_Type + " | " + v_amt + " | cur=" + v_cur + " | status=" + v_st + " | eff=" + v_eff + v_flag);
                 			if(v_cur == "Yes")
                 			{
                 				v_have.add(v_r.Rate_Type);
                 			}
                 		}
                 		if(v_rateLines.size() == 0)
                 		{
                 			v_out = v_out + "\n  rate   : NONE";
                 			v_zeroRate.add(v_l.Partner_Location_Label);
                 		}
                 		else
                 		{
                 			v_rateLines = v_rateLines.sort(true);
                 			for each  v_rl in v_rateLines
                 			{
                 				v_out = v_out + "\n" + v_rl;
                 			}
                 		}
                 		v_missing = List();
                 		for each  v_n in v_need
                 		{
                 			if(!v_have.contains(v_n))
                 			{
                 				v_missing.add(v_n);
                 			}
                 		}
                 		if(v_missing.size() > 0)
                 		{
                 			v_out = v_out + "\n  MISSING: " + v_missing.toString(", ");
                 		}
                 		else
                 		{
                 			v_out = v_out + "\n  MISSING: none";
                 		}
                 	}
                 	v_head = "PARTNER RATE COVERAGE";
                 	v_head = v_head + "\nLocations: " + v_locCount + " | Partner_Rates records: " + v_totalRates + " | locations with no rates: " + v_zeroRate.size() + " | orphaned rate records: " + v_orphans.size();
                 	if(v_zeroRate.size() > 0)
                 	{
                 		v_head = v_head + "\nNO RATES AT ALL: " + v_zeroRate.toString(", ");
                 	}
                 	if(v_orphans.size() > 0)
                 	{
                 		v_head = v_head + "\n\nORPHANED RATE RECORDS (no valid location link)";
                 		for each  v_o in v_orphans
                 		{
                 			v_head = v_head + "\n  " + v_o;
                 		}
                 	}
                 	return v_head + "\n" + v_out;
                 }
				 string run_invoice_batch(int p_batchId)
                 {
                 	v_b = Invoice_Batch[ID == p_batchId];
                 	if(v_b.ID == null)
                 	{
                 		return "ERROR: Batch record not found.";
                 	}
                 	if(v_b.Partner_Location_Link == null)
                 	{
                 		v_b.Batch_Status="Failed";
                 		v_b.Result_Message="ERROR: No billing branch selected.";
                 		return v_b.Result_Message;
                 	}
                 	if(v_b.Date_From == null || v_b.Date_To == null)
                 	{
                 		v_b.Batch_Status="Failed";
                 		v_b.Result_Message="ERROR: Date From and Date To are both required.";
                 		return v_b.Result_Message;
                 	}
                 	if(v_b.Date_From > v_b.Date_To)
                 	{
                 		v_b.Batch_Status="Failed";
                 		v_b.Result_Message="ERROR: Date From is after Date To.";
                 		return v_b.Result_Message;
                 	}
                 	v_ids = List();
                 	v_bad = List();
                 	v_recs = Encounter_PatientVisit[Billing_Branch == v_b.Partner_Location_Link && Invoice_Status == "Draft" && Visit_Completion_Date >= v_b.Date_From && Visit_Completion_Date <= v_b.Date_To];
                 	for each  v_r in v_recs
                 	{
                 		if(v_r.Invoice_Link == null && v_r.Hold_From_Invoicing != "Yes")
                 		{
                 			v_lvl = v_r.Complexity_Level;
                 			if(v_lvl == null)
                 			{
                 				v_lvl = "";
                 			}
                 			v_amt = 0.0;
                 			if(v_r.Complexity_Charge != null)
                 			{
                 				v_amt = v_r.Complexity_Charge.toDecimal();
                 			}
                 			if(v_lvl.trim() == "")
                 			{
                 				v_bad.add(v_r.PVS_ID + " (no complexity level)");
                 			}
                 			else if(v_amt <= 0 && v_lvl != "No Charge")
                 			{
                 				v_bad.add(v_r.PVS_ID + " (" + v_lvl + " has no rate)");
                 			}
                 			else
                 			{
                 				v_ids.add(v_r.ID);
                 			}
                 		}
                 	}
                 	if(v_bad.size() > 0)
                 	{
                 		v_b.Batch_Status="Failed";
                 		v_b.Result_Message="ERROR: " + v_bad.size() + " visit(s) have a missing or zero rate. Fix these and re-run: " + v_bad.toString(", ");
                 		return v_b.Result_Message;
                 	}
                 	if(v_ids.size() == 0)
                 	{
                 		v_b.Batch_Status="Failed";
                 		v_b.Result_Message="No eligible visits found for that branch and date range.";
                 		return v_b.Result_Message;
                 	}
                 	v_out = thisapp.create_invoice_from_selection(v_ids);
                 	v_b.Result_Message=v_out;
                 	if(v_out.startsWith("ERROR"))
                 	{
                 		v_b.Batch_Status="Failed";
                 	}
                 	else
                 	{
                 		v_b.Batch_Status="Complete";
                 	}
                 	return v_out;
                 }
				 void run_schema_monitor()
                 {
                 	ownerName = "sosmmc";
                 	appName = "sos-referrals-app";
                 	baseUrl = "https://www.zohoapis.com/creator/v2.1/meta/" + ownerName + "/" + appName;
                 	repoOwner = "m1ndspark";
                 	repoName = "sos-emr";
                 	branch = "main";
                 	alertTo = "neil.heird@sosmmc.com";
                 	typeMap = Map();
                 	typeMap.put("1","Single Line");
                 	typeMap.put("2","Multi Line");
                 	typeMap.put("3","Email");
                 	typeMap.put("5","Number");
                 	typeMap.put("6","Decimal");
                 	typeMap.put("8","Currency");
                 	typeMap.put("9","Auto Number");
                 	typeMap.put("10","Date");
                 	typeMap.put("11","Date-Time");
                 	typeMap.put("12","Dropdown/Lookup");
                 	typeMap.put("13","Radio");
                 	typeMap.put("14","Multi Select");
                 	typeMap.put("15","Checkbox");
                 	typeMap.put("16","Decision Box");
                 	typeMap.put("19","File Upload");
                 	typeMap.put("20","Formula");
                 	typeMap.put("21","Subform");
                 	typeMap.put("27","Phone");
                 	typeMap.put("29","Name");
                 	typeMap.put("30","Address");
                 	currentMap = Map();
                 	fileMap = Map();
                 	formsResp = invokeurl
                 	[
                 		url :baseUrl + "/forms"
                 		type :GET
                 		connection:"sos_schema_monitor"
                 	];
                 	if(formsResp.get("code") != 3000)
                 	{
                 		thisapp.send_via_sendgrid(alertTo,"SOS EMR schema monitor ERROR (forms)","Get Forms failed. Response: " + formsResp.toString());
                 		return;
                 	}
                 	for each  frm in formsResp.get("forms")
                 	{
                 		formLink = frm.get("link_name");
                 		if(formLink != "Schema_Snapshot")
                 		{
                 			fieldsResp = invokeurl
                 			[
                 				url :baseUrl + "/form/" + formLink + "/fields"
                 				type :GET
                 				connection:"sos_schema_monitor"
                 			];
                 			if(fieldsResp.get("code") != 3000)
                 			{
                 				thisapp.send_via_sendgrid(alertTo,"SOS EMR schema monitor ERROR (fields)","Get Fields failed for form " + formLink + ". Response: " + fieldsResp.toString());
                 				return;
                 			}
                 			formDisplay = frm.get("display_name");
                 			fieldMap = Map();
                 			fieldRows = List();
                 			for each  fld in fieldsResp.get("fields")
                 			{
                 				fLink = fld.get("link_name");
                 				if(fLink != null)
                 				{
                 					attr = fld.get("type") + "~" + fld.get("mandatory") + "~" + fld.get("unique");
                 					fieldMap.put(fLink,attr);
                 					tcStr = fld.get("type").toLong().toString();
                 					tName = typeMap.get(tcStr);
                 					if(tName == null)
                 					{
                 						typeLabel = "Type " + tcStr;
                 					}
                 					else
                 					{
                 						typeLabel = tName + " (" + tcStr + ")";
                 					}
                 					dName = fld.get("display_name");
                 					if(dName == null)
                 					{
                 						dName = "";
                 					}
                 					mandStr = "no";
                 					if(fld.get("mandatory") == true)
                 					{
                 						mandStr = "YES";
                 					}
                 					uniqStr = "no";
                 					if(fld.get("unique") == true)
                 					{
                 						uniqStr = "YES";
                 					}
                 					detail = "";
                 					if(fld.get("choices") != null)
                 					{
                 						chList = List();
                 						for each  ch in fld.get("choices")
                 						{
                 							chList.add(ch.get("value"));
                 						}
                 						detail = "choices: " + chList.toString(", ");
                 					}
                 					else if(fld.get("subfields") != null)
                 					{
                 						sfList = List();
                 						for each  sf in fld.get("subfields")
                 						{
                 							sfName = sf.get("link_name");
                 							if(sf.get("is_hidden") == true)
                 							{
                 								sfName = sfName + " (hidden)";
                 							}
                 							sfList.add(sfName);
                 						}
                 						detail = "subfields: " + sfList.toString(", ");
                 					}
                 					else if(fld.get("max_char") != null)
                 					{
                 						detail = "max " + fld.get("max_char");
                 					}
                 					fieldRows.add("| " + fLink + " | " + dName + " | " + typeLabel + " | " + mandStr + " | " + uniqStr + " | " + detail + " |");
                 				}
                 			}
                 			currentMap.put(formLink,fieldMap);
                 			contentLines = List();
                 			contentLines.add("# Schema: " + formDisplay);
                 			contentLines.add("");
                 			contentLines.add("Form link name: `" + formLink + "`");
                 			contentLines.add("Auto-generated by the SOS schema monitor. Source of truth is the live Creator app.");
                 			contentLines.add("Captured: " + zoho.currenttime);
                 			contentLines.add("Field count: " + fieldRows.size());
                 			contentLines.add("");
                 			contentLines.add("| Link Name | Display Name | Type | Mandatory | Unique | Detail |");
                 			contentLines.add("|---|---|---|---|---|---|");
                 			for each  r in fieldRows
                 			{
                 				contentLines.add(r);
                 			}
                 			fileMap.put(formLink,contentLines.toString("\n"));
                 		}
                 	}
                 	formKeys = currentMap.keys();
                 	formKeys = formKeys.sort(true);
                 	lineList = List();
                 	for each  fk in formKeys
                 	{
                 		fMap = currentMap.get(fk);
                 		fldKeys = fMap.keys();
                 		fldKeys = fldKeys.sort(true);
                 		entryList = List();
                 		for each  fl in fldKeys
                 		{
                 			entryList.add(fl + "~" + fMap.get(fl));
                 		}
                 		lineList.add(fk + "::" + entryList.toString(";;"));
                 	}
                 	lineList = lineList.sort(true);
                 	currentSnapshot = lineList.toString("\n");
                 	activeForms = currentMap.keys();
                 	activeForms = activeForms.sort(true);
                 	activeFormsHtml = activeForms.toString("<br>");
                 	previousData = "";
                 	previousSummary = "";
                 	latestTime = null;
                 	for each  rec in Schema_Snapshot[ID != null]
                 	{
                 		if(latestTime == null || rec.Captured_On > latestTime)
                 		{
                 			latestTime = rec.Captured_On;
                 			previousData = rec.Snapshot_Data;
                 			previousSummary = rec.Change_Summary;
                 		}
                 	}
                 	if(previousData == null)
                 	{
                 		previousData = "";
                 	}
                 	if(previousData == "")
                 	{
                 		insert into Schema_Snapshot
                 		[
                 			Snapshot_Data=currentSnapshot
                 			Captured_On=zoho.currenttime
                 			Change_Summary="Baseline captured"
                 			Added_User=zoho.loginuser
                 		]
                 		for each  cf in currentMap.keys()
                 		{
                 			bPath = "schema/" + cf + ".md";
                 			bPayload = Map();
                 			bPayload.put("message","schema: baseline " + cf);
                 			bPayload.put("content",zoho.encryption.base64Encode(fileMap.get(cf)));
                 			bPayload.put("branch",branch);
                 			bGet = invokeurl
                 			[
                 				url :"https://api.github.com/repos/" + repoOwner + "/" + repoName + "/contents/" + bPath + "?ref=" + branch
                 				type :GET
                 				connection:"sos_github_sync"
                 			];
                 			if(bGet.get("sha") != null)
                 			{
                 				bPayload.put("sha",bGet.get("sha"));
                 			}
                 			invokeurl
                 			[
                 				url :"https://api.github.com/repos/" + repoOwner + "/" + repoName + "/contents/" + bPath
                 				type :PUT
                 				parameters:bPayload.toString()
                 				connection:"sos_github_sync"
                 			]
                 		}
                 		thisapp.send_via_sendgrid(alertTo,"SOS EMR schema monitor: baseline captured","Baseline captured on " + zoho.currenttime + ". Forms tracked: " + currentMap.size() + ". Schema files committed to schema/ in " + repoOwner + "/" + repoName + ".");
                 		return;
                 	}
                 	prevMap = Map();
                 	for each  pline in previousData.toList("\n")
                 	{
                 		pIdx = pline.indexOf("::");
                 		if(pIdx > -1)
                 		{
                 			pForm = pline.subString(0,pIdx);
                 			pRest = pline.subString(pIdx + 2);
                 			pFieldMap = Map();
                 			if(pRest != "")
                 			{
                 				for each  pe in pRest.toList(";;")
                 				{
                 					eIdx = pe.indexOf("~");
                 					if(eIdx > -1)
                 					{
                 						peLink = pe.subString(0,eIdx);
                 						peAttr = pe.subString(eIdx + 1);
                 						pFieldMap.put(peLink,peAttr);
                 					}
                 				}
                 			}
                 			prevMap.put(pForm,pFieldMap);
                 		}
                 	}
                 	addedForms = List();
                 	removedForms = List();
                 	changedForms = List();
                 	formAddedLines = List();
                 	formRemovedLines = List();
                 	fieldAddedLines = List();
                 	fieldChangedLines = List();
                 	fieldRemovedLines = List();
                 	for each  fk in currentMap.keys()
                 	{
                 		if(!prevMap.keys().contains(fk))
                 		{
                 			addedForms.add(fk);
                 			formAddedLines.add("FORM ADDED: " + fk);
                 		}
                 	}
                 	for each  pk in prevMap.keys()
                 	{
                 		if(!currentMap.keys().contains(pk))
                 		{
                 			removedForms.add(pk);
                 			formRemovedLines.add("FORM REMOVED: " + pk);
                 		}
                 	}
                 	for each  fk in currentMap.keys()
                 	{
                 		if(prevMap.keys().contains(fk))
                 		{
                 			curFields = currentMap.get(fk);
                 			prevFields = prevMap.get(fk);
                 			formTouched = false;
                 			for each  cf in curFields.keys()
                 			{
                 				if(!prevFields.keys().contains(cf))
                 				{
                 					fieldAddedLines.add(fk + "." + cf + " (" + curFields.get(cf) + ")");
                 					formTouched = true;
                 				}
                 				else if(curFields.get(cf) != prevFields.get(cf))
                 				{
                 					fieldChangedLines.add(fk + "." + cf + " [" + prevFields.get(cf) + " -> " + curFields.get(cf) + "]");
                 					formTouched = true;
                 				}
                 			}
                 			for each  pf in prevFields.keys()
                 			{
                 				if(!curFields.keys().contains(pf))
                 				{
                 					fieldRemovedLines.add(fk + "." + pf);
                 					formTouched = true;
                 				}
                 			}
                 			if(formTouched)
                 			{
                 				changedForms.add(fk);
                 			}
                 		}
                 	}
                 	suspectPull = false;
                 	if(currentMap.size() == 0)
                 	{
                 		suspectPull = true;
                 	}
                 	else if(prevMap.size() >= 5 && removedForms.size() * 10 > prevMap.size() * 3)
                 	{
                 		suspectPull = true;
                 	}
                 	if(suspectPull)
                 	{
                 		warnBody = "<div style=\"font-family:-apple-system,'Segoe UI',sans-serif;font-size:14px;\">";
                 		warnBody = warnBody + "<p><b>SUSPECTED PARTIAL / BAD SCHEMA PULL - no changes were written.</b></p>";
                 		warnBody = warnBody + "<p>Run time: " + zoho.currenttime + "<br>Forms returned this run: " + currentMap.size() + "<br>Forms in last snapshot: " + prevMap.size() + "<br>Forms appearing removed: " + removedForms.size() + "</p>";
                 		warnBody = warnBody + "<p>This exceeded the safety threshold, so the monitor did NOT tombstone files, did NOT commit, and did NOT update the snapshot. Most likely a transient Meta API hiccup. If a genuine bulk form deletion happened, re-run run_schema_monitor manually to apply it.</p>";
                 		warnBody = warnBody + "<p>Forms flagged removed:<br>" + removedForms.toString("<br>") + "</p>";
                 		warnBody = warnBody + "</div>";
                 		thisapp.send_via_sendgrid(alertTo,"SOS EMR schema monitor: suspected bad pull (no changes applied)",warnBody);
                 		return;
                 	}
                 	totalChanges = formAddedLines.size() + formRemovedLines.size() + fieldAddedLines.size() + fieldChangedLines.size() + fieldRemovedLines.size();
                 	legend = "Attribute format is type~mandatory~unique. Type codes: 1 Single Line, 2 Multi Line, 3 Email, 5 Number, 6 Decimal, 8 Currency, 9 Auto Number, 10 Date, 11 Date-Time, 12 Dropdown/Lookup, 13 Radio, 14 Multi Select, 15 Checkbox, 16 Decision Box, 19 File Upload, 20 Formula, 21 Subform, 27 Phone, 29 Name, 30 Address.";
                 	if(totalChanges == 0)
                 	{
                 		lastTimeStr = "unknown";
                 		if(latestTime != null)
                 		{
                 			lastTimeStr = latestTime.toString();
                 		}
                 		lastSummary = previousSummary;
                 		if(lastSummary == null)
                 		{
                 			lastSummary = "";
                 		}
                 		if(lastSummary.trim() == "")
                 		{
                 			lastSummary = "No change detail recorded for that snapshot.";
                 		}
                 		okBody = "<div style=\"font-family:-apple-system,'Segoe UI',sans-serif;font-size:14px;line-height:1.5;\">";
                 		okBody = okBody + "<p><b>SOS EMR schema monitor ran on " + zoho.currenttime + ".</b></p>";
                 		okBody = okBody + "<p style=\"padding:8px 12px;background:#f0f7f0;border-left:3px solid #2e7d32;\"><b>NO FIELD CHANGES THIS RUN.</b><br>Nothing was added, changed, or removed. No files committed.</p>";
                 		okBody = okBody + "<p>Forms checked: " + currentMap.size() + "</p>";
                 		okBody = okBody + "<p><b>MOST RECENT SCHEMA CHANGE</b><br>Captured: " + lastTimeStr + "</p>";
                 		okBody = okBody + "<pre style=\"background:#f6f6f6;padding:10px;white-space:pre-wrap;font-size:12px;\">" + lastSummary + "</pre>";
                 		okBody = okBody + "<hr><p><b>ACTIVE FORMS AT THIS RUN (" + activeForms.size() + ")</b><br>" + activeFormsHtml + "</p>";
                 		okBody = okBody + "<p style=\"color:#666;font-size:12px;\">" + legend + "</p>";
                 		okBody = okBody + "</div>";
                 		thisapp.send_via_sendgrid(alertTo,"SOS EMR schema monitor: NO CHANGES (" + zoho.currentdate.toString("MM-dd-yyyy") + ")",okBody);
                 		return;
                 	}
                 	insert into Schema_Snapshot
                 	[
                 		Snapshot_Data=currentSnapshot
                 		Captured_On=zoho.currenttime
                 		Change_Summary=formRemovedLines.toString("\n") + "\n" + formAddedLines.toString("\n") + "\n" + fieldAddedLines.toString("\n") + "\n" + fieldChangedLines.toString("\n") + "\n" + fieldRemovedLines.toString("\n")
                 		Added_User=zoho.loginuser
                 	]
                 	for each  rf in removedForms
                 	{
                 		tPath = "schema/" + rf + ".md";
                 		tLines = List();
                 		tLines.add("# " + rf + " - REMOVED FROM CREATOR");
                 		tLines.add("");
                 		tLines.add("This form no longer exists in the live Creator app as of " + zoho.currenttime + ".");
                 		tLines.add("");
                 		tLines.add("## Last-known fields (quick reference)");
                 		tLines.add("Attribute format is type~mandatory~unique. Full detail (choices, subfields, display names) is preserved in this file's GIT HISTORY - open the commit immediately before this one.");
                 		tLines.add("");
                 		tLines.add("| Link Name | type~mandatory~unique |");
                 		tLines.add("|---|---|");
                 		rfPrev = prevMap.get(rf);
                 		rfKeys = rfPrev.keys();
                 		rfKeys = rfKeys.sort(true);
                 		for each  rk in rfKeys
                 		{
                 			tLines.add("| " + rk + " | " + rfPrev.get(rk) + " |");
                 		}
                 		tLines.add("");
                 		tLines.add("Linked workflows/functions are NOT detectable via the Meta API. Before rebuilding, check _INDEX.md and the " + rf + "/ folder for attached .dg files.");
                 		tLines.add("");
                 		tLines.add("ACTION:");
                 		tLines.add("- If this removal was intentional: you may delete this file.");
                 		tLines.add("- If NOT intentional: a form was deleted in Creator - investigate before deleting anything.");
                 		tLines.add("- A form RENAME shows as one REMOVED + one ADDED; if a new form was added this run, this may be a rename.");
                 		tPayload = Map();
                 		tPayload.put("message","schema: TOMBSTONE " + rf + " (removed from Creator)");
                 		tPayload.put("content",zoho.encryption.base64Encode(tLines.toString("\n")));
                 		tPayload.put("branch",branch);
                 		tGet = invokeurl
                 		[
                 			url :"https://api.github.com/repos/" + repoOwner + "/" + repoName + "/contents/" + tPath + "?ref=" + branch
                 			type :GET
                 			connection:"sos_github_sync"
                 		];
                 		if(tGet.get("sha") != null)
                 		{
                 			tPayload.put("sha",tGet.get("sha"));
                 		}
                 		invokeurl
                 		[
                 			url :"https://api.github.com/repos/" + repoOwner + "/" + repoName + "/contents/" + tPath
                 			type :PUT
                 			parameters:tPayload.toString()
                 			connection:"sos_github_sync"
                 		]
                 	}
                 	commitForms = List();
                 	for each  af in addedForms
                 	{
                 		commitForms.add(af);
                 	}
                 	for each  cff in changedForms
                 	{
                 		commitForms.add(cff);
                 	}
                 	committedList = List();
                 	for each  cf in commitForms
                 	{
                 		cPath = "schema/" + cf + ".md";
                 		cPayload = Map();
                 		cPayload.put("message","schema: update " + cf);
                 		cPayload.put("content",zoho.encryption.base64Encode(fileMap.get(cf)));
                 		cPayload.put("branch",branch);
                 		cGet = invokeurl
                 		[
                 			url :"https://api.github.com/repos/" + repoOwner + "/" + repoName + "/contents/" + cPath + "?ref=" + branch
                 			type :GET
                 			connection:"sos_github_sync"
                 		];
                 		if(cGet.get("sha") != null)
                 		{
                 			cPayload.put("sha",cGet.get("sha"));
                 		}
                 		cPut = invokeurl
                 		[
                 			url :"https://api.github.com/repos/" + repoOwner + "/" + repoName + "/contents/" + cPath
                 			type :PUT
                 			parameters:cPayload.toString()
                 			connection:"sos_github_sync"
                 		];
                 		if(cPut.get("content") != null)
                 		{
                 			committedList.add(cf);
                 		}
                 	}
                 	mailBody = "<div style=\"font-family:-apple-system,'Segoe UI',sans-serif;font-size:14px;line-height:1.5;\">";
                 	mailBody = mailBody + "<p><b>SOS EMR schema changes detected on " + zoho.currenttime + ".</b></p>";
                 	if(formRemovedLines.size() > 0)
                 	{
                 		mailBody = mailBody + "<p><b style=\"color:#b00020;\">⚠ FORMS REMOVED (" + formRemovedLines.size() + ")</b></p>";
                 		for each  rf in removedForms
                 		{
                 			mailBody = mailBody + "<div style=\"margin:0 0 10px 0;padding:8px 12px;background:#fdf0f0;border-left:3px solid #b00020;\">";
                 			mailBody = mailBody + "<b>" + rf + "</b> is gone from Creator. Its mirror file <code>schema/" + rf + ".md</code> has been TOMBSTONED (overwritten with a removal notice + last-known fields; full detail stays in git history).<br>";
                 			mailBody = mailBody + "→ If intentional: delete <code>schema/" + rf + ".md</code> from the repo (GitHub Desktop, or on github.com open the file → trash icon → commit).<br>";
                 			mailBody = mailBody + "→ If NOT intentional: investigate - a form was deleted in Creator.<br>";
                 			mailBody = mailBody + "→ If a new form was also added this run, this may be a RENAME, not a deletion.";
                 			mailBody = mailBody + "</div>";
                 		}
                 	}
                 	if(formAddedLines.size() > 0)
                 	{
                 		mailBody = mailBody + "<p><b>FORMS ADDED (" + formAddedLines.size() + ")</b><br>" + formAddedLines.toString("<br>") + "</p>";
                 	}
                 	if(fieldAddedLines.size() > 0)
                 	{
                 		mailBody = mailBody + "<p><b>FIELDS ADDED (" + fieldAddedLines.size() + ")</b><br>" + fieldAddedLines.toString("<br>") + "</p>";
                 	}
                 	if(fieldChangedLines.size() > 0)
                 	{
                 		mailBody = mailBody + "<p><b>FIELDS CHANGED (" + fieldChangedLines.size() + ")</b><br>" + fieldChangedLines.toString("<br>") + "</p>";
                 	}
                 	if(fieldRemovedLines.size() > 0)
                 	{
                 		mailBody = mailBody + "<p><b>FIELDS REMOVED (" + fieldRemovedLines.size() + ")</b><br>" + fieldRemovedLines.toString("<br>") + "</p>";
                 	}
                 	if(committedList.size() > 0)
                 	{
                 		mailBody = mailBody + "<p><b>Files updated in repo (" + committedList.size() + ")</b><br>schema/" + committedList.toString(".md<br>schema/") + ".md</p>";
                 	}
                 	mailBody = mailBody + "<hr><p><b>ACTIVE FORMS AT THIS RUN (" + activeForms.size() + ")</b><br>" + activeFormsHtml + "</p>";
                 	mailBody = mailBody + "<p style=\"color:#666;font-size:12px;\">" + legend + "</p>";
                 	mailBody = mailBody + "</div>";
                 	thisapp.send_via_sendgrid(alertTo,"SOS EMR schema change detected (" + totalChanges + " changes)",mailBody);
                 }
				 void seed_schema_to_github()
                 {
                 	ownerName = "sosmmc";
                 	appName = "sos-referrals-app";
                 	baseUrl = "https://www.zohoapis.com/creator/v2.1/meta/" + ownerName + "/" + appName;
                 	repoOwner = "m1ndspark";
                 	repoName = "sos-emr";
                 	branch = "main";
                 	alertTo = "neil.heird@sosmmc.com";
                 	typeMap = Map();
                 	typeMap.put("1","Single Line");
                 	typeMap.put("2","Multi Line");
                 	typeMap.put("3","Email");
                 	typeMap.put("5","Number");
                 	typeMap.put("6","Decimal");
                 	typeMap.put("8","Currency");
                 	typeMap.put("9","Auto Number");
                 	typeMap.put("10","Date");
                 	typeMap.put("11","Date-Time");
                 	typeMap.put("12","Dropdown/Lookup");
                 	typeMap.put("13","Radio");
                 	typeMap.put("14","Multi Select");
                 	typeMap.put("15","Checkbox");
                 	typeMap.put("16","Decision Box");
                 	typeMap.put("19","File Upload");
                 	typeMap.put("20","Formula");
                 	typeMap.put("21","Subform");
                 	typeMap.put("27","Phone");
                 	typeMap.put("29","Name");
                 	typeMap.put("30","Address");
                 	seededList = List();
                 	failedList = List();
                 	formsResp = invokeurl
                 	[
                 		url :baseUrl + "/forms"
                 		type :GET
                 		connection:"sos_schema_monitor"
                 	];
                 	if(formsResp.get("code") != 3000)
                 	{
                 		sendmail
                 		[
                 			from :zoho.adminuserid
                 			to :alertTo
                 			subject :"SOS schema SEED ERROR (forms)"
                 			message :"Get Forms failed. Response: " + formsResp.toString()
                 		]
                 		return;
                 	}
                 	for each  frm in formsResp.get("forms")
                 	{
                 		formLink = frm.get("link_name");
                 		if(formLink != "Schema_Snapshot")
                 		{
                 			fieldsResp = invokeurl
                 			[
                 				url :baseUrl + "/form/" + formLink + "/fields"
                 				type :GET
                 				connection:"sos_schema_monitor"
                 			];
                 			if(fieldsResp.get("code") != 3000)
                 			{
                 				failedList.add(formLink + " (fields fetch failed)");
                 			}
                 			else
                 			{
                 				formDisplay = frm.get("display_name");
                 				fieldRows = List();
                 				for each  fld in fieldsResp.get("fields")
                 				{
                 					fLink = fld.get("link_name");
                 					if(fLink != null)
                 					{
                 						tcStr = fld.get("type").toLong().toString();
                 						tName = typeMap.get(tcStr);
                 						if(tName == null)
                 						{
                 							typeLabel = "Type " + tcStr;
                 						}
                 						else
                 						{
                 							typeLabel = tName + " (" + tcStr + ")";
                 						}
                 						dName = fld.get("display_name");
                 						if(dName == null)
                 						{
                 							dName = "";
                 						}
                 						mandStr = "no";
                 						if(fld.get("mandatory") == true)
                 						{
                 							mandStr = "YES";
                 						}
                 						uniqStr = "no";
                 						if(fld.get("unique") == true)
                 						{
                 							uniqStr = "YES";
                 						}
                 						detail = "";
                 						if(fld.get("choices") != null)
                 						{
                 							chList = List();
                 							for each  ch in fld.get("choices")
                 							{
                 								chList.add(ch.get("value"));
                 							}
                 							detail = "choices: " + chList.toString(", ");
                 						}
                 						else if(fld.get("subfields") != null)
                 						{
                 							sfList = List();
                 							for each  sf in fld.get("subfields")
                 							{
                 								sfName = sf.get("link_name");
                 								if(sf.get("is_hidden") == true)
                 								{
                 									sfName = sfName + " (hidden)";
                 								}
                 								sfList.add(sfName);
                 							}
                 							detail = "subfields: " + sfList.toString(", ");
                 						}
                 						else if(fld.get("max_char") != null)
                 						{
                 							detail = "max " + fld.get("max_char");
                 						}
                 						rowText = "| " + fLink + " | " + dName + " | " + typeLabel + " | " + mandStr + " | " + uniqStr + " | " + detail + " |";
                 						fieldRows.add(rowText);
                 					}
                 				}
                 				contentLines = List();
                 				contentLines.add("# Schema: " + formDisplay);
                 				contentLines.add("");
                 				contentLines.add("Form link name: `" + formLink + "`");
                 				contentLines.add("Auto-generated by the SOS schema monitor. Source of truth is the live Creator app.");
                 				contentLines.add("Captured: " + zoho.currenttime);
                 				contentLines.add("Field count: " + fieldRows.size());
                 				contentLines.add("");
                 				contentLines.add("| Link Name | Display Name | Type | Mandatory | Unique | Detail |");
                 				contentLines.add("|---|---|---|---|---|---|");
                 				for each  r in fieldRows
                 				{
                 					contentLines.add(r);
                 				}
                 				fileContent = contentLines.toString("\n");
                 				encoded = zoho.encryption.base64Encode(fileContent);
                 				filePath = "schema/" + formLink + ".md";
                 				payload = Map();
                 				payload.put("message","schema: seed " + formLink);
                 				payload.put("content",encoded);
                 				payload.put("branch",branch);
                 				getResp = invokeurl
                 				[
                 					url :"https://api.github.com/repos/" + repoOwner + "/" + repoName + "/contents/" + filePath + "?ref=" + branch
                 					type :GET
                 					connection:"sos_github_sync"
                 				];
                 				if(getResp.get("sha") != null)
                 				{
                 					payload.put("sha",getResp.get("sha"));
                 				}
                 				putResp = invokeurl
                 				[
                 					url :"https://api.github.com/repos/" + repoOwner + "/" + repoName + "/contents/" + filePath
                 					type :PUT
                 					parameters:payload.toString()
                 					connection:"sos_github_sync"
                 				];
                 				if(putResp.get("content") != null)
                 				{
                 					seededList.add(formLink);
                 				}
                 				else
                 				{
                 					failedList.add(formLink + " (commit failed: " + putResp.toString() + ")");
                 				}
                 			}
                 		}
                 	}
                 	bodyHtml = "<div style=\"font-family:-apple-system,'Segoe UI',sans-serif;font-size:14px;\">";
                 	bodyHtml = bodyHtml + "<p>Schema seed complete on " + zoho.currenttime + ".</p>";
                 	bodyHtml = bodyHtml + "<p><b>Seeded (" + seededList.size() + "):</b><br>" + seededList.toString("<br>") + "</p>";
                 	if(failedList.size() > 0)
                 	{
                 		bodyHtml = bodyHtml + "<p><b>Failed (" + failedList.size() + "):</b><br>" + failedList.toString("<br>") + "</p>";
                 	}
                 	bodyHtml = bodyHtml + "<p>Files written to <code>schema/&lt;FormName&gt;.md</code> in m1ndspark/sos-emr. Pull via GitHub Desktop.</p>";
                 	bodyHtml = bodyHtml + "</div>";
                 	sendmail
                 	[
                 		from :zoho.adminuserid
                 		to :alertTo
                 		subject :"SOS schema seed complete (" + seededList.size() + " forms)"
                 		message :bodyHtml
                 	]
                 }
				 void send_via_sendgrid(string pTo, string pSubject, string pMessage)
                 {
                 	toMap = Map();
                 	toMap.put("email",pTo);
                 	toList = List();
                 	toList.add(toMap);
                 	personalization = Map();
                 	personalization.put("to",toList);
                 	persList = List();
                 	persList.add(personalization);
                 	fromMap = Map();
                 	fromMap.put("email","notifications@sosreferrals.com");
                 	fromMap.put("name","SOS Mobile Medical Care");
                 	contentMap = Map();
                 	contentMap.put("type","text/html");
                 	contentMap.put("value",pMessage);
                 	contentList = List();
                 	contentList.add(contentMap);
                 	body = Map();
                 	body.put("personalizations",persList);
                 	body.put("from",fromMap);
                 	body.put("subject",pSubject);
                 	body.put("content",contentList);
                 	sgResponse = invokeurl
                 	[
                 		url :"https://api.sendgrid.com/v3/mail/send"
                 		type :POST
                 		parameters:body.toString()
                 		headers:{"Content-Type":"application/json"}
                 		connection:"sendgrid_connection"
                 	];
                 	info sgResponse;
                 }
				 void set_current_rate(int rateId)
                 {
                 	rate = Partner_Rates[ID == rateId];
                 	v_partner = rate.Partner_Link;
                 	v_loc = rate.Partner_Location_Link;
                 	v_cat = rate.Rate_Category;
                 	v_type = rate.Rate_Type;
                 	v_latestDate = null;
                 	v_latestRec = null;
                 	for each  r in Partner_Rates[Partner_Link == v_partner && Partner_Location_Link == v_loc && Rate_Category == v_cat && Rate_Type == v_type && Partner_Rate_Status == "Active"]
                 	{
                 		if(v_latestDate == null || r.Partner_Rates_Effective_Date >= v_latestDate)
                 		{
                 			v_latestDate = r.Partner_Rates_Effective_Date;
                 			v_latestRec = r.ID;
                 		}
                 	}
                 	for each  r in Partner_Rates[Partner_Link == v_partner && Partner_Location_Link == v_loc && Rate_Category == v_cat && Rate_Type == v_type]
                 	{
                 		if(r.ID == v_latestRec)
                 		{
                 			r.Current_Rate="Yes";
                 		}
                 		else
                 		{
                 			r.Current_Rate="No";
                 		}
                 	}
                 }
				 void set_partner_poc_name_title(int recId)
                 {
                 	rec = Referrals_Main[ID == recId];
                 	if(rec != null)
                 	{
                 		v_name = "";
                 		if(rec.Partner_POC_First_Name != null && rec.Partner_POC_First_Name.trim() != "")
                 		{
                 			v_name = rec.Partner_POC_First_Name.trim();
                 		}
                 		if(rec.Partner_POC_Last_Name != null && rec.Partner_POC_Last_Name.trim() != "")
                 		{
                 			if(v_name != "")
                 			{
                 				v_name = v_name + " ";
                 			}
                 			v_name = v_name + rec.Partner_POC_Last_Name.trim();
                 		}
                 		if(rec.Partner_POC_Title != null && rec.Partner_POC_Title.trim() != "")
                 		{
                 			if(v_name != "")
                 			{
                 				v_name = v_name + ", ";
                 			}
                 			v_name = v_name + rec.Partner_POC_Title.trim();
                 		}
                 		rec.Partner_POC_Name_Title=v_name;
                 	}
                 }
				 void set_patient_full_name(int recId)
                 {
                 	rec = Referrals_Main[ID == recId];
                 	if(rec != null)
                 	{
                 		v_last = rec.Patient_Last_Name;
                 		if(v_last == null)
                 		{
                 			v_last = "";
                 		}
                 		if(v_last.trim() != "")
                 		{
                 			v_full = "";
                 			if(rec.Patient_First_Name != null && rec.Patient_First_Name.trim() != "")
                 			{
                 				v_full = rec.Patient_First_Name.trim();
                 			}
                 			if(rec.Patient_MI != null && rec.Patient_MI.trim() != "")
                 			{
                 				if(v_full != "")
                 				{
                 					v_full = v_full + " ";
                 				}
                 				v_full = v_full + rec.Patient_MI.trim();
                 			}
                 			if(v_full != "")
                 			{
                 				v_full = v_full + " ";
                 			}
                 			v_full = v_full + v_last.trim();
                 			rec.Patient_Full_Name=v_full;
                 		}
                 	}
                 }
				 void test_github_commit()
                 {
                 	repoOwner = "m1ndspark";
                 	repoName = "sos-emr";
                 	filePath = "schema/_connection_test.md";
                 	branch = "main";
                 	rawContent = "GitHub write path proven from Creator on " + zoho.currenttime + ".";
                 	encoded = zoho.encryption.base64Encode(rawContent);
                 	payload = Map();
                 	payload.put("message","test: prove Creator->GitHub commit path");
                 	payload.put("content",encoded);
                 	payload.put("branch",branch);
                 	getResp = invokeurl
                 	[
                 		url :"https://api.github.com/repos/" + repoOwner + "/" + repoName + "/contents/" + filePath + "?ref=" + branch
                 		type :GET
                 		connection:"sos_github_sync"
                 	];
                 	if(getResp.get("sha") != null)
                 	{
                 		payload.put("sha",getResp.get("sha"));
                 	}
                 	putResp = invokeurl
                 	[
                 		url :"https://api.github.com/repos/" + repoOwner + "/" + repoName + "/contents/" + filePath
                 		type :PUT
                 		parameters:payload.toString()
                 		connection:"sos_github_sync"
                 	];
                 	info putResp;
                 }
				 void test_schema_connection()
                 {
                 	response = invokeurl
                 	[
                 		url :"https://www.zohoapis.com/creator/v2.1/meta/sosmmc/sos-referrals-app/form/Partners/fields"
                 		type :GET
                 		connection:"sos_schema_monitor"
                 	];
                 	info response;
                 }
				 string test_smtp()
                 {
                 	sendmail
                 	[
                 		from :zoho.adminuserid
                 		to :"neil.heird@sosmmc.com"
                 		subject :"SOS SMTP test"
                 		message :"If you received this, Creator is routing through SendGrid."
                 	]
                 	return "Sent. Check SendGrid Activity Feed.";
                 }
			 }
		 }


		workflow
		{
		form
		{
			PVS_ID_Stamp_Generator as "PVS ID Stamp Generator"
			{
				type =  form
				form = Encounter_PatientVisit

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.PVS_ID == null || input.PVS_ID == "")
										{
											v_EmpInitials = input.Employee_Initials.toString();
											v_SeqValue = 0;
											v_SeqRecord = Sequence_Tracker[Object_Prefix == "PVS"];
											for each  v_Rec in v_SeqRecord
											{
												v_SeqValue = v_Rec.Object_Sequence;
												update v_Rec
												[
													Object_Sequence=v_SeqValue + 1
												];
												break;
											}
											v_PVSBase = "PVS-" + v_SeqValue.toString();
											if(input.Has_Referral_ID == "Yes")
											{
												input.PVS_ID = v_PVSBase + "-" + v_EmpInitials;
											}
											else
											{
												input.PVS_ID = v_PVSBase + "-" + v_EmpInitials + "-M";
											}
										}
										if(input.Has_Referral_ID == "Yes" && input.Referral_ID != null && input.Referral_ID != "")
										{
											if(input.PVS_Referral_ID == null || input.PVS_Referral_ID == "")
											{
												input.PVS_Referral_ID = "PVS-" + input.Referral_ID;
											}
										}
						)
					}
				}

			}
			Pre_fills_provider_sectio as "Pre-fills provider section from employee record"
			{
				type =  form
				form = Encounter_PatientVisit

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											v_EmpRecord = Employees[Employee_Email == zoho.loginuserid];
										for each  v_Emp in v_EmpRecord
										{
											input.Employee_First_Name = v_Emp.Employee_First_Name;
											input.Employee_Last_Name = v_Emp.Employee_Last_Name;
											input.Employee_Title = v_Emp.Employee_Title;
											input.Employee_Initials = v_Emp.Employee_Initials;
											input.Employee_Full_Name = v_Emp.Employee_First_Name + " " + v_Emp.Employee_Last_Name;
											input.Employee_Name_Title = v_Emp.Employee_First_Name + " " + v_Emp.Employee_Last_Name + ", " + v_Emp.Employee_Title;
											break;
										}
						)
					}
				}

			}
			Entry_Type_Section_Visibi as "Entry Type Section Visibility"
			{
				type =  form
				form = Encounter_PatientVisit

				record event = on add

				on user input of Type_of_Entry
				{
					actions 
					{
						custom deluge script
						(
											if(input.Type_of_Entry == "Patient Visit")
										{
											show Referral_Details_Section;
											show Final_Clinical_Note_Section;
											show Type_of_Procedure_Section;
											show Visit_Cost_Drivers_Section;
											show Charges_Section;
											show Diversion_Tracking_Section;
											show Files_Upload_Section;
											hide Cares_3008_Completion_Section;
											hide Imaging_Orders_Section;
											hide Lab_Orders_Section;
										}
										else if(input.Type_of_Entry == "3008")
										{
											show Cares_3008_Completion_Section;
											hide Referral_Details_Section;
											hide Final_Clinical_Note_Section;
											hide Type_of_Procedure_Section;
											hide Visit_Cost_Drivers_Section;
											hide Charges_Section;
											hide Diversion_Tracking_Section;
											hide Files_Upload_Section;
											hide Imaging_Orders_Section;
											hide Lab_Orders_Section;
										}
										else if(input.Type_of_Entry == "Lab Order")
										{
											show Lab_Orders_Section;
											show Diversion_Tracking_Section;
											hide Referral_Details_Section;
											hide Final_Clinical_Note_Section;
											hide Type_of_Procedure_Section;
											hide Visit_Cost_Drivers_Section;
											hide Charges_Section;
											hide Cares_3008_Completion_Section;
											hide Imaging_Orders_Section;
											hide Files_Upload_Section;
										}
										else if(input.Type_of_Entry == "Imaging Order")
										{
											show Imaging_Orders_Section;
											show Diversion_Tracking_Section;
											hide Referral_Details_Section;
											hide Final_Clinical_Note_Section;
											hide Type_of_Procedure_Section;
											hide Visit_Cost_Drivers_Section;
											hide Charges_Section;
											hide Cares_3008_Completion_Section;
											hide Lab_Orders_Section;
											hide Files_Upload_Section;
										}
										else if(input.Type_of_Entry == "Clinic Hours")
										{
											show Diversion_Tracking_Section;
											hide Referral_Details_Section;
											hide Final_Clinical_Note_Section;
											hide Type_of_Procedure_Section;
											hide Visit_Cost_Drivers_Section;
											hide Charges_Section;
											hide Cares_3008_Completion_Section;
											hide Imaging_Orders_Section;
											hide Lab_Orders_Section;
											hide Files_Upload_Section;
										}
										else
										{
											hide Referral_Details_Section;
											hide Final_Clinical_Note_Section;
											hide Type_of_Procedure_Section;
											hide Visit_Cost_Drivers_Section;
											hide Charges_Section;
											hide Cares_3008_Completion_Section;
											hide Imaging_Orders_Section;
											hide Lab_Orders_Section;
											hide Diversion_Tracking_Section;
											hide Files_Upload_Section;
										}
						)
					}
				}

			}
