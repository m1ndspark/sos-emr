			Partner_Location_Primary_ as "Partner Location Primary Required"
			{
				type =  form
				form = Partner_Locations

				record event = on add or edit
					status = inactive

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Primary_Office == "Yes")
										{
											others = Partner_Locations[Partner_Link == input.Partner_Link && Primary_Office == "Yes" && ID != input.ID];
											if(others.count() > 0)
											{
												alert "This Partner already has a Primary Office. Only one location per partner can be the Primary Office.";
												cancel submit;
											}
										}
						)
					}
				}

			}
			PAR_Required_Code1 as "PAR Required Code"
			{
				type =  form
				form = Partners

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											v_partnerCode = input.Partner_Code;
										if(v_partnerCode == null)
										{
											v_partnerCode = "";
										}
										v_partnerCode = v_partnerCode.trim();
										input.Partner_Code = v_partnerCode;
										if(v_partnerCode == "")
										{
											alert "Partner Code is required before this partner can be created.";
											cancel submit;
										}
										else
										{
											dupes = Partners[Partner_Code == v_partnerCode && ID != input.ID];
											if(dupes.count() > 0)
											{
												alert "Partner Code \"" + v_partnerCode + "\" is already assigned to another partner. Each partner must have a unique code — enter a different one.";
												cancel submit;
											}
										}
						)
					}
				}

			}
			LOC_Partner_Lock as "LOC Partner Lock"
			{
				type =  form
				form = Partner_Locations

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											v_storedPartner = null;
										for each  loc in Partner_Locations[ID == input.ID]
										{
											v_storedPartner = loc.Partner_Link;
										}
										if(v_storedPartner != null && input.Partner_Link != v_storedPartner)
										{
											alert "A location's Partner cannot be changed after creation. To move a location, deactivate it and create a new one under the correct partner.";
											cancel submit;
										}
						)
					}
				}

			}
