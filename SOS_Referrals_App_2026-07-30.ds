			Provider_ICD_Print_Builde as "Provider ICD Print Builder"
			{
				type =  form
				form = Encounter_PatientVisit

				record event = on add or edit

				on user input of Provider_ICD10_Codes_Link
				{
					actions 
					{
						custom deluge script
						(
											v_Codes = "";
										for each  v_Id in input.Provider_ICD10_Codes_Link
										{
											v_Rec = ICD10_Codes[ID == v_Id];
											for each  v_R in v_Rec
											{
												if(v_Codes == "")
												{
													v_Codes = v_R.ICD_Code;
												}
												else
												{
													v_Codes = v_Codes + ", " + v_R.ICD_Code;
												}
											}
										}
										input.Provider_ICD_Print = v_Codes;
						)
					}
				}

			}
			Partner_Contact_Upsert as "Partner Contact Upsert"
			{
				type =  form
				form = Referrals_Main

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											v_Email = input.Partner_POC_Email;
										if(v_Email != "")
										{
											v_Existing = Partner_Referral_Contacts[Partner_POC_Email == v_Email];
											v_Found = false;
											for each  v_Rec in v_Existing
											{
												v_Rec.Partner_POC_First_Name=input.Partner_POC_First_Name;
												v_Rec.Partner_POC_Last_Name=input.Partner_POC_Last_Name;
												v_Rec.Partner_POC_Title=input.Partner_POC_Title;
												v_Rec.Partner_POC_Phone=input.Partner_POC_Phone;
												v_Rec.Partner_Organization=input.Partner_Organization;
												v_Rec.Partner_Branch=input.Partner_Branch;
												v_Rec.Partner_POC_Team=input.Partner_POC_Team;
												v_Found = true;
												break;
											}
											if(v_Found == false)
											{
												insert into Partner_Referral_Contacts
												[
													Partner_POC_Email=v_Email
													Partner_POC_First_Name=input.Partner_POC_First_Name
													Partner_POC_Last_Name=input.Partner_POC_Last_Name
													Partner_POC_Title=input.Partner_POC_Title
													Partner_POC_Phone=input.Partner_POC_Phone
													Partner_Organization=input.Partner_Organization
													Partner_Branch=input.Partner_Branch
													Partner_POC_Team=input.Partner_POC_Team
													Added_User=zoho.loginuser
												]
											}
										}
						)
					}
				}

			}
			Imaging_Order_Provider_St as "Imaging Order Provider Stamp"
			{
				type =  form
				form = Imaging_Orders

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											v_Email = zoho.loginuserid;
										for each  v_Emp in Employees[Employee_Email == v_Email]
										{
											input.Provider_Signature_Link = v_Emp.ID;
											input.Provider_NPI = v_Emp.Provider_NPI;
											input.Employee_Phone = v_Emp.Employee_Phone;
										}
										disable Provider_Signature_Link;
										disable Provider_NPI;
										disable Employee_Phone;
						)
					}
				}

			}
			Imaging_Order_Provider_Ga as "Imaging Order Provider Gate"
			{
				type =  form
				form = Imaging_Orders

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											v_Email = zoho.loginuserid;
										v_Found = false;
										for each  v_Emp in Employees[Employee_Email == v_Email && Employee_Status == "Active"]
										{
											v_Found = true;
										}
										if(v_Found == false)
										{
											alert "Your provider profile was not found or is inactive. Please contact an admin for assistance.";
											cancel submit;
										}
						)
					}
				}

			}
