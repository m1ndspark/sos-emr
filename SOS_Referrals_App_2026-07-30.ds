			)
			conditional formatting
			(
				"Routine Visit Priority"
				{
				condition = (Referral_Link.Requested_Priority == "Routine")
				fields = [Referral_Link.Requested_Priority]
				format = "color:#ffffff;background-color:#1bbc9b;"
				}
				"Urgent Priority"
				{
				condition = (Referral_Link.Requested_Priority == "Priority")
				fields = [Referral_Link.Requested_Priority]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
