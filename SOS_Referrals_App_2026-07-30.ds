ame":"Patient_Hospice_ID"},{"Label_Name":"Referral_ID"},{"Label_Name":"Partner_Organization"},{"Label_Name":"Visit_Completion_Date"},{"Related_Fields":["Partner_POC_Name_Title"],"Label_Name":"Referral_Link"},{"Related_Fields":["Partner_POC_Team"],"Label_Name":"Referral_Link"},{"Related_Fields":["Patient_Full_Name"],"Label_Name":"Referral_Link"},{"Related_Fields":["Referral_Date"],"Label_Name":"Referral_Link"}],"id":"u_elem_24070533100000024","content":"<div\n    style=\"font-family: &quot;Lato&quot;, Arimo, Arial, sans-serif; font-size: 13px; color: rgb(34, 35, 38); padding: 8px 24px 24px 24px\">\n\n  <table\n    style=\"width: 100%; border: 1px solid rgb(221, 221, 221); border-collapse: collapse\"\n          cellspacing=\"0\">\n    <tbody>\n      <tr>\n        <td\n          style=\"padding: 7px 12px; white-space: nowrap; width: 1%; border-right: 1px solid rgb(221, 221, 221); border-bottom: 1px solid rgb(221, 221, 221)\">Patient Name:<\/td>\n        <td\n          style=\"padding: 7px 12px; border-right: 1px solid rgb(221, 221, 221); border-bottom: 1px solid rgb(221, 221, 221)\">${Referral_Link.Patient_Full_Name}<\/td>\n        <td\n          style=\"padding: 7px 12px; white-space: nowrap; width: 1%; border-right: 1px solid rgb(221, 221, 221); border-bottom: 1px solid rgb(221, 221, 221)\">Referral ID:<\/td>\n        <td\n          style=\"padding: 7px 12px; border-bottom: 1px solid rgb(221, 221, 221)\">${Referral_ID}<\/td>\n      <\/tr>\n      <tr>\n        <td\n          style=\"padding: 7px 12px; white-space: nowrap; width: 1%; border-right: 1px solid rgb(221, 221, 221); border-bottom: 1px solid rgb(221, 221, 221)\">DOB:<\/td>\n        <td\n          style=\"padding: 7px 12px; border-right: 1px solid rgb(221, 221, 221); border-bottom: 1px solid rgb(221, 221, 221)\">${Patient_DOB}<\/td>\n        <td\n          style=\"padding: 7px 12px; white-space: nowrap; width: 1%; border-right: 1px solid rgb(221, 221, 221); border-bottom: 1px solid rgb(221, 221, 221)\">Referral Date:<\/td>\n        <td\n          style=\"padding: 7px 12px; border-bottom: 1px solid rgb(221, 221, 221)\">${Referral_Link.Referral_Date}<\/td>\n      <\/tr>\n      <tr>\n        <td\n          style=\"padding: 7px 12px; white-space: nowrap; width: 1%; border-right: 1px solid rgb(221, 221, 221); border-bottom: 1px solid rgb(221, 221, 221)\">Hospice ID:<\/td>\n        <td\n          style=\"padding: 7px 12px; border-right: 1px solid rgb(221, 221, 221); border-bottom: 1px solid rgb(221, 221, 221)\">${Patient_Hospice_ID}<\/td>\n        <td\n          style=\"padding: 7px 12px; white-space: nowrap; width: 1%; border-right: 1px solid rgb(221, 221, 221); border-bottom: 1px solid rgb(221, 221, 221)\">Referral Partner:<\/td>\n        <td\n          style=\"padding: 7px 12px; border-bottom: 1px solid rgb(221, 221, 221)\">${Partner_Organization}<\/td>\n      <\/tr>\n      <tr>\n        <td\n          style=\"padding: 7px 12px; white-space: nowrap; width: 1%; border-right: 1px solid rgb(221, 221, 221); border-bottom: 1px solid rgb(221, 221, 221)\">Acuity Level:<\/td>\n        <td\n          style=\"padding: 7px 12px; border-right: 1px solid rgb(221, 221, 221); border-bottom: 1px solid rgb(221, 221, 221)\">${Complexity_Level}<\/td>\n        <td\n          style=\"padding: 7px 12px; white-space: nowrap; width: 1%; border-right: 1px solid rgb(221, 221, 221); border-bottom: 1px solid rgb(221, 221, 221)\">Referred By:<\/td>\n        <td\n          style=\"padding: 7px 12px; border-bottom: 1px solid rgb(221, 221, 221)\">${Referral_Link.Partner_POC_Name_Title}<\/td>\n      <\/tr>\n      <tr>\n        <td\n          style=\"padding: 7px 12px; white-space: nowrap; width: 1%; border-right: 1px solid rgb(221, 221, 221); border-bottom: 1px solid rgb(221, 221, 221)\">Date of Service:<\/td>\n        <td\n          style=\"padding: 7px 12px; border-right: 1px solid rgb(221, 221, 221); border-bottom: 1px solid rgb(221, 221, 221)\">${Visit_Completion_Date}<\/td>\n        <td\n          style=\"padding: 7px 12px; white-space: nowrap; width: 1%; border-right: 1px solid rgb(221, 221, 221); border-bottom: 1px solid rgb(221, 221, 221)\">Clinical Team:<\/td>\n        <td\n          style=\"padding: 7px 12px; border-bottom: 1px solid rgb(221, 221, 221)\">${Referral_Link.Partner_POC_Team}<\/td>\n      <\/tr>\n      <tr>\n        <td\n          style=\"padding: 7px 12px; white-space: nowrap; width: 1%; border-right: 1px solid rgb(221, 221, 221)\">Provider:<\/td>\n        <td\n          style=\"padding: 7px 12px; border-right: 1px solid rgb(221, 221, 221)\">${Employee_Full_Name} ${Employee_Title}<\/td>\n        <td\n          style=\"padding: 7px 12px; white-space: nowrap; width: 1%; border-right: 1px solid rgb(221, 221, 221)\"><\/td>\n        <td\n    style=\"padding: 7px 12px\"><\/td>\n      <\/tr>\n    <\/tbody>\n  <\/table>\n\n  <div\n    style=\"margin-top: 24px; font-weight: 700\">Clinical Note:&nbsp;${Clinical_Note_Type}<\/div>\n\n  <div\n    style=\"margin-top: 10px; white-space: pre-wrap; line-height: 1.5\">${Final_Clinical_Note}<\/div>\n\n  <div style=\"margin-top: 25px\">Electronically signed by: ${Employee_Full_Name} ${Employee_Title} on ${Visit_Completion_Date}<\/div>\n\n<\/div>"}}],"style":""}]}}],"id":1}],"resize":"letter","themeFont":"lato","isHeaderEnabled":false}
