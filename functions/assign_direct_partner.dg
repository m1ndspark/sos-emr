v_Mode = ifnull(p_mode,"").toString().trim().toUpperCase();
if(v_Mode != "PREVIEW" && v_Mode != "COMMIT")
{
	return "SKIP-NOMODE";
}
v_Src = ifnull(p_source,"").toString().trim();
if(v_Src == "")
{
	return "SKIP-NOSOURCE";
}
v_Ids = ifnull(p_refIds,"").toString().trim();
if(v_Ids == "")
{
	return "SKIP-NOIDS";
}
v_LocId = null;
v_PartnerId = null;
v_LocName = "";
v_LocLabel = "";
v_Org = "";
v_PID = "";
for each  v_L in Partner_Locations[Partner_Location_Label == "Direct - Individual" && Partner_Location_Status == "Active"]
{
	v_LocId = v_L.ID;
	v_PartnerId = v_L.Partner_Link;
	v_LocName = v_L.Partner_Location_Name;
	v_LocLabel = v_L.Partner_Location_Label;
	v_Org = v_L.Partner_Link.Partner_Display_Name;
	v_PID = v_L.Partner_Link.Partner_ID;
	break;
}
if(v_LocId == null)
{
	return "SKIP-NODIRECTLOCATION";
}
v_Lines = List();
v_Changed = 0;
v_Skipped = 0;
v_Missing = 0;
for each  v_Raw in v_Ids.toList(",")
{
	v_Key = v_Raw.trim();
	if(v_Key != "")
	{
		v_RecId = null;
		v_HasPartner = false;
		for each  v_R in Referrals_Main[Referral_ID == v_Key]
		{
			v_RecId = v_R.ID;
			if(v_R.Partner_Branch_Link != null)
			{
				v_HasPartner = true;
			}
			break;
		}
		if(v_RecId == null)
		{
			v_Missing = v_Missing + 1;
			v_Lines.add(v_Key + " NOTFOUND");
		}
		else if(v_HasPartner)
		{
			v_Skipped = v_Skipped + 1;
			v_Lines.add(v_Key + " SKIP already has a partner");
		}
		else if(v_Mode == "PREVIEW")
		{
			v_Changed = v_Changed + 1;
			v_Lines.add(v_Key + " WOULD SET source=" + v_Src + " partner=" + v_Org + " branch=" + v_LocName);
		}
		else
		{
			for each  v_Upd in Referrals_Main[ID == v_RecId]
			{
				update v_Upd
				[
					Referral_Source=v_Src
					Partner_Organization=v_Org
					Partner_Branch=v_LocName
					Partner_Location_Label=v_LocLabel
					Partner_Link=v_PartnerId
					Partner_Branch_Link=v_LocId
					Partner_ID=v_PID
					Partner_ID_Stamp=v_PartnerId.toString()
				];
			}
			v_Changed = v_Changed + 1;
			v_Lines.add(v_Key + " SET source=" + v_Src + " partner=" + v_Org + " branch=" + v_LocName);
		}
	}
}
v_Head = "ASSIGN DIRECT PARTNER | mode=" + v_Mode + " | changed=" + v_Changed + " | skipped=" + v_Skipped + " | notfound=" + v_Missing;
return v_Head + "\n" + v_Lines.toString("\n");
