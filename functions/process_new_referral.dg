v_Key = ifnull(p_refKey,"").trim();
if(v_Key == "")
{
	return "SKIP-NOKEY";
}
v_Notify = ifnull(p_notify,"").trim().toUpperCase();
if(v_Notify == "")
{
	v_Notify = "YES";
}
v_Ref = Referrals_Main[Referral_ID == v_Key];
if(v_Ref.count() == 0)
{
	if(v_Key.matches("^[0-9]+$"))
	{
		v_Ref = Referrals_Main[ID == v_Key.toLong()];
	}
}
if(v_Ref.count() == 0)
{
	return "SKIP-NOTFOUND";
}
v_RecId = v_Ref.ID;
v_R = Referrals_Main[ID == v_RecId];
v_Steps = List();
v_WasUnnotified = false;
if(v_R.Referral_Date == null)
{
	v_WasUnnotified = true;
}
v_FromForm = false;
if(ifnull(v_R.Form_Token,"").toString().trim() != "")
{
	v_FromForm = true;
}
v_RefDate = null;
if(v_FromForm)
{
	if(v_R.Added_Time != null)
	{
		v_RefDate = v_R.Added_Time.toDate();
	}
}
v_SubmittedLabel = ifnull(v_R.Partner_Location_Label,"").toString().trim();
v_SubmittedOnFile = ifnull(v_R.Partner_Branch_Submitted,"").toString().trim();
if(v_SubmittedOnFile == "" && v_SubmittedLabel != "")
{
	for each  v_SubUpd in Referrals_Main[ID == v_RecId]
	{
		update v_SubUpd
		[
			Partner_Branch_Submitted=v_SubmittedLabel
		];
	}
	v_Steps.add("submitted branch captured");
}
v_RefIdAtEntry = ifnull(v_R.Referral_ID,"").toString().trim();
if(v_RefIdAtEntry == "")
{
	thisapp.mint_referral_id(v_RecId);
	v_Steps.add("minted ID");
}
v_Vals = List();
v_Vals.add(v_R.Patient_Phone);
v_Vals.add(v_R.AC_Phone);
v_Vals.add(v_R.Partner_POC_Phone);
v_Vals.add(v_R.Facility_Phone);
v_Out = List();
for each  v_Raw in v_Vals
{
	v_F = "";
	if(v_Raw != null)
	{
		v_D = v_Raw.toString().replaceAll("[^0-9]","");
		if(v_D.length() == 10)
		{
			v_F = v_D.subString(0,3) + "-" + v_D.subString(3,6) + "-" + v_D.subString(6,10);
		}
		else
		{
			v_F = v_D;
		}
	}
	v_Out.add(v_F);
}
v_SSN = "";
if(v_R.Patient_SSN != null)
{
	v_S = v_R.Patient_SSN.toString().replaceAll("[^0-9]","");
	if(v_S.length() == 9)
	{
		v_SSN = v_S.subString(0,3) + "-" + v_S.subString(3,5) + "-" + v_S.subString(5,9);
	}
	else
	{
		v_SSN = v_S;
	}
}
v_DobDate = thisapp.parse_patient_dob(ifnull(v_R.Patient_DOB1,"").toString());
v_DobText = "";
if(v_DobDate != null)
{
	v_DobText = v_DobDate.toString("MM/dd/yyyy");
}
v_Addr = "";
if(v_R.Patient_Address.address_line_1 != null && v_R.Patient_Address.address_line_1.trim() != "")
{
	v_Addr = v_R.Patient_Address.address_line_1.trim();
}
if(v_R.Patient_Address.address_line_2 != null && v_R.Patient_Address.address_line_2.trim() != "")
{
	v_Addr = v_Addr + ", " + v_R.Patient_Address.address_line_2.trim();
}
if(v_R.Patient_Address.district_city != null && v_R.Patient_Address.district_city.trim() != "")
{
	v_Addr = v_Addr + ", " + v_R.Patient_Address.district_city.trim();
}
if(v_R.Patient_Address.state_province != null && v_R.Patient_Address.state_province.trim() != "")
{
	v_Addr = v_Addr + ", " + v_R.Patient_Address.state_province.trim();
}
if(v_R.Patient_Address.postal_Code != null && v_R.Patient_Address.postal_Code.trim() != "")
{
	v_Addr = v_Addr + " " + v_R.Patient_Address.postal_Code.trim();
}
v_Addr = v_Addr.trim();
v_ACFull = "";
if(v_R.AC_First_Name != null && v_R.AC_First_Name.trim() != "")
{
	v_ACFull = v_R.AC_First_Name.trim();
}
if(v_R.AC_Last_Name != null && v_R.AC_Last_Name.trim() != "")
{
	v_ACFull = (v_ACFull + " " + v_R.AC_Last_Name.trim()).trim();
}
v_Full = "";
if(v_R.Patient_First_Name != null && v_R.Patient_First_Name.trim() != "")
{
	v_Full = v_R.Patient_First_Name.trim();
}
if(v_R.Patient_MI != null && v_R.Patient_MI.trim() != "")
{
	if(v_Full != "")
	{
		v_Full = v_Full + " ";
	}
	v_Full = v_Full + v_R.Patient_MI.trim();
}
if(v_R.Patient_Last_Name != null && v_R.Patient_Last_Name.trim() != "")
{
	if(v_Full != "")
	{
		v_Full = v_Full + " ";
	}
	v_Full = v_Full + v_R.Patient_Last_Name.trim();
}
v_NameTitle = "";
if(v_R.Partner_POC_First_Name != null && v_R.Partner_POC_First_Name.trim() != "")
{
	v_NameTitle = v_R.Partner_POC_First_Name.trim();
}
if(v_R.Partner_POC_Last_Name != null && v_R.Partner_POC_Last_Name.trim() != "")
{
	if(v_NameTitle != "")
	{
		v_NameTitle = v_NameTitle + " ";
	}
	v_NameTitle = v_NameTitle + v_R.Partner_POC_Last_Name.trim();
}
if(v_R.Partner_POC_Title != null && v_R.Partner_POC_Title.trim() != "")
{
	if(v_NameTitle != "")
	{
		v_NameTitle = v_NameTitle + ", ";
	}
	v_NameTitle = v_NameTitle + v_R.Partner_POC_Title.trim();
}
v_LocId = null;
v_PartnerId = null;
v_LocName = "";
v_LocLabel = "";
v_Org = "";
v_PID = "";
if(v_SubmittedLabel != "")
{
	v_Sel = v_SubmittedLabel;
	v_SelKey = v_Sel.toLowerCase();
	v_Loc = Partner_Locations[Partner_Location_Label == v_Sel && Partner_Location_Status == "Active"];
	if(v_Loc.ID == null)
	{
		v_Loc = Partner_Locations[Partner_Location_Name == v_Sel && Partner_Location_Status == "Active"];
	}
	if(v_Loc.ID == null)
	{
		for each  v_L2 in Partner_Locations[Partner_Location_Status == "Active"]
		{
			v_LabKey = "";
			if(v_L2.Partner_Location_Label != null)
			{
				v_LabKey = v_L2.Partner_Location_Label.trim().toLowerCase();
			}
			v_NamKey = "";
			if(v_L2.Partner_Location_Name != null)
			{
				v_NamKey = v_L2.Partner_Location_Name.trim().toLowerCase();
			}
			if(v_LabKey == v_SelKey || v_NamKey == v_SelKey)
			{
				v_Loc = Partner_Locations[ID == v_L2.ID];
				break;
			}
		}
	}
	if(v_Loc.ID != null)
	{
		v_LocId = v_Loc.ID;
		v_PartnerId = v_Loc.Partner_Link;
		v_LocName = v_Loc.Partner_Location_Name;
		v_LocLabel = v_Loc.Partner_Location_Label;
		v_Org = v_Loc.Partner_Link.Partner_Display_Name;
		v_PID = v_Loc.Partner_Link.Partner_ID;
	}
}
for each  v_Rec in Referrals_Main[ID == v_RecId]
{
	update v_Rec
	[
		Patient_Phone=v_Out.get(0)
		AC_Phone=v_Out.get(1)
		Partner_POC_Phone=v_Out.get(2)
		Facility_Phone=v_Out.get(3)
		Patient_SSN=v_SSN
		Patient_Full_Address=v_Addr
		AC_Full_Name=v_ACFull
		Patient_Full_Name=v_Full
		Partner_POC_Name_Title=v_NameTitle
	];
	if(v_DobDate != null)
	{
		update v_Rec
		[
			Patient_DOB=v_DobDate
		];
	}
	if(v_LocId != null)
	{
		update v_Rec
		[
			Partner_Organization=v_Org
			Partner_Branch=v_LocName
			Partner_Location_Label=v_LocLabel
			Partner_Link=v_PartnerId
			Partner_Branch_Link=v_LocId
			Partner_ID=v_PID
			Partner_ID_Stamp=v_PartnerId.toString()
		];
		v_Steps.add("partner resolved");
	}
}
if(v_LocId == null)
{
	v_Steps.add("PARTNER UNRESOLVED, submitted branch was [" + v_SubmittedLabel + "]");
}
v_RefIdNow = "";
for each  v_RN in Referrals_Main[ID == v_RecId]
{
	v_RefIdNow = ifnull(v_RN.Referral_ID,"").toString().trim();
}
if(v_RefIdNow == "")
{
	v_RefIdNow = v_RecId.toString();
}
v_NameParts = List();
v_NameParts.add(ifnull(v_R.Patient_First_Name,"").toString().trim());
v_NameParts.add(ifnull(v_R.Patient_Last_Name,"").toString().trim());
v_NameParts.add(v_RefIdNow);
v_NameParts.add(v_Org);
v_NameParts.add(v_LocName);
v_BaseName = "";
for each  v_NP in v_NameParts
{
	v_NC = v_NP.replaceAll("[^A-Za-z0-9-]+","_");
	if(v_NC.startsWith("_"))
	{
		v_NC = v_NC.removeFirstOccurence("_");
	}
	if(v_NC.endsWith("_"))
	{
		v_NC = v_NC.removeLastOccurence("_");
	}
	if(v_NC != "")
	{
		if(v_BaseName != "")
		{
			v_BaseName = v_BaseName + "_";
		}
		v_BaseName = v_BaseName + v_NC;
	}
}
if(v_BaseName == "")
{
	v_BaseName = "referral_" + v_RecId.toString();
}
v_FileCount = Referral_Files[Referrals_Main == v_RecId].count();
if(v_FileCount == 0)
{
	v_FileFields = Map();
	v_FileFields.put("3008",v_R.Files_3008_URLs);
	v_FileFields.put("General",v_R.General_Files_URLs);
	v_FileFields.put("Imaging Orders",v_R.Imaging_Orders_URLs);
	v_TargetFields = Map();
	v_TargetFields.put("3008","File_Upload_3008");
	v_TargetFields.put("General","General_Files_Upload");
	v_TargetFields.put("Imaging Orders","Imaging_Orders_Upload");
	v_Attached = 0;
	for each  v_Cat in v_FileFields.keys()
	{
		v_UrlRaw = v_FileFields.get(v_Cat);
		if(v_UrlRaw != null && v_UrlRaw.toString().trim() != "")
		{
			v_TargetField = v_TargetFields.get(v_Cat).toString();
			v_UrlList = v_UrlRaw.toString().replaceAll("\r","").replaceAll("\n",",").toList(",");
			v_FileIdx = 0;
			for each  v_Url in v_UrlList
			{
				v_U = v_Url.trim();
				if(v_U != "" && v_U.contains("/file/"))
				{
					v_ResId = v_U.subString(v_U.lastIndexOf("/") + 1);
					if(v_ResId.contains("?"))
					{
						v_ResId = v_ResId.subString(0,v_ResId.indexOf("?"));
					}
					try 
					{
						v_File = invokeurl
						[
							url :"https://workdrive.zoho.com/api/v1/download/" + v_ResId
							type :GET
							connection:"sos_workdrive"
						];
						v_FileIdx = v_FileIdx + 1;
						v_OrigName = ifnull(v_File.getFileName(),"").toString().trim();
						v_Ext = "";
						if(v_OrigName.contains("."))
						{
							v_Ext = "." + v_OrigName.subString(v_OrigName.lastIndexOf(".") + 1);
						}
						v_NewName = v_BaseName;
						if(v_FileIdx > 1)
						{
							v_NewName = v_NewName + "_" + v_FileIdx;
						}
						v_NewName = v_NewName + v_Ext;
						v_File.setFileName(v_NewName);
						v_File.setParamName("file");
						v_UpResp = invokeurl
						[
							url :"https://www.zohoapis.com/creator/v2.1/data" + zoho.appuri + "report/Referrals_Main_Report/" + v_RecId.toString() + "/" + v_TargetField + "/upload"
							type :POST
							detailed:true
							files:v_File
							connection:"sos_file_upload"
						];
						v_UpCode = v_UpResp.get("responseCode");
						if(v_UpCode != 200 && v_UpCode != 201)
						{
							info "Referral file attach failed for " + v_Cat + " " + v_ResId + ": " + v_UpResp.get("responseText").toString();
						}
						v_File2 = invokeurl
						[
							url :"https://workdrive.zoho.com/api/v1/download/" + v_ResId
							type :GET
							connection:"sos_workdrive"
						];
						insert into Referral_Files
						[
							Referrals_Main=v_RecId
							Form_Token=v_R.Form_Token
							File_Category=v_Cat
							File_Name=v_NewName
							File_Upload=v_File2
							Added_User=zoho.loginuser
						]
						v_Attached = v_Attached + 1;
					}						catch (e)
					{
						info "Referral file intake failed for " + v_Cat + " " + v_ResId + ": " + e;
					}
				}
			}
		}
	}
	if(v_Attached > 0)
	{
		v_Steps.add("files attached: " + v_Attached);
	}
}
else
{
	v_Steps.add("files skipped, " + v_FileCount + " already present");
}
v_Email = v_R.Partner_POC_Email;
if(v_Email != null && v_Email.trim() != "")
{
	v_Email = v_Email.trim();
	v_EmailKey = v_Email.toLowerCase();
	v_MatchId = 0;
	for each  v_C in Partner_Referral_Contacts[Partner_POC_Email == v_Email]
	{
		v_MatchId = v_C.ID;
		break;
	}
	if(v_MatchId == 0)
	{
		for each  v_Scan in Partner_Referral_Contacts[ID != null]
		{
			if(v_Scan.Partner_POC_Email != null && v_Scan.Partner_POC_Email.trim().toLowerCase() == v_EmailKey)
			{
				v_MatchId = v_Scan.ID;
				break;
			}
		}
	}
	if(v_MatchId != 0)
	{
		for each  v_Upd in Partner_Referral_Contacts[ID == v_MatchId]
		{
			update v_Upd
			[
				Partner_POC_First_Name=v_R.Partner_POC_First_Name
				Partner_POC_Last_Name=v_R.Partner_POC_Last_Name
				Partner_POC_Title=v_R.Partner_POC_Title
				Partner_POC_Phone=v_Out.get(2)
				Partner_Organization=v_Org
				Partner_Branch=v_LocName
				Partner_POC_Team=v_R.Partner_POC_Team
				Partner_POC_Name_Title=v_NameTitle
			];
			if(v_LocId != null)
			{
				update v_Upd
				[
					Partner_Link=v_PartnerId
					Partner_Locations_Link=v_LocId
				];
			}
		}
		v_Steps.add("contact updated");
	}
	else
	{
		v_NewId = insert into Partner_Referral_Contacts
		[
			Partner_POC_Email=v_Email
			Partner_POC_First_Name=v_R.Partner_POC_First_Name
			Partner_POC_Last_Name=v_R.Partner_POC_Last_Name
			Partner_POC_Title=v_R.Partner_POC_Title
			Partner_POC_Phone=v_Out.get(2)
			Partner_Organization=v_Org
			Partner_Branch=v_LocName
			Partner_POC_Team=v_R.Partner_POC_Team
			Partner_POC_Name_Title=v_NameTitle
			Added_User=zoho.loginuser
		];
		if(v_LocId != null)
		{
			for each  v_New in Partner_Referral_Contacts[ID == v_NewId]
			{
				update v_New
				[
					Partner_Link=v_PartnerId
					Partner_Locations_Link=v_LocId
				];
			}
		}
		v_Steps.add("contact created");
	}
}
v_AsgExisting = Assignments[Referral_Link == v_RecId].count();
if(v_AsgExisting == 0)
{
	v_AsgId = insert into Assignments
	[
		Referral_Link=v_RecId
		Patient_First_Name=v_R.Patient_First_Name
		Patient_Last_Name=v_R.Patient_Last_Name
		Patient_DOB=v_DobText
		Patient_Phone=v_Out.get(0)
		Patient_Address=v_R.Patient_Address
		Patient_Location=v_R.Patient_Location
		Facility_Name=v_R.Facility_Name
		Facility_Phone=v_Out.get(3)
		Facility_Room_Number=v_R.Facility_Room_Number
		Added_User=zoho.loginuser
	];
	thisapp.mint_assignment_id(v_AsgId);
	v_Steps.add("assignment created");
}
else
{
	v_Steps.add("assignment already existed");
}
if(v_WasUnnotified && v_Notify == "YES" && v_RefDate == null)
{
	v_Steps.add("NO TRUSTED ARRIVAL DATE, nothing sent and nothing stamped");
}
else if(v_WasUnnotified && v_Notify == "YES")
{
	v_NotifiedAt = zoho.currenttime;
	for each  v_Stamp in Referrals_Main[ID == v_RecId]
	{
		update v_Stamp
		[
			Referral_Date=v_RefDate
			Notified_Time=v_NotifiedAt
		];
	}
	v_NotifyRef = thisapp.send_referral_notification(v_RecId.toString());
	v_Notify3008 = thisapp.send_3008_notification(v_RecId.toString());
	v_NotifyImg = thisapp.send_imaging_notification(v_RecId.toString());
	if(!v_NotifyRef.startsWith("SENT") && !v_Notify3008.startsWith("SENT") && !v_NotifyImg.startsWith("SENT"))
	{
		for each  v_Revert in Referrals_Main[ID == v_RecId]
		{
			update v_Revert
			[
				Referral_Date=null
				Notified_Time=null
			];
		}
		v_Steps.add("NOT NOTIFIED, still queued [referral=" + v_NotifyRef + "] [3008=" + v_Notify3008 + "] [imaging=" + v_NotifyImg + "]");
	}
	else
	{
		v_Steps.add("notified at " + v_NotifiedAt.toString() + " [referral=" + v_NotifyRef + "] [3008=" + v_Notify3008 + "] [imaging=" + v_NotifyImg + "]");
	}
}
else if(v_WasUnnotified)
{
	v_Steps.add("NOTIFY SUPPRESSED, still queued as un-notified");
}
else
{
	v_Steps.add("already notified, no email sent");
}
return v_RefIdNow + ": " + v_Steps.toString("; ");
