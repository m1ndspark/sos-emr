v_mode = ifnull(p_mode,"").trim().toUpperCase();
if(v_mode != "PREVIEW" && v_mode != "COMMIT")
{
	return "ERROR: p_mode must be PREVIEW or COMMIT.";
}
v_statSet = 0;
v_dateSet = 0;
v_lvlSet = 0;
v_chgSet = 0;
v_touched = 0;
v_ok = 0;
v_invoiced = 0;
v_nodate = 0;
v_nobranch = 0;
v_norate = 0;
v_miss = List();
v_needDate = List();
v_detail = List();
for each  p in Encounter_PatientVisit[Type_of_Entry == "3008"]
{
	v_pid = ifnull(p.PVS_ID,"NO-ID");
	v_skip = false;
	if(p.Invoice_Link != null)
	{
		v_skip = true;
	}
	if(p.Invoice_Status == "Final")
	{
		v_skip = true;
	}
	if(v_skip)
	{
		v_invoiced = v_invoiced + 1;
	}
	else
	{
		v_acts = List();
		v_doStat = false;
		v_newDate = null;
		v_newLvl = null;
		v_newChg = null;
		v_stat = ifnull(p.Invoice_Status,"").trim();
		if(v_stat == "")
		{
			v_doStat = true;
			v_acts.add("status Draft");
		}
		v_eff = p.Cares_3008_Completion_Date;
		if(v_eff == null)
		{
			v_eff = p.Visit_Completion_Date;
		}
		if(p.Visit_Completion_Date == null)
		{
			if(p.Cares_3008_Completion_Date != null)
			{
				v_newDate = p.Cares_3008_Completion_Date;
				v_acts.add("visit date");
			}
		}
		if(v_eff == null)
		{
			v_nodate = v_nodate + 1;
			v_needDate.add(v_pid);
		}
		else
		{
			v_lvl = ifnull(p.Complexity_Level,"").trim();
			if(v_lvl == "")
			{
				v_newLvl = "Cares 3008 Assessment";
				v_lvl = "Cares 3008 Assessment";
				v_acts.add("level");
			}
			v_amt = 0.0;
			if(p.Complexity_Charge != null)
			{
				v_amt = p.Complexity_Charge.toDecimal();
			}
			if(v_amt <= 0)
			{
				if(p.Billing_Branch == null)
				{
					v_nobranch = v_nobranch + 1;
					v_detail.add(v_pid + " | NO BRANCH | cannot price");
				}
				else
				{
					v_rate = null;
					for each  r in Partner_Rates[Partner_Location_Link == p.Billing_Branch && Rate_Type == v_lvl && Current_Rate == "Yes"]
					{
						v_rate = r.Rate_Amount;
						break;
					}
					v_loc = Partner_Locations[ID == p.Billing_Branch];
					v_label = ifnull(v_loc.Partner_Location_Label,"UNKNOWN BRANCH");
					if(v_rate == null)
					{
						v_norate = v_norate + 1;
						v_pair = v_label + " / " + v_lvl;
						if(!v_miss.contains(v_pair))
						{
							v_miss.add(v_pair);
						}
						v_detail.add(v_pid + " | NO RATE | " + v_pair);
					}
					else
					{
						v_newChg = v_rate;
						v_acts.add("charge $" + v_rate);
					}
				}
			}
		}
		if(v_acts.size() == 0)
		{
			v_ok = v_ok + 1;
		}
		else
		{
			v_touched = v_touched + 1;
			if(v_doStat)
			{
				v_statSet = v_statSet + 1;
			}
			if(v_newDate != null)
			{
				v_dateSet = v_dateSet + 1;
			}
			if(v_newLvl != null)
			{
				v_lvlSet = v_lvlSet + 1;
			}
			if(v_newChg != null)
			{
				v_chgSet = v_chgSet + 1;
			}
			if(v_detail.size() < 120)
			{
				v_detail.add(v_pid + " | SET | " + v_acts.toString(", "));
			}
			if(v_mode == "COMMIT")
			{
				if(v_doStat)
				{
					p.Invoice_Status="Draft";
				}
				if(v_newDate != null)
				{
					p.Visit_Completion_Date=v_newDate;
				}
				if(v_newLvl != null)
				{
					p.Complexity_Level=v_newLvl;
				}
				if(v_newChg != null)
				{
					p.Complexity_Charge=v_newChg;
				}
			}
		}
	}
}
v_out = "MODE: " + v_mode;
v_out = v_out + "\nRecords changed: " + v_touched + " (status " + v_statSet + ", visit date " + v_dateSet + ", level " + v_lvlSet + ", charge " + v_chgSet + ").";
v_out = v_out + "\nAlready correct: " + v_ok + ". Already invoiced, skipped: " + v_invoiced + ".";
v_out = v_out + "\nStill blocked, no date in either field: " + v_nodate + ".";
v_out = v_out + "\nNo billing branch: " + v_nobranch + ". No current rate: " + v_norate + ".";
if(v_miss.size() > 0)
{
	v_out = v_out + "\nMissing rates: " + v_miss.toString(", ");
}
if(v_needDate.size() > 0)
{
	v_out = v_out + "\n\nNEED A DATE\n" + v_needDate.toString(", ");
}
if(v_detail.size() > 0)
{
	v_out = v_out + "\n\nDETAIL\n" + v_detail.toString("\n");
}
return v_out;
