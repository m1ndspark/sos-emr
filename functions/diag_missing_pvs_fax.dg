v_out = Map();
v_noContact = List();
v_noFax = List();
v_inactive = List();
v_dupes = List();
v_haveFax = List();
for each  v_Loc in Partner_Locations[ID != 0] sort by Partner_Location_Label
{
	v_label = ifnull(v_Loc.Partner_Location_Label,"").toString();
	if(v_label == "")
	{
		v_label = ifnull(v_Loc.Partner_Location_Name,"").toString();
	}
	v_status = ifnull(v_Loc.Partner_Location_Status,"").toString();
	v_total = 0;
	v_active = 0;
	v_withFax = 0;
	v_fax = "";
	for each  v_c in Partner_Billing_Contacts[Partner_Location_Link == v_Loc.ID]
	{
		v_total = v_total + 1;
		if(ifnull(v_c.Partner_Billing_POC_Status,"") == "Active")
		{
			v_active = v_active + 1;
			v_d = ifnull(v_c.Partner_PVS_Fax,"").toString().replaceAll("[^0-9]","");
			if(v_d.length() >= 10)
			{
				v_withFax = v_withFax + 1;
				v_fax = ifnull(v_c.Partner_PVS_Fax,"").toString();
			}
		}
	}
	if(v_total == 0)
	{
		v_noContact.add(v_label + " [" + v_status + "]");
		continue;
	}
	if(v_active == 0)
	{
		v_inactive.add(v_label + " [" + v_status + "] - " + v_total + " contact(s), none Active");
		continue;
	}
	if(v_withFax == 0)
	{
		v_noFax.add(v_label + " [" + v_status + "] - " + v_active + " Active contact(s), no PVS fax");
		continue;
	}
	if(v_withFax > 1)
	{
		v_dupes.add(v_label + " - " + v_withFax + " Active contacts carry a PVS fax");
		continue;
	}
	v_haveFax.add(v_label + " -> " + v_fax);
}
v_out.put("locations_total",v_noContact.size() + v_noFax.size() + v_inactive.size() + v_dupes.size() + v_haveFax.size());
v_out.put("ok_count",v_haveFax.size());
v_out.put("no_billing_contact",v_noContact);
v_out.put("no_active_contact",v_inactive);
v_out.put("active_but_no_fax",v_noFax);
v_out.put("more_than_one_fax",v_dupes);
v_out.put("ok",v_haveFax);
return v_out;
