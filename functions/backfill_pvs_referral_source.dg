v_Mode = ifnull(p_mode,"").toString().trim().toUpperCase();
if(v_Mode != "PREVIEW" && v_Mode != "COMMIT")
{
	return "SKIP-NOMODE";
}
v_Cap = p_limit;
if(v_Cap == null || v_Cap < 1)
{
	v_Cap = 100;
}
v_Scanned = 0;
v_Already = 0;
v_NoSource = 0;
v_Done = 0;
v_Remaining = 0;
v_Sample = List();
for each  v_Pvs in Encounter_PatientVisit[Referral_Link != null]
{
	v_Scanned = v_Scanned + 1;
	v_Cur = ifnull(v_Pvs.Referral_Source,"").toString().trim();
	if(v_Cur != "")
	{
		v_Already = v_Already + 1;
	}
	else
	{
		v_Src = ifnull(v_Pvs.Referral_Link.Referral_Source,"").toString().trim();
		if(v_Src == "")
		{
			v_NoSource = v_NoSource + 1;
		}
		else if(v_Done >= v_Cap)
		{
			v_Remaining = v_Remaining + 1;
		}
		else
		{
			if(v_Mode == "COMMIT")
			{
				for each  v_Upd in Encounter_PatientVisit[ID == v_Pvs.ID]
				{
					update v_Upd
					[
						Referral_Source=v_Src
					];
				}
			}
			v_Done = v_Done + 1;
			if(v_Sample.size() < 10)
			{
				v_Sample.add(ifnull(v_Pvs.PVS_ID,v_Pvs.ID.toString()).toString() + " = " + v_Src);
			}
		}
	}
}
v_Head = "BACKFILL PVS REFERRAL SOURCE | mode=" + v_Mode + " | scanned=" + v_Scanned + " | already set=" + v_Already + " | referral has no source=" + v_NoSource + " | written=" + v_Done + " | remaining=" + v_Remaining;
return v_Head + "\n" + v_Sample.toString("\n");
