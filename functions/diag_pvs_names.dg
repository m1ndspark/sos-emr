v_Rows = List();
v_List = ifnull(p_pvsIds,"").toList(",");
for each  v_Raw in v_List
{
	v_Id = v_Raw.trim();
	if(v_Id == "")
	{
		continue;
	}
	v_Found = false;
	for each  v_P in Encounter_PatientVisit[PVS_ID == v_Id]
	{
		v_Found = true;
		v_PName = ifnull(v_P.Patient_Full_Name_1,"").toString().trim();
		if(v_PName == "")
		{
			v_PName = (ifnull(v_P.Patient_First_Name,"").toString().trim() + " " + ifnull(v_P.Patient_Last_Name,"").toString().trim()).trim();
		}
		v_PDob = "";
		if(v_P.Patient_DOB != null)
		{
			v_PDob = v_P.Patient_DOB.toString("MM-dd-yyyy");
		}
		v_Dos = "NO DOS";
		if(v_P.Visit_Completion_Date != null)
		{
			v_Dos = v_P.Visit_Completion_Date.toString("MM-dd-yyyy");
		}
		v_Type = ifnull(v_P.Type_of_Entry,"").toString();
		v_Ref = "NO REFERRAL LINK";
		if(v_P.Referral_Link != null)
		{
			v_Ref = "REF NOT FOUND";
			for each  v_R in Referrals_Main[ID == v_P.Referral_Link]
			{
				v_RDob = "";
				if(v_R.Patient_DOB != null)
				{
					v_RDob = v_R.Patient_DOB.toString("MM-dd-yyyy");
				}
				v_RName = (ifnull(v_R.Patient_First_Name,"").toString().trim() + " " + ifnull(v_R.Patient_Last_Name,"").toString().trim()).trim();
				v_Ref = ifnull(v_R.Referral_ID,"").toString() + "|" + v_RName + "|" + v_RDob;
			}
		}
		v_Rows.add(v_Id + "|" + v_PName + "|" + v_PDob + "|" + v_Dos + "|" + v_Type + " || " + v_Ref);
	}
	if(!v_Found)
	{
		v_Rows.add(v_Id + "|NOT FOUND");
	}
}
return "READ-ONLY\n" + v_Rows.toString("\n");
