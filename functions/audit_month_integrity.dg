v_Mode = ifnull(p_mode,"").toString().trim().toUpperCase();
v_Valid = {"PVS","BILLING","REFERRALS","DATELESS"};
if(!v_Valid.contains(v_Mode))
{
	return "Invalid mode. Use PVS, BILLING, REFERRALS or DATELESS.";
}
if(p_from == null || p_to == null)
{
	return "Enter both dates.";
}
v_HitList = List();
v_Summary = List();
v_Scanned = 0;
v_Zero = {"No Charge","Visit Cancelled"};
if(v_Mode == "PVS")
{
	v_Labels = {"Referral ID","Referral Date","First Name","Last Name","DOB","Gender","Hospice ID","Phone","Location","Facility Name","Facility Phone","Address Line 1","Address City","Address State","Address Zip","Partner ID","Partner Organization","Partner Branch","Partner Location Label","Reason"};
	for each  v_P in Encounter_PatientVisit[Visit_Completion_Date >= p_from && Visit_Completion_Date <= p_to]
	{
		v_Rs = ifnull(v_P.Row_Status,"").toString().trim();
		if(v_Rs == "Duplicate" || v_Rs == "Cancelled" || v_Rs == "Folded")
		{
			continue;
		}
		v_Scanned = v_Scanned + 1;
		v_HasPid = true;
		v_Pid = ifnull(v_P.PVS_ID,"").toString().trim();
		if(v_Pid == "")
		{
			v_HasPid = false;
			v_Pid = "rec " + v_P.ID.toString();
			v_HitList.add("6 PVS | no PVS ID~~" + v_Pid);
		}
		v_Type = ifnull(v_P.Type_of_Entry,"").toString().trim();
		v_Lvl = ifnull(v_P.Complexity_Level,"").toString().trim();
		v_PLoc = ifnull(v_P.Patient_Location,"").toString().trim();
		v_PV = Map();
		v_PV.put("Referral ID",ifnull(v_P.Referral_ID,"").toString().trim().toUpperCase());
		v_Tmp = "";
		if(v_P.Referral_Date != null)
		{
			v_Tmp = v_P.Referral_Date.toString("yyyy-MM-dd");
		}
		v_PV.put("Referral Date",v_Tmp);
		v_PV.put("First Name",ifnull(v_P.Patient_First_Name,"").toString().toLowerCase().trim().replaceAll(" +"," "));
		v_PV.put("Last Name",ifnull(v_P.Patient_Last_Name,"").toString().toLowerCase().trim().replaceAll(" +"," "));
		v_Tmp = "";
		if(v_P.Patient_DOB != null)
		{
			v_Tmp = v_P.Patient_DOB.toString("yyyy-MM-dd");
		}
		v_PV.put("DOB",v_Tmp);
		v_PV.put("Gender",ifnull(v_P.Patient_Gender,"").toString().toLowerCase().trim());
		v_PV.put("Hospice ID",ifnull(v_P.Patient_Hospice_ID,"").toString().toLowerCase().trim());
		v_Ph = ifnull(v_P.Patient_Phone,"").toString().replaceAll("[^0-9]","");
		if(v_Ph.length() == 11 && v_Ph.startsWith("1"))
		{
			v_Ph = v_Ph.subString(1,v_Ph.length());
		}
		v_PV.put("Phone",v_Ph);
		v_PV.put("Location",v_PLoc.toLowerCase());
		v_PV.put("Facility Name",ifnull(v_P.Facility_Name,"").toString().toLowerCase().trim().replaceAll(" +"," "));
		v_Ph = ifnull(v_P.Facility_Phone,"").toString().replaceAll("[^0-9]","");
		if(v_Ph.length() == 11 && v_Ph.startsWith("1"))
		{
			v_Ph = v_Ph.subString(1,v_Ph.length());
		}
		v_PV.put("Facility Phone",v_Ph);
		v_PV.put("Address Line 1",ifnull(v_P.Patient_Address.address_line_1,"").toString().toLowerCase().trim().replaceAll(" +"," "));
		v_PV.put("Address City",ifnull(v_P.Patient_Address.district_city,"").toString().toLowerCase().trim());
		v_PV.put("Address State",ifnull(v_P.Patient_Address.state_province,"").toString().toLowerCase().trim());
		v_PV.put("Address Zip",ifnull(v_P.Patient_Address.postal_Code,"").toString().trim());
		v_PV.put("Partner ID",ifnull(v_P.Partner_ID,"").toString().trim().toUpperCase());
		v_PV.put("Partner Organization",ifnull(v_P.Partner_Organization,"").toString().toLowerCase().trim());
		v_PV.put("Partner Branch",ifnull(v_P.Partner_Branch,"").toString().toLowerCase().trim());
		v_PV.put("Partner Location Label",ifnull(v_P.Partner_Location_Label,"").toString().toLowerCase().trim());
		v_PV.put("Reason",ifnull(v_P.Reason_for_Referral,"").toString().trim());
		v_HasRef = false;
		v_RLoc = "";
		v_RV = Map();
		if(v_P.Referral_Link == null)
		{
			v_HitList.add("1 LINK | no referral link~~" + v_Pid);
		}
		else
		{
			for each  v_R in Referrals_Main[ID == v_P.Referral_Link]
			{
				v_HasRef = true;
				v_RLoc = ifnull(v_R.Patient_Location,"").toString().trim();
				v_RV.put("Referral ID",ifnull(v_R.Referral_ID,"").toString().trim().toUpperCase());
				v_Tmp = "";
				if(v_R.Referral_Date != null)
				{
					v_Tmp = v_R.Referral_Date.toString("yyyy-MM-dd");
				}
				v_RV.put("Referral Date",v_Tmp);
				v_RV.put("First Name",ifnull(v_R.Patient_First_Name,"").toString().toLowerCase().trim().replaceAll(" +"," "));
				v_RV.put("Last Name",ifnull(v_R.Patient_Last_Name,"").toString().toLowerCase().trim().replaceAll(" +"," "));
				v_Tmp = "";
				if(v_R.Patient_DOB != null)
				{
					v_Tmp = v_R.Patient_DOB.toString("yyyy-MM-dd");
				}
				v_RV.put("DOB",v_Tmp);
				v_RV.put("Gender",ifnull(v_R.Patient_Gender,"").toString().toLowerCase().trim());
				v_RV.put("Hospice ID",ifnull(v_R.Patient_Hospice_ID,"").toString().toLowerCase().trim());
				v_Ph = ifnull(v_R.Patient_Phone,"").toString().replaceAll("[^0-9]","");
				if(v_Ph.length() == 11 && v_Ph.startsWith("1"))
				{
					v_Ph = v_Ph.subString(1,v_Ph.length());
				}
				v_RV.put("Phone",v_Ph);
				v_RV.put("Location",v_RLoc.toLowerCase());
				v_RV.put("Facility Name",ifnull(v_R.Facility_Name,"").toString().toLowerCase().trim().replaceAll(" +"," "));
				v_Ph = ifnull(v_R.Facility_Phone,"").toString().replaceAll("[^0-9]","");
				if(v_Ph.length() == 11 && v_Ph.startsWith("1"))
				{
					v_Ph = v_Ph.subString(1,v_Ph.length());
				}
				v_RV.put("Facility Phone",v_Ph);
				v_RV.put("Address Line 1",ifnull(v_R.Patient_Address.address_line_1,"").toString().toLowerCase().trim().replaceAll(" +"," "));
				v_RV.put("Address City",ifnull(v_R.Patient_Address.district_city,"").toString().toLowerCase().trim());
				v_RV.put("Address State",ifnull(v_R.Patient_Address.state_province,"").toString().toLowerCase().trim());
				v_RV.put("Address Zip",ifnull(v_R.Patient_Address.postal_Code,"").toString().trim());
				v_RV.put("Partner ID",ifnull(v_R.Partner_ID,"").toString().trim().toUpperCase());
				v_RV.put("Partner Organization",ifnull(v_R.Partner_Organization,"").toString().toLowerCase().trim());
				v_RV.put("Partner Branch",ifnull(v_R.Partner_Branch,"").toString().toLowerCase().trim());
				v_RV.put("Partner Location Label",ifnull(v_R.Partner_Location_Label,"").toString().toLowerCase().trim());
				v_RV.put("Reason",ifnull(v_R.Referral_Reason,"").toString().trim());
			}
			if(!v_HasRef)
			{
				v_HitList.add("1 LINK | referral link points to a missing referral~~" + v_Pid);
			}
		}
		if(v_HasRef)
		{
			v_Skip = List();
			v_BlankOk = List();
			v_NoDiff = {"Reason"};
			v_IsFac = false;
			if(v_PLoc == "Facility")
			{
				v_IsFac = true;
			}
			if(v_RLoc == "Facility")
			{
				v_IsFac = true;
			}
			if(v_IsFac)
			{
				v_BlankOk.add("Address Line 1");
				v_BlankOk.add("Address City");
				v_BlankOk.add("Address State");
				v_BlankOk.add("Address Zip");
			}
			else
			{
				v_Skip.add("Facility Name");
				v_Skip.add("Facility Phone");
			}
			if(v_Type == "3008")
			{
				v_BlankOk.add("Hospice ID");
				v_Skip.add("Reason");
			}
			for each  v_Lab in v_Labels
			{
				if(v_Skip.contains(v_Lab))
				{
					continue;
				}
				v_A = v_PV.get(v_Lab);
				v_B = v_RV.get(v_Lab);
				if(v_A == "")
				{
					if(v_B != "")
					{
						v_HitList.add("2 FIXABLE: blank on PVS, filled on referral | " + v_Lab + "~~" + v_Pid);
					}
					else if(!v_BlankOk.contains(v_Lab))
					{
						v_HitList.add("3 MISSING on PVS and referral | " + v_Lab + "~~" + v_Pid);
					}
				}
				else if(v_B == "")
				{
					v_HitList.add("4 ON PVS, blank on referral | " + v_Lab + "~~" + v_Pid);
				}
				else if(v_A != v_B)
				{
					if(!v_NoDiff.contains(v_Lab))
					{
						v_HitList.add("5 DIFFERS from referral | " + v_Lab + "~~" + v_Pid);
					}
				}
			}
		}
		v_Fn1 = ifnull(v_P.Patient_Full_Name_1,"").toString().toLowerCase().trim().replaceAll(" +"," ");
		v_Last = v_PV.get("Last Name");
		if(v_Fn1 == "")
		{
			v_HitList.add("6 PVS | Patient Full Name 1 blank (prints on invoice)~~" + v_Pid);
		}
		else if(v_Last != "")
		{
			if(!v_Fn1.contains(v_Last))
			{
				v_HitList.add("6 PVS | Patient Full Name 1 does not contain last name~~" + v_Pid);
			}
		}
		if(v_P.Billing_Branch == null)
		{
			v_HitList.add("6 PVS | no Billing Branch~~" + v_Pid);
		}
		if(v_P.Employee_Link == null)
		{
			v_HitList.add("6 PVS | no Employee Link~~" + v_Pid);
		}
		v_Ini = ifnull(v_P.Employee_Initials,"").toString().trim().toUpperCase();
		if(v_Ini == "")
		{
			v_HitList.add("6 PVS | no provider initials~~" + v_Pid);
		}
		else if(v_HasPid)
		{
			v_Parts = v_Pid.toList("-");
			v_Suf = v_Parts.get(v_Parts.size() - 1).toString().trim().toUpperCase();
			if(v_Suf != v_Ini)
			{
				v_HitList.add("6 PVS | PVS ID suffix does not match provider initials~~" + v_Pid + " (" + v_Ini + ")");
			}
		}
		if(ifnull(v_P.Employee_Name_Title,"").toString().trim() == "")
		{
			v_HitList.add("6 PVS | no provider name/title~~" + v_Pid);
		}
		if(v_Type == "")
		{
			v_HitList.add("6 PVS | no Type of Entry~~" + v_Pid);
		}
		v_Vs = ifnull(v_P.Visit_Status,"").toString().trim();
		if(v_Vs != "Completed")
		{
			if(v_Vs == "")
			{
				v_Vs = "(blank)";
			}
			v_HitList.add("6 PVS | Visit Status " + v_Vs + "~~" + v_Pid);
		}
		if(v_Type == "3008")
		{
			if(v_P.Cares_3008_Completion_Date == null)
			{
				v_HitList.add("6 PVS | 3008 with no 3008 Completion Date~~" + v_Pid);
			}
		}
		if(v_Type == "Patient Visit")
		{
			v_Cnt = ifnull(v_P.Clinical_Note_Type,"").toString().trim();
			if(v_Cnt == "")
			{
				v_HitList.add("6 PVS | Patient Visit with no Clinical Note Type~~" + v_Pid);
			}
			else if(v_Cnt == "Preliminary")
			{
				v_HitList.add("6 PVS | Patient Visit note still Preliminary~~" + v_Pid);
			}
			if(ifnull(v_P.Final_Clinical_Note,"").toString().trim() == "")
			{
				v_HitList.add("6 PVS | Patient Visit with empty clinical note~~" + v_Pid);
			}
			v_Proc = ifnull(v_P.Type_of_Procedures,"").toString().trim();
			if(v_Proc == "" || v_Proc == "[]")
			{
				v_HitList.add("6 PVS | Patient Visit with no Type of Procedures~~" + v_Pid);
			}
			if(ifnull(v_P.Diversion_Tracking,"").toString().trim() == "")
			{
				v_HitList.add("6 PVS | Patient Visit with no Diversion Tracking~~" + v_Pid);
			}
		}
		if(v_Type != "Imaging Order")
		{
			if(v_Lvl == "")
			{
				v_HitList.add("6 PVS | no Complexity Level~~" + v_Pid);
			}
		}
		if(v_Lvl != "")
		{
			if(!v_Zero.contains(v_Lvl))
			{
				if(v_P.Complexity_Charge == null)
				{
					v_HitList.add("6 PVS | no Complexity Charge~~" + v_Pid);
				}
			}
		}
	}
}
if(v_Mode == "BILLING")
{
	v_Rates = Map();
	for each  v_RR in Partner_Rates[Current_Rate == "Yes"]
	{
		if(ifnull(v_RR.Partner_Rate_Status,"").toString().trim() == "Inactive")
		{
			continue;
		}
		v_Bk = ifnull(v_RR.Partner_Location_Link,"").toString().trim();
		v_Rt = ifnull(v_RR.Rate_Type,"").toString().trim();
		if(v_Bk != "" && v_Rt != "")
		{
			v_Rates.put(v_Bk + "|" + v_Rt,ifnull(v_RR.Rate_Amount,0));
		}
	}
	v_SeenRef = Map();
	v_SeenPat = Map();
	v_BilledCt = 0;
	v_BilledAmt = 0.0;
	v_OpenCt = 0;
	v_OpenAmt = 0.0;
	for each  v_P in Encounter_PatientVisit[Visit_Completion_Date >= p_from && Visit_Completion_Date <= p_to]
	{
		v_Pid = ifnull(v_P.PVS_ID,"").toString().trim();
		if(v_Pid == "")
		{
			v_Pid = "rec " + v_P.ID.toString();
		}
		v_Rs = ifnull(v_P.Row_Status,"").toString().trim();
		v_Excl = false;
		if(v_Rs == "Duplicate" || v_Rs == "Cancelled" || v_Rs == "Folded")
		{
			v_Excl = true;
		}
		v_Hold = ifnull(v_P.Hold_From_Invoicing,"").toString().trim();
		v_InvNum = "";
		v_InvSt = "NONE";
		if(v_P.Invoice_Link != null)
		{
			v_InvSt = "DEAD";
			for each  v_I in Invoices[ID == v_P.Invoice_Link]
			{
				v_InvSt = "LIVE";
				v_InvNum = ifnull(v_I.Books_Invoice_Number,"").toString().trim();
				if(ifnull(v_I.Invoice_Record_Status,"").toString().trim() == "Void")
				{
					v_InvSt = "VOID";
				}
			}
		}
		v_Tag = v_Pid;
		if(v_InvNum != "")
		{
			v_Tag = v_Pid + " (" + v_InvNum + ")";
		}
		if(v_Excl)
		{
			if(v_InvSt == "LIVE")
			{
				v_HitList.add("1 RETIRED (" + v_Rs + ") but on a live invoice~~" + v_Tag);
			}
			if(v_Hold != "Yes")
			{
				v_HitList.add("3 RETIRED (" + v_Rs + ") but not held~~" + v_Tag);
			}
			continue;
		}
		v_Scanned = v_Scanned + 1;
		if(v_Rs != "Counted")
		{
			if(v_Rs == "")
			{
				v_Rs = "(blank)";
			}
			v_HitList.add("3 Row Status " + v_Rs + "~~" + v_Tag);
		}
		v_Type = ifnull(v_P.Type_of_Entry,"").toString().trim();
		v_Lvl = ifnull(v_P.Complexity_Level,"").toString().trim();
		v_Bill = ifnull(v_P.Billing_Branch,"").toString().trim();
		v_IStat = ifnull(v_P.Invoice_Status,"").toString().trim();
		v_Chg = 0.0;
		if(v_P.Complexity_Charge != null)
		{
			v_Chg = v_P.Complexity_Charge.toDecimal();
		}
		v_Amt = v_Chg;
		if(v_P.After_Hours_Fee != null)
		{
			v_Amt = v_Amt + v_P.After_Hours_Fee.toDecimal();
		}
		if(v_P.Super_Stat_Fee != null)
		{
			v_Amt = v_Amt + v_P.Super_Stat_Fee.toDecimal();
		}
		if(v_P.Equipment_Charge_Amount != null)
		{
			v_Amt = v_Amt + v_P.Equipment_Charge_Amount.toDecimal();
		}
		if(v_P.Other_Charges_Amount != null)
		{
			v_Amt = v_Amt + v_P.Other_Charges_Amount.toDecimal();
		}
		if(v_InvSt == "DEAD")
		{
			v_HitList.add("1 Invoice link points to a missing invoice~~" + v_Tag);
		}
		else if(v_InvSt == "VOID")
		{
			v_HitList.add("1 On a VOID invoice (needs rebill)~~" + v_Tag);
		}
		else if(v_InvSt == "LIVE")
		{
			v_BilledCt = v_BilledCt + 1;
			v_BilledAmt = v_BilledAmt + v_Amt;
			if(v_IStat != "Final")
			{
				v_HitList.add("2 On an invoice but Invoice Status not Final~~" + v_Tag);
			}
		}
		else
		{
			if(v_IStat == "Final")
			{
				v_HitList.add("2 Invoice Status Final but no invoice link~~" + v_Tag);
			}
			if(v_Hold == "Yes")
			{
				v_HitList.add("4 HELD, not billed~~" + v_Tag + " $" + v_Amt.round(2));
			}
			else if(v_Zero.contains(v_Lvl))
			{
				v_HitList.add("4 Not billed, $0 level " + v_Lvl + "~~" + v_Tag);
			}
			else if(v_Amt == 0)
			{
				v_HitList.add("1 Not billed, $0 total but level " + v_Lvl + "~~" + v_Tag);
			}
			else
			{
				v_OpenCt = v_OpenCt + 1;
				v_OpenAmt = v_OpenAmt + v_Amt;
				v_HitList.add("1 NOT BILLED, has a charge~~" + v_Tag + " $" + v_Amt.round(2));
			}
		}
		if(v_Lvl != "")
		{
			if(!v_Zero.contains(v_Lvl))
			{
				v_Card = v_Rates.get(v_Bill + "|" + v_Lvl);
				if(v_Card == null)
				{
					v_HitList.add("3 No Active current rate card for branch + level~~" + v_Tag + " " + v_Lvl);
				}
				else if(v_Chg != v_Card.toDecimal())
				{
					v_HitList.add("3 Charge differs from current rate card~~" + v_Tag + " $" + v_Chg + " vs $" + v_Card);
				}
			}
		}
		v_Dos = v_P.Visit_Completion_Date.toString("yyyy-MM-dd");
		v_RefKey = ifnull(v_P.Referral_Link,"").toString() + "|" + v_Dos + "|" + v_Type;
		if(v_SeenRef.containKey(v_RefKey))
		{
			v_HitList.add("1 SAME referral + visit date + type~~" + v_SeenRef.get(v_RefKey) + " & " + v_Tag);
		}
		else
		{
			v_SeenRef.put(v_RefKey,v_Tag);
		}
		v_Dob = "";
		if(v_P.Patient_DOB != null)
		{
			v_Dob = v_P.Patient_DOB.toString("yyyy-MM-dd");
		}
		v_LastN = ifnull(v_P.Patient_Last_Name,"").toString().toLowerCase().trim();
		if(v_LastN != "" && v_Dob != "")
		{
			v_PatKey = v_LastN + "|" + v_Dob + "|" + v_Dos;
			v_PatVal = ifnull(v_P.Referral_Link,"").toString() + "^" + v_Tag;
			if(v_SeenPat.containKey(v_PatKey))
			{
				v_Prev = v_SeenPat.get(v_PatKey).toString();
				v_PrevLink = v_Prev.subString(0,v_Prev.indexOf("^"));
				if(v_PrevLink != ifnull(v_P.Referral_Link,"").toString())
				{
					v_HitList.add("2 SAME patient + visit date on different referrals~~" + v_Prev.subString(v_Prev.indexOf("^") + 1,v_Prev.length()) + " & " + v_Tag);
				}
			}
			else
			{
				v_SeenPat.put(v_PatKey,v_PatVal);
			}
		}
	}
	v_Summary.add("Billed on live invoices: " + v_BilledCt + " visits, $" + v_BilledAmt.round(2));
	v_Summary.add("Not billed with a charge: " + v_OpenCt + " visits, $" + v_OpenAmt.round(2));
}
if(v_Mode == "REFERRALS")
{
	v_Linked = Map();
	for each  v_P in Encounter_PatientVisit[ID != 0]
	{
		v_Rs = ifnull(v_P.Row_Status,"").toString().trim();
		if(v_Rs == "Duplicate" || v_Rs == "Cancelled" || v_Rs == "Folded")
		{
			continue;
		}
		if(v_P.Referral_Link != null)
		{
			v_Linked.put(v_P.Referral_Link.toString(),1);
		}
	}
	for each  v_R in Referrals_Main[ID != 0]
	{
		v_Rid = ifnull(v_R.Referral_ID,"").toString().trim();
		v_Tag = v_Rid;
		if(v_Rid == "")
		{
			v_Tag = "rec " + v_R.ID.toString();
		}
		v_Rd = v_R.Referral_Date;
		v_NoRd = false;
		if(v_Rd == null)
		{
			v_NoRd = true;
			if(v_R.Referral_Added_Time != null)
			{
				v_Rd = toDate(v_R.Referral_Added_Time.toString("yyyy-MM-dd"),"yyyy-MM-dd");
			}
		}
		if(v_Rd == null)
		{
			v_HitList.add("2 No Referral Date and no Added Time (any month)~~" + v_Tag);
			continue;
		}
		if(v_Rd < p_from)
		{
			continue;
		}
		if(v_Rd > p_to)
		{
			continue;
		}
		v_Scanned = v_Scanned + 1;
		v_RType = ifnull(v_R.Referral_Type,"").toString().trim();
		if(!v_Linked.containKey(v_R.ID.toString()))
		{
			v_Lbl = v_RType;
			if(v_Lbl == "")
			{
				v_Lbl = "(no type)";
			}
			v_HitList.add("1 NO PVS | " + v_Lbl + "~~" + v_Tag);
		}
		if(v_NoRd)
		{
			v_HitList.add("2 MISSING | Referral Date (Added Time used)~~" + v_Tag);
		}
		if(v_Rid == "")
		{
			v_HitList.add("2 MISSING | Referral ID~~" + v_Tag);
		}
		if(v_RType == "")
		{
			v_HitList.add("2 MISSING | Referral Type~~" + v_Tag);
		}
		if(ifnull(v_R.Patient_First_Name,"").toString().trim() == "")
		{
			v_HitList.add("2 MISSING | Patient First Name~~" + v_Tag);
		}
		if(ifnull(v_R.Patient_Last_Name,"").toString().trim() == "")
		{
			v_HitList.add("2 MISSING | Patient Last Name~~" + v_Tag);
		}
		if(ifnull(v_R.Patient_Full_Name,"").toString().trim() == "")
		{
			v_HitList.add("2 MISSING | Patient Full Name~~" + v_Tag);
		}
		if(v_R.Patient_DOB == null)
		{
			if(ifnull(v_R.Patient_DOB1,"").toString().trim() != "")
			{
				v_HitList.add("2 MISSING | Patient DOB (text DOB not parsed)~~" + v_Tag);
			}
			else
			{
				v_HitList.add("2 MISSING | Patient DOB~~" + v_Tag);
			}
		}
		if(v_R.Partner_Link == null)
		{
			v_HitList.add("2 MISSING | Partner Link~~" + v_Tag);
		}
		if(v_R.Partner_Branch_Link == null)
		{
			v_HitList.add("2 MISSING | Partner Branch Link~~" + v_Tag);
		}
		if(ifnull(v_R.Partner_ID,"").toString().trim() == "")
		{
			v_HitList.add("2 MISSING | Partner ID~~" + v_Tag);
		}
		if(ifnull(v_R.Partner_Organization,"").toString().trim() == "")
		{
			v_HitList.add("2 MISSING | Partner Organization~~" + v_Tag);
		}
		v_RLoc = ifnull(v_R.Patient_Location,"").toString().trim();
		if(v_RLoc == "")
		{
			v_HitList.add("2 MISSING | Patient Location~~" + v_Tag);
		}
		else if(v_RLoc == "Facility")
		{
			if(ifnull(v_R.Facility_Name,"").toString().trim() == "")
			{
				v_HitList.add("2 MISSING | Facility Name~~" + v_Tag);
			}
		}
		else
		{
			if(ifnull(v_R.Patient_Address.address_line_1,"").toString().trim() == "")
			{
				v_HitList.add("2 MISSING | Home address~~" + v_Tag);
			}
		}
		if(v_RType != "3008")
		{
			if(ifnull(v_R.Patient_Hospice_ID,"").toString().trim() == "")
			{
				v_HitList.add("2 MISSING | Hospice ID (MRN)~~" + v_Tag);
			}
		}
		if(v_R.Employee_Link == null)
		{
			v_HitList.add("3 Not assigned to a provider~~" + v_Tag);
		}
	}
}
if(v_Mode == "DATELESS")
{
	v_Summary.add("DATELESS ignores the dates entered and scans every PVS.");
	for each  v_P in Encounter_PatientVisit[ID != 0]
	{
		if(v_P.Visit_Completion_Date != null)
		{
			continue;
		}
		v_Scanned = v_Scanned + 1;
		v_Pid = ifnull(v_P.PVS_ID,"").toString().trim();
		if(v_Pid == "")
		{
			v_Pid = "rec " + v_P.ID.toString();
		}
		v_Rd = "no ref date";
		if(v_P.Referral_Date != null)
		{
			v_Rd = v_P.Referral_Date.toString("MM/dd/yyyy");
		}
		v_Tag = v_Pid + " / " + ifnull(v_P.Referral_ID,"no REF").toString() + " / " + v_Rd;
		v_Type = ifnull(v_P.Type_of_Entry,"").toString().trim();
		if(v_Type == "")
		{
			v_Type = "(no type)";
		}
		v_Rs = ifnull(v_P.Row_Status,"").toString().trim();
		if(v_Rs == "Duplicate" || v_Rs == "Cancelled" || v_Rs == "Folded")
		{
			v_HitList.add("2 DATELESS, retired " + v_Rs + "~~" + v_Tag);
		}
		else if(v_Type == "3008")
		{
			if(v_P.Cares_3008_Completion_Date != null)
			{
				v_HitList.add("1 DATELESS 3008 that has a 3008 date (stamp missed)~~" + v_Tag);
			}
			else
			{
				v_HitList.add("1 DATELESS, counted | 3008~~" + v_Tag);
			}
		}
		else
		{
			v_HitList.add("1 DATELESS, counted | " + v_Type + "~~" + v_Tag);
		}
	}
}
v_Group = Map();
v_Count = Map();
v_Keys = List();
for each  v_H in v_HitList
{
	v_Pos = v_H.indexOf("~~");
	v_K = v_H.subString(0,v_Pos);
	v_V = v_H.subString(v_Pos + 2,v_H.length());
	if(v_Group.containKey(v_K))
	{
		v_Group.put(v_K,v_Group.get(v_K) + ", " + v_V);
		v_Count.put(v_K,v_Count.get(v_K) + 1);
	}
	else
	{
		v_Keys.add(v_K);
		v_Group.put(v_K,v_V);
		v_Count.put(v_K,1);
	}
}
v_Out = List();
v_Out.add("READ-ONLY AUDIT | mode " + v_Mode + " | " + p_from.toString("MM/dd/yyyy") + " to " + p_to.toString("MM/dd/yyyy") + " | scanned " + v_Scanned + " | issue types " + v_Keys.size() + " | flags " + v_HitList.size());
for each  v_S in v_Summary
{
	v_Out.add(v_S);
}
if(v_Keys.size() == 0)
{
	v_Out.add("NO ISSUES FOUND");
}
else
{
	v_Sorted = v_Keys.sort(true);
	for each  v_K in v_Sorted
	{
		v_Out.add("== " + v_K + " (" + v_Count.get(v_K) + "): " + v_Group.get(v_K));
	}
}
return v_Out.toString("\n");
