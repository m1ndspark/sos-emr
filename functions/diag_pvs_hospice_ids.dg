v_Out = "READ-ONLY";
v_Keys = ifnull(p_pvsIds,"").toList(",");
for each  v_Part in v_Keys
{
	v_Key = v_Part.trim();
	if(v_Key == "")
	{
		continue;
	}
	v_Hit = false;
	for each  v_P in Encounter_PatientVisit[PVS_ID == v_Key]
	{
		v_Hit = true;
		v_Ref = "(no link)";
		if(v_P.Referral_Link != null)
		{
			for each  v_R in Referrals_Main[ID == v_P.Referral_Link]
			{
				v_Ref = ifnull(v_R.Patient_Hospice_ID,"(blank)").toString();
				break;
			}
		}
		v_Out = v_Out + " || " + v_Key + " | PVS=" + ifnull(v_P.Patient_Hospice_ID,"(blank)").toString() + " | Referral=" + v_Ref;
		break;
	}
	if(!v_Hit)
	{
		v_Out = v_Out + " || " + v_Key + " | NOT FOUND";
	}
}
return v_Out;
