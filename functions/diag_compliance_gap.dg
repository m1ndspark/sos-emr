v_byRefId = Map();
v_byLink = Map();
v_byStamp = Map();
v_anyStatus = Map();
v_refIds = Map();
v_pvsNoRef = 0;
v_pvsCompleted = 0;
for each  v_p in Encounter_PatientVisit[ID != 0]
{
	v_rs = ifnull(v_p.Row_Status,"").toString();
	if(v_rs != "Duplicate" && v_rs != "Cancelled" && v_rs != "Folded")
	{
		v_vs = ifnull(v_p.Visit_Status,"").toString();
		v_rid = ifnull(v_p.Referral_ID,"").toString().trim();
		v_stamp = ifnull(v_p.Referral_ID_Stamp,"").toString().trim();
		if(v_rid != "")
		{
			v_anyStatus.put(v_rid,1);
		}
		if(v_vs == "Completed")
		{
			v_pvsCompleted = v_pvsCompleted + 1;
			if(v_rid != "")
			{
				v_byRefId.put(v_rid,1);
			}
			else
			{
				v_pvsNoRef = v_pvsNoRef + 1;
			}
			if(v_p.Referral_Link != null)
			{
				v_byLink.put(v_p.Referral_Link.toString(),1);
			}
			if(v_stamp != "")
			{
				v_byStamp.put(v_stamp,1);
			}
		}
	}
}
v_total = 0;
v_gap = 0;
v_viaLink = 0;
v_viaStamp = 0;
v_onlyAttempt = 0;
v_blankId = 0;
v_noDate = 0;
v_bySvc = Map();
v_byAsg = Map();
v_byMonth = Map();
v_sample = List();
v_today = zoho.currentdate;
for each  v_r in Referrals_Main[ID != 0]
{
	v_total = v_total + 1;
	v_rid = ifnull(v_r.Referral_ID,"").toString().trim();
	v_refIds.put(v_rid,1);
	if(v_rid == "" || !v_byRefId.containKey(v_rid))
	{
		v_rdStr = "";
		if(v_r.Referral_Date != null)
		{
			v_rdStr = v_r.Referral_Date.toString("MM/dd/yyyy");
		}
		else if(v_r.Referral_Added_Time != null)
		{
			v_rdStr = v_r.Referral_Added_Time.toString("MM/dd/yyyy");
		}
		else if(v_r.Added_Time != null)
		{
			v_rdStr = v_r.Added_Time.toString("MM/dd/yyyy");
		}
		if(v_rdStr == "")
		{
			v_noDate = v_noDate + 1;
		}
		else if(v_rdStr.toDate().daysBetween(v_today) > 1)
		{
			v_gap = v_gap + 1;
			if(v_rid == "")
			{
				v_blankId = v_blankId + 1;
			}
			if(v_byLink.containKey(v_r.ID.toString()))
			{
				v_viaLink = v_viaLink + 1;
				if(v_sample.size() < 10)
				{
					v_sample.add(v_rid);
				}
			}
			if(v_rid != "" && v_byStamp.containKey(v_rid))
			{
				v_viaStamp = v_viaStamp + 1;
			}
			if(v_rid != "" && v_anyStatus.containKey(v_rid))
			{
				v_onlyAttempt = v_onlyAttempt + 1;
			}
			v_svc = ifnull(v_r.Referral_Type,"").toString();
			if(v_svc == "")
			{
				v_svc = "(blank)";
			}
			if(v_bySvc.containKey(v_svc))
			{
				v_bySvc.put(v_svc,v_bySvc.get(v_svc).toLong() + 1);
			}
			else
			{
				v_bySvc.put(v_svc,1);
			}
			v_asg = ifnull(v_r.Assignment_Status,"").toString();
			if(v_asg == "")
			{
				v_asg = "(blank)";
			}
			if(v_byAsg.containKey(v_asg))
			{
				v_byAsg.put(v_asg,v_byAsg.get(v_asg).toLong() + 1);
			}
			else
			{
				v_byAsg.put(v_asg,1);
			}
			v_mo = v_rdStr.toDate().toString("yyyy-MM");
			if(v_byMonth.containKey(v_mo))
			{
				v_byMonth.put(v_mo,v_byMonth.get(v_mo).toLong() + 1);
			}
			else
			{
				v_byMonth.put(v_mo,1);
			}
		}
	}
}
v_orphan = 0;
for each  v_k in v_byRefId.keys()
{
	if(!v_refIds.containKey(v_k))
	{
		v_orphan = v_orphan + 1;
	}
}
v_out = "REFERRALS " + v_total + " | NO COMPLETED PVS BY REFERRAL_ID AND >1 DAY OLD " + v_gap + " | no ref date " + v_noDate;
v_out = v_out + "\nOF THE GAP: blank Referral_ID " + v_blankId + " | completed PVS found via Referral_Link " + v_viaLink + " | via Referral_ID_Stamp " + v_viaStamp + " | PVS exists but only attempted/cancelled " + v_onlyAttempt;
v_out = v_out + "\nGAP BY SERVICE: " + v_bySvc.toString();
v_out = v_out + "\nGAP BY ASSIGNMENT STATUS: " + v_byAsg.toString();
v_out = v_out + "\nGAP BY REFERRAL MONTH: " + v_byMonth.toString();
v_out = v_out + "\nPVS: completed " + v_pvsCompleted + " | completed with blank Referral_ID " + v_pvsNoRef + " | Referral_IDs on PVS not found in Referrals_Main " + v_orphan;
v_out = v_out + "\nSAMPLE matched only via Referral_Link: " + v_sample.toString(", ");
return v_out;
