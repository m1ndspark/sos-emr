v_Mode = ifnull(p_mode,"").toString().trim().toUpperCase();
if(v_Mode != "COMMIT")
{
	v_Mode = "PREVIEW";
}
v_Type = ifnull(p_type,"").toString().trim();
v_Allowed = {"Patient Visit","3008","Imaging Order"};
if(!v_Allowed.contains(v_Type))
{
	return "ERROR: p_type must be Patient Visit, 3008 or Imaging Order.";
}
v_Changed = List();
v_Same = List();
v_Missing = List();
v_List = ifnull(p_pvsIds,"").toList(",");
for each  v_Raw in v_List
{
	v_Id = v_Raw.trim();
	if(v_Id == "")
	{
		continue;
	}
	v_Found = false;
	for each  v_P in Encounter_PatientVisit[PVS_ID == v_Id]
	{
		v_Found = true;
		v_Cur = ifnull(v_P.Type_of_Entry,"").toString();
		if(v_Cur == v_Type)
		{
			v_Same.add(v_Id);
		}
		else
		{
			v_Changed.add(v_Id + " [" + v_Cur + "] -> " + v_Type);
			if(v_Mode == "COMMIT")
			{
				update v_P
				[
					Type_of_Entry=v_Type
				];
			}
		}
	}
	if(!v_Found)
	{
		v_Missing.add(v_Id);
	}
}
v_Out = v_Mode + " | changed " + v_Changed.size() + " | already " + v_Same.size() + " | not found " + v_Missing.size();
if(v_Changed.size() > 0)
{
	v_Out = v_Out + "\n" + v_Changed.toString("\n");
}
if(v_Missing.size() > 0)
{
	v_Out = v_Out + "\nNOT FOUND: " + v_Missing.toString(", ");
}
return v_Out;
