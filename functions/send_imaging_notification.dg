v_key = ifnull(p_refKey,"").trim();
if(v_key == "")
{
	return "SKIP-NOKEY";
}
v_ref = Referrals_Main[Referral_ID == v_key];
if(v_ref.count() == 0)
{
	if(v_key.matches("^[0-9]+$"))
	{
		v_ref = Referrals_Main[ID == v_key.toLong()];
	}
}
if(v_ref.count() == 0)
{
	return "SKIP-NOTFOUND";
}
v_recId = v_ref.ID;
v_refid = "";
for each  v_Live in Referrals_Main[ID == v_recId]
{
	v_refid = ifnull(v_Live.Referral_ID,"").toString().trim();
}
if(v_refid == "")
{
	return "SKIP-NOID";
}
v_type = ifnull(v_ref.Referral_Type,"").trim();
if(v_type != "Imaging Order (only)")
{
	return "SKIP-TYPE";
}
v_cfg = API_Config[Config_Name == "ZEPTOMAIL"];
if(v_cfg.count() == 0)
{
	return "SKIP-NOCONFIG";
}
v_token = ifnull(v_cfg.Zepto_Send_Token,"").trim();
if(v_token == "")
{
	return "SKIP-NOTOKEN";
}
v_tpl = thisapp.build_imaging_email_html(v_recId);
if(v_tpl.isEmpty())
{
	return "SKIP-NOHTML";
}
v_html = v_tpl.get("html").toString();
v_patname = v_tpl.get("patname").toString();
v_subject = "REF Imaging: " + v_patname + " - " + v_refid;
v_from = "notifications@sosreferrals.com";
v_fromMap = Map();
v_fromMap.put("address",v_from);
v_fromMap.put("name","SOS Mobile Medical Care");
v_toList = List();
for each  v_addr in thisapp.get_notification_recipients("Imaging Orders")
{
	v_addrMap = Map();
	v_addrMap.put("address",v_addr);
	v_entry = Map();
	v_entry.put("email_address",v_addrMap);
	v_toList.add(v_entry);
}
v_payload = Map();
v_payload.put("from",v_fromMap);
v_payload.put("to",v_toList);
v_payload.put("subject",v_subject);
v_payload.put("htmlbody",v_html);
v_attach = thisapp.build_zepto_attachments(v_recId,v_token);
if(v_attach.size() > 0)
{
	v_payload.put("attachments",v_attach);
}
v_hdr = Map();
v_hdr.put("Accept","application/json");
v_hdr.put("Content-Type","application/json");
v_hdr.put("Authorization","Zoho-enczapikey " + v_token);
v_resp = invokeurl
[
	url :"https://api.zeptomail.com/v1.1/email"
	type :POST
	body:v_payload.toString()
	headers:v_hdr
	detailed:true
];
if(v_resp.get("responseCode") == 201)
{
	return "SENT " + v_refid;
}
return "FAIL " + v_refid + " " + v_resp.toString();
