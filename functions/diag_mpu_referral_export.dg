v_M = if(p_month < 10,"0" + p_month.toString(),p_month.toString());
v_Start = toDate(p_year.toString() + "-" + v_M + "-01","yyyy-MM-dd");
v_End = v_Start.addMonth(1);
v_Partner = ifnull(p_partner,"").trim();
v_Rows = List();
v_NoTime = 0;
for each  v_R in Referrals_Main[Referral_Date >= v_Start && Referral_Date < v_End]
{
	if(ifnull(v_R.Partner_Organization,"").toString().trim() != v_Partner)
	{
		continue;
	}
	v_T = "";
	if(v_R.Referral_Added_Time != null)
	{
		v_T = v_R.Referral_Added_Time.toString("MM-dd HH:mm");
	}
	else
	{
		v_NoTime = v_NoTime + 1;
	}
	v_Rows.add(ifnull(v_R.Referral_ID,"").toString() + "|" + ifnull(v_R.Cognito_Referral_ID,"").toString() + "|" + v_R.Referral_Date.toString("MM-dd") + "|" + v_T + "|" + ifnull(v_R.Referral_Type,"").toString() + "|" + ifnull(v_R.Partner_Location_Label,"").toString() + "|" + ifnull(v_R.Partner_POC_First_Name,"").toString().trim() + "|" + ifnull(v_R.Partner_POC_Last_Name,"").toString().trim() + "|" + ifnull(v_R.Partner_POC_Title,"").toString().trim());
}
return "READ-ONLY | " + v_Partner + " | rows=" + v_Rows.size() + " | blank added time=" + v_NoTime + " || " + v_Rows.toString(";");
