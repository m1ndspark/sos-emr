v_out = Map();
v_out.put("ok",false);
v_out.put("gate","");
v_out.put("to_name","");
v_out.put("to_partner","");
v_out.put("fax_display","");
v_out.put("fax_digits","");
v_out.put("attn","");
v_out.put("contact_id","");
if(Encounter_PatientVisit[ID == pPvsID].count() == 0)
{
	v_out.put("gate","PVS record not found.");
	return v_out;
}
v_pvs = Encounter_PatientVisit[ID == pPvsID];
v_visit = ifnull(v_pvs.Visit_Status,"").toString();
v_entry = ifnull(v_pvs.Type_of_Entry,"").toString();
v_noteType = ifnull(v_pvs.Clinical_Note_Type,"").toString();
v_branch = 0;
if(v_pvs.Billing_Branch != null)
{
	v_branch = v_pvs.Billing_Branch.toLong();
}
v_faxRaw = "";
v_toName = "";
v_partner = "";
v_cid = "";
v_bcCount = 0;
if(v_branch > 0)
{
	v_bcCount = Partner_Billing_Contacts[Partner_Location_Link == v_branch && Partner_Billing_POC_Status == "Active" && Partner_PVS_Fax != ""].count();
	for each  v_bc in Partner_Billing_Contacts[Partner_Location_Link == v_branch && Partner_Billing_POC_Status == "Active" && Partner_PVS_Fax != ""]
	{
		v_faxRaw = ifnull(v_bc.Partner_PVS_Fax,"").toString().trim();
		v_toName = (ifnull(v_bc.Partner_Billing_POC_First_Name,"").toString() + " " + ifnull(v_bc.Partner_Billing_POC_Last_Name,"").toString()).trim();
		v_cid = v_bc.ID.toString();
		for each  v_p in Partners[ID == v_bc.Partner_Link]
		{
			v_partner = ifnull(v_p.Partner_Display_Name,"").toString();
			break;
		}
		break;
	}
}
v_digits = v_faxRaw.replaceAll("[^0-9]","");
if(v_digits.length() == 11 && v_digits.startsWith("1"))
{
	v_digits = v_digits.subString(1,11);
}
v_disp = "";
if(v_digits.length() == 10)
{
	v_disp = "(" + v_digits.subString(0,3) + ") " + v_digits.subString(3,6) + "-" + v_digits.subString(6,10);
}
if(v_toName == "")
{
	v_toName = ifnull(v_pvs.Partner_Location_Label,"").toString();
}
v_gate = "";
if(v_visit == "Cancelled")
{
	v_gate = "Blocked: visit status is Cancelled.";
}
else if(v_entry != "Patient Visit")
{
	v_gate = "Blocked: faxing is supported for Patient Visit entries only. This record is " + v_entry + ".";
}
else if(v_noteType == "Preliminary")
{
	v_gate = "Blocked: clinical note type is Preliminary. Set it to Final or Addendum before faxing.";
}
else if(ifnull(v_pvs.Final_Clinical_Note,"").toString().trim() == "")
{
	v_gate = "Blocked: the clinical note is empty.";
}
else if(v_bcCount > 1)
{
	v_gate = "Blocked: " + v_bcCount + " active billing contacts carry a PVS fax number for this branch. Correct the duplicate before faxing.";
}
else if(v_bcCount == 0)
{
	v_gate = "Blocked: no PVS fax number on file for this billing branch.";
}
else if(v_disp == "")
{
	v_gate = "Blocked: the PVS fax number on file is not 10 digits.";
}
v_out.put("gate",v_gate);
v_out.put("to_name",v_toName);
v_out.put("to_partner",v_partner);
v_out.put("fax_display",v_disp);
v_out.put("fax_digits",v_digits);
v_out.put("attn",v_toName);
v_out.put("contact_id",v_cid);
if(v_gate == "")
{
	v_out.put("ok",true);
}
return v_out;
