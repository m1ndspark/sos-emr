		{
			v_blank.add("Patient_Has_Advanced_Directives");
		}
		if(r.Additional_Information == null || r.Additional_Information == "")
		{
			v_blank.add("Additional_Information");
		}
		if(r.Imaging_Type_Order == null || r.Imaging_Type_Order == "")
		{
			v_blank.add("Imaging_Type_Order");
		}
		if(r.Imaging_Order_Indication == null || r.Imaging_Order_Indication == "")
		{
			v_blank.add("Imaging_Order_Indication");
		}
		if(r.Lab_Type_Orders == null || r.Lab_Type_Orders == "")
		{
			v_blank.add("Lab_Type_Orders");
