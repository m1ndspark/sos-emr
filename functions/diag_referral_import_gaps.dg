			v_blank.add("Partner_POC_Phone");
		}
		if(r.Partner_POC_Email == null || r.Partner_POC_Email == "")
		{
			v_blank.add("Partner_POC_Email");
		}
		if(r.Referral_Date == null)
		{
			v_blank.add("Referral_Date");
		}
		v_addr = "<NULL>";
		if(r.Patient_Address != null)
		{
			v_addr = r.Patient_Address.toString();
		}
		v_out = v_out + "\n== " + v_rid + " | ADDRESS: " + v_addr;
		if(v_blank.size() == 0)
		{
			v_out = v_out + "\n   ALL FIELDS LANDED";
		}
		else
		{
			v_out = v_out + "\n   BLANK (" + v_blank.size() + "): " + v_blank.toString(", ");
		}
	}
}
return v_out;
