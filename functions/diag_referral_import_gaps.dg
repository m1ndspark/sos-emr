		{
			v_blank.add("Patient_First_Name");
		}
		if(r.Patient_MI == null || r.Patient_MI == "")
		{
			v_blank.add("Patient_MI");
		}
		if(r.Patient_Last_Name == null || r.Patient_Last_Name == "")
		{
			v_blank.add("Patient_Last_Name");
		}
		if(r.Patient_DOB == null)
		{
			v_blank.add("Patient_DOB");
		}
		if(r.Patient_Gender == null || r.Patient_Gender == "")
		{
			v_blank.add("Patient_Gender");
		}
		if(r.Patient_Hospice_ID == null || r.Patient_Hospice_ID == "")
