			v_blank.add("Patient_Hospice_ID");
		}
		if(r.Patient_SSN == null || r.Patient_SSN == "")
		{
			v_blank.add("Patient_SSN");
		}
		if(r.Patient_Phone == null || r.Patient_Phone == "")
		{
			v_blank.add("Patient_Phone");
		}
		if(r.Patient_Email == null || r.Patient_Email == "")
		{
			v_blank.add("Patient_Email");
		}
		if(r.Patient_Responsibility == null || r.Patient_Responsibility == "")
		{
			v_blank.add("Patient_Responsibility");
		}
		if(r.DM_First_Name == null || r.DM_First_Name == "")
		{
			v_blank.add("DM_First_Name");
		}
		if(r.DM_Last_Name == null || r.DM_Last_Name == "")
		{
			v_blank.add("DM_Last_Name");
		}
		if(r.Decision_Maker_Phone == null || r.Decision_Maker_Phone == "")
		{
			v_blank.add("Decision_Maker_Phone");
		}
		if(r.Decision_Maker_Email == null || r.Decision_Maker_Email == "")
		{
			v_blank.add("Decision_Maker_Email");
		}
		if(r.Decision_Maker_Relationship_to_Patient == null || r.Decision_Maker_Relationship_to_Patient == "")
		{
			v_blank.add("Decision_Maker_Relationship_to_Patient");
		}
		if(r.Patient_Location == null || r.Patient_Location == "")
		{
			v_blank.add("Patient_Location");
		}
		if(r.Facility_Name == null || r.Facility_Name == "")
		{
			v_blank.add("Facility_Name");
		}
		if(r.Facility_Phone == null || r.Facility_Phone == "")
		{
			v_blank.add("Facility_Phone");
		}
		if(r.Facility_Room_Number == null || r.Facility_Room_Number == "")
		{
			v_blank.add("Facility_Room_Number");
		}
		if(r.Referral_Reason == null || r.Referral_Reason == "")
		{
			v_blank.add("Referral_Reason");
		}
		if(r.Partner_ICD_Codes == null || r.Partner_ICD_Codes == "")
		{
			v_blank.add("Partner_ICD_Codes");
		}
		if(r.Goals_of_Care == null || r.Goals_of_Care == "")
		{
			v_blank.add("Goals_of_Care");
		}
		if(r.X_Ray_Needed == null || r.X_Ray_Needed == "")
		{
			v_blank.add("X_Ray_Needed");
		}
		if(r.Patient_Has_Allergies == null || r.Patient_Has_Allergies == "")
		{
			v_blank.add("Patient_Has_Allergies");
		}
		if(r.List_Patient_Allergies == null || r.List_Patient_Allergies == "")
