		{
			v_blank.add("Requested_Lab_Vendor");
		}
		if(r.Partner_Organization == null || r.Partner_Organization == "")
		{
			v_blank.add("Partner_Organization");
		}
		if(r.Partner_Branch == null || r.Partner_Branch == "")
		{
			v_blank.add("Partner_Branch");
		}
		if(r.Partner_POC_First_Name == null || r.Partner_POC_First_Name == "")
		{
			v_blank.add("Partner_POC_First_Name");
		}
		if(r.Partner_POC_Last_Name == null || r.Partner_POC_Last_Name == "")
