v_out = "";
for each  r in Referrals_Main[ID != 0]
{
	v_rid = r.Referral_ID;
	if(v_rid == null)
	{
		v_rid = "";
	}
	if(v_rid.startsWith("ZZCOV"))
	{
		v_blank = List();
		if(r.Referral_Source == null || r.Referral_Source == "")
		{
			v_blank.add("Referral_Source");
		}
		if(r.Referral_Type == null || r.Referral_Type == "")
		{
			v_blank.add("Referral_Type");
		}
		if(r.Requested_Priority == null || r.Requested_Priority == "")
		{
			v_blank.add("Requested_Priority");
		}
		if(r.SOS_Prior_Service == null || r.SOS_Prior_Service == "")
		{
			v_blank.add("SOS_Prior_Service");
		}
