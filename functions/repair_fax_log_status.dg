v_token = thisapp.get_rc_token();
if(v_token == "")
{
	return "aborted: no RingCentral access token";
}
v_since = zoho.currenttime.subHour(12);
v_checked = 0;
v_toFix = 0;
v_fixed = 0;
v_notSent = List();
v_errs = 0;
v_deferred = 0;
v_noPvs = 0;
v_sample = List();
for each  v_row in Fax_Log[Fax_Status == "Stuck" || (Fax_Status == "Sent" && Completed_Time >= v_since)] sort by Submitted_Time
{
	v_mid = ifnull(v_row.RC_Message_ID,"").toString();
	if(v_mid != "")
	{
		if(v_checked >= 40)
		{
			v_deferred = v_deferred + 1;
			continue;
		}
		v_checked = v_checked + 1;
		v_resp = Map();
		v_thrown = "";
		try 
		{
			v_resp = invokeurl
			[
				url :"https://platform.ringcentral.com/restapi/v1.0/account/~/extension/~/message-store/" + v_mid
				type :GET
				headers:{"Authorization":"Bearer " + v_token,"Accept":"application/json"}
			];
		}			catch (e)
		{
			v_thrown = e.message.toString();
			v_resp = Map();
		}
		v_status = "";
		if(v_thrown == "" && v_resp.get("messageStatus") != null)
		{
			v_status = v_resp.get("messageStatus").toString();
		}
		v_fid = ifnull(v_row.Fax_ID,"(no Fax ID)").toString();
		if(v_status == "")
		{
			v_errs = v_errs + 1;
		}
		else if(v_status != "Sent")
		{
			v_notSent.add(v_fid + " = " + v_status);
		}
		else
		{
			v_rcTime = null;
			if(v_resp.get("lastModifiedTime") != null)
			{
				v_iso = v_resp.get("lastModifiedTime").toString();
				if(v_iso.length() >= 19)
				{
					v_rcTime = v_iso.subString(0,19).replaceAll("T"," ").toTime("yyyy-MM-dd HH:mm:ss","UTC");
				}
			}
			if(v_rcTime == null)
			{
				v_errs = v_errs + 1;
			}
			else
			{
				v_toFix = v_toFix + 1;
				if(v_sample.size() < 10)
				{
					v_sample.add(v_fid + " " + ifnull(v_row.Fax_Status,"") + " -> Sent @ " + v_rcTime.toString("MM/dd/yyyy hh:mm a"));
				}
				if(p_commit == true)
				{
					v_row.Fax_Status="Sent";
					v_row.Completed_Time=v_rcTime;
					v_fixed = v_fixed + 1;
					if(v_row.PVS_Link != null)
					{
						v_pvs = Encounter_PatientVisit[ID == v_row.PVS_Link];
						if(v_pvs.count() > 0)
						{
							v_pvs.Fax_Status="Sent";
						}
						else
						{
							v_noPvs = v_noPvs + 1;
						}
					}
					else
					{
						v_noPvs = v_noPvs + 1;
					}
				}
			}
		}
	}
}
v_mode = "DRY RUN";
if(p_commit == true)
{
	v_mode = "COMMIT";
}
return v_mode + ": checked " + v_checked + ", to fix " + v_toFix + ", fixed " + v_fixed + ", RC errors " + v_errs + ", not Sent at RC " + v_notSent.size() + " " + v_notSent.toString("; ") + ", no PVS link " + v_noPvs + ", deferred to next run " + v_deferred + " | sample: " + v_sample.toString("; ");
