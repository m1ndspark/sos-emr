v_M = if(p_month < 10,"0" + p_month.toString(),p_month.toString());
v_Start = toDate(p_year.toString() + "-" + v_M + "-01","yyyy-MM-dd");
v_End = v_Start.addMonth(1);
v_Rows = List();
for each  v_R in Referrals_Main[Referral_Date >= v_Start && Referral_Date < v_End && Referral_Type == "3008"]
{
	v_Dob = "";
	if(v_R.Patient_DOB != null)
	{
		v_Dob = v_R.Patient_DOB.toString("MM/dd/yyyy");
	}
	v_Line = ifnull(v_R.Referral_ID,"").toString() + "|" + ifnull(v_R.Cognito_Referral_ID,"").toString() + "|" + v_R.Referral_Date.toString("MM-dd") + "|" + ifnull(v_R.Partner_Location_Label,"").toString() + "|" + ifnull(v_R.Patient_First_Name,"").toString().trim() + "|" + ifnull(v_R.Patient_Last_Name,"").toString().trim() + "|" + v_Dob;
	v_Pvs = List();
	for each  v_P in Encounter_PatientVisit[Referral_Link == v_R.ID]
	{
		v_Done = "";
		if(v_P.Visit_Completion_Date != null)
		{
			v_Done = v_P.Visit_Completion_Date.toString("MM-dd");
		}
		v_Pvs.add(ifnull(v_P.PVS_ID,"").toString() + "," + v_Done + "," + ifnull(v_P.Visit_Status,"").toString() + "," + ifnull(v_P.Row_Status,"").toString() + "," + ifnull(v_P.Employee_Name_Title,"").toString().trim());
	}
	v_Rows.add(v_Line + "|" + v_Pvs.toString("~"));
}
return "READ-ONLY | 3008 referrals=" + v_Rows.size() + " || " + v_Rows.toString(";");
