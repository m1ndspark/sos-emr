		}
		if(p.Invoice_Status == null || p.Invoice_Status == "")
		{
			v_blank.add("Invoice_Status");
		}
		v_addr = "<NULL>";
		if(p.Patient_Address != null)
		{
			v_addr = p.Patient_Address.toString();
		}
		v_out = v_out + "\n== " + v_rid + " | ADDRESS: " + v_addr;
		if(v_blank.size() == 0)
		{
			v_out = v_out + "\n   ALL FIELDS LANDED";
		}
		else
		{
			v_out = v_out + "\n   BLANK (" + v_blank.size() + "): " + v_blank.toString(", ");
		}
	}
}
return v_out;
