v_out = "";
for each  p in Encounter_PatientVisit[ID != 0]
{
	v_rid = p.Referral_ID;
	if(v_rid == null)
	{
		v_rid = "";
	}
	if(v_rid.startsWith("ZZCOV"))
	{
		v_blank = List();
