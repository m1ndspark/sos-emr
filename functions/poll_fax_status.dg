v_token = thisapp.get_rc_token();
if(v_token == "")
{
	return "aborted: no RingCentral access token";
}
v_noRetry = {"LineBusy","NoAnswer","NoFaxMachine","WrongNumber","NotAcceptingFax","InvalidNumber","NumberBlocked","InternationalDisabled"};
v_polled = 0;
v_sent = 0;
v_retry = 0;
v_perm = 0;
v_stuck = 0;
v_errs = 0;
v_noPvs = 0;
v_deferred = 0;
v_bundle = 0;
for each  v_row in Fax_Log[Fax_Status == "Queued"] sort by Submitted_Time
{
	if(v_row.RC_Message_ID != null && v_row.RC_Message_ID != "")
	{
		if(v_polled >= 40)
		{
			v_deferred = v_deferred + 1;
			continue;
		}
		v_polled = v_polled + 1;
		v_resp = Map();
		v_thrown = "";
		try 
		{
			v_resp = invokeurl
			[
				url :"https://platform.ringcentral.com/restapi/v1.0/account/~/extension/~/message-store/" + v_row.RC_Message_ID
				type :GET
				headers:{"Authorization":"Bearer " + v_token,"Accept":"application/json"}
			];
		}			catch (e)
		{
			v_thrown = e.message.toString();
			v_resp = Map();
		}
		v_row.Last_Polled_Time=zoho.currenttime;
		v_status = "";
		if(v_thrown == "" && v_resp.get("messageStatus") != null)
		{
			v_status = v_resp.get("messageStatus").toString();
		}
		if(v_status == "")
		{
			v_errs = v_errs + 1;
		}
		else
		{
			if(v_resp.get("faxPageCount") != null)
			{
				v_row.Page_Count=v_resp.get("faxPageCount").toLong();
			}
			v_rcTime = zoho.currenttime;
			if(v_resp.get("lastModifiedTime") != null)
			{
				v_iso = v_resp.get("lastModifiedTime").toString();
				if(v_iso.length() >= 19)
				{
					v_rcTime = v_iso.subString(0,19).replaceAll("T"," ").toTime("yyyy-MM-dd HH:mm:ss","UTC");
				}
			}
			v_pvsStatus = "";
			if(v_status == "Sent")
			{
				v_row.Fax_Status="Sent";
				v_row.Completed_Time=v_rcTime;
				v_pvsStatus = "Sent";
				v_sent = v_sent + 1;
			}
			else if(v_status == "SendingFailed")
			{
				v_code = "";
				if(v_resp.get("faxErrorCode") != null)
				{
					v_code = v_resp.get("faxErrorCode").toString();
				}
				v_reason = v_resp.toString();
				if(v_reason.length() > 250)
				{
					v_reason = v_reason.left(250);
				}
				v_row.Fax_Error_Code=v_code;
				v_row.Fax_Error_Reason=v_reason;
				v_row.Completed_Time=v_rcTime;
				v_pvsStatus = "Failed";
				if(v_noRetry.contains(v_code))
				{
					v_row.Fax_Status="Permanent Fail";
					v_perm = v_perm + 1;
				}
				else if(v_row.Attempt_Number >= 3)
				{
					v_row.Fax_Status="Permanent Fail";
					v_perm = v_perm + 1;
				}
				else
				{
					v_row.Fax_Status="Retry Pending";
					v_retry = v_retry + 1;
				}
			}
			else if(v_row.Submitted_Time != null)
			{
				if(v_row.Submitted_Time.addHour(4) < zoho.currenttime)
				{
					v_row.Fax_Status="Stuck";
					v_stuck = v_stuck + 1;
				}
			}
			if(v_pvsStatus != "")
			{
				v_done = Map();
				if(v_row.PVS_Link != null)
				{
					v_pvs = Encounter_PatientVisit[ID == v_row.PVS_Link];
					if(v_pvs.count() > 0)
					{
						v_pvs.Fax_Status=v_pvsStatus;
						v_done.put(v_row.PVS_Link.toString(),1);
					}
					else
					{
						v_noPvs = v_noPvs + 1;
					}
				}
				for each  v_at in Fax_Attachments[Fax_Log == v_row.ID]
				{
					if(v_at.Source_PVS_Link != null)
					{
						v_ak = v_at.Source_PVS_Link.toString();
						if(!v_done.containKey(v_ak))
						{
							v_p2 = Encounter_PatientVisit[ID == v_at.Source_PVS_Link];
							if(v_p2.count() > 0)
							{
								v_p2.Fax_Status=v_pvsStatus;
								v_bundle = v_bundle + 1;
							}
							else
							{
								v_noPvs = v_noPvs + 1;
							}
							v_done.put(v_ak,1);
						}
					}
				}
			}
		}
	}
}
return "polled " + v_polled + ", sent " + v_sent + ", retry pending " + v_retry + ", permanent fail " + v_perm + ", stuck " + v_stuck + ", poll errors " + v_errs + ", missing PVS " + v_noPvs + ", bundle PVS updated " + v_bundle + ", deferred to next run " + v_deferred;
