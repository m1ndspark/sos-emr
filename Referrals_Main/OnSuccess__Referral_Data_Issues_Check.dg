v_Flag = thisapp.compute_data_issues(input.ID);
if(v_Flag != "")
{
	v_RefId = "";
	v_SvcRaw = "";
	v_First = "";
	v_Last = "";
	v_Org = "";
	for each  v_Rec in Referrals_Main[ID == input.ID]
	{
		update v_Rec
		[
			Data_Issues=v_Flag
		];
		v_RefId = ifnull(v_Rec.Referral_ID,"").toString().trim();
		v_SvcRaw = ifnull(v_Rec.Referral_Type,"").toString().trim();
		v_First = ifnull(v_Rec.Patient_First_Name,"").toString().trim();
		v_Last = ifnull(v_Rec.Patient_Last_Name,"").toString().trim();
		v_Org = ifnull(v_Rec.Partner_Organization,"").toString().trim();
	}
	if(v_RefId == "")
	{
		v_RefId = "(no Referral ID)";
	}
	v_Name = (v_First + " " + v_Last).trim();
	if(v_Name == "")
	{
		v_Name = "(no name)";
	}
	if(v_Org == "")
	{
		v_Org = "(no partner)";
	}
	v_SvcLbl = v_SvcRaw;
	if(v_SvcRaw == "Patient Visit")
	{
		v_SvcLbl = "Visit";
	}
	else if(v_SvcRaw == "Imaging Order (only)")
	{
		v_SvcLbl = "Imaging";
	}
	if(v_SvcLbl == "")
	{
		v_SvcLbl = "(no service)";
	}
	v_Msg = "A referral was created with missing required data.<br/><br/>";
	v_Msg = v_Msg + "Referral ID: " + v_RefId + "<br/>";
	v_Msg = v_Msg + "Patient: " + v_Name + "<br/>";
	v_Msg = v_Msg + "Partner: " + v_Org + "<br/>";
	v_Msg = v_Msg + "Service: " + v_SvcRaw + "<br/><br/>";
	v_Msg = v_Msg + "Issues: " + v_Flag;
	sendmail
	[
		from :zoho.adminuserid
		to :"neil.heird@sosmmc.com"
		subject :"Data Issue: " + v_SvcLbl + " - " + v_Name + "  |  " + v_RefId
		message :v_Msg
	]
}
