if(input.Partner_POC_Email != null && input.Partner_POC_Email != "")
{
	v_c = Partner_Referral_Contacts[Partner_POC_Email == input.Partner_POC_Email];
	if(v_c.ID != null && v_c.Partner_Locations_Link != null)
	{
		input.Partner_Branch_Link = v_c.Partner_Locations_Link;
		v_Loc = Partner_Locations[ID == v_c.Partner_Locations_Link];
		input.Partner_Link = v_Loc.Partner_Link;
		input.Partner_Branch = v_Loc.Partner_Location_Name;
		input.Partner_Location_Label = v_Loc.Partner_Location_Label;
		input.Partner_Organization = v_Loc.Partner_Link.Partner_Display_Name;
		input.Partner_ID = v_Loc.Partner_Link.Partner_ID;
	}
}
