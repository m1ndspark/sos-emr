v_User = zoho.loginuserid.toLowerCase();
v_Billing = false;
if(v_User == "joshua.kolanko@sosmmc.com" || v_User == "neil.heird@sosmmc.com")
{
	v_Billing = true;
}
v_Existing = false;
if(input.PVS_ID != null)
{
	if(input.PVS_ID.toString().trim() != "")
	{
		v_Existing = true;
	}
}
v_Batched = false;
if(input.Invoice_Link != null)
{
	v_Batched = true;
}
if(input.Invoice_Status == "Final")
{
	v_Batched = true;
}
v_Unlock = false;
if(v_Existing && !v_Batched)
{
	v_Unlock = true;
}
