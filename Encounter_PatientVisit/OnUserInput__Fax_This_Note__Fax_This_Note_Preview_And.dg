if(input.Fax_This_Note == false)
{
	input.Print_Preview = "";
	return;
}
v_entry = ifnull(input.Type_of_Entry,"").toString().trim();
v_noteType = ifnull(input.Clinical_Note_Type,"").toString().trim();
v_visit = ifnull(input.Visit_Status,"").toString().trim();
v_body = ifnull(input.Final_Clinical_Note,"").toString().trim();
v_block = "";
if(v_visit == "Cancelled")
{
	v_block = "Visit status is Cancelled. This note cannot be faxed.";
}
else if(v_entry != "Patient Visit")
{
	v_block = "Faxing is supported for Patient Visit entries only. This record is " + v_entry + ".";
}
else if(v_noteType != "Final" && v_noteType != "Addendum")
{
	v_block = "Set the Clinical Note Type to Final or Addendum before faxing.";
}
else if(v_body == "")
{
	v_block = "The clinical note is empty.";
}
v_toName = "";
v_faxDisp = "";
v_override = false;
if(input.Fax_Override_Unlock == true)
{
	v_override = true;
}
if(v_block == "" && v_override)
{
	v_od = ifnull(input.Fax_Override_Number,"").toString().replaceAll("[^0-9]","");
	if(v_od.length() == 11 && v_od.startsWith("1"))
	{
		v_od = v_od.subString(1,11);
	}
	v_orsn = ifnull(input.Fax_Override_Reason,"").toString().trim();
	if(v_od.length() != 10)
	{
		v_block = "Override is on but the override fax number is not 10 digits.";
	}
	else if(v_orsn == "")
	{
		v_block = "Override is on. Enter a reason before faxing.";
	}
	else
	{
		v_faxDisp = "(" + v_od.subString(0,3) + ") " + v_od.subString(3,6) + "-" + v_od.subString(6,10);
		v_toName = ifnull(input.Partner_Location_Label,"").toString().trim();
		if(v_toName == "")
		{
			v_toName = "manually entered number";
		}
	}
}
if(v_block == "" && !v_override)
{
	v_branch = 0;
	if(input.Billing_Branch != null)
	{
		v_branch = input.Billing_Branch.toLong();
	}
	if(v_branch == 0)
	{
		v_block = "No billing branch on this visit. Tick Override Fax Number and enter one, or set the billing branch.";
	}
	else
	{
		v_bcCount = 0;
		v_faxRaw = "";
		for each  v_bc in Partner_Billing_Contacts[Partner_Location_Link == v_branch && Partner_Billing_POC_Status == "Active"]
		{
			v_thisFax = ifnull(v_bc.Partner_PVS_Fax,"").toString().trim();
			if(v_thisFax != "")
			{
				v_bcCount = v_bcCount + 1;
				if(v_bcCount == 1)
				{
					v_faxRaw = v_thisFax;
					v_toName = (ifnull(v_bc.Partner_Billing_POC_First_Name,"").toString() + " " + ifnull(v_bc.Partner_Billing_POC_Last_Name,"").toString()).trim();
				}
			}
		}
		v_digits = v_faxRaw.replaceAll("[^0-9]","");
		if(v_digits.length() == 11 && v_digits.startsWith("1"))
		{
			v_digits = v_digits.subString(1,11);
		}
		if(v_digits.length() == 10)
		{
			v_faxDisp = "(" + v_digits.subString(0,3) + ") " + v_digits.subString(3,6) + "-" + v_digits.subString(6,10);
		}
		if(v_bcCount > 1)
		{
			v_block = v_bcCount + " active billing contacts carry a PVS fax number for this branch. Tick Override Fax Number, or correct the duplicate.";
		}
		else if(v_bcCount == 0)
		{
			v_block = "No PVS fax number on file for this billing branch. Tick Override Fax Number and enter one.";
		}
		else if(v_faxDisp == "")
		{
			v_block = "The PVS fax number on file is not 10 digits. Tick Override Fax Number and enter one.";
		}
	}
}
if(v_block != "")
{
	input.Fax_This_Note = false;
	input.Print_Preview = "";
	alert "CANNOT FAX. " + v_block;
	return;
}
v_nm = "";
if(ifnull(input.Patient_First_Name,"").toString().trim() != "")
{
	v_nm = input.Patient_First_Name.trim();
}
if(ifnull(input.Patient_MI,"").toString().trim() != "")
{
	v_nm = (v_nm + " " + input.Patient_MI.trim()).trim();
}
if(ifnull(input.Patient_Last_Name,"").toString().trim() != "")
{
	v_nm = (v_nm + " " + input.Patient_Last_Name.trim()).trim();
}
v_dob = "";
if(input.Patient_DOB != null)
{
	v_dob = input.Patient_DOB.toString("MM/dd/yyyy");
}
v_dos = "";
if(input.Visit_Completion_Date != null)
{
	v_dos = input.Visit_Completion_Date.toString("MM/dd/yyyy");
}
v_refDate = "";
if(input.Referral_Link != null)
{
	for each  v_ref in Referrals_Main[ID == input.Referral_Link]
	{
		if(v_ref.Referral_Date != null)
		{
			v_refDate = v_ref.Referral_Date.toString("MM/dd/yyyy");
		}
		break;
	}
}
v_source = thisapp.fmt_referral_source(ifnull(input.Partner_Organization,"").toString(),ifnull(input.Partner_Branch,"").toString());
v_procs = "";
if(input.Type_of_Procedures != null)
{
	v_procs = input.Type_of_Procedures.toString(", ");
}
v_banner = "";
if(v_noteType == "Addendum")
{
	v_banner = "<div class='amend'>AMENDED NOTE - SUPERSEDES THE PREVIOUSLY FAXED SUMMARY</div>";
}
v_vals = Map();
v_vals.put("PATIENT_NAME",v_nm);
v_vals.put("PATIENT_DOB",v_dob);
v_vals.put("PATIENT_GENDER",ifnull(input.Patient_Gender,""));
v_vals.put("PROVIDER_NAME",ifnull(input.Employee_Name_Title,""));
v_vals.put("SERVICE_DATE",v_dos);
v_vals.put("ACUITY_LEVEL",ifnull(input.Complexity_Level,""));
v_vals.put("VISIT_STATUS",v_visit);
v_vals.put("PVS_ID",ifnull(input.PVS_ID,""));
v_vals.put("NOTE_TYPE",v_noteType);
v_vals.put("REFERRAL_ID",ifnull(input.Referral_ID,""));
v_vals.put("REFERRAL_DATE",v_refDate);
v_vals.put("REFERRAL_SOURCE",v_source);
v_vals.put("REFERRED_BY",ifnull(input.Partner_POC_Name_Title,""));
v_vals.put("CLINICAL_TEAM",ifnull(input.Partner_POC_Team,""));
v_vals.put("TYPE_OF_PROCEDURES",v_procs);
v_vals.put("ICD_CODES",ifnull(input.Provider_ICD_Print,""));
v_vals.put("SIGNED_TIME",zoho.currenttime.toString("MM/dd/yyyy h:mm a"));
v_vals.put("CLINICAL_NOTE",v_body);
v_vals.put("AMENDMENT_BANNER",v_banner);
input.Print_Preview = thisapp.build_pvs_note_html(v_vals);
v_lead = "Review the note below. It will fax to ";
if(v_override)
{
	v_lead = "OVERRIDE. Review the note below. It will fax to ";
}
alert v_lead + v_toName + " at " + v_faxDisp + " when you submit.";
