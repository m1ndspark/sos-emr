if(input.Type_of_Entry == "3008")
{
	if(input.Reason_for_Referral == null || input.Reason_for_Referral.trim() == "")
	{
		input.Reason_for_Referral = "3008 Assessment";
	}
}
if(input.Patient_DOB == null)
{
	v_DobTxt = ifnull(input.Patient_DOB1,"").toString().trim();
	if(v_DobTxt != "")
	{
		v_DobFix = thisapp.parse_patient_dob(v_DobTxt);
		if(v_DobFix != null)
		{
			input.Patient_DOB = v_DobFix;
		}
	}
}
