if(input.Type_of_Entry == "3008")
{
	if(input.Reason_for_Referral == null || input.Reason_for_Referral.trim() == "")
	{
		input.Reason_for_Referral = "3008 Assessment";
	}
}
if(input.Patient_DOB == null)
{
	v_DobTxt = ifnull(input.Patient_DOB1,"").toString().trim();
	if(v_DobTxt != "")
	{
		v_DobFix = thisapp.parse_patient_dob(v_DobTxt);
		if(v_DobFix != null)
		{
			input.Patient_DOB = v_DobFix;
		}
	}
}
if(input.Type_of_Entry == "3008")
{
	if(input.Cares_3008_Completion_Date == null)
	{
		alert "3008 Completion Date is required for a 3008 entry.";
		cancel submit;
	}
}
else if(input.Type_of_Entry == "Patient Visit" || input.Type_of_Entry == "Imaging Order")
{
	if(input.Visit_Completion_Date == null)
	{
		alert "Visit Completion Date is required for a Patient Visit or Imaging Order.";
		cancel submit;
	}
}
