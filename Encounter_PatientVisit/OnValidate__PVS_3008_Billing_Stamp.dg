if(input.Type_of_Entry == "3008")
{
	if(input.Invoice_Status == null || input.Invoice_Status.trim() == "")
	{
		input.Invoice_Status = "Draft";
	}
	if(input.Complexity_Level == null || input.Complexity_Level.trim() == "")
	{
		input.Complexity_Level = "Cares 3008 Assessment";
	}
	if(input.Visit_Completion_Date == null)
	{
		if(input.Cares_3008_Completion_Date != null)
		{
			input.Visit_Completion_Date = input.Cares_3008_Completion_Date;
		}
	}
	if(input.Cares_3008_Completion_Date == null)
	{
		if(input.Visit_Completion_Date != null)
		{
			input.Cares_3008_Completion_Date = input.Visit_Completion_Date;
		}
	}
	v_amt = 0.0;
	if(input.Complexity_Charge != null)
	{
		v_amt = input.Complexity_Charge.toDecimal();
	}
	if(v_amt <= 0)
	{
		if(input.Billing_Branch != null)
		{
			for each  v_r in Partner_Rates[Partner_Location_Link == input.Billing_Branch && Rate_Type == "Cares 3008 Assessment" && Current_Rate == "Yes"]
			{
				input.Complexity_Charge = v_r.Rate_Amount;
				break;
			}
		}
	}
}
