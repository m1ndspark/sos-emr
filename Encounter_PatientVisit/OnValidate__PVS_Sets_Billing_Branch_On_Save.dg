if(input.Billing_Branch != null)
{
	return;
}
if(input.Referral_Link == null)
{
	return;
}
v_Ref = Referrals_Main[ID == input.Referral_Link];
if(v_Ref.ID == null)
{
	return;
}
v_ArgLink = "";
if(v_Ref.Partner_Branch_Link != null)
{
	v_ArgLink = v_Ref.Partner_Branch_Link.toString();
}
v_ArgEmail = "";
if(v_Ref.Partner_POC_Email != null)
{
	v_ArgEmail = v_Ref.Partner_POC_Email.toString();
}
v_ArgLabel = "";
if(v_Ref.Partner_Location_Label != null)
{
	v_ArgLabel = v_Ref.Partner_Location_Label.toString();
}
v_ArgOrg = "";
if(v_Ref.Partner_Organization != null)
{
	v_ArgOrg = v_Ref.Partner_Organization.toString();
}
v_Code = thisapp.resolve_branch_id(v_ArgLink,v_ArgEmail,v_ArgLabel,v_ArgOrg);
if(v_Code == "")
{
	return;
}
v_Vals = thisapp.partner_branch_values(v_Code);
if(v_Vals.get("Found").toString() != "true")
{
	return;
}
v_BranchId = 0;
for each  v_L in Partner_Locations[Partner_Location_ID == v_Code]
{
	v_BranchId = v_L.ID;
	break;
}
if(v_BranchId == 0 && v_Code.matches("^[0-9]+$"))
{
	v_BranchId = v_Code.toLong();
}
if(v_BranchId == 0)
{
	return;
}
input.Billing_Branch = v_BranchId;
input.Partner_Organization = v_Vals.get("Partner_Organization");
input.Partner_Branch = v_Vals.get("Partner_Branch");
input.Partner_Location_Label = v_Vals.get("Partner_Location_Label");
v_Charge = 0;
if(input.Complexity_Level != null && input.Complexity_Level != "")
{
	for each  v_r in Partner_Rates[Partner_Location_Link == v_BranchId && Rate_Type == input.Complexity_Level && Current_Rate == "Yes"]
	{
		v_Charge = v_r.Rate_Amount;
		break;
	}
}
input.Complexity_Charge = v_Charge;
