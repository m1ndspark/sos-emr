v_app = ifnull(zoho.loginuserid,"NULL");
v_portalEmail = "NOT AVAILABLE";
v_portalName = "NOT AVAILABLE";
try
{
	v_portalEmail = thisapp.portal.loginUserEmailid().toString();
}catch (e)
{
	v_portalEmail = "ERROR: " + e.toString();
}
try
{
	v_portalName = thisapp.portal.loginUserName().toString();
