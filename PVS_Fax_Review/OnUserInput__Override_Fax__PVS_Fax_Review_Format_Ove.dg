v_raw = ifnull(input.Override_Fax,"").toString();
if(v_raw.trim() != "")
{
	v_d = v_raw.replaceAll("[^0-9]","");
	if(v_d.length() == 11 && v_d.startsWith("1"))
	{
		v_d = v_d.subString(1,11);
	}
	if(v_d.length() == 10)
	{
		v_new = thisapp.fmt_phone_display(v_d);
		if(v_new != v_raw)
		{
			input.Override_Fax = v_new;
		}
	}
	else
	{
		input.Override_Fax = "";
		alert "Enter a 10 digit US fax number.";
	}
}
