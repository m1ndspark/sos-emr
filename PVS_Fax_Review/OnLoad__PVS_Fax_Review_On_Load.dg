v_raw = ifnull(input.PVS_Link,"").toString().trim();
v_ok = true;
v_gate = "";
if(v_raw == "")
{
	v_ok = false;
	v_gate = "No PVS supplied. Open this page from a Patient Visit Summary record.";
}
v_pid = 0;
if(v_ok)
{
	v_pid = v_raw.toLong();
	if(Encounter_PatientVisit[ID == v_pid].count() == 0)
	{
		v_ok = false;
		v_gate = "PVS record " + v_raw + " was not found.";
	}
}
hide PVS_Link;
hide Patient_Display;
hide Cover_Remarks;
if(!v_ok)
{
	input.Gate_Message = v_gate;
	input.Result_Message = "";
	disable Gate_Message;
	hide Result_Message;
	hide Patient_Name;
	hide Referral_ID;
	hide Note_Preview;
	hide Destination_Name;
	hide Destination_Fax;
	hide Override_Unlock;
	hide Override_Fax;
	hide Override_Fax_Confirm;
	hide Override_Reason;
	hide Attachments_Select;
}
else
{
	v_pvs = Encounter_PatientVisit[ID == v_pid];
	v_refId = "";
	v_refRec = 0;
	if(v_pvs.Referral_Link != null)
	{
		v_refRec = v_pvs.Referral_Link.toLong();
	}
	if(v_refRec > 0)
	{
		for each  v_ref in Referrals_Main[ID == v_refRec]
		{
			v_refId = ifnull(v_ref.Referral_ID,"").toString().trim();
			break;
		}
	}
	v_patName = ifnull(v_pvs.Patient_Full_Name_1,"").toString().trim();
	input.Patient_Name = v_patName;
	input.Referral_ID = v_refId;
	v_ids = List();
	v_ids.add(v_pid.toString());
	v_docs = thisapp.build_console_docs("PREVIEW","","","","","",v_ids,List());
	v_nlist = v_docs.get("notes");
	v_prev = "";
	if(v_nlist != null)
	{
		if(v_nlist.size() > 0)
		{
			v_prev = v_nlist.get(0).get("html").toString();
		}
	}
	if(v_prev == "")
	{
		v_prev = "<p>The note could not be rendered. Open the record and check the clinical note.</p>";
	}
	input.Note_Preview = v_prev;
	v_tgt = thisapp.resolve_pvs_fax_target(v_pid);
	v_toName = v_tgt.get("to_name").toString();
	v_faxDisp = v_tgt.get("fax_display").toString();
	v_gate = v_tgt.get("gate").toString();
	if(v_gate == "")
	{
		v_gate = "Ready to fax. Read the note below before sending. To change anything, close this window and open the visit.";
	}
	input.Destination_Name = v_toName;
	input.Destination_Fax = v_faxDisp;
	input.Gate_Message = v_gate;
	v_choices = List();
	v_cn = ifnull(v_pvs.Clinical_Note_File_Upload,"").toString();
	for each  v_f in v_cn.toList(",")
	{
		v_name = v_f.toString().trim();
		if(v_name != "")
		{
			v_choices.add("CN :: " + v_name);
		}
	}
	v_pv = ifnull(v_pvs.PVS_File_Upload,"").toString();
	for each  v_f in v_pv.toList(",")
	{
		v_name = v_f.toString().trim();
		if(v_name != "")
		{
			v_choices.add("PV :: " + v_name);
		}
	}
	v_p3 = ifnull(v_pvs.PVS_3008_Upload,"").toString();
	for each  v_f in v_p3.toList(",")
	{
		v_name = v_f.toString().trim();
		if(v_name != "")
		{
			v_choices.add("P3 :: " + v_name);
		}
	}
	clear Attachments_Select;
	if(v_choices.size() > 0)
	{
		input.Attachments_Select:ui.add(v_choices);
	}
	else
	{
		hide Attachments_Select;
	}
	input.Result_Message = "";
	disable Patient_Name;
	disable Referral_ID;
	disable Destination_Name;
	disable Destination_Fax;
	disable Gate_Message;
	hide Result_Message;
	disable Note_Preview;
	hide Override_Fax;
	hide Override_Fax_Confirm;
	hide Override_Reason;
}
