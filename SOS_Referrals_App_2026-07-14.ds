			Has_Referral_ID_Show_Hide as "Has Referral_ID Show_Hide"
			{
				type =  form
				form = Encounter_PatientVisit

				record event = on add or edit

				on user input of Has_Referral_ID
				{
					actions 
					{
						custom deluge script
						(
											if(input.Has_Referral_ID == "Yes")
										{
											show Referral_Link;
											show Referral_ID;
										}
										else if(input.Has_Referral_ID == "No")
										{
											input.Referral_Link = null;
											input.Patient_Full_Name = null;
											input.Patient_First_Name = null;
											input.Patient_MI = null;
											input.Patient_Last_Name = null;
											input.Patient_DOB = null;
											input.Patient_Gender = null;
											input.Patient_Address = null;
											input.Patient_Hospice_ID = null;
											input.Patient_SSN = null;
											input.Patient_Phone = null;
											input.Patient_Email = null;
											input.Patient_Location = null;
											input.Facility_Name = null;
											input.Facility_Phone = null;
											input.Facility_Room_Number = null;
											input.Referral_ID = null;
											input.Referral_ID_Stamp = null;
											input.Partner_ID = null;
											input.Partner_ID_Stamp = null;
											input.Partner_Organization = null;
											input.Partner_Branch = null;
											input.Partner_POC_Team = null;
											input.Partner_POC_First_Name = null;
											input.Partner_POC_Last_Name = null;
											input.Partner_POC_Title = null;
											input.Partner_POC_Phone = null;
											input.Partner_POC_Email = null;
											input.Partner_POC_Name_Title = null;
											input.Edit_Needed = null;
											hide Referral_Link;
											hide Referral_ID;
											hide Referral_Partner_Section;
											hide Edit_Needed;
											show Patient_First_Name;
											show Patient_MI;
											show Patient_Last_Name;
											hide Patient_Full_Name;
											enable Patient_First_Name;
											enable Patient_MI;
											enable Patient_Last_Name;
											enable Patient_DOB;
											enable Patient_Gender;
											enable Patient_Address;
											enable Patient_Phone;
											enable Patient_Email;
											enable Patient_Hospice_ID;
											enable Patient_SSN;
											enable Facility_Name;
											enable Facility_Phone;
											enable Facility_Room_Number;
										}
										else
										{
											hide Referral_Link;
											hide Referral_ID;
											hide Referral_Partner_Section;
											hide Edit_Needed;
										}
						)
					}
				}

			}
			Provider_ICD_Print_Builde as "Provider ICD Print Builder"
			{
				type =  form
				form = Encounter_PatientVisit

				record event = on add or edit

				on user input of Provider_ICD10_Codes_Link
				{
					actions 
					{
						custom deluge script
						(
											v_Codes = "";
										for each  v_Id in input.Provider_ICD10_Codes_Link
										{
											v_Rec = ICD10_Codes[ID == v_Id];
											for each  v_R in v_Rec
											{
												if(v_Codes == "")
												{
													v_Codes = v_R.ICD_Code;
												}
												else
												{
													v_Codes = v_Codes + ", " + v_R.ICD_Code;
												}
											}
										}
										input.Provider_ICD_Print = v_Codes;
						)
					}
				}

			}
			Partner_Contact_Upsert as "Partner Contact Upsert"
			{
				type =  form
				form = Referrals_Main

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											v_Email = input.Partner_POC_Email;
										if(v_Email != "")
										{
											v_Existing = Partner_Referral_Contacts[Partner_POC_Email == v_Email];
											v_Found = false;
											for each  v_Rec in v_Existing
											{
												v_Rec.Partner_POC_First_Name=input.Partner_POC_First_Name;
												v_Rec.Partner_POC_Last_Name=input.Partner_POC_Last_Name;
												v_Rec.Partner_POC_Title=input.Partner_POC_Title;
												v_Rec.Partner_POC_Phone=input.Partner_POC_Phone;
												v_Rec.Partner_Organization=input.Partner_Organization;
												v_Rec.Partner_Branch=input.Partner_Branch;
												v_Rec.Partner_POC_Team=input.Partner_POC_Team;
												v_Found = true;
												break;
											}
											if(v_Found == false)
											{
												insert into Partner_Referral_Contacts
												[
													Partner_POC_Email=v_Email
													Partner_POC_First_Name=input.Partner_POC_First_Name
													Partner_POC_Last_Name=input.Partner_POC_Last_Name
													Partner_POC_Title=input.Partner_POC_Title
													Partner_POC_Phone=input.Partner_POC_Phone
													Partner_Organization=input.Partner_Organization
													Partner_Branch=input.Partner_Branch
													Partner_POC_Team=input.Partner_POC_Team
													Added_User=zoho.loginuser
												]
											}
										}
						)
					}
				}

			}
		}

