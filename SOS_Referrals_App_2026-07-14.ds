				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Schema_Snapshot
		{
			displayname = "Schema Snapshot"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Snapshot_Data
			(
    			type = textarea
				displayname = "Snapshot Data"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Captured_On
			(
    			type = datetime
				displayname = "Captured On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Change_Summary
			(
    			type = textarea
				displayname = "Change Summary"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Sequence_Tracker
		{
			displayname = "Sequence Tracker"
			success message = "Sequence Tracker Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Object_Name
			(
    			type = text
				displayname = "Object Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Object_Prefix
			(
    			type = text
				displayname = "Object Prefix"
				maxchar = 3
	 			row = 1
	 			column = 1   
				width = medium
			)
			Object_Sequence
			(
				type = number
				displayname = "Object Sequence"
				maxchar = 5
				initial value = 1001
	 			row = 1
	 			column = 1   
				width = medium
			)
			Object_Lock_Status
			(
				type = radiobuttons
				displayname = "Object Lock Status"
				maxchar = 100
				values = {"Available","Locked"}
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form X_Ray_Orders
		{
			displayname = "X-Ray Orders"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Referral_Link
			(
				type = picklist	
				displayname = "Referral Link"
				values  = Referrals_Main.ID
    			displayformat = [Referral_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Is_Self_Responsible
			(
				type = radiobuttons
				displayname = "Is the patient self responsible?"
				maxchar = 100
				values = {"No","Yes"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Patient_POC
			(
    			type = text
				displayname = "POC For This Visit"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Patient_Full_Name
			(
    			type = text
				displayname = "Patient Full Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Patient_Address
			(
    			type = address
				displayname = "Patient Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Zip"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
	     			 visibility = false
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Patient_Phone
			(
    			type = phonenumber
				displayname = "Patient Phone"
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			X_Ray_Order
			(
    			type = textarea
				displayname = "X-Ray Order"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Send_X_Ray_Results
			(
    			type = text
				displayname = "Where to Send X-Ray Results"
	 			row = 1
	 			column = 1   
				width = medium
			)
			X_Ray_Results_Fax
			(
    			type = phonenumber
				displayname = "Fax"
    			allowedcountries={us}
    			defaultcountry="us"
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			X_Ray_Results_Email
			(
    			type = email
				displayname = "Email"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Provider_Signature_Link
			(
				type = picklist	
				displayname = "Provider Signature Link"
				values  = Employees.ID
    			displayformat = [Employee_Name_Title]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			System_Fields_Section
			(
				type = section
				displayname = "System Fields Section"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			X_Ray_Order_ID
			(
    			type = text
				displayname = "X-Ray Order ID"
	 			row = 2
	 			column = 1   
				width = medium
			)
			X_Ray_Order_ID_Stamp
			(
    			type = text
				displayname = "X-Ray Order ID Stamp"
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
