                 }
				 void mint_assignment_id(int recId)
                 {
                 	rec = Assignments[ID == recId];
                 	if(rec != null)
                 	{
                 		existing = rec.Assignment_ID;
                 		if(existing == null)
                 		{
                 			existing = "";
                 		}
                 		if(existing.trim() == "")
                 		{
                 			v_seq = 0;
                 			for each  trk in Sequence_Tracker[Object_Prefix == "ASG"]
                 			{
                 				v_seq = trk.Object_Sequence;
                 			}
                 			rec.Assignment_ID="ASG-" + v_seq;
                 			rec.Assignment_ID_Stamp=recId.toString();
                 			for each  trk in Sequence_Tracker[Object_Prefix == "ASG"]
                 			{
                 				trk.Object_Sequence=v_seq + 1;
                 			}
                 		}
                 	}
                 }
				 void mint_employee_id(int recId)
                 {
                 	rec = Employees[ID == recId];
                 	if(rec != null)
                 	{
                 		existing = rec.Employee_ID;
                 		if(existing == null)
                 		{
                 			existing = "";
                 		}
                 		if(existing.trim() == "")
                 		{
                 			v_seq = 0;
                 			for each  trk in Sequence_Tracker[Object_Prefix == "EMP"]
                 			{
                 				v_seq = trk.Object_Sequence;
                 			}
                 			rec.Employee_ID="EMP-" + v_seq;
                 			rec.Employee_ID_Stamp=recId.toString();
                 			for each  trk in Sequence_Tracker[Object_Prefix == "EMP"]
                 			{
                 				trk.Object_Sequence=v_seq + 1;
                 			}
                 		}
                 	}
                 }
				 void mint_location_id(int recId)
                 {
                 	rec = Partner_Locations[ID == recId];
                 	if(rec != null)
                 	{
                 		existing = rec.Partner_Location_ID;
                 		if(existing == null)
                 		{
                 			existing = "";
                 		}
                 		if(existing.trim() == "" || existing.startsWith("LOC-REVIEW-"))
                 		{
                 			partnerRec = Partners[ID == rec.Partner_Link];
                 			v_partnerCode = "";
                 			if(partnerRec != null)
                 			{
                 				v_partnerCode = partnerRec.Partner_Code;
                 			}
                 			if(v_partnerCode == null)
                 			{
                 				v_partnerCode = "";
                 			}
                 			v_branchCode = rec.Partner_Location_Code;
                 			if(v_branchCode == null)
                 			{
                 				v_branchCode = "";
                 			}
                 			rec.Partner_Location_ID_Stamp=recId.toString();
                 			if(v_partnerCode.trim() == "" || v_branchCode.trim() == "")
                 			{
                 				rec.Partner_Location_ID="LOC-REVIEW-" + recId.toString();
                 			}
                 			else
                 			{
                 				v_seq = 0;
                 				for each  trk in Sequence_Tracker[Object_Prefix == "LOC"]
                 				{
                 					v_seq = trk.Object_Sequence;
                 				}
                 				rec.Partner_Location_ID="LOC-" + v_partnerCode + v_branchCode + "-" + v_seq;
                 				for each  trk in Sequence_Tracker[Object_Prefix == "LOC"]
                 				{
                 					trk.Object_Sequence=v_seq + 1;
                 				}
                 			}
                 		}
                 	}
                 }
				 void mint_partner_id(int recId)
                 {
                 	rec = Partners[ID == recId];
                 	if(rec != null)
                 	{
                 		existing = rec.Partner_ID;
                 		if(existing == null)
                 		{
                 			existing = "";
                 		}
                 		if(existing.trim() == "" || existing.startsWith("PAR-REVIEW-"))
                 		{
                 			v_partnerCode = rec.Partner_Code;
                 			if(v_partnerCode == null)
                 			{
                 				v_partnerCode = "";
                 			}
                 			rec.Partner_ID_Stamp=recId.toString();
                 			if(v_partnerCode.trim() == "")
                 			{
                 				rec.Partner_ID="PAR-REVIEW-" + recId.toString();
                 			}
                 			else
                 			{
                 				v_seq = 0;
                 				for each  trk in Sequence_Tracker[Object_Prefix == "PAR"]
                 				{
                 					v_seq = trk.Object_Sequence;
                 				}
                 				rec.Partner_ID="PAR-" + v_partnerCode + "-" + v_seq;
                 				for each  trk in Sequence_Tracker[Object_Prefix == "PAR"]
                 				{
                 					trk.Object_Sequence=v_seq + 1;
                 				}
                 			}
                 		}
                 	}
                 }
				 void mint_referral_id(int recId)
                 {
                 	rec = Referrals_Main[ID == recId];
                 	if(rec != null)
                 	{
