			Patient_Fields_Editabilit as "Patient Fields Editability Toggle"
			{
				type =  form
				form = Encounter_PatientVisit

				record event = on add
					status = inactive

				on user input of Has_Referral_ID
				{
					actions 
					{
						custom deluge script
						(
											if(input.Has_Referral_ID == "Yes")
										{
											show Referral_Link;
											show Referral_ID;
											hide PVS_Referral_ID;
											disable Patient_First_Name;
											disable Patient_MI;
											disable Patient_Last_Name;
											disable Patient_DOB;
											disable Patient_Gender;
											disable Patient_Address;
										}
										else if(input.Has_Referral_ID == "No")
										{
											show PVS_Referral_ID;
											hide Referral_Link;
											hide Referral_ID;
											enable Patient_First_Name;
											enable Patient_MI;
											enable Patient_Last_Name;
											enable Patient_DOB;
											enable Patient_Gender;
											enable Patient_Address;
										}
										else
										{
											hide Referral_Link;
											hide Referral_ID;
											hide PVS_Referral_ID;
											enable Patient_First_Name;
											enable Patient_MI;
											enable Patient_Last_Name;
											enable Patient_DOB;
											enable Patient_Gender;
											enable Patient_Address;
										}
						)
					}
				}

			}
			SSN_Format1 as "SSN Format"
			{
				type =  form
				form = Referrals_Main

				record event = on add or edit

				on user input of Patient_SSN
				{
					actions 
					{
						custom deluge script
						(
											v_SSN = input.Patient_SSN.toString();
										if(v_SSN.contains("-"))
										{
											return;
										}
										v_SSN = v_SSN.replaceAll("[^0-9]","");
										if(v_SSN.length() == 9)
										{
											input.Patient_SSN = v_SSN.subString(0,3) + "-" + v_SSN.subString(3,5) + "-" + v_SSN.subString(5,9);
										}
						)
					}
				}

			}
			Patient_Phone_Format1 as "Patient Phone Format"
			{
				type =  form
				form = Referrals_Main

				record event = on add or edit

				on user input of Patient_Phone
				{
					actions 
					{
						custom deluge script
						(
											v_Raw = input.Patient_Phone.toString();
										if(v_Raw.contains("("))
										{
											return;
										}
										v_Digits = v_Raw.replaceAll("[^0-9]","");
										v_Digits = v_Digits.subString(v_Digits.length() - 10,v_Digits.length());
										v_Area = v_Digits.subString(0,3);
										v_Mid = v_Digits.subString(3,6);
										v_Last = v_Digits.subString(6,10);
										input.Patient_Phone = "(" + v_Area + ") " + v_Mid + "-" + v_Last;
						)
					}
				}

			}
